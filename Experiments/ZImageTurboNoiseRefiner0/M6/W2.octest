package ZImageTurboNoiseRefiner0

import Artifact
import IO

[Suite("EVT2.O7.W2")]
[Fact]
fn CapturedW2DotIsFiniteAndMatchesFixedOrderWitness() -> Void ! Error {
    let witness = LoadOctagon<W2DotWitness>("Experiments/ZImageTurboNoiseRefiner0/M6/w2_token0_channel0.octagon")?
    Assert.Equal(10240, Len(witness.Input), "FFN width")
    Assert.Equal(Len(witness.Input), Len(witness.Weight), "W2 reduction width")
    let output = W2DotFixedOrder(witness.Input, witness.Weight)
    Assert.True(output < 1000000.0 and output > -1000000.0, "W2 selected output remains finite and bounded")
    Assert.Near(witness.Expected, output, 0.001, "fixed-order FP32 diagnostic W2 output")
}

[Suite("EVT2.O7.W2")]
[Artifact]
fn WriteO7W2Witness() -> Void ! Error {
    let witness = LoadOctagon<W2DotWitness>("Experiments/ZImageTurboNoiseRefiner0/M6/w2_token0_channel0.octagon")?
    let root = "internal/prometheus/DevelopmentReport/artifacts/Evt2OctOracle"
    let _directory = IO.MakeAll(root)?
    Artifact.WriteOctagon(IO.JoinPath([root, "o7_w2_token0_channel0_witness.octagon"]), W2DotWitness { Input: witness.Input Weight: witness.Weight Expected: W2DotFixedOrder(witness.Input, witness.Weight) })
}
