package ZImageTurboNoiseRefiner0

import Artifact
import IO

[Suite("EVT2.O5.RMSNorm")]
[Fact]
fn CapturedQNormRowUsesUncenteredEpsilonRmsNorm() -> Void ! Error {
    let witness = LoadOctagon<QNormRowWitness>("Experiments/ZImageTurboNoiseRefiner0/M4/qnorm_row0_head0.octagon")?
    let actual = QkRmsNorm(witness.Input, witness.Scale)
    Assert.Equal(128, Len(actual), "Q head width")
    for i in 0..Len(actual) {
        Assert.Near(witness.Expected[i], actual[i], 0.000002, "captured Q norm row")
    }
}

[Suite("EVT2.O5.RMSNorm")]
[Artifact]
fn WriteO5QNormWitness() -> Void ! Error {
    let witness = LoadOctagon<QNormRowWitness>("Experiments/ZImageTurboNoiseRefiner0/M4/qnorm_row0_head0.octagon")?
    let root = "internal/prometheus/DevelopmentReport/artifacts/Evt2OctOracle"
    let _directory = IO.MakeAll(root)?
    Artifact.WriteOctagon(IO.JoinPath([root, "o5_qnorm_row0_head0_witness.octagon"]), QNormRowWitness { Input: witness.Input Scale: witness.Scale Expected: QkRmsNorm(witness.Input, witness.Scale) })
}
