package Manifest

record PackageManifest {
    Name: String
    Version: String
    Description: String
    Authors: String[]
    Date: String
    Kind: String
    EntryMilestone: String
    Dependencies: Dependency[]
}

record Dependency {
    Name: String
    VersionRequirement: String
}

fn Manifest() -> PackageManifest {
    return PackageManifest {
        Name: "OrbitalDecay"
        Version: "0.1.0"
        Description: "Low Earth Orbit (LEO) atmospheric drag and multi-orbit altitude decay simulation"
        Authors:["Antigravity"]
        Date: "2026-10-02"
        Kind: "experiment"
        EntryMilestone: "M0"
        Dependencies:[Dependency {Name: "OctStd" VersionRequirement: "0.1.0"}]
    }
}
