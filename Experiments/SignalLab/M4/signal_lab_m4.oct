package SignalLabM4

record Mount {
    Handle: Int
}

record SignalState {
    ControlMode: String
    DisplayMode: String
    AlertStatus: String
    FaultLatched: Bool
    Time: Float
    Value: Float
    NoiseEnabled: Bool
    SelectedSignal: String
    TickCount: Int
    HistoryCount: Int
    History0: Float
    History1: Float
    History2: Float
    History3: Float
    History4: Float
    History5: Float
}

fn Text(content: String) -> UI { return UIText(content) }
fn Button(label: String, event: String, enabled: Bool) -> UI { return UIButton(label, event, enabled) }
fn Row(children: UI[]) -> UI { return UIRow(children) }
fn Column(children: UI[]) -> UI { return UIColumn(children) }
fn Canvas(children: UI[]) -> UI { return UICanvas(children) }

fn MountUI(root: UI) -> Mount { return Mount { Handle: UIMount(root) } }
fn PatchUI(mount: Mount, next: UI) -> Int { return UIPatch(mount.Handle, next) }
fn UnmountUI(mount: Mount) -> Int { return UIUnmount(mount.Handle) }
fn Emit(mount: Mount, event: String) -> Int ! Error { return UIEmit(mount.Handle, event)? }
fn DrainEvents(mount: Mount) -> String[] { return UIDrainEvents(mount.Handle) }
fn Signature(node: UI) -> String { return UISignature(node) }

fn Init() -> SignalState {
    return ReevaluateBehavior(SignalState {
        ControlMode: ControlIdle()
        DisplayMode: DisplayTrend()
        AlertStatus: AlertNormal()
        FaultLatched: false
        Time: 0.0
        Value: 0.0
        NoiseEnabled: false
        SelectedSignal: SignalSine()
        TickCount: 0
        HistoryCount: 0
        History0: 0.0
        History1: 0.0
        History2: 0.0
        History3: 0.0
        History4: 0.0
        History5: 0.0
    })
}

fn View(model: SignalState) -> UI {
    return Canvas([
        Column([
            Text("SignalLab M4"),
            Row([
                Text("Mode: " + ControlModeLabel(model.ControlMode)),
                Text("Display: " + DisplayModeLabel(model.DisplayMode)),
                Text("Alert: " + AlertLabel(model.AlertStatus))
            ]),
            Row([
                Button("Start", StartEvent(), IsRunning(model.ControlMode) == false),
                Button("Stop", StopEvent(), IsRunning(model.ControlMode)),
                Button("Pause", PauseEvent(), model.ControlMode == ControlRunning()),
                Button("Resume", ResumeEvent(), model.ControlMode == ControlPaused())
            ]),
            Row([
                Button("Step", StepEvent(), true),
                Button("Reset", ResetEvent(), true),
                Button("Inspect", InspectEvent(), model.ControlMode == ControlRunning()),
                Button("Ack fault", AckFaultEvent(), model.FaultLatched)
            ]),
            Row([
                Button("Noise: " + NoiseToggleLabel(model.NoiseEnabled), ToggleNoiseEvent(), true),
                SignalSelectButton("Sine", SelectSignalSineEvent(), model.SelectedSignal == SignalSine()),
                SignalSelectButton("Square", SelectSignalSquareEvent(), model.SelectedSignal == SignalSquare()),
                SignalSelectButton("Noise", SelectSignalNoiseEvent(), model.SelectedSignal == SignalNoise())
            ]),
            Text("t=" + FormatFloat(model.Time, 2) + " v=" + FormatFloat(model.Value, 4)),
            Text("latest=" + LatestSampleText(model)),
            Text("plot oldest->newest"),
            PlotSampleLine(model, 5),
            PlotSampleLine(model, 4),
            PlotSampleLine(model, 3),
            PlotSampleLine(model, 2),
            PlotSampleLine(model, 1),
            PlotSampleLine(model, 0)
        ])
    ])
}

fn SignalSelectButton(label: String, token: String, selected: Bool) -> UI {
    if selected {
        return Button("[*] " + label, token, false)
    }

    return Button("[ ] " + label, token, true)
}

fn PlotSampleLine(model: SignalState, slot: Int) -> UI {
    if HasHistorySlot(model, slot) == false {
        return Text("slot | .... | --")
    }

    let v = HistorySlotValue(model, slot)
    return Text("slot | " + MarkerForValue(v) + " | " + FormatFloat(v, 4))
}

fn Update(model: SignalState, event: String) -> SignalState {
    if event == ResetEvent() {
        return Init()
    }

    if event == StepEvent() {
        let stepped = AdvanceOne(model)
        let recomputed = Recompute(stepped)
        let sampled = RecordSample(recomputed)
        return ReevaluateBehavior(WithControlMode(sampled, NextControlMode(sampled, StepEvent())))
    }

    if event == ToggleNoiseEvent() {
        return ReevaluateBehavior(Recompute(WithNoiseEnabled(model, model.NoiseEnabled == false)))
    }

    if event == SelectSignalSineEvent() {
        return ReevaluateBehavior(Recompute(WithSelectedSignal(model, SignalSine())))
    }

    if event == SelectSignalSquareEvent() {
        return ReevaluateBehavior(Recompute(WithSelectedSignal(model, SignalSquare())))
    }

    if event == SelectSignalNoiseEvent() {
        return ReevaluateBehavior(Recompute(WithSelectedSignal(model, SignalNoise())))
    }

    if event == AckFaultEvent() {
        let cleared = WithFaultLatched(model, false)
        let resumed = WithControlMode(cleared, NextControlMode(cleared, AckFaultEvent()))
        return ReevaluateBehavior(WithAlertStatus(resumed, AlertNormal()))
    }

    let modeShifted = WithControlMode(model, NextControlMode(model, event))
    return ReevaluateBehavior(modeShifted)
}

fn ReevaluateBehavior(model: SignalState) -> SignalState {
    let withFault = WithFaultLatched(model, ShouldLatchFault(model))
    let display = ChooseDisplayMode(withFault)
    let alert = ChooseAlertStatus(withFault)

    let withDisplay = WithDisplayMode(withFault, display)
    return WithAlertStatus(withDisplay, alert)
}

fn ShouldLatchFault(model: SignalState) -> Bool {
    if model.FaultLatched {
        return true
    }

    return model.SelectedSignal == SignalNoise() and model.NoiseEnabled and model.HistoryCount >= 1 and model.Value <= 0.0 - 0.40
}

fn NextControlMode(model: SignalState, event: String) -> String {
    let f = ControlDirector(model.ControlMode, event, model.FaultLatched, ShouldLatchFault(model))
    Step(f)

    if Complete(f) == false { Step(f) }
    if Complete(f) == false { Step(f) }
    if Complete(f) == false { Step(f) }
    if Complete(f) == false { Step(f) }

    match Result(f) {
        ok(value) => { return value }
        err(e) => { return model.ControlMode }
    }
}

flow ControlDirector(current: String, event: String, faultLatched: Bool, faultNow: Bool) -> String {
    state ResolveCurrent {
        when {
            case current == ControlIdle() -> goto Idle
            case current == ControlRunning() -> goto Running
            case current == ControlPaused() -> goto Paused
            case current == ControlInspect() -> goto Inspect
            else -> goto FaultHoldDirect
        }
    }

    state Idle {
        when {
            case event == StartEvent() -> goto Running
            case event == PauseEvent() -> goto Paused
            else -> return ControlIdle()
        }
    }

    state Running {
        when {
            case faultNow or faultLatched -> goto RememberForFault
            case event == InspectEvent() -> goto RememberForInspect
            case event == StopEvent() -> goto Idle
            case event == PauseEvent() -> goto Paused
            else -> return ControlRunning()
        }
    }

    state Paused {
        when {
            case faultNow or faultLatched -> goto RememberForFault
            case event == ResumeEvent() -> goto Running
            case event == StopEvent() -> goto Idle
            else -> return ControlPaused()
        }
    }

    state RememberForInspect {
        remember
        goto Inspect
    }

    state RememberForFault {
        remember
        goto FaultHold
    }

    state Inspect {
        suspend
        resume
    }

    state FaultHold {
        suspend
        when {
            case event == AckFaultEvent() -> goto ResumeFromFault
            else -> return ControlFault()
        }
    }

    state FaultHoldDirect {
        suspend
        when {
            case event == AckFaultEvent() -> return ControlRunning()
            else -> return ControlFault()
        }
    }

    state ResumeFromFault {
        resume
    }
}

flow DisplayPolicy(mode: String, selected: String, noise: Bool, fault: Bool, historyCount: Int) -> String {
    state Decide {
        let view = when policy {
            hysteresis: 8
            min_commit: 1
        } {
            case 3 when fault score 120
            case 2 when mode == ControlPaused() or mode == ControlInspect() score 85
            case 4 when selected == SignalNoise() and noise score 70
            case 1 when historyCount > 0 score 45
            else 1
        }

        when {
            case view == 1 -> return DisplayTrend()
            case view == 2 -> return DisplayInspect()
            case view == 3 -> return DisplayFault()
            else -> return DisplayNoiseFocus()
        }
    }
}

flow AlertPolicy(mode: String, fault: Bool, noise: Bool, selected: String) -> String {
    state Decide {
        let next = when policy {
            hysteresis: 10
            min_commit: 1
        } {
            case 3 when fault score 140
            case 2 when mode == ControlInspect() score 90
            case 1 when noise and selected == SignalNoise() score 55
            else 0
        }

        when {
            case next == 3 -> return AlertFault()
            case next == 2 -> return AlertInspecting()
            case next == 1 -> return AlertWatch()
            else -> return AlertNormal()
        }
    }
}

flow InspectResumeProbe() -> Int {
    state Running {
        suspend
        remember
        goto Inspect
    }

    state Inspect {
        suspend
        resume
    }
}

fn ChooseDisplayMode(model: SignalState) -> String {
    let f = DisplayPolicy(model.ControlMode, model.SelectedSignal, model.NoiseEnabled, model.FaultLatched, model.HistoryCount)
    Step(f)

    match Result(f) {
        ok(value) => { return value }
        err(e) => { return model.DisplayMode }
    }
}

fn ChooseAlertStatus(model: SignalState) -> String {
    let f = AlertPolicy(model.ControlMode, model.FaultLatched, model.NoiseEnabled, model.SelectedSignal)
    Step(f)

    match Result(f) {
        ok(value) => { return value }
        err(e) => { return model.AlertStatus }
    }
}

fn RecordSample(model: SignalState) -> SignalState {
    let nextCount = model.HistoryCount + 1
    if nextCount > 6 {
        return WithHistory(model, 6, model.Value, model.History0, model.History1, model.History2)
    }

    return WithHistory(model, nextCount, model.Value, model.History0, model.History1, model.History2)
}

fn AdvanceOne(model: SignalState) -> SignalState {
    return WithTickCount(WithTime(model, model.Time + 0.25), model.TickCount + 1)
}

fn Recompute(model: SignalState) -> SignalState {
    return WithValue(model, ComputeBaseSignal(model.SelectedSignal, model.Time, model.TickCount) + ComputeNoiseOffset(model.NoiseEnabled, model.TickCount))
}

fn WithControlMode(model: SignalState, mode: String) -> SignalState {
    return SignalState {
        ControlMode: mode
        DisplayMode: model.DisplayMode
        AlertStatus: model.AlertStatus
        FaultLatched: model.FaultLatched
        Time: model.Time
        Value: model.Value
        NoiseEnabled: model.NoiseEnabled
        SelectedSignal: model.SelectedSignal
        TickCount: model.TickCount
        HistoryCount: model.HistoryCount
        History0: model.History0
        History1: model.History1
        History2: model.History2
        History3: model.History3
        History4: model.History4
        History5: model.History5
    }
}

