fn WithHistory(model: SignalState, count: Int, h0: Float, h1: Float, h2: Float, h3: Float) -> SignalState {
    return SignalState {
        ControlMode: model.ControlMode
        DisplayMode: model.DisplayMode
        AlertStatus: model.AlertStatus
        FaultLatched: model.FaultLatched
        Time: model.Time
        Value: model.Value
        NoiseEnabled: model.NoiseEnabled
        SelectedSignal: model.SelectedSignal
        TickCount: model.TickCount
        HistoryCount: count
        History0: h0
        History1: h1
        History2: h2
        History3: h3
        History4: model.History3
        History5: model.History4
    }
}

fn HasHistorySlot(model: SignalState, slot: Int) -> Bool { return model.HistoryCount > slot }

fn HistorySlotValue(model: SignalState, slot: Int) -> Float {
    if slot == 0 { return model.History0 }
    if slot == 1 { return model.History1 }
    if slot == 2 { return model.History2 }
    if slot == 3 { return model.History3 }
    if slot == 4 { return model.History4 }
    return model.History5
}

fn LatestSampleText(model: SignalState) -> String {
    if model.HistoryCount == 0 { return "empty" }
    return MarkerForValue(model.History0)
}

fn MarkerForValue(value: Float) -> String {
    if value <= 0.0 - 0.50 { return "<<--" }
    if value <= 0.0 - 0.20 { return "<-.-" }
    if value < 0.20 { return "--o-" }
    if value < 0.50 { return "-.->" }
    return "-->>"
}

fn ComputeBaseSignal(signal: String, time: Float, tickCount: Int) -> Float {
    if signal == SignalSine() { return time }
    if signal == SignalSquare() {
        if IsEvenTick(tickCount) { return 1.0 }
        return 0.0 - 1.0
    }

    return NoisePatternFromTick(tickCount)
}

fn ComputeNoiseOffset(noiseEnabled: Bool, tickCount: Int) -> Float {
    if noiseEnabled == false { return 0.0 }
    if tickCount == 0 or tickCount == 5 or tickCount == 10 { return 0.0 - 0.06 }
    if tickCount == 1 or tickCount == 6 or tickCount == 11 { return 0.0 - 0.03 }
    if tickCount == 2 or tickCount == 7 or tickCount == 12 { return 0.0 }
    if tickCount == 3 or tickCount == 8 or tickCount == 13 { return 0.03 }
    return 0.06
}

fn NoisePatternFromTick(tickCount: Int) -> Float {
    if tickCount == 0 or tickCount == 7 or tickCount == 14 { return 0.0 - 0.6 }
    if tickCount == 1 or tickCount == 8 or tickCount == 15 { return 0.0 - 0.4 }
    if tickCount == 2 or tickCount == 9 or tickCount == 16 { return 0.0 - 0.2 }
    if tickCount == 3 or tickCount == 10 or tickCount == 17 { return 0.0 }
    if tickCount == 4 or tickCount == 11 or tickCount == 18 { return 0.2 }
    if tickCount == 5 or tickCount == 12 or tickCount == 19 { return 0.4 }
    return 0.6
}

fn IsEvenTick(tickCount: Int) -> Bool {
    if tickCount == 0 or tickCount == 2 or tickCount == 4 or tickCount == 6 or tickCount == 8 or tickCount == 10 { return true }
    return false
}

fn ControlModeLabel(mode: String) -> String {
    if mode == ControlIdle() { return "Idle" }
    if mode == ControlRunning() { return "Running" }
    if mode == ControlPaused() { return "Paused" }
    if mode == ControlInspect() { return "Inspect" }
    return "Fault"
}

fn DisplayModeLabel(mode: String) -> String {
    if mode == DisplayTrend() { return "Trend" }
    if mode == DisplayInspect() { return "Inspect" }
    if mode == DisplayFault() { return "Fault" }
    return "NoiseFocus"
}

fn AlertLabel(status: String) -> String {
    if status == AlertNormal() { return "Normal" }
    if status == AlertWatch() { return "Watch" }
    if status == AlertInspecting() { return "Inspecting" }
    return "Fault"
}

fn IsRunning(mode: String) -> Bool { return mode == ControlRunning() }
fn NoiseToggleLabel(enabled: Bool) -> String { if enabled { return "Disable" } return "Enable" }

fn ControlIdle() -> String { return "control.idle" }
fn ControlRunning() -> String { return "control.running" }
fn ControlPaused() -> String { return "control.paused" }
fn ControlInspect() -> String { return "control.inspect" }
fn ControlFault() -> String { return "control.fault" }

fn DisplayTrend() -> String { return "display.trend" }
fn DisplayInspect() -> String { return "display.inspect" }
fn DisplayFault() -> String { return "display.fault" }
fn DisplayNoiseFocus() -> String { return "display.noise.focus" }

fn AlertNormal() -> String { return "alert.normal" }
fn AlertWatch() -> String { return "alert.watch" }
fn AlertInspecting() -> String { return "alert.inspecting" }
fn AlertFault() -> String { return "alert.fault" }

fn SignalSine() -> String { return "signal.sine" }
fn SignalSquare() -> String { return "signal.square" }
fn SignalNoise() -> String { return "signal.noise" }

fn StartEvent() -> String { return "signal.start" }
fn StopEvent() -> String { return "signal.stop" }
fn StepEvent() -> String { return "signal.step" }
fn ResetEvent() -> String { return "signal.reset" }
fn ToggleNoiseEvent() -> String { return "signal.noise.toggle" }
fn PauseEvent() -> String { return "signal.pause" }
fn ResumeEvent() -> String { return "signal.resume" }
fn InspectEvent() -> String { return "signal.inspect" }
fn AckFaultEvent() -> String { return "signal.fault.ack" }
fn SelectSignalSineEvent() -> String { return "signal.select.sine" }
fn SelectSignalSquareEvent() -> String { return "signal.select.square" }
fn SelectSignalNoiseEvent() -> String { return "signal.select.noise" }
