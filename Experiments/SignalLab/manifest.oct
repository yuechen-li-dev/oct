package Manifest

record PackageManifest {
    Name: String
    Version: String
    Description: String
    Dependencies: Dependency[]
}

record Dependency {
    Name: String
    VersionRequirement: String
}

fn Manifest() -> PackageManifest {
    return PackageManifest {
        Name: "SignalLab"
        Version: "0.1.0"
        Description: "SignalLab M0-M9a UI-backed application experiment for layout, helper conventions, control-state expression probes, and blackboard/control-memory pressure probes"
        Dependencies: [Dependency { Name: "OctStd" VersionRequirement: "0.1.0" }]
    }
}
