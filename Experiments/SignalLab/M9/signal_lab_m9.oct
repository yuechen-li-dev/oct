package SignalLabM9

record Mount {
    Handle: Int
}

record SignalBoard {
    DisplayMode: String
    DisplayOverlay: String
    AlertStatus: String
    AlertSeverity: Int
    AlertLatched: Bool
    FaultLatched: Bool
    ResumeMode: String
    ResumeModeInspect: String
    ResumeModeFault: String
    CooldownTicks: Int
    CooldownActive: Bool
    JustTriggered: Bool
    BehaviorSummary: String
}

record SignalState {
    ControlMode: String
    Board: SignalBoard
    Time: Float
    Value: Float
    NoiseEnabled: Bool
    SelectedSignal: String
    TickCount: Int
    HistoryCount: Int
    History0: Float
    History1: Float
    History2: Float
    History3: Float
    History4: Float
    History5: Float
}

record ViewReadout {
    DisplayMode: String
    AlertStatus: String
    FaultLatched: Bool
}

fn Text(content: String) -> UI { return UIText(content) }
fn Button(label: String, event: String, enabled: Bool) -> UI { return UIButton(label, event, enabled) }
fn Row(children: UI[]) -> UI { return UIRow(children) }
fn Column(children: UI[]) -> UI { return UIColumn(children) }
fn Canvas(children: UI[]) -> UI { return UICanvas(children) }

fn MountUI(root: UI) -> Mount { return Mount { Handle: UIMount(root) } }
fn PatchUI(mount: Mount, next: UI) -> Int { return UIPatch(mount.Handle, next) }
fn UnmountUI(mount: Mount) -> Int { return UIUnmount(mount.Handle) }
fn Emit(mount: Mount, event: String) -> Int ! Error { return UIEmit(mount.Handle, event)? }
fn DrainEvents(mount: Mount) -> String[] { return UIDrainEvents(mount.Handle) }
fn Signature(node: UI) -> String { return UISignature(node) }

fn Init() -> SignalState {
    let board = SignalBoard {
        DisplayMode: DisplayTrend()
        DisplayOverlay: OverlayNone()
        AlertStatus: AlertNormal()
        AlertSeverity: 0
        AlertLatched: false
        FaultLatched: false
        ResumeMode: ControlRunning()
        ResumeModeInspect: ControlRunning()
        ResumeModeFault: ControlRunning()
        CooldownTicks: 0
        CooldownActive: false
        JustTriggered: false
        BehaviorSummary: "idle/clean"
    }
    return ReevaluateBehavior(SignalState {
        ControlMode: ControlIdle()
        Board: board
        Time: 0.0
        Value: 0.0
        NoiseEnabled: false
        SelectedSignal: SignalSine()
        TickCount: 0
        HistoryCount: 0
        History0: 0.0
        History1: 0.0
        History2: 0.0
        History3: 0.0
        History4: 0.0
        History5: 0.0
    }, ResetEvent())
}

fn View(model: SignalState) -> UI {
    let readout = ProjectReadout(model)
    return Canvas([
        Column([
            Text("SignalLab M8"),
            Row([
                Text("Mode: " + ControlModeLabel(model.ControlMode)),
                Text("Display: " + DisplayModeLabel(readout.DisplayMode)),
                Text("Alert: " + AlertLabel(readout.AlertStatus))
            ]),
            Row([
                Button("Start", StartEvent(), IsRunning(model.ControlMode) == false),
                Button("Stop", StopEvent(), IsRunning(model.ControlMode)),
                Button("Pause", PauseEvent(), model.ControlMode == ControlRunning()),
                Button("Resume", ResumeEvent(), model.ControlMode == ControlPaused())
            ]),
            Row([
                Button("Step", StepEvent(), true),
                Button("Reset", ResetEvent(), true),
                Button("Inspect", InspectEvent(), model.ControlMode == ControlRunning()),
                Button("Ack fault", AckFaultEvent(), readout.FaultLatched)
            ]),
            Row([
                Button("Noise: " + NoiseToggleLabel(model.NoiseEnabled), ToggleNoiseEvent(), true),
                SignalSelectButton("Sine", SelectSignalSineEvent(), model.SelectedSignal == SignalSine()),
                SignalSelectButton("Square", SelectSignalSquareEvent(), model.SelectedSignal == SignalSquare()),
                SignalSelectButton("Noise", SelectSignalNoiseEvent(), model.SelectedSignal == SignalNoise())
            ]),
            Text("t=" + FormatFloat(model.Time, 2) + " v=" + FormatFloat(model.Value, 4)),
            Text("latest=" + LatestSampleText(model)),
            Text("plot oldest->newest"),
            PlotSampleLine(model, 5),
            PlotSampleLine(model, 4),
            PlotSampleLine(model, 3),
            PlotSampleLine(model, 2),
            PlotSampleLine(model, 1),
            PlotSampleLine(model, 0)
        ])
    ])
}

fn ProjectReadout(model: SignalState) -> ViewReadout {
    let board = model.Board
    return ViewReadout {
        DisplayMode: board.DisplayMode
        AlertStatus: board.AlertStatus
        FaultLatched: board.FaultLatched
    }
}

fn SignalSelectButton(label: String, token: String, selected: Bool) -> UI {
    if selected {
        return Button("[*] " + label, token, false)
    }

    return Button("[ ] " + label, token, true)
}

fn PlotSampleLine(model: SignalState, slot: Int) -> UI {
    if HasHistorySlot(model, slot) == false {
        return Text("slot | .... | --")
    }

    let v = HistorySlotValue(model, slot)
    return Text("slot | " + MarkerForValue(v) + " | " + FormatFloat(v, 4))
}

fn Update(model: SignalState, event: String) -> SignalState {
    if event == ResetEvent() {
        return Init()
    }

    if event == StepEvent() {
        let stepped = AdvanceOne(model)
        let recomputed = Recompute(stepped)
        let sampled = RecordSample(recomputed)
        let remembered = sampled with { Board: RememberResumeMode(sampled.Board, sampled.ControlMode, StepEvent(), ShouldLatchFault(sampled)) }
        return ReevaluateBehavior(remembered with { ControlMode: NextControlMode(remembered, StepEvent()) }, StepEvent())
    }

    if event == ToggleNoiseEvent() {
        return ReevaluateBehavior(Recompute(model with { NoiseEnabled: model.NoiseEnabled == false }), ToggleNoiseEvent())
    }

    if event == SelectSignalSineEvent() {
        return ReevaluateBehavior(Recompute(model with { SelectedSignal: SignalSine() }), SelectSignalSineEvent())
    }

    if event == SelectSignalSquareEvent() {
        return ReevaluateBehavior(Recompute(model with { SelectedSignal: SignalSquare() }), SelectSignalSquareEvent())
    }

    if event == SelectSignalNoiseEvent() {
        return ReevaluateBehavior(Recompute(model with { SelectedSignal: SignalNoise() }), SelectSignalNoiseEvent())
    }

    if event == AckFaultEvent() {
        let clearedBoard = AckBoard(model.Board)
        let resumed = (model with { Board: clearedBoard }) with { ControlMode: clearedBoard.ResumeModeFault }
        return ReevaluateBehavior(resumed, AckFaultEvent())
    }

    let remembered = model with { Board: RememberResumeMode(model.Board, model.ControlMode, event, ShouldLatchFault(model)) }
    let modeShifted = remembered with { ControlMode: NextControlMode(remembered, event) }
    return ReevaluateBehavior(modeShifted, event)
}

fn ReevaluateBehavior(model: SignalState, event: String) -> SignalState {
    let board = UpdateBoardPolicy(model.Board, model.ControlMode, model.SelectedSignal, model.NoiseEnabled, model.HistoryCount, model.Value, event)
    return model with { Board: board }
}

fn ShouldLatchFault(model: SignalState) -> Bool {
    let board = model.Board
    if board.FaultLatched {
        return true
    }

    return model.SelectedSignal == SignalNoise() and model.NoiseEnabled and model.HistoryCount >= 1 and model.Value <= 0.0 - 0.40
}

fn NextControlMode(model: SignalState, event: String) -> String {
    let board = model.Board
    let f = ControlDirector(model.ControlMode, event, board.FaultLatched, ShouldLatchFault(model))
    Step(f)

    if Complete(f) == false { Step(f) }
    if Complete(f) == false { Step(f) }
    if Complete(f) == false { Step(f) }
    if Complete(f) == false { Step(f) }

    match Result(f) {
        ok(value) => { return value }
        err(e) => { return model.ControlMode }
    }
}

flow ControlDirector(current: String, event: String, faultLatched: Bool, faultNow: Bool) -> String {
    state ResolveCurrent {
        when {
            case current == ControlIdle() -> goto Idle
            case current == ControlRunning() -> goto Running
            case current == ControlPaused() -> goto Paused
            case current == ControlInspect() -> goto Inspect
            else -> goto FaultHoldDirect
        }
    }

    state Idle {
        when {
            case event == StartEvent() -> goto Running
            case event == PauseEvent() -> goto Paused
            else -> return ControlIdle()
        }
    }

    state Running {
        when {
            case faultNow or faultLatched -> goto RememberForFault
            case event == InspectEvent() -> goto RememberForInspect
            case event == StopEvent() -> goto Idle
            case event == PauseEvent() -> goto Paused
            else -> return ControlRunning()
        }
    }

    state Paused {
        when {
            case faultNow or faultLatched -> goto RememberForFault
            case event == ResumeEvent() -> goto Running
            case event == StopEvent() -> goto Idle
            else -> return ControlPaused()
        }
    }

    state RememberForInspect {
        remember
        goto Inspect
    }

    state RememberForFault {
        remember
        goto FaultHold
    }

    state Inspect {
        suspend
        resume
    }

    state FaultHold {
        suspend
        when {
            case event == AckFaultEvent() -> goto ResumeFromFault
            else -> return ControlFault()
        }
    }

    state FaultHoldDirect {
        suspend
        when {
            case event == AckFaultEvent() -> return ControlRunning()
            else -> return ControlFault()
        }
    }

    state ResumeFromFault {
        resume
    }
}

flow BoardPolicy(board: SignalBoard, mode: String, selected: String, noise: Bool, historyCount: Int, value: Float, event: String) -> SignalBoard {
    state Decide {
        if board.FaultLatched == false and selected == SignalNoise() and noise and historyCount >= 1 and value <= 0.0 - 0.40 {
            board.FaultLatched = true
            board.JustTriggered = true
            board.CooldownTicks = 3
            board.CooldownActive = true
            board.AlertLatched = true
        } else {
            board.JustTriggered = false
        }

        if board.CooldownTicks > 0 and board.JustTriggered == false {
            board.CooldownTicks = board.CooldownTicks - 1
        }
        if board.CooldownTicks == 0 {
            board.CooldownActive = false
        }

        let display = DisplayPolicy(mode, selected, noise, board.FaultLatched, historyCount)
        Step(display)
        match Result(display) {
            ok(next) => { board.DisplayMode = next }
            err(e) => { board.DisplayMode = board.DisplayMode }
        }

        let alert = AlertPolicy(mode, board.FaultLatched, noise, selected)
        Step(alert)
        match Result(alert) {
            ok(next) => { board.AlertStatus = next }
            err(e) => { board.AlertStatus = board.AlertStatus }
        }

        board.AlertSeverity = SeverityForAlert(board.AlertStatus)
        board.DisplayOverlay = OverlayFromBoard(board.FaultLatched, board.CooldownActive, board.AlertSeverity)
        board.BehaviorSummary = SummaryFromBoard(mode, board.DisplayMode, board.AlertStatus, board.CooldownActive, board.JustTriggered)
        if event == AckFaultEvent() {
            board.AlertLatched = false
        }
        return board
    }
}

flow ResumeMemory(board: SignalBoard, mode: String, event: String, faultNow: Bool) -> SignalBoard {
    state Decide {
        if event == InspectEvent() and mode == ControlRunning() {
            board.ResumeModeInspect = ControlRunning()
            board.ResumeMode = board.ResumeModeInspect
        }
        if faultNow {
            if mode == ControlPaused() { board.ResumeModeFault = ControlPaused() }
            if mode == ControlRunning() { board.ResumeModeFault = ControlRunning() }
            if mode == ControlInspect() { board.ResumeModeFault = ControlRunning() }
            if mode == ControlIdle() { board.ResumeModeFault = ControlRunning() }
            board.ResumeMode = board.ResumeModeFault
        }
        return board
    }
}

flow AckBoardFlow(board: SignalBoard) -> SignalBoard {
    state Decide {
        board.FaultLatched = false
        board.AlertStatus = AlertNormal()
        board.AlertSeverity = 0
        board.AlertLatched = false
        board.DisplayMode = DisplayTrend()
        board.DisplayOverlay = OverlayNone()
        board.CooldownTicks = 0
        board.CooldownActive = false
        board.JustTriggered = false
        board.BehaviorSummary = "ack/cleared"
        return board
    }
}

flow DisplayPolicy(mode: String, selected: String, noise: Bool, fault: Bool, historyCount: Int) -> String {
    state Decide {
        let view = when policy {
            hysteresis: 8
            min_commit: 1
        } {
            case 3 when fault score 120
            case 2 when mode == ControlPaused() or mode == ControlInspect() score 85
            case 4 when selected == SignalNoise() and noise score 70
            case 1 when historyCount > 0 score 45
            else 1
        }

        when {
            case view == 1 -> return DisplayTrend()
            case view == 2 -> return DisplayInspect()
            case view == 3 -> return DisplayFault()
            else -> return DisplayNoiseFocus()
        }
    }
}

flow AlertPolicy(mode: String, fault: Bool, noise: Bool, selected: String) -> String {
    state Decide {
        let next = when policy {
            hysteresis: 10
            min_commit: 1
        } {
            case 3 when fault score 140
            case 2 when mode == ControlInspect() score 90
            case 1 when noise and selected == SignalNoise() score 55
            else 0
        }

        when {
            case next == 3 -> return AlertFault()
            case next == 2 -> return AlertInspecting()
            case next == 1 -> return AlertWatch()
            else -> return AlertNormal()
        }
    }
}

flow InspectResumeProbe() -> Int {
    state Running {
        suspend
        remember
        goto Inspect
    }

    state Inspect {
        suspend
        resume
    }
}

fn UpdateBoardPolicy(board: SignalBoard, mode: String, selected: String, noise: Bool, historyCount: Int, value: Float, event: String) -> SignalBoard {
    let machine = BoardPolicy(board, mode, selected, noise, historyCount, value, event)
    Step(machine)

    match Result(machine) {
        ok(next) => { return next }
        err(e) => { return board }
    }
}

fn RememberResumeMode(board: SignalBoard, mode: String, event: String, faultNow: Bool) -> SignalBoard {
    let machine = ResumeMemory(board, mode, event, faultNow)
    Step(machine)

    match Result(machine) {
        ok(next) => { return next }
        err(e) => { return board }
    }
}

fn AckBoard(board: SignalBoard) -> SignalBoard {
    let machine = AckBoardFlow(board)
    Step(machine)
    match Result(machine) {
        ok(next) => { return next }
        err(e) => { return board }
    }
}

fn SeverityForAlert(status: String) -> Int {
    if status == AlertFault() { return 3 }
    if status == AlertInspecting() { return 2 }
    if status == AlertWatch() { return 1 }
    return 0
}

fn OverlayFromBoard(fault: Bool, cooldown: Bool, severity: Int) -> String {
    if fault { return OverlayFault() }
    if cooldown { return OverlayCooldown() }
    if severity >= 2 { return OverlayInspect() }
    return OverlayNone()
}

fn SummaryFromBoard(mode: String, display: String, alert: String, cooldown: Bool, justTriggered: Bool) -> String {
    if justTriggered { return "fault edge latched" }
    if mode == ControlFault() { return "fault hold active" }
    if cooldown { return "cooldown gating policy" }
    if display == DisplayInspect() and alert == AlertInspecting() { return "inspect pressure" }
    return "steady behavior"
}

fn RecordSample(model: SignalState) -> SignalState {
    let nextCount = model.HistoryCount + 1
    if nextCount > 6 {
        return model with { HistoryCount: 6 History0: model.Value History1: model.History0 History2: model.History1 History3: model.History2 History4: model.History3 History5: model.History4 }
    }

    return model with { HistoryCount: nextCount History0: model.Value History1: model.History0 History2: model.History1 History3: model.History2 History4: model.History3 History5: model.History4 }
}

fn AdvanceOne(model: SignalState) -> SignalState {
    return model with { Time: model.Time + 0.25 TickCount: model.TickCount + 1 }
}

fn Recompute(model: SignalState) -> SignalState {
    return model with { Value: ComputeBaseSignal(model.SelectedSignal, model.Time, model.TickCount) + ComputeNoiseOffset(model.NoiseEnabled, model.TickCount) }
}

fn HasHistorySlot(model: SignalState, slot: Int) -> Bool { return model.HistoryCount > slot }

fn HistorySlotValue(model: SignalState, slot: Int) -> Float {
    if slot == 0 { return model.History0 }
    if slot == 1 { return model.History1 }
    if slot == 2 { return model.History2 }
    if slot == 3 { return model.History3 }
    if slot == 4 { return model.History4 }
    return model.History5
}

fn LatestSampleText(model: SignalState) -> String {
    if model.HistoryCount == 0 { return "empty" }
    return MarkerForValue(model.History0)
}

fn MarkerForValue(value: Float) -> String {
    if value <= 0.0 - 0.50 { return "<<--" }
    if value <= 0.0 - 0.20 { return "<-.-" }
    if value < 0.20 { return "--o-" }
    if value < 0.50 { return "-.->" }
    return "-->>"
}

fn ComputeBaseSignal(signal: String, time: Float, tickCount: Int) -> Float {
    if signal == SignalSine() { return time }
    if signal == SignalSquare() {
        if IsEvenTick(tickCount) { return 1.0 }
        return 0.0 - 1.0
    }

    return NoisePatternFromTick(tickCount)
}

fn ComputeNoiseOffset(noiseEnabled: Bool, tickCount: Int) -> Float {
    if noiseEnabled == false { return 0.0 }
    if tickCount == 0 or tickCount == 5 or tickCount == 10 { return 0.0 - 0.06 }
    if tickCount == 1 or tickCount == 6 or tickCount == 11 { return 0.0 - 0.03 }
    if tickCount == 2 or tickCount == 7 or tickCount == 12 { return 0.0 }
    if tickCount == 3 or tickCount == 8 or tickCount == 13 { return 0.03 }
    return 0.06
}

fn NoisePatternFromTick(tickCount: Int) -> Float {
    if tickCount == 0 or tickCount == 7 or tickCount == 14 { return 0.0 - 0.6 }
    if tickCount == 1 or tickCount == 8 or tickCount == 15 { return 0.0 - 0.4 }
    if tickCount == 2 or tickCount == 9 or tickCount == 16 { return 0.0 - 0.2 }
    if tickCount == 3 or tickCount == 10 or tickCount == 17 { return 0.0 }
    if tickCount == 4 or tickCount == 11 or tickCount == 18 { return 0.2 }
    if tickCount == 5 or tickCount == 12 or tickCount == 19 { return 0.4 }
    return 0.6
}

fn IsEvenTick(tickCount: Int) -> Bool {
    if tickCount == 0 or tickCount == 2 or tickCount == 4 or tickCount == 6 or tickCount == 8 or tickCount == 10 { return true }
    return false
}

fn ControlModeLabel(mode: String) -> String {
    if mode == ControlIdle() { return "Idle" }
    if mode == ControlRunning() { return "Running" }
    if mode == ControlPaused() { return "Paused" }
    if mode == ControlInspect() { return "Inspect" }
    return "Fault"
}

fn DisplayModeLabel(mode: String) -> String {
    if mode == DisplayTrend() { return "Trend" }
    if mode == DisplayInspect() { return "Inspect" }
    if mode == DisplayFault() { return "Fault" }
    return "NoiseFocus"
}

fn AlertLabel(status: String) -> String {
    if status == AlertNormal() { return "Normal" }
    if status == AlertWatch() { return "Watch" }
    if status == AlertInspecting() { return "Inspecting" }
    return "Fault"
}

fn AlertSeverityLabel(severity: Int) -> String {
    if severity >= 3 { return "Sev3" }
    if severity == 2 { return "Sev2" }
    if severity == 1 { return "Sev1" }
    return "Sev0"
}

fn OverlayLabel(overlay: String) -> String {
    if overlay == OverlayFault() { return "Fault" }
    if overlay == OverlayCooldown() { return "Cooldown" }
    if overlay == OverlayInspect() { return "Inspect" }
    return "None"
}

fn CooldownLabel(active: Bool) -> String { if active { return "Active" } return "Inactive" }

fn IsRunning(mode: String) -> Bool { return mode == ControlRunning() }
fn NoiseToggleLabel(enabled: Bool) -> String { if enabled { return "Disable" } return "Enable" }

fn ControlIdle() -> String { return "control.idle" }
fn ControlRunning() -> String { return "control.running" }
fn ControlPaused() -> String { return "control.paused" }
fn ControlInspect() -> String { return "control.inspect" }
fn ControlFault() -> String { return "control.fault" }

fn DisplayTrend() -> String { return "display.trend" }
fn DisplayInspect() -> String { return "display.inspect" }
fn DisplayFault() -> String { return "display.fault" }
fn DisplayNoiseFocus() -> String { return "display.noise.focus" }

fn AlertNormal() -> String { return "alert.normal" }
fn AlertWatch() -> String { return "alert.watch" }
fn AlertInspecting() -> String { return "alert.inspecting" }
fn AlertFault() -> String { return "alert.fault" }

fn OverlayNone() -> String { return "overlay.none" }
fn OverlayInspect() -> String { return "overlay.inspect" }
fn OverlayCooldown() -> String { return "overlay.cooldown" }
fn OverlayFault() -> String { return "overlay.fault" }

fn SignalSine() -> String { return "signal.sine" }
fn SignalSquare() -> String { return "signal.square" }
fn SignalNoise() -> String { return "signal.noise" }

fn StartEvent() -> String { return "signal.start" }
fn StopEvent() -> String { return "signal.stop" }
fn StepEvent() -> String { return "signal.step" }
fn ResetEvent() -> String { return "signal.reset" }
fn ToggleNoiseEvent() -> String { return "signal.noise.toggle" }
fn PauseEvent() -> String { return "signal.pause" }
fn ResumeEvent() -> String { return "signal.resume" }
fn InspectEvent() -> String { return "signal.inspect" }
fn AckFaultEvent() -> String { return "signal.fault.ack" }
fn SelectSignalSineEvent() -> String { return "signal.select.sine" }
fn SelectSignalSquareEvent() -> String { return "signal.select.square" }
fn SelectSignalNoiseEvent() -> String { return "signal.select.noise" }
