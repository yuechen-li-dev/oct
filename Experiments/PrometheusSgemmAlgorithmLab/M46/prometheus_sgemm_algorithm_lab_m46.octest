[Artifact]
fn EmitM46AcceptanceGates() -> Void {
    let config = M46BaseConfig("comparison")
    let device = M46DefaultDevice(true)
    let shape = M46ShapeCases()[0]
    let measurement = M46BuildCaseMeasurement(config, device, shape, "baseline-scalar", "", M46VariantAvailabilityTable(), 1.0, 1.2, 0.0, 0.0, -1, false, M46GoodDiagnostics(device, shape, "baseline-scalar"))
    let rec = M46EvaluateCase(config, measurement)
    let _status = WriteOctagon("Experiments/PrometheusSgemmAlgorithmLab/M46/m46_acceptance_gates.octagon", [M46AcceptanceGateTable(rec)])
}

[Artifact]
fn EmitM46FinalRecommendation() -> Void {
    let config = M46BaseConfig("comparison")
    let device = M46DefaultDevice(true)
    let shape = M46ShapeCases()[0]
    let measurement = M46BuildCaseMeasurement(config, device, shape, "baseline-scalar", "", M46VariantAvailabilityTable(), 1.0, 1.2, 0.0, 0.0, -1, false, M46GoodDiagnostics(device, shape, "baseline-scalar"))
    let rec = M46EvaluateCase(config, measurement)
