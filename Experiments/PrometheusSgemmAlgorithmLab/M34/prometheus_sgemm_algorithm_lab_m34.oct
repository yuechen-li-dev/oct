package PrometheusSgemmAlgorithmLab

record M34PullLagTimingRow {
    CaseName: String
    PredictedDemandTimeMs: Int
    EstimatedTransferLeadTimeMs: Int
    SafetyMarginMs: Int
    StageStartTimeMs: Int
    StageCompletionTimeMs: Int
    ComputeStartTimeMs: Int
    LateStageCount: Int
    EarlyStageCount: Int
    StarvationTimeMs: Int
    ReadyButUnusedTimeMs: Int
    MemoryCommittedSlots: Int
    MemoryCeilingSlots: Int
    MemoryCeilingViolations: Int
    WipDepth: Int
    TransitionReason: String
    FallbackReason: String
    SelectedMode: String
}

record M34PullLagMemoryEdgeRow {
    CaseName: String
    MemoryBudgetSlots: Int
    PullLagPeakRequirementSlots: Int
    StageAllowed: Bool
    AllocationAccepted: Bool
    MemoryCommittedSlots: Int
    MemoryCeilingSlots: Int
    MemoryCeilingViolations: Int
    FeasibilityTruthful: Bool
    FallbackReason: String
}

record M34PullLagVarianceMissRow {
    CaseName: String
    ClassifiedVariance: String
    ActualVariance: String
    PredictedTransferLeadTimeMs: Int
    ActualTransferLeadTimeMs: Int
    LateStageCount: Int
    StarvationTimeMs: Int
    VarianceMissDetected: Bool
    RetreatedToMode: String
    FallbackReason: String
}

record M34SerialJitContractRow {
    CaseName: String
    ActiveSlotCount: Int
    WipDepth: Int
    CommittedMemorySlots: Int
    SerialRequirementSlots: Int
    SequentialStepCount: Int
    BusyRetryCount: Int
    FailureCount: Int
    CleanupCount: Int
