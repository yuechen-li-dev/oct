    SerialJitSafetyDecision: String
    SerialJitInvariants: String[]
    LegalCrossModeTransitions: String[]
    MandatoryReasonCodes: String[]
    AdditionalRakeNeededBeforeImplementation: String
    M35BuildDirection: String
}

fn M34PullLagTimingRows() -> M34PullLagTimingRow[] {
    return [
        M34PullLagTimingRow { CaseName: "pull-lag-steady-safe-window" PredictedDemandTimeMs: 100 EstimatedTransferLeadTimeMs: 30 SafetyMarginMs: 10 StageStartTimeMs: 60 StageCompletionTimeMs: 90 ComputeStartTimeMs: 100 LateStageCount: 0 EarlyStageCount: 0 StarvationTimeMs: 0 ReadyButUnusedTimeMs: 0 MemoryCommittedSlots: 2 MemoryCeilingSlots: 2 MemoryCeilingViolations: 0 WipDepth: 2 TransitionReason: "none" FallbackReason: "none" SelectedMode: "PullLagPressure" },
        M34PullLagTimingRow { CaseName: "pull-lag-late-stage-starvation" PredictedDemandTimeMs: 100 EstimatedTransferLeadTimeMs: 18 SafetyMarginMs: 2 StageStartTimeMs: 80 StageCompletionTimeMs: 108 ComputeStartTimeMs: 100 LateStageCount: 1 EarlyStageCount: 0 StarvationTimeMs: 8 ReadyButUnusedTimeMs: 0 MemoryCommittedSlots: 2 MemoryCeilingSlots: 2 MemoryCeilingViolations: 0 WipDepth: 2 TransitionReason: "retreat-to-serial-after-starvation" FallbackReason: "PULL_LAG_LATE_STAGE_STARVATION" SelectedMode: "SerialJitSurvival" },
        M34PullLagTimingRow { CaseName: "pull-lag-early-stage-wip-waste" PredictedDemandTimeMs: 100 EstimatedTransferLeadTimeMs: 55 SafetyMarginMs: 24 StageStartTimeMs: 21 StageCompletionTimeMs: 76 ComputeStartTimeMs: 100 LateStageCount: 0 EarlyStageCount: 1 StarvationTimeMs: 0 ReadyButUnusedTimeMs: 24 MemoryCommittedSlots: 2 MemoryCeilingSlots: 2 MemoryCeilingViolations: 0 WipDepth: 2 TransitionReason: "wip-waste-threshold-breach" FallbackReason: "PULL_LAG_WIP_WASTE_EXCEEDED" SelectedMode: "SerialJitSurvival" },
        M34PullLagTimingRow { CaseName: "pull-lag-compute-drift" PredictedDemandTimeMs: 120 EstimatedTransferLeadTimeMs: 30 SafetyMarginMs: 10 StageStartTimeMs: 80 StageCompletionTimeMs: 110 ComputeStartTimeMs: 96 LateStageCount: 1 EarlyStageCount: 0 StarvationTimeMs: 14 ReadyButUnusedTimeMs: 0 MemoryCommittedSlots: 2 MemoryCeilingSlots: 2 MemoryCeilingViolations: 0 WipDepth: 2 TransitionReason: "compute-duration-drift-detected" FallbackReason: "PULL_LAG_COMPUTE_UNSTABLE" SelectedMode: "SerialJitSurvival" }
    ]
}

fn M34PullLagMemoryEdgeRows() -> M34PullLagMemoryEdgeRow[] {
    return [
        M34PullLagMemoryEdgeRow { CaseName: "edge-fit-equal-budget" MemoryBudgetSlots: 2 PullLagPeakRequirementSlots: 2 StageAllowed: true AllocationAccepted: true MemoryCommittedSlots: 2 MemoryCeilingSlots: 2 MemoryCeilingViolations: 0 FeasibilityTruthful: true FallbackReason: "none" },
        M34PullLagMemoryEdgeRow { CaseName: "edge-under-budget-reject-stage" MemoryBudgetSlots: 1 PullLagPeakRequirementSlots: 2 StageAllowed: false AllocationAccepted: false MemoryCommittedSlots: 1 MemoryCeilingSlots: 1 MemoryCeilingViolations: 0 FeasibilityTruthful: true FallbackReason: "PULL_LAG_MEMORY_EDGE_REJECTED" },
        M34PullLagMemoryEdgeRow { CaseName: "edge-no-temp-overbudget" MemoryBudgetSlots: 2 PullLagPeakRequirementSlots: 3 StageAllowed: false AllocationAccepted: false MemoryCommittedSlots: 2 MemoryCeilingSlots: 2 MemoryCeilingViolations: 0 FeasibilityTruthful: true FallbackReason: "PULL_LAG_MEMORY_EDGE_REJECTED" }
    ]
}

fn M34PullLagVarianceMissRows() -> M34PullLagVarianceMissRow[] {
    return [
        M34PullLagVarianceMissRow { CaseName: "classified-moderate-actual-high-spike" ClassifiedVariance: "moderate" ActualVariance: "high" PredictedTransferLeadTimeMs: 28 ActualTransferLeadTimeMs: 49 LateStageCount: 1 StarvationTimeMs: 11 VarianceMissDetected: true RetreatedToMode: "SerialJitSurvival" FallbackReason: "PULL_LAG_VARIANCE_MISS" },
        M34PullLagVarianceMissRow { CaseName: "classified-low-actual-bursty" ClassifiedVariance: "low" ActualVariance: "high" PredictedTransferLeadTimeMs: 24 ActualTransferLeadTimeMs: 46 LateStageCount: 1 StarvationTimeMs: 7 VarianceMissDetected: true RetreatedToMode: "SerialJitSurvival" FallbackReason: "PULL_LAG_VARIANCE_MISS" },
        M34PullLagVarianceMissRow { CaseName: "classified-moderate-actual-moderate" ClassifiedVariance: "moderate" ActualVariance: "moderate" PredictedTransferLeadTimeMs: 32 ActualTransferLeadTimeMs: 34 LateStageCount: 0 StarvationTimeMs: 0 VarianceMissDetected: false RetreatedToMode: "PullLagPressure" FallbackReason: "none" }
    ]
}

fn M34SerialJitContractRows() -> M34SerialJitContractRow[] {
    return [
        M34SerialJitContractRow { CaseName: "serial-jit-steady-sequential" ActiveSlotCount: 1 WipDepth: 1 CommittedMemorySlots: 1 SerialRequirementSlots: 1 SequentialStepCount: 8 BusyRetryCount: 0 FailureCount: 0 CleanupCount: 0 OverlapObserved: false StaleReuseObserved: false CapacityChecksApplied: true Result: "pass" },
        M34SerialJitContractRow { CaseName: "serial-jit-shape-layout-precision-churn" ActiveSlotCount: 1 WipDepth: 1 CommittedMemorySlots: 1 SerialRequirementSlots: 1 SequentialStepCount: 6 BusyRetryCount: 2 FailureCount: 0 CleanupCount: 0 OverlapObserved: false StaleReuseObserved: false CapacityChecksApplied: true Result: "pass" },
        M34SerialJitContractRow { CaseName: "serial-jit-failure-needs-cleanup" ActiveSlotCount: 1 WipDepth: 1 CommittedMemorySlots: 1 SerialRequirementSlots: 1 SequentialStepCount: 4 BusyRetryCount: 1 FailureCount: 1 CleanupCount: 1 OverlapObserved: false StaleReuseObserved: false CapacityChecksApplied: true Result: "explicit-failure-and-cleanup" }
    ]
}

fn M34CrossModeTransitionRows() -> M34CrossModeTransitionRow[] {
    return [
        M34CrossModeTransitionRow { CaseName: "pull-lag-to-serial-after-late-stage" EntryMode: "PullLagPressure" ExitMode: "SerialJitSurvival" FixedDoubleFeasible: false PullLagFeasible: true SerialJitFeasible: true TransferVarianceClass: "moderate" ComputePredictabilityClass: "stable" TransitionAllowed: true TransitionReason: "PULL_LAG_LATE_STAGE_STARVATION" HardFailureReason: "none" },
        M34CrossModeTransitionRow { CaseName: "serial-to-pull-lag-after-headroom-recovery" EntryMode: "SerialJitSurvival" ExitMode: "PullLagPressure" FixedDoubleFeasible: false PullLagFeasible: true SerialJitFeasible: true TransferVarianceClass: "low" ComputePredictabilityClass: "stable" TransitionAllowed: true TransitionReason: "M33_GATES_RESTORED" HardFailureReason: "none" },
        M34CrossModeTransitionRow { CaseName: "serial-to-fixed-double-when-memory-restored" EntryMode: "SerialJitSurvival" ExitMode: "FixedDoubleDefault" FixedDoubleFeasible: true PullLagFeasible: true SerialJitFeasible: true TransferVarianceClass: "high" ComputePredictabilityClass: "unstable" TransitionAllowed: true TransitionReason: "FIXED_DOUBLE_MEMORY_RESTORED" HardFailureReason: "none" },
        M34CrossModeTransitionRow { CaseName: "all-modes-infeasible-hard-failure" EntryMode: "SerialJitSurvival" ExitMode: "NO_BUFFERING_MODE_FEASIBLE" FixedDoubleFeasible: false PullLagFeasible: false SerialJitFeasible: false TransferVarianceClass: "high" ComputePredictabilityClass: "unstable" TransitionAllowed: true TransitionReason: "NO_BUFFERING_MODE_FEASIBLE" HardFailureReason: "NO_BUFFERING_MODE_FEASIBLE" }
    ]
}

fn M34PullLagTimingRakeTableFrom(rows: M34PullLagTimingRow[]) -> M34PullLagTimingRakeTable {
    var caseName = [rows[0].CaseName]
    var predictedDemandTimeMs = [rows[0].PredictedDemandTimeMs]
    var estimatedTransferLeadTimeMs = [rows[0].EstimatedTransferLeadTimeMs]
    var safetyMarginMs = [rows[0].SafetyMarginMs]
    var stageStartTimeMs = [rows[0].StageStartTimeMs]
    var stageCompletionTimeMs = [rows[0].StageCompletionTimeMs]
    var computeStartTimeMs = [rows[0].ComputeStartTimeMs]
    var lateStageCount = [rows[0].LateStageCount]
    var earlyStageCount = [rows[0].EarlyStageCount]
    var starvationTimeMs = [rows[0].StarvationTimeMs]
    var readyButUnusedTimeMs = [rows[0].ReadyButUnusedTimeMs]
    var memoryCommittedSlots = [rows[0].MemoryCommittedSlots]
    var memoryCeilingSlots = [rows[0].MemoryCeilingSlots]
    var memoryCeilingViolations = [rows[0].MemoryCeilingViolations]
    var wipDepth = [rows[0].WipDepth]
    var selectedMode = [rows[0].SelectedMode]
    var transitionReason = [rows[0].TransitionReason]
    var fallbackReason = [rows[0].FallbackReason]

    for i in 1 .. Len(rows) {
        caseName = Append(caseName, rows[i].CaseName)
        predictedDemandTimeMs = Append(predictedDemandTimeMs, rows[i].PredictedDemandTimeMs)
        estimatedTransferLeadTimeMs = Append(estimatedTransferLeadTimeMs, rows[i].EstimatedTransferLeadTimeMs)
        safetyMarginMs = Append(safetyMarginMs, rows[i].SafetyMarginMs)
        stageStartTimeMs = Append(stageStartTimeMs, rows[i].StageStartTimeMs)
        stageCompletionTimeMs = Append(stageCompletionTimeMs, rows[i].StageCompletionTimeMs)
        computeStartTimeMs = Append(computeStartTimeMs, rows[i].ComputeStartTimeMs)
        lateStageCount = Append(lateStageCount, rows[i].LateStageCount)
        earlyStageCount = Append(earlyStageCount, rows[i].EarlyStageCount)
        starvationTimeMs = Append(starvationTimeMs, rows[i].StarvationTimeMs)
        readyButUnusedTimeMs = Append(readyButUnusedTimeMs, rows[i].ReadyButUnusedTimeMs)
        memoryCommittedSlots = Append(memoryCommittedSlots, rows[i].MemoryCommittedSlots)
        memoryCeilingSlots = Append(memoryCeilingSlots, rows[i].MemoryCeilingSlots)
        memoryCeilingViolations = Append(memoryCeilingViolations, rows[i].MemoryCeilingViolations)
        wipDepth = Append(wipDepth, rows[i].WipDepth)
        selectedMode = Append(selectedMode, rows[i].SelectedMode)
        transitionReason = Append(transitionReason, rows[i].TransitionReason)
        fallbackReason = Append(fallbackReason, rows[i].FallbackReason)
    }

    return M34PullLagTimingRakeTable {
        CaseName: caseName
        PredictedDemandTimeMs: predictedDemandTimeMs
        EstimatedTransferLeadTimeMs: estimatedTransferLeadTimeMs
        SafetyMarginMs: safetyMarginMs
        StageStartTimeMs: stageStartTimeMs
        StageCompletionTimeMs: stageCompletionTimeMs
        ComputeStartTimeMs: computeStartTimeMs
        LateStageCount: lateStageCount
        EarlyStageCount: earlyStageCount
        StarvationTimeMs: starvationTimeMs
        ReadyButUnusedTimeMs: readyButUnusedTimeMs
        MemoryCommittedSlots: memoryCommittedSlots
        MemoryCeilingSlots: memoryCeilingSlots
        MemoryCeilingViolations: memoryCeilingViolations
        WipDepth: wipDepth
        SelectedMode: selectedMode
        TransitionReason: transitionReason
        FallbackReason: fallbackReason
    }
}

