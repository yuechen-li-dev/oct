    ExitMode: String
    FixedDoubleFeasible: Bool
    PullLagFeasible: Bool
    SerialJitFeasible: Bool
    TransferVarianceClass: String
    ComputePredictabilityClass: String
    TransitionAllowed: Bool
    TransitionReason: String
    HardFailureReason: String
}

