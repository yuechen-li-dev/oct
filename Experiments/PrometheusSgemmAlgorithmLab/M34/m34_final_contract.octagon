[M34FinalContract {
    M33Recap: "M33 fixed policy selection: FixedDoubleDefault is normal default, PullLagPressure is a guarded pressure-mode only when fixed-double is memory-infeasible and stability gates are satisfied, SerialJitSurvival is final feasible fallback, and hard failure must emit NO_BUFFERING_MODE_FEASIBLE"
    PullLagSafetyDecision: "yes, safe to implement as a guarded mode only with explicit timing, memory-edge, variance-miss, and compute-drift diagnostics plus mandatory fallback behavior"
    PullLagExecutionConditions: ["fixed-double memory-feasible gate fails", "pull-lag memory-feasible gate passes without temporary budget overshoot", "transfer variance classification is low or moderate", "compute predictability is stable and deadline updates track drift", "slot ownership invariants hold: no overwrite-before-ready and no consume-before-ready", "WIP depth never exceeds two slots in pull-lag path"]
    PullLagFallbackTriggers: ["PULL_LAG_LATE_STAGE_STARVATION", "PULL_LAG_MEMORY_EDGE_REJECTED", "PULL_LAG_VARIANCE_MISS", "PULL_LAG_COMPUTE_UNSTABLE", "PULL_LAG_WIP_WASTE_EXCEEDED"]
    SerialJitSafetyDecision: "yes, safe to implement as survival fallback provided strict one-at-a-time lifecycle and cleanup-before-retry contract is enforced"
    SerialJitInvariants: ["active slot count <= 1", "WIP depth <= 1", "committed memory <= serial requirement", "no overlap between transfer/compute of different chunks", "shape/layout/precision churn forces invalidation and capacity checks", "failure must be explicit and require cleanup before retry"]
    LegalCrossModeTransitions: ["PullLagPressure -> SerialJitSurvival when pull-lag safety trigger fires and fixed-double remains infeasible", "SerialJitSurvival -> PullLagPressure only when M33 pull-lag gates are re-satisfied", "PullLagPressure or SerialJitSurvival -> FixedDoubleDefault once fixed-double feasibility recovers", "Any mode -> NO_BUFFERING_MODE_FEASIBLE when all feasibility flags are false"]
    MandatoryReasonCodes: ["PULL_LAG_LATE_STAGE_STARVATION", "PULL_LAG_MEMORY_EDGE_REJECTED", "PULL_LAG_VARIANCE_MISS", "PULL_LAG_COMPUTE_UNSTABLE", "PULL_LAG_WIP_WASTE_EXCEEDED", "FIXED_DOUBLE_MEMORY_RESTORED", "M33_GATES_RESTORED", "NO_BUFFERING_MODE_FEASIBLE"]
    AdditionalRakeNeededBeforeImplementation: "no additional broad rake required before M35; targeted runtime instrumentation validation is enough"
    M35BuildDirection: "implement three-mode selector with FixedDoubleDefault default, guarded PullLagPressure entry/exit contract, SerialJitSurvival fallback, and mandatory reason-coded diagnostics/telemetry fields captured in decision reports"
}]
