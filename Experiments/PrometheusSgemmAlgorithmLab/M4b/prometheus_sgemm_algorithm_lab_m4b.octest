package Main

[Benchmark]
fn M4b_Prometheus_S16x16x16() -> Void {
    let a = Matrix.fill(16, 16, 1.25)
    let b = Matrix.fill(16, 16, -0.75)
    PROMETHEUS {
        let c = a @ b
        ConsumeMatrix(c)
    }
}

[Benchmark]
fn M4b_Prometheus_S32x32x32() -> Void {
    let a = Matrix.fill(32, 32, 0.5)
