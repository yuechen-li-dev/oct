package PrometheusSgemmAlgorithmLab

record M25WorkloadRegime {
    Name: String
    Why: String
    NumChunks: Int
    ChunkSizeUnits: Int
    TransferSetup: Int
    TransferPerUnit: Int
    ComputePerUnit: Int
    TransferJitterAmplitude: Int
    JitterPeriod: Int
    ShockStartChunk: Int
    ShockEndChunk: Int
    ShockExtraTransferSetup: Int
    ShockExtraTransferPerUnit: Int
}

record M25StrategyConfig {
    Name: String
    Kind: String
    PushLookahead: Int
    FixedWipTarget: Int
    BaseWipCap: Int
    BaseSafetyMargin: Int
}

record M25SimulationResult {
    Regime: String
    Strategy: String
    TotalCompletionTime: Int
    ComputeStarvationTime: Int
    TransferIdleTime: Int
    ReadyButUnusedTime: Int
    TotalWipTime: Int
    PeakWipDepth: Int
    AverageWipDepthMilli: Int
    MemoryPressureProxy: Int
    StageTooEarlyCount: Int
    StageTooLateCount: Int
    SafetyMarginUsed: Int
    WipCapChanges: Int
    ModeTransitions: Int
    FlowEfficiencyScore: Int
    WipWasteScore: Int
    StarvationPenaltyScore: Int
    MemoryPressurePenalty: Int
    ProductScore: Int
}

record M25StrategyComparisonTable {
    Regime: String[]
    Strategy: String[]
    TotalCompletionTime: Int[]
    ComputeStarvationTime: Int[]
    ReadyButUnusedTime: Int[]
    PeakWipDepth: Int[]
    ProductScore: Int[]
}

record M25WipInventoryTable {
    Regime: String[]
    Strategy: String[]
    TotalWipTime: Int[]
    AverageWipDepthMilli: Int[]
    PeakWipDepth: Int[]
    MemoryPressureProxy: Int[]
    StageTooEarlyCount: Int[]
}

record M25StarvationTable {
    Regime: String[]
    Strategy: String[]
    ComputeStarvationTime: Int[]
    StageTooLateCount: Int[]
    TransferIdleTime: Int[]
    StarvationPenaltyScore: Int[]
}

record M25JitterStressTable {
    Regime: String[]
    Strategy: String[]
    ComputeStarvationTime: Int[]
    ReadyButUnusedTime: Int[]
    SafetyMarginUsed: Int[]
    ProductScore: Int[]
}

record M25AdaptiveKanbanTable {
    Regime: String[]
    AdaptiveProductScore: Int[]
    PullProductScore: Int[]
    FixedDoubleProductScore: Int[]
    AdaptiveWipCapChanges: Int[]
    AdaptiveModeTransitions: Int[]
    AdaptiveStarvation: Int[]
    AdaptiveReadyIdle: Int[]
}

record M25FinalRecommendation {
    BestOverallStrategy: String
    BestUnderJitter: String
    AdaptiveKanbanWorthIt: String
    TripleBufferJustified: String
    CarryForward: String
    RejectOrDefer: String
}

record M25TransferSignal {
    Setup: Int
    PerUnit: Int
}

record M25AdaptiveDecision {
    Cap: Int
    Margin: Int
    Mode: String
}

fn M25Max(a: Int, b: Int) -> Int { return switch { case a > b => a else => b } }
fn M25Min(a: Int, b: Int) -> Int { return switch { case a < b => a else => b } }

fn M25Regimes() -> M25WorkloadRegime[] {
    return [
        M25WorkloadRegime { Name: "stable-balanced" Why: "transfer and compute are near parity with low variance" NumChunks: 24 ChunkSizeUnits: 16 TransferSetup: 8 TransferPerUnit: 2 ComputePerUnit: 2 TransferJitterAmplitude: 1 JitterPeriod: 8 ShockStartChunk: -1 ShockEndChunk: -1 ShockExtraTransferSetup: 0 ShockExtraTransferPerUnit: 0 },
        M25WorkloadRegime { Name: "transfer-bound" Why: "transfer dominates compute so lag handling matters" NumChunks: 24 ChunkSizeUnits: 16 TransferSetup: 12 TransferPerUnit: 4 ComputePerUnit: 1 TransferJitterAmplitude: 1 JitterPeriod: 7 ShockStartChunk: -1 ShockEndChunk: -1 ShockExtraTransferSetup: 0 ShockExtraTransferPerUnit: 0 },
        M25WorkloadRegime { Name: "compute-bound" Why: "compute dominates transfer so extra buffering tends to become inventory" NumChunks: 24 ChunkSizeUnits: 16 TransferSetup: 5 TransferPerUnit: 1 ComputePerUnit: 4 TransferJitterAmplitude: 1 JitterPeriod: 9 ShockStartChunk: -1 ShockEndChunk: -1 ShockExtraTransferSetup: 0 ShockExtraTransferPerUnit: 0 },
        M25WorkloadRegime { Name: "jittery-transfer" Why: "high transfer jitter pressures lead-time estimation" NumChunks: 24 ChunkSizeUnits: 16 TransferSetup: 8 TransferPerUnit: 2 ComputePerUnit: 2 TransferJitterAmplitude: 6 JitterPeriod: 3 ShockStartChunk: -1 ShockEndChunk: -1 ShockExtraTransferSetup: 0 ShockExtraTransferPerUnit: 0 },
        M25WorkloadRegime { Name: "burst-shock" Why: "short abrupt transfer shock tests lag compensation resilience" NumChunks: 24 ChunkSizeUnits: 16 TransferSetup: 8 TransferPerUnit: 2 ComputePerUnit: 2 TransferJitterAmplitude: 2 JitterPeriod: 6 ShockStartChunk: 11 ShockEndChunk: 15 ShockExtraTransferSetup: 12 ShockExtraTransferPerUnit: 2 },
        M25WorkloadRegime { Name: "calm-then-burst" Why: "controller may over-trust calm phase and shrink too far before burst" NumChunks: 24 ChunkSizeUnits: 16 TransferSetup: 8 TransferPerUnit: 2 ComputePerUnit: 2 TransferJitterAmplitude: 1 JitterPeriod: 10 ShockStartChunk: 15 ShockEndChunk: 20 ShockExtraTransferSetup: 14 ShockExtraTransferPerUnit: 3 }
    ]
}

fn M25Strategies() -> M25StrategyConfig[] {
    return [
        M25StrategyConfig { Name: "A-serial-jit" Kind: "serial" PushLookahead: 0 FixedWipTarget: 1 BaseWipCap: 1 BaseSafetyMargin: 0 },
        M25StrategyConfig { Name: "B-fixed-double" Kind: "fixed" PushLookahead: 0 FixedWipTarget: 2 BaseWipCap: 2 BaseSafetyMargin: 1 },
        M25StrategyConfig { Name: "C-fixed-triple" Kind: "fixed" PushLookahead: 0 FixedWipTarget: 3 BaseWipCap: 3 BaseSafetyMargin: 1 },
        M25StrategyConfig { Name: "D-push-lookahead" Kind: "push" PushLookahead: 3 FixedWipTarget: 0 BaseWipCap: 3 BaseSafetyMargin: 0 },
        M25StrategyConfig { Name: "E-pull-lag-comp" Kind: "pull" PushLookahead: 0 FixedWipTarget: 0 BaseWipCap: 2 BaseSafetyMargin: 2 },
        M25StrategyConfig { Name: "F-adaptive-kanban" Kind: "adaptive" PushLookahead: 0 FixedWipTarget: 0 BaseWipCap: 2 BaseSafetyMargin: 2 }
    ]
}

fn M25TransferSignalFor(regime: M25WorkloadRegime, chunk: Int) -> M25TransferSignal {
    let sign = switch {
        case regime.JitterPeriod > 0 and ((chunk / regime.JitterPeriod) * regime.JitterPeriod) == chunk => 1
        case regime.JitterPeriod > 0 and (((chunk + regime.JitterPeriod / 2) / regime.JitterPeriod) * regime.JitterPeriod) == (chunk + regime.JitterPeriod / 2) => -1
        else => 0
    }
    let jitter = sign * regime.TransferJitterAmplitude
    let inShock = regime.ShockStartChunk >= 0 and chunk >= regime.ShockStartChunk and chunk <= regime.ShockEndChunk

    return M25TransferSignal {
        Setup: regime.TransferSetup + jitter + switch { case inShock => regime.ShockExtraTransferSetup else => 0 }
        PerUnit: regime.TransferPerUnit + switch { case inShock => regime.ShockExtraTransferPerUnit else => 0 }
    }
}

fn M25TransferDuration(regime: M25WorkloadRegime, chunk: Int) -> Int {
    let signal = M25TransferSignalFor(regime, chunk)
    let value = signal.Setup + (signal.PerUnit * regime.ChunkSizeUnits)
    return M25Max(value, 1)
}

fn M25ComputeDuration(regime: M25WorkloadRegime, _chunk: Int) -> Int {
    return M25Max(regime.ComputePerUnit * regime.ChunkSizeUnits, 1)
}

flow M25AdaptiveKanbanPolicy(starvationWindow: Int, readyIdleWindow: Int, jitterWindow: Int, currentCap: Int, currentMargin: Int) -> M25AdaptiveDecision {
    state Evaluate {
        let modeCode = when policy {
            hysteresis: 2
            min_commit: 2
        } {
            case 3 when starvationWindow >= 6 score 120
            case 2 when jitterWindow >= 7 score 95
            case 1 when readyIdleWindow >= 8 and starvationWindow <= 2 score 80
            else 0
        }

        return switch {
            case modeCode == 3 => M25AdaptiveDecision { Cap: 3 Margin: M25Min(currentMargin + 2, 8) Mode: "recover-starvation" }
            case modeCode == 2 => M25AdaptiveDecision { Cap: M25Min(M25Max(currentCap, 2) + 1, 3) Margin: M25Min(currentMargin + 1, 8) Mode: "jitter-guard" }
            case modeCode == 1 => M25AdaptiveDecision { Cap: M25Max(currentCap - 1, 1) Margin: M25Max(currentMargin - 1, 0) Mode: "trim-inventory" }
            else => M25AdaptiveDecision { Cap: currentCap Margin: currentMargin Mode: "hold" }
        }
    }
}

fn M25AdaptiveKanbanDecision(starvationWindow: Int, readyIdleWindow: Int, jitterWindow: Int, currentCap: Int, currentMargin: Int) -> M25AdaptiveDecision {
    let machine = M25AdaptiveKanbanPolicy(starvationWindow, readyIdleWindow, jitterWindow, currentCap, currentMargin)
    Step(machine)
    match Result(machine) {
        ok(next) => { return next }
        err(_e) => { return M25AdaptiveDecision { Cap: currentCap Margin: currentMargin Mode: "hold" } }
    }
}

fn M25DemandPrediction(now: Int, demandChunk: Int, nextToStage: Int, computeRemaining: Int, estCompute: Int) -> Int {
    let chunksAhead = M25Max(nextToStage - demandChunk, 0)
    return now + computeRemaining + (M25Max(chunksAhead - 1, 0) * estCompute)
}

fn M25ShouldStage(
    strategy: M25StrategyConfig,
    now: Int,
    demandChunk: Int,
    nextToStage: Int,
    wipDepth: Int,
    computeRemaining: Int,
    estTransfer: Int,
    estCompute: Int,
    cap: Int,
    margin: Int
) -> Bool {
    if nextToStage < demandChunk { return true }
    let demandTime = M25DemandPrediction(now, demandChunk, nextToStage, computeRemaining, estCompute)

    return switch {
        case strategy.Kind == "serial" => nextToStage == demandChunk and computeRemaining == 0 and wipDepth == 0
        case strategy.Kind == "fixed" => (nextToStage - demandChunk) < strategy.FixedWipTarget
        case strategy.Kind == "push" => (nextToStage - demandChunk) <= strategy.PushLookahead
        case strategy.Kind == "pull" => now >= demandTime - estTransfer - margin and wipDepth < cap
        else => now >= demandTime - estTransfer - margin and wipDepth < cap
    }
}

fn M25Simulate(strategy: M25StrategyConfig, regime: M25WorkloadRegime) -> M25SimulationResult {
    let n = regime.NumChunks
    var time = 0

    var transferChunk = -1
    var transferRemaining = 0
    var transferStart = 0

    var computeChunk = -1
    var computeRemaining = 0

    var nextToStage = 0
    var demandChunk = 0
    var completed = 0

    var ready = [false]
    var readySince = [0]
    var chunkStarveCounted = [false]
    for i in 1 .. n {
        ready = Append(ready, false)
        readySince = Append(readySince, 0)
        chunkStarveCounted = Append(chunkStarveCounted, false)
    }

    var estTransfer = M25TransferDuration(regime, 0)
    var estCompute = M25ComputeDuration(regime, 0)

    var wipCap = strategy.BaseWipCap
    var margin = strategy.BaseSafetyMargin
    var mode = "hold"

    var starvation = 0
    var transferIdle = 0
    var readyIdle = 0
    var totalWipTime = 0
    var peakWip = 0
    var stageTooEarly = 0
    var stageTooLate = 0
    var capChanges = 0
    var modeTransitions = 0
    var safetyMarginUsed = 0

    var starvationWindow = 0
    var readyIdleWindow = 0
    var jitterWindow = 0

    while completed < n {
        if computeChunk >= 0 {
            computeRemaining = computeRemaining - 1
            if computeRemaining <= 0 {
                completed = completed + 1
                demandChunk = completed
                computeChunk = -1
                estCompute = (estCompute * 7 + M25ComputeDuration(regime, completed - 1)) / 8
            }
        }

        if transferChunk >= 0 {
            transferRemaining = transferRemaining - 1
            if transferRemaining <= 0 {
                ready[transferChunk] = true
                readySince[transferChunk] = time
                let observed = time - transferStart
                estTransfer = (estTransfer * 7 + observed) / 8
                let jitterAbs = M25Max(observed - estTransfer, estTransfer - observed)
                jitterWindow = (jitterWindow * 3 + jitterAbs) / 4
                transferChunk = -1
            }
        }

        if computeChunk < 0 and demandChunk < n {
            let hadReady = ready[demandChunk]
            if hadReady {
                let idleSpan = time - readySince[demandChunk]
                if idleSpan > 0 {
                    readyIdle = readyIdle + idleSpan
                    readyIdleWindow = (readyIdleWindow * 3 + idleSpan) / 4
                    stageTooEarly = stageTooEarly + 1
                }
                if idleSpan <= 0 { readyIdleWindow = (readyIdleWindow * 3) / 4 }
                ready[demandChunk] = false
                computeChunk = demandChunk
                computeRemaining = M25ComputeDuration(regime, demandChunk)
            }
            if not hadReady {
                starvation = starvation + 1
                starvationWindow = M25Min(starvationWindow + 1, 32)
                if not chunkStarveCounted[demandChunk] {
                    stageTooLate = stageTooLate + 1
                    chunkStarveCounted[demandChunk] = true
                }
            }
        }
        if not (computeChunk < 0 and demandChunk < n) { starvationWindow = (starvationWindow * 3) / 4 }

        var inTransfer = 0
        if transferChunk >= 0 { inTransfer = 1 }
        var readyDepth = 0
        var probe = demandChunk
        while probe < nextToStage {
            if ready[probe] { readyDepth = readyDepth + 1 }
            probe = probe + 1
        }
        let wipDepth = inTransfer + readyDepth
        totalWipTime = totalWipTime + wipDepth
        peakWip = M25Max(peakWip, wipDepth)

        if strategy.Kind == "adaptive" {
            let decision = M25AdaptiveKanbanDecision(starvationWindow, readyIdleWindow, jitterWindow, wipCap, margin)
            if decision.Cap != wipCap { capChanges = capChanges + 1 }
            if decision.Mode != mode { modeTransitions = modeTransitions + 1 }
            wipCap = decision.Cap
            margin = decision.Margin
            mode = decision.Mode
        }

        if transferChunk < 0 and nextToStage < n {
            let shouldStage = M25ShouldStage(strategy, time, demandChunk, nextToStage, wipDepth, computeRemaining, estTransfer, estCompute, wipCap, margin)
            if shouldStage {
                transferChunk = nextToStage
                transferStart = time
                transferRemaining = M25TransferDuration(regime, nextToStage)
                nextToStage = nextToStage + 1
                safetyMarginUsed = safetyMarginUsed + margin
            }
            if not shouldStage { transferIdle = transferIdle + 1 }
        }
        if transferChunk < 0 and nextToStage >= n { transferIdle = transferIdle + 1 }

        time = time + 1
    }

    let avgWipMilli = switch {
        case time > 0 => (totalWipTime * 1000) / time
        else => 0
    }
    let memoryPressure = peakWip * regime.ChunkSizeUnits
    let flowEfficiency = switch {
        case time > 0 => ((time - starvation) * 1000) / time
        else => 0
    }
    let wipWasteScore = readyIdle + (peakWip * 8) + (stageTooEarly * 5)
    let starvationPenalty = starvation * 4 + stageTooLate * 25
    let memoryPenalty = memoryPressure * 2
    let productScore = (flowEfficiency / 10) - (wipWasteScore / 8) - (starvationPenalty / 10) - (memoryPenalty / 6)

    return M25SimulationResult {
        Regime: regime.Name
        Strategy: strategy.Name
        TotalCompletionTime: time
        ComputeStarvationTime: starvation
        TransferIdleTime: transferIdle
        ReadyButUnusedTime: readyIdle
        TotalWipTime: totalWipTime
        PeakWipDepth: peakWip
        AverageWipDepthMilli: avgWipMilli
        MemoryPressureProxy: memoryPressure
        StageTooEarlyCount: stageTooEarly
        StageTooLateCount: stageTooLate
        SafetyMarginUsed: safetyMarginUsed
        WipCapChanges: capChanges
        ModeTransitions: modeTransitions
        FlowEfficiencyScore: flowEfficiency
        WipWasteScore: wipWasteScore
        StarvationPenaltyScore: starvationPenalty
        MemoryPressurePenalty: memoryPenalty
        ProductScore: productScore
    }
}

fn M25RunAll() -> M25SimulationResult[] {
    let strategies = M25Strategies()
    let regimes = M25Regimes()

    var out = [M25Simulate(strategies[0], regimes[0])]

    var r = 0
    while r < Len(regimes) {
        var s = 0
        while s < Len(strategies) {
            if not (r == 0 and s == 0) {
                out = Append(out, M25Simulate(strategies[s], regimes[r]))
            }
            s = s + 1
        }
        r = r + 1
    }

    return out
}

fn M25StrategyComparisonTableFrom(rows: M25SimulationResult[]) -> M25StrategyComparisonTable {
    var regime = [rows[0].Regime]
    var strategy = [rows[0].Strategy]
    var total = [rows[0].TotalCompletionTime]
    var starve = [rows[0].ComputeStarvationTime]
    var readyIdle = [rows[0].ReadyButUnusedTime]
    var peak = [rows[0].PeakWipDepth]
    var score = [rows[0].ProductScore]

    for i in 1 .. Len(rows) {
        regime = Append(regime, rows[i].Regime)
        strategy = Append(strategy, rows[i].Strategy)
        total = Append(total, rows[i].TotalCompletionTime)
        starve = Append(starve, rows[i].ComputeStarvationTime)
        readyIdle = Append(readyIdle, rows[i].ReadyButUnusedTime)
        peak = Append(peak, rows[i].PeakWipDepth)
        score = Append(score, rows[i].ProductScore)
    }

    return M25StrategyComparisonTable {
        Regime: regime
        Strategy: strategy
        TotalCompletionTime: total
        ComputeStarvationTime: starve
        ReadyButUnusedTime: readyIdle
        PeakWipDepth: peak
        ProductScore: score
    }
}

fn M25WipInventoryTableFrom(rows: M25SimulationResult[]) -> M25WipInventoryTable {
    var regime = [rows[0].Regime]
    var strategy = [rows[0].Strategy]
    var totalWip = [rows[0].TotalWipTime]
    var avgWip = [rows[0].AverageWipDepthMilli]
    var peak = [rows[0].PeakWipDepth]
    var memory = [rows[0].MemoryPressureProxy]
    var early = [rows[0].StageTooEarlyCount]

    for i in 1 .. Len(rows) {
        regime = Append(regime, rows[i].Regime)
        strategy = Append(strategy, rows[i].Strategy)
        totalWip = Append(totalWip, rows[i].TotalWipTime)
        avgWip = Append(avgWip, rows[i].AverageWipDepthMilli)
        peak = Append(peak, rows[i].PeakWipDepth)
        memory = Append(memory, rows[i].MemoryPressureProxy)
        early = Append(early, rows[i].StageTooEarlyCount)
    }

    return M25WipInventoryTable {
        Regime: regime
        Strategy: strategy
        TotalWipTime: totalWip
        AverageWipDepthMilli: avgWip
        PeakWipDepth: peak
        MemoryPressureProxy: memory
        StageTooEarlyCount: early
    }
}

fn M25StarvationTableFrom(rows: M25SimulationResult[]) -> M25StarvationTable {
    var regime = [rows[0].Regime]
    var strategy = [rows[0].Strategy]
    var starvation = [rows[0].ComputeStarvationTime]
    var late = [rows[0].StageTooLateCount]
    var idle = [rows[0].TransferIdleTime]
    var penalty = [rows[0].StarvationPenaltyScore]

    for i in 1 .. Len(rows) {
        regime = Append(regime, rows[i].Regime)
        strategy = Append(strategy, rows[i].Strategy)
        starvation = Append(starvation, rows[i].ComputeStarvationTime)
        late = Append(late, rows[i].StageTooLateCount)
        idle = Append(idle, rows[i].TransferIdleTime)
        penalty = Append(penalty, rows[i].StarvationPenaltyScore)
    }

    return M25StarvationTable {
        Regime: regime
        Strategy: strategy
        ComputeStarvationTime: starvation
        StageTooLateCount: late
        TransferIdleTime: idle
        StarvationPenaltyScore: penalty
    }
}

fn M25JitterStressRows(rows: M25SimulationResult[]) -> M25SimulationResult[] {
    var out = [rows[0]]
    var i = 0
    var seeded = false
    while i < Len(rows) {
        let regime = rows[i].Regime
        if regime == "jittery-transfer" or regime == "burst-shock" or regime == "calm-then-burst" {
            let wasSeeded = seeded
            if not seeded {
                out = [rows[i]]
                seeded = true
            }
            if wasSeeded { out = Append(out, rows[i]) }
        }
        i = i + 1
    }
    return out
}

fn M25JitterStressTableFrom(rows: M25SimulationResult[]) -> M25JitterStressTable {
    let stressRows = M25JitterStressRows(rows)

    var regime = [stressRows[0].Regime]
    var strategy = [stressRows[0].Strategy]
    var starvation = [stressRows[0].ComputeStarvationTime]
    var readyIdle = [stressRows[0].ReadyButUnusedTime]
    var margin = [stressRows[0].SafetyMarginUsed]
    var score = [stressRows[0].ProductScore]

    for i in 1 .. Len(stressRows) {
        regime = Append(regime, stressRows[i].Regime)
        strategy = Append(strategy, stressRows[i].Strategy)
        starvation = Append(starvation, stressRows[i].ComputeStarvationTime)
        readyIdle = Append(readyIdle, stressRows[i].ReadyButUnusedTime)
        margin = Append(margin, stressRows[i].SafetyMarginUsed)
        score = Append(score, stressRows[i].ProductScore)
    }

    return M25JitterStressTable {
        Regime: regime
        Strategy: strategy
        ComputeStarvationTime: starvation
        ReadyButUnusedTime: readyIdle
        SafetyMarginUsed: margin
        ProductScore: score
    }
}

fn M25ScoreFor(rows: M25SimulationResult[], regime: String, strategy: String) -> Int {
    var i = 0
    while i < Len(rows) {
        if rows[i].Regime == regime and rows[i].Strategy == strategy { return rows[i].ProductScore }
        i = i + 1
    }
    return -999999
}

fn M25MetricFor(rows: M25SimulationResult[], regime: String, strategy: String, field: String) -> Int {
    var i = 0
    while i < Len(rows) {
        if rows[i].Regime == regime and rows[i].Strategy == strategy {
            return switch {
                case field == "cap_changes" => rows[i].WipCapChanges
                case field == "mode_transitions" => rows[i].ModeTransitions
                case field == "starvation" => rows[i].ComputeStarvationTime
                case field == "ready_idle" => rows[i].ReadyButUnusedTime
                else => 0
            }
        }
        i = i + 1
    }
    return 0
}

fn M25AdaptiveKanbanTableFrom(rows: M25SimulationResult[]) -> M25AdaptiveKanbanTable {
    let regimes = M25Regimes()

    var regime = [regimes[0].Name]
    var adaptiveScore = [M25ScoreFor(rows, regimes[0].Name, "F-adaptive-kanban")]
    var pullScore = [M25ScoreFor(rows, regimes[0].Name, "E-pull-lag-comp")]
    var doubleScore = [M25ScoreFor(rows, regimes[0].Name, "B-fixed-double")]
    var cap = [M25MetricFor(rows, regimes[0].Name, "F-adaptive-kanban", "cap_changes")]
    var transitions = [M25MetricFor(rows, regimes[0].Name, "F-adaptive-kanban", "mode_transitions")]
    var starve = [M25MetricFor(rows, regimes[0].Name, "F-adaptive-kanban", "starvation")]
    var readyIdle = [M25MetricFor(rows, regimes[0].Name, "F-adaptive-kanban", "ready_idle")]

    for i in 1 .. Len(regimes) {
        regime = Append(regime, regimes[i].Name)
        adaptiveScore = Append(adaptiveScore, M25ScoreFor(rows, regimes[i].Name, "F-adaptive-kanban"))
        pullScore = Append(pullScore, M25ScoreFor(rows, regimes[i].Name, "E-pull-lag-comp"))
        doubleScore = Append(doubleScore, M25ScoreFor(rows, regimes[i].Name, "B-fixed-double"))
        cap = Append(cap, M25MetricFor(rows, regimes[i].Name, "F-adaptive-kanban", "cap_changes"))
        transitions = Append(transitions, M25MetricFor(rows, regimes[i].Name, "F-adaptive-kanban", "mode_transitions"))
        starve = Append(starve, M25MetricFor(rows, regimes[i].Name, "F-adaptive-kanban", "starvation"))
        readyIdle = Append(readyIdle, M25MetricFor(rows, regimes[i].Name, "F-adaptive-kanban", "ready_idle"))
    }

    return M25AdaptiveKanbanTable {
        Regime: regime
        AdaptiveProductScore: adaptiveScore
        PullProductScore: pullScore
        FixedDoubleProductScore: doubleScore
        AdaptiveWipCapChanges: cap
        AdaptiveModeTransitions: transitions
        AdaptiveStarvation: starve
        AdaptiveReadyIdle: readyIdle
    }
}

fn M25BestAverageStrategy(rows: M25SimulationResult[]) -> String {
    let names = ["A-serial-jit", "B-fixed-double", "C-fixed-triple", "D-push-lookahead", "E-pull-lag-comp", "F-adaptive-kanban"]
    var bestName = names[0]
    var bestScore = -999999

    var n = 0
    while n < Len(names) {
        var total = 0
        var count = 0
        var i = 0
        while i < Len(rows) {
            if rows[i].Strategy == names[n] {
                total = total + rows[i].ProductScore
                count = count + 1
            }
            i = i + 1
        }
        let avg = switch { case count > 0 => total / count else => -999999 }
        if avg > bestScore {
            bestScore = avg
            bestName = names[n]
        }
        n = n + 1
    }

    return bestName
}

fn M25BestJitterStrategy(rows: M25SimulationResult[]) -> String {
    let names = ["A-serial-jit", "B-fixed-double", "C-fixed-triple", "D-push-lookahead", "E-pull-lag-comp", "F-adaptive-kanban"]
    var bestName = names[0]
    var bestScore = -999999
    var n = 0

    while n < Len(names) {
        let score = M25ScoreFor(rows, "jittery-transfer", names[n]) + M25ScoreFor(rows, "burst-shock", names[n]) + M25ScoreFor(rows, "calm-then-burst", names[n])
        if score > bestScore {
            bestScore = score
            bestName = names[n]
        }
        n = n + 1
    }

    return bestName
}

fn M25FinalRecommendationFrom(rows: M25SimulationResult[]) -> M25FinalRecommendation {
    let bestOverall = M25BestAverageStrategy(rows)
    let bestJitter = M25BestJitterStrategy(rows)

    let adaptiveStable = M25ScoreFor(rows, "stable-balanced", "F-adaptive-kanban") >= M25ScoreFor(rows, "stable-balanced", "E-pull-lag-comp")
    let adaptiveShock = M25ScoreFor(rows, "calm-then-burst", "F-adaptive-kanban") > M25ScoreFor(rows, "calm-then-burst", "E-pull-lag-comp")
    let tripleMemory = M25MetricFor(rows, "compute-bound", "C-fixed-triple", "ready_idle") > M25MetricFor(rows, "compute-bound", "B-fixed-double", "ready_idle")
    let tripleTiming = M25ScoreFor(rows, "transfer-bound", "C-fixed-triple") > M25ScoreFor(rows, "transfer-bound", "B-fixed-double")

    return M25FinalRecommendation {
        BestOverallStrategy: bestOverall
        BestUnderJitter: bestJitter
        AdaptiveKanbanWorthIt: switch { case adaptiveStable and adaptiveShock => "yes-for-shock-heavy-regimes" else => "only-if-jitter-recovery-is-product-critical" }
        TripleBufferJustified: switch { case tripleTiming and not tripleMemory => "yes-in-specific-transfer-bound-windows" else => "no-default-double-buffer-preferred" }
        CarryForward: "Carry forward pull-based lag compensation as default controller shape with adaptive kanban escape hatch and explicit memory-pressure metric gating."
        RejectOrDefer: "Reject serial JIT and naive push lookahead as defaults; defer triple buffering to guarded temporary mode only under sustained transfer shock."
    }
}
