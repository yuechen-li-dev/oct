fn M37RiskHandoffFrom() -> M37RiskHandoff {
    return M37RiskHandoff {
        RiskArea: [
            "typed-arena-growth-shrink-policy",
            "capacity-reuse-correctness",
            "per-artifact-invalidation-interaction",
            "layout-precision-churn-isolation",
            "fixed-double-and-n-slot-ownership",
            "failure-recovery-under-budget-pressure",
            "memory-budget-accounting"
        ]
        WhyItMattersForP11M2M38: [
            "unbounded growth removes reuse gains and breaks budget planning",
            "undersized reuse can silently corrupt writes",
            "P10 dirty-key wins are lost if ownership invalidation disagrees",
            "mode flips are frequent and can cause false invalidations",
            "handoff model must stay valid as slot count grows",
            "allocator failures must preserve reactor liveness and diagnostics",
            "Dominatus decisions need deterministic memory availability facts"
        ]
        RequiredRake: [
            "growth-threshold and optional shrink hysteresis matrix",
            "capacity-class key proof with byte-accurate assertions",
            "A/B/C invalidation truth table bound to dirty masks",
            "layout/precision namespace and cross-mode transition tests",
            "slot-owner lifecycle table for 2,4,8 slots",
            "inject OOM/fragmentation faults and verify fallback contracts",
            "per-role committed/available ledger with budget gates"
        ]
        ExitEvidence: [
            "peak and average memory stabilize after warm-up",
            "zero missed invalidation in modeled churn scenarios",
            "false invalidation count lower than status quo in all churn workloads",
            "mode transition workload shows bounded reallocations",
            "no ownership leaks in slot lifecycle transitions",
            "recovery path keeps scheduler progress and reports reason",
            "budget decisions reproducible from artifact logs"
        ]
        Priority: ["P0","P0","P0","P1","P1","P0","P0"]
    }
}

fn M37FinalRecommendationFrom() -> M37FinalRecommendation {
    return M37FinalRecommendation {
        Decision: [
            "Implement typed arena pools per buffer role first (candidate C) as P11 M2 / PrometheusSgemmAlgorithmLab M38"
        ]
        Assumptions: [
            "Dominatus remains source of dirty-key truth, per-artifact invalidation from P10 stays authoritative, and near-term product path is fixed-double with planned N-slot growth"
        ]
        DeferNow: [
            "Defer generic VMA-like suballocator as first product step unless typed arenas fail correctness or budget targets"
        ]
        ShapeClassSlabFollowUp: [
            "Worth a focused follow-up only after typed arenas land and real workload corpus confirms stable shape clusters"
        ]
        SparseBindingFollowUp: [
            "Keep sparse virtual buffers as research branch only; not near-term product path due to feature/synchronization risk"
        ]
        P11M2M38Scope: [
            "build typed arenas for A/B/C/staging(+readback optional), enforce capacity-class ownership keys, add budget ledger, and run growth/failure rakes"
        ]
        DoNotImplementYet: [
            "Do not implement sparse binding, full generic allocator framework, or N-slot/work-stealing runtime changes in M38"
        ]
    }
}
