package PrometheusSgemmAlgorithmLab

record M37StrategyComparison {
    Strategy: String[]
    PeakCommittedMiB: Int[]
    AverageCommittedMiB: Int[]
    InternalSlackMiB: Int[]
    AllocationCount: Int[]
    ReallocationCount: Int[]
    InvalidationCount: Int[]
    ReuseCount: Int[]
    FalseInvalidationAvoided: Int[]
    MissedInvalidationRisk: String[]
    FragmentationRisk: String[]
    VulkanFeatureRequirementRisk: String[]
    SynchronizationRisk: String[]
    ImplementationComplexityScore: Int[]
    NSlotReadinessScore: Int[]
    DominatusDirtyKeyFitScore: Int[]
    Recommendation: String[]
}

record M37WorkloadMatrix {
    Scenario: String[]
    Strategy: String[]
    PeakCommittedMiB: Int[]
    ReallocationCount: Int[]
    ReuseCount: Int[]
    InternalSlackMiB: Int[]
    PressureOutcome: String[]
    Notes: String[]
}

record M37RiskHandoff {
    RiskArea: String[]
    WhyItMattersForP11M2M38: String[]
    RequiredRake: String[]
    ExitEvidence: String[]
    Priority: String[]
}

record M37FinalRecommendation {
    Decision: String[]
    Assumptions: String[]
    DeferNow: String[]
    ShapeClassSlabFollowUp: String[]
    SparseBindingFollowUp: String[]
    P11M2M38Scope: String[]
    DoNotImplementYet: String[]
}

