package PrometheusSgemmAlgorithmLab

[Fact]
fn M38ReuseConditionAllowsCompatibleCapacitySufficientReuse() -> Void {
    let m = M38RunScenario("A", "steady-same-shape", 2, 8192).Metrics
    Assert.True(m.ReuseCount > 0, "steady shape must reuse when compatibility and capacity are satisfied")
}

[Fact]
fn M38CapacityGrowOccursWhenRequiredExceedsCapacityAndBudgetAllows() -> Void {
    let m = M38RunScenario("A", "m-only-churn", 2, 8192).Metrics
    Assert.True(m.GrowCount > 0, "policy A must grow under churn when budget allows")
}

[Fact]
fn M38BudgetRejectionIsExplicitUnderTightBudget() -> Void {
    let m = M38RunScenario("D", "budget-pressure-failure", 2, 16).Metrics
    Assert.True(m.BudgetRejectionCount > 0 and m.FailureCount > 0, "budget pressure must emit explicit rejections/failures")
}

[Fact]
fn M38LayoutAndPrecisionNamespaceMismatchCannotUnsafeReuse() -> Void {
    let layout = M38RunScenario("A", "layout-churn", 2, 8192).Metrics
    let precision = M38RunScenario("A", "precision-churn", 2, 8192).Metrics
    Assert.True(layout.LayoutPrecisionMismatchRejectionCount > 0, "layout mismatch must reject unsafe reuse")
    Assert.True(precision.LayoutPrecisionMismatchRejectionCount > 0, "precision mismatch must reject unsafe reuse")
}

[Fact]
fn M38ExactFitRebuildThrashesComparedToGrowPolicies() -> Void {
    let a = M38RunScenario("A", "m-only-churn", 2, 8192).Metrics
    let b = M38RunScenario("B", "m-only-churn", 2, 8192).Metrics
    let c = M38RunScenario("C", "m-only-churn", 2, 8192).Metrics
    Assert.True(c.RebuildCount > a.RebuildCount and c.RebuildCount > b.RebuildCount, "exact-fit must rebuild more under churn")
}

[Fact]
fn M38HysteresisShrinkAvoidsPingPongComparedToExactFit() -> Void {
    let b = M38RunScenario("B", "capacity-growth-then-shrink", 2, 8192).Metrics
    let c = M38RunScenario("C", "capacity-growth-then-shrink", 2, 8192).Metrics
    Assert.True(b.ShrinkCount < c.RebuildCount, "hysteresis should avoid exact-fit ping-pong")
}

[Fact]
fn M38DependencyContractForMnkChurnMatchesA_B_COwnership() -> Void {
    let rake = M38ArtifactDependencyRakeFrom()
    Assert.True(rake.AInvalidations[1] > 0 and rake.BInvalidations[1] == 0 and rake.CInvalidations[1] > 0, "m-only churn should invalidate A and C, not B")
    Assert.True(rake.AInvalidations[5] == 0 and rake.BInvalidations[5] > 0 and rake.CInvalidations[5] > 0, "n-only churn should invalidate B and C, not A")
    Assert.True(rake.AInvalidations[9] > 0 and rake.BInvalidations[9] > 0 and rake.CInvalidations[9] == 0, "k-only churn should invalidate A and B, not C")
}

[Fact]
fn M38FixedDoubleOwnershipBlocksInflightOverwrite() -> Void {
    let m = M38RunScenario("A", "fixed-double-two-slot", 2, 8192).Metrics
    Assert.True(m.OwnershipRejectionCount > 0, "in-flight slot ownership must reject overwrite")
}

[Fact]
fn M38RecommendationIsDerivedFromComputedScores() -> Void {
    let recommended = M38RecommendationFromSimulation()
    Assert.True(recommended == "typed-arenas-grow-with-conservative-hysteresis-shrink", "recommendation must be computed from model score, not static literal table")
}

[Artifact]
fn EmitM38ArenaPolicyComparison() -> Void {
    let _status = WriteOctagon("Experiments/PrometheusSgemmAlgorithmLab/M38/m38_arena_policy_comparison.octagon", [M38ArenaPolicyComparisonFrom()])
}

