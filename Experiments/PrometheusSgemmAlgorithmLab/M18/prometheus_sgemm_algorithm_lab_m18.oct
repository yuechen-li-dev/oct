package PrometheusSgemmAlgorithmLab

record M18Context {
    Name: String
    M: Int
    N: Int
    KDim: Int
    ControllerMode: String
    StrictFP32Correctness: Bool
    AllowFP16StorageQuantization: Bool
    FP16StorageCapability: Bool
    Packed4Capability: Bool
    FallbackAvailable: Bool
    ToleranceProvided: Bool
    ToleranceMaxAbsMilli: Int
    ToleranceMaxRelPPM: Int
    HasSpecialValues: Bool
    CancellationRisk: Int
}

record M18Packed4Result {
    CaseName: String
    M: Int
    N: Int
    KDim: Int
    MTail: Int
    NTail: Int
    KTail: Int
    TailCount: Int
    PaddedLaneCount: Int
    PaddingWastePct: Int
    PackedEligible: Bool
    ModeBudgetPass: Bool
    IndexingRiskClass: String
    RowMajorCanonicalOutputCheck: Bool
    SelectedOrFallback: String
    FallbackReason: String
}

record M18FP16Result {
    CaseName: String
    M: Int
    N: Int
    KDim: Int
    MaxAbsoluteErrorMilli: Int
    MaxRelativeErrorPPM: Int
    AggregateErrorMilli: Int
    KSensitiveErrorGrowthMilli: Int
    TolerancePass: Bool
    CapabilityGatePass: Bool
    SpecialValueRejected: Bool
    SelectedOrFallback: String
    FallbackReason: String
}

record M18DecisionRow {
    CaseName: String
    SelectedCandidate: String
    RejectedCandidates: String
    HardGateReasons: String
    FallbackChain: String
    ObservabilityReasonCodes: String
}

record M18Recommendation {
    Packed4FP32Status: String
    FP16StorageFP32AccumStatus: String
    MandatoryHardGates: String
    MandatoryDiagnostics: String
    M19Plan: String
}

record M18Packed4Table {
    CaseName: String[]
    M: Int[]
    N: Int[]
    KDim: Int[]
    MTail: Int[]
    NTail: Int[]
    KTail: Int[]
    TailCount: Int[]
    PaddedLaneCount: Int[]
    PaddingWastePct: Int[]
    PackedEligible: Bool[]
    ModeBudgetPass: Bool[]
    IndexingRiskClass: String[]
    RowMajorCanonicalOutputCheck: Bool[]
    SelectedOrFallback: String[]
    FallbackReason: String[]
}

record M18FP16Table {
    CaseName: String[]
    M: Int[]
    N: Int[]
    KDim: Int[]
    MaxAbsoluteErrorMilli: Int[]
    MaxRelativeErrorPPM: Int[]
    AggregateErrorMilli: Int[]
    KSensitiveErrorGrowthMilli: Int[]
    TolerancePass: Bool[]
    CapabilityGatePass: Bool[]
    SpecialValueRejected: Bool[]
    SelectedOrFallback: String[]
    FallbackReason: String[]
}

record M18DecisionTable {
    CaseName: String[]
    SelectedCandidate: String[]
    RejectedCandidates: String[]
    HardGateReasons: String[]
    FallbackChain: String[]
    ObservabilityReasonCodes: String[]
}

fn M18CeilDiv(numerator: Int, denominator: Int) -> Int {
    if denominator <= 0 { return 0 }
    return (numerator + denominator - 1) / denominator
}

fn M18MaxInt(a: Int, b: Int) -> Int { return switch { case a > b => a else => b } }
fn M18MinInt(a: Int, b: Int) -> Int { return switch { case a < b => a else => b } }

fn M18PadWaste(length: Int) -> Int {
    let padded = M18CeilDiv(length, 4) * 4
    return padded - length
}

fn M18Tail(length: Int) -> Int {
    let tail = length % 4
    return switch {
        case tail < 0 => tail + 4
        else => tail
    }
}

fn M18ControllerPackedWasteBudget(mode: String) -> Int {
    return switch {
        case mode == "AGGRESSIVE" => 36
        case mode == "SAFE" => 20
        case mode == "RECOVERY" => 12
        else => 20
    }
}

fn M18TailCount(m: Int, n: Int, k: Int) -> Int {
    var count = 0
    if M18Tail(m) != 0 { count = count + 1 }
    if M18Tail(n) != 0 { count = count + 1 }
    if M18Tail(k) != 0 { count = count + 1 }
    return count
}

fn M18PaddingWastePct(m: Int, n: Int, k: Int) -> Int {
    let total = m + n + k
    if total <= 0 { return 0 }
    let waste = M18PadWaste(m) + M18PadWaste(n) + M18PadWaste(k)
    return (waste * 100) / total
}

fn M18IndexingRiskClass(m: Int, n: Int, k: Int) -> String {
    let tailCount = M18TailCount(m, n, k)
    let rectangularDelta = Abs(m - n)
    return switch {
        case tailCount >= 2 and rectangularDelta > 64 => "high"
        case tailCount >= 2 => "elevated"
        case tailCount == 1 => "medium"
        else => "low"
    }
}

fn M18Packed4Eligible(context: M18Context) -> Bool {
    let area = context.M * context.N
    let tinyShape = area < 192
    let waste = M18PadWaste(context.M) + M18PadWaste(context.N) + M18PadWaste(context.KDim)
    let budget = M18ControllerPackedWasteBudget(context.ControllerMode)
    return context.Packed4Capability and context.FallbackAvailable and (not tinyShape) and waste <= budget
}

fn M18Packed4ResultForContext(context: M18Context) -> M18Packed4Result {
    let paddedLanes = M18PadWaste(context.M) + M18PadWaste(context.N) + M18PadWaste(context.KDim)
    let budgetPass = paddedLanes <= M18ControllerPackedWasteBudget(context.ControllerMode)
    let eligible = M18Packed4Eligible(context)
    let fallbackReason = switch {
        case not context.Packed4Capability => "missing packed4 capability"
        case not context.FallbackAvailable => "fallback unavailable"
        case (context.M * context.N) < 192 => "small shape"
        case not budgetPass => "padding waste too high for mode"
        else => "none"
    }
    let selected = switch {
        case eligible => "Packed4FP32"
        else => "ScalarFP32"
    }
    return M18Packed4Result {
        CaseName: context.Name
        M: context.M
        N: context.N
        KDim: context.KDim
        MTail: M18Tail(context.M)
        NTail: M18Tail(context.N)
        KTail: M18Tail(context.KDim)
        TailCount: M18TailCount(context.M, context.N, context.KDim)
        PaddedLaneCount: paddedLanes
        PaddingWastePct: M18PaddingWastePct(context.M, context.N, context.KDim)
        PackedEligible: eligible
        ModeBudgetPass: budgetPass
        IndexingRiskClass: M18IndexingRiskClass(context.M, context.N, context.KDim)
        RowMajorCanonicalOutputCheck: true
        SelectedOrFallback: selected
        FallbackReason: fallbackReason
    }
}

fn M18BaseErrorMilli(context: M18Context) -> Int {
    let scale = M18MinInt((context.KDim / 8), 80)
    let shapeWeight = (context.M + context.N) / 32
    let cancellationWeight = context.CancellationRisk * 9
    return scale + shapeWeight + cancellationWeight
}

fn M18FP16ErrorMetrics(context: M18Context) -> M18FP16Result {
    let base = M18BaseErrorMilli(context)
    let maxAbs = base + (context.KDim / 16)
    let maxRel = (base * 1400) + (context.CancellationRisk * 400)
    let aggregate = (base * M18MaxInt(context.M * context.N, 1)) / 256
    let kGrowth = (context.KDim * (context.CancellationRisk + 1)) / 8
    let toleranceAbsMilli = context.ToleranceMaxAbsMilli
    let toleranceRelPPM = context.ToleranceMaxRelPPM

    let capabilityPass = context.FP16StorageCapability and context.FallbackAvailable
    let strictGatePass = not context.StrictFP32Correctness
    let toleranceKnown = context.ToleranceProvided
    let tolerancePass = toleranceKnown and (maxAbs <= toleranceAbsMilli) and (maxRel <= toleranceRelPPM)
    let specialRejected = context.HasSpecialValues

    let eligible = capabilityPass and strictGatePass and tolerancePass and (not specialRejected)
    let selected = switch {
        case eligible => "FP16StorageFP32Accum"
        else => "ScalarFP32"
    }
    let reason = switch {
        case context.StrictFP32Correctness => "strict FP32"
        case not context.FP16StorageCapability => "missing FP16 storage capability"
        case not context.FallbackAvailable => "fallback unavailable"
        case not context.ToleranceProvided => "tolerance not provided"
        case context.HasSpecialValues => "special values present"
        case not tolerancePass => "tolerance exceeded"
        else => "none"
    }

    return M18FP16Result {
        CaseName: context.Name
        M: context.M
        N: context.N
        KDim: context.KDim
        MaxAbsoluteErrorMilli: maxAbs
        MaxRelativeErrorPPM: maxRel
        AggregateErrorMilli: aggregate
        KSensitiveErrorGrowthMilli: kGrowth
        TolerancePass: tolerancePass
        CapabilityGatePass: capabilityPass
        SpecialValueRejected: specialRejected
        SelectedOrFallback: selected
        FallbackReason: reason
    }
}

fn M18CrossDecision(context: M18Context) -> M18DecisionRow {
    let packed = M18Packed4ResultForContext(context)
    let fp16 = M18FP16ErrorMetrics(context)
    let selected = switch {
        case context.StrictFP32Correctness and packed.PackedEligible => "Packed4FP32"
        case context.StrictFP32Correctness => "ScalarFP32"
        case packed.PackedEligible => "Packed4FP32"
        case fp16.SelectedOrFallback == "FP16StorageFP32Accum" => "FP16StorageFP32Accum"
        else => "ScalarFP32"
    }

    let packedRejected = switch {
        case packed.PackedEligible => "none"
        else => packed.FallbackReason
    }
    let fp16Rejected = switch {
        case fp16.SelectedOrFallback == "FP16StorageFP32Accum" => "none"
        else => fp16.FallbackReason
    }

    return M18DecisionRow {
        CaseName: context.Name
        SelectedCandidate: selected
        RejectedCandidates: "Packed4FP32=" + packedRejected + "; FP16StorageFP32Accum=" + fp16Rejected
        HardGateReasons: "strict_fp32=" + switch { case context.StrictFP32Correctness => "true" else => "false" } + ", packed_cap=" + switch { case context.Packed4Capability => "true" else => "false" } + ", fp16_cap=" + switch { case context.FP16StorageCapability => "true" else => "false" } + ", tolerance_known=" + switch { case context.ToleranceProvided => "true" else => "false" }
        FallbackChain: "Packed4FP32->ScalarFP32; FP16StorageFP32Accum->ScalarFP32"
        ObservabilityReasonCodes: "PACKED4_PADDING_WASTE,PACKED4_SMALL_SHAPE,FP16_STRICT_FP32,FP16_TOLERANCE_UNKNOWN,FP16_TOLERANCE_EXCEEDED,FP16_SPECIAL_VALUE,CAPABILITY_MISSING"
    }
}

fn M18Packed4RakeRows() -> M18Packed4Result[] {
    return [
        M18Packed4ResultForContext(M18Context { Name: "packed-tail-1x64x64" M: 1 N: 64 KDim: 64 ControllerMode: "SAFE" StrictFP32Correctness: false AllowFP16StorageQuantization: false FP16StorageCapability: false Packed4Capability: true FallbackAvailable: true ToleranceProvided: false ToleranceMaxAbsMilli: 0 ToleranceMaxRelPPM: 0 HasSpecialValues: false CancellationRisk: 0 }),
        M18Packed4ResultForContext(M18Context { Name: "packed-tail-2x5x7" M: 2 N: 5 KDim: 7 ControllerMode: "SAFE" StrictFP32Correctness: false AllowFP16StorageQuantization: false FP16StorageCapability: false Packed4Capability: true FallbackAvailable: true ToleranceProvided: false ToleranceMaxAbsMilli: 0 ToleranceMaxRelPPM: 0 HasSpecialValues: false CancellationRisk: 0 }),
        M18Packed4ResultForContext(M18Context { Name: "packed-tail-3x17x15" M: 3 N: 17 KDim: 15 ControllerMode: "RECOVERY" StrictFP32Correctness: false AllowFP16StorageQuantization: false FP16StorageCapability: false Packed4Capability: true FallbackAvailable: true ToleranceProvided: false ToleranceMaxAbsMilli: 0 ToleranceMaxRelPPM: 0 HasSpecialValues: false CancellationRisk: 0 }),
        M18Packed4ResultForContext(M18Context { Name: "packed-tail-15x17x33" M: 15 N: 17 KDim: 33 ControllerMode: "AGGRESSIVE" StrictFP32Correctness: false AllowFP16StorageQuantization: false FP16StorageCapability: false Packed4Capability: true FallbackAvailable: true ToleranceProvided: false ToleranceMaxAbsMilli: 0 ToleranceMaxRelPPM: 0 HasSpecialValues: false CancellationRisk: 0 }),
        M18Packed4ResultForContext(M18Context { Name: "packed-rect-m-gt-n" M: 256 N: 7 KDim: 17 ControllerMode: "AGGRESSIVE" StrictFP32Correctness: false AllowFP16StorageQuantization: false FP16StorageCapability: false Packed4Capability: true FallbackAvailable: true ToleranceProvided: false ToleranceMaxAbsMilli: 0 ToleranceMaxRelPPM: 0 HasSpecialValues: false CancellationRisk: 0 }),
        M18Packed4ResultForContext(M18Context { Name: "packed-rect-n-gt-m" M: 7 N: 256 KDim: 15 ControllerMode: "SAFE" StrictFP32Correctness: false AllowFP16StorageQuantization: false FP16StorageCapability: false Packed4Capability: true FallbackAvailable: true ToleranceProvided: false ToleranceMaxAbsMilli: 0 ToleranceMaxRelPPM: 0 HasSpecialValues: false CancellationRisk: 0 }),
        M18Packed4ResultForContext(M18Context { Name: "packed-k-tail-only" M: 64 N: 64 KDim: 17 ControllerMode: "SAFE" StrictFP32Correctness: false AllowFP16StorageQuantization: false FP16StorageCapability: false Packed4Capability: true FallbackAvailable: true ToleranceProvided: false ToleranceMaxAbsMilli: 0 ToleranceMaxRelPPM: 0 HasSpecialValues: false CancellationRisk: 0 }),
        M18Packed4ResultForContext(M18Context { Name: "packed-capability-missing" M: 64 N: 64 KDim: 64 ControllerMode: "SAFE" StrictFP32Correctness: false AllowFP16StorageQuantization: false FP16StorageCapability: false Packed4Capability: false FallbackAvailable: true ToleranceProvided: false ToleranceMaxAbsMilli: 0 ToleranceMaxRelPPM: 0 HasSpecialValues: false CancellationRisk: 0 })
    ]
}

fn M18FP16RakeRows() -> M18FP16Result[] {
    return [
        M18FP16ErrorMetrics(M18Context { Name: "fp16-small-k" M: 64 N: 64 KDim: 16 ControllerMode: "SAFE" StrictFP32Correctness: false AllowFP16StorageQuantization: true FP16StorageCapability: true Packed4Capability: true FallbackAvailable: true ToleranceProvided: true ToleranceMaxAbsMilli: 90 ToleranceMaxRelPPM: 35000 HasSpecialValues: false CancellationRisk: 1 }),
        M18FP16ErrorMetrics(M18Context { Name: "fp16-medium-k" M: 128 N: 64 KDim: 128 ControllerMode: "SAFE" StrictFP32Correctness: false AllowFP16StorageQuantization: true FP16StorageCapability: true Packed4Capability: true FallbackAvailable: true ToleranceProvided: true ToleranceMaxAbsMilli: 90 ToleranceMaxRelPPM: 35000 HasSpecialValues: false CancellationRisk: 2 }),
        M18FP16ErrorMetrics(M18Context { Name: "fp16-large-k" M: 128 N: 128 KDim: 1024 ControllerMode: "SAFE" StrictFP32Correctness: false AllowFP16StorageQuantization: true FP16StorageCapability: true Packed4Capability: true FallbackAvailable: true ToleranceProvided: true ToleranceMaxAbsMilli: 90 ToleranceMaxRelPPM: 35000 HasSpecialValues: false CancellationRisk: 3 }),
        M18FP16ErrorMetrics(M18Context { Name: "fp16-cancellation-heavy" M: 96 N: 96 KDim: 512 ControllerMode: "SAFE" StrictFP32Correctness: false AllowFP16StorageQuantization: true FP16StorageCapability: true Packed4Capability: true FallbackAvailable: true ToleranceProvided: true ToleranceMaxAbsMilli: 60 ToleranceMaxRelPPM: 20000 HasSpecialValues: false CancellationRisk: 6 }),
        M18FP16ErrorMetrics(M18Context { Name: "fp16-strict-fp32" M: 64 N: 64 KDim: 128 ControllerMode: "SAFE" StrictFP32Correctness: true AllowFP16StorageQuantization: true FP16StorageCapability: true Packed4Capability: true FallbackAvailable: true ToleranceProvided: true ToleranceMaxAbsMilli: 120 ToleranceMaxRelPPM: 50000 HasSpecialValues: false CancellationRisk: 1 }),
        M18FP16ErrorMetrics(M18Context { Name: "fp16-tolerance-missing" M: 64 N: 64 KDim: 256 ControllerMode: "SAFE" StrictFP32Correctness: false AllowFP16StorageQuantization: true FP16StorageCapability: true Packed4Capability: true FallbackAvailable: true ToleranceProvided: false ToleranceMaxAbsMilli: 0 ToleranceMaxRelPPM: 0 HasSpecialValues: false CancellationRisk: 2 }),
        M18FP16ErrorMetrics(M18Context { Name: "fp16-capability-missing" M: 64 N: 64 KDim: 256 ControllerMode: "SAFE" StrictFP32Correctness: false AllowFP16StorageQuantization: true FP16StorageCapability: false Packed4Capability: true FallbackAvailable: true ToleranceProvided: true ToleranceMaxAbsMilli: 200 ToleranceMaxRelPPM: 80000 HasSpecialValues: false CancellationRisk: 2 }),
