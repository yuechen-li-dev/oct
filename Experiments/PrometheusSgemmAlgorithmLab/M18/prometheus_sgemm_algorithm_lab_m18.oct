fn M18Packed4Columns(rows: M18Packed4Result[]) -> M18Packed4Table {
    return M18Packed4Table {
        CaseName: [rows[0].CaseName, rows[1].CaseName, rows[2].CaseName, rows[3].CaseName, rows[4].CaseName, rows[5].CaseName, rows[6].CaseName, rows[7].CaseName]
        M: [rows[0].M, rows[1].M, rows[2].M, rows[3].M, rows[4].M, rows[5].M, rows[6].M, rows[7].M]
        N: [rows[0].N, rows[1].N, rows[2].N, rows[3].N, rows[4].N, rows[5].N, rows[6].N, rows[7].N]
        KDim: [rows[0].KDim, rows[1].KDim, rows[2].KDim, rows[3].KDim, rows[4].KDim, rows[5].KDim, rows[6].KDim, rows[7].KDim]
        MTail: [rows[0].MTail, rows[1].MTail, rows[2].MTail, rows[3].MTail, rows[4].MTail, rows[5].MTail, rows[6].MTail, rows[7].MTail]
        NTail: [rows[0].NTail, rows[1].NTail, rows[2].NTail, rows[3].NTail, rows[4].NTail, rows[5].NTail, rows[6].NTail, rows[7].NTail]
        KTail: [rows[0].KTail, rows[1].KTail, rows[2].KTail, rows[3].KTail, rows[4].KTail, rows[5].KTail, rows[6].KTail, rows[7].KTail]
        TailCount: [rows[0].TailCount, rows[1].TailCount, rows[2].TailCount, rows[3].TailCount, rows[4].TailCount, rows[5].TailCount, rows[6].TailCount, rows[7].TailCount]
        PaddedLaneCount: [rows[0].PaddedLaneCount, rows[1].PaddedLaneCount, rows[2].PaddedLaneCount, rows[3].PaddedLaneCount, rows[4].PaddedLaneCount, rows[5].PaddedLaneCount, rows[6].PaddedLaneCount, rows[7].PaddedLaneCount]
        PaddingWastePct: [rows[0].PaddingWastePct, rows[1].PaddingWastePct, rows[2].PaddingWastePct, rows[3].PaddingWastePct, rows[4].PaddingWastePct, rows[5].PaddingWastePct, rows[6].PaddingWastePct, rows[7].PaddingWastePct]
        PackedEligible: [rows[0].PackedEligible, rows[1].PackedEligible, rows[2].PackedEligible, rows[3].PackedEligible, rows[4].PackedEligible, rows[5].PackedEligible, rows[6].PackedEligible, rows[7].PackedEligible]
        ModeBudgetPass: [rows[0].ModeBudgetPass, rows[1].ModeBudgetPass, rows[2].ModeBudgetPass, rows[3].ModeBudgetPass, rows[4].ModeBudgetPass, rows[5].ModeBudgetPass, rows[6].ModeBudgetPass, rows[7].ModeBudgetPass]
        IndexingRiskClass: [rows[0].IndexingRiskClass, rows[1].IndexingRiskClass, rows[2].IndexingRiskClass, rows[3].IndexingRiskClass, rows[4].IndexingRiskClass, rows[5].IndexingRiskClass, rows[6].IndexingRiskClass, rows[7].IndexingRiskClass]
        RowMajorCanonicalOutputCheck: [rows[0].RowMajorCanonicalOutputCheck, rows[1].RowMajorCanonicalOutputCheck, rows[2].RowMajorCanonicalOutputCheck, rows[3].RowMajorCanonicalOutputCheck, rows[4].RowMajorCanonicalOutputCheck, rows[5].RowMajorCanonicalOutputCheck, rows[6].RowMajorCanonicalOutputCheck, rows[7].RowMajorCanonicalOutputCheck]
        SelectedOrFallback: [rows[0].SelectedOrFallback, rows[1].SelectedOrFallback, rows[2].SelectedOrFallback, rows[3].SelectedOrFallback, rows[4].SelectedOrFallback, rows[5].SelectedOrFallback, rows[6].SelectedOrFallback, rows[7].SelectedOrFallback]
        FallbackReason: [rows[0].FallbackReason, rows[1].FallbackReason, rows[2].FallbackReason, rows[3].FallbackReason, rows[4].FallbackReason, rows[5].FallbackReason, rows[6].FallbackReason, rows[7].FallbackReason]
    }
}

