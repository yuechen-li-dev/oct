fn M18DecisionColumns(rows: M18DecisionRow[]) -> M18DecisionTable {
    return M18DecisionTable {
        CaseName: [rows[0].CaseName, rows[1].CaseName, rows[2].CaseName, rows[3].CaseName, rows[4].CaseName]
        SelectedCandidate: [rows[0].SelectedCandidate, rows[1].SelectedCandidate, rows[2].SelectedCandidate, rows[3].SelectedCandidate, rows[4].SelectedCandidate]
        RejectedCandidates: [rows[0].RejectedCandidates, rows[1].RejectedCandidates, rows[2].RejectedCandidates, rows[3].RejectedCandidates, rows[4].RejectedCandidates]
        HardGateReasons: [rows[0].HardGateReasons, rows[1].HardGateReasons, rows[2].HardGateReasons, rows[3].HardGateReasons, rows[4].HardGateReasons]
        FallbackChain: [rows[0].FallbackChain, rows[1].FallbackChain, rows[2].FallbackChain, rows[3].FallbackChain, rows[4].FallbackChain]
        ObservabilityReasonCodes: [rows[0].ObservabilityReasonCodes, rows[1].ObservabilityReasonCodes, rows[2].ObservabilityReasonCodes, rows[3].ObservabilityReasonCodes, rows[4].ObservabilityReasonCodes]
    }
}

fn M18RecommendationSummary() -> M18Recommendation {
    return M18Recommendation {
        Packed4FP32Status: "implement first with mandatory tail/padding gates and explicit ScalarFP32 fallback"
        FP16StorageFP32AccumStatus: "plan-only: implement after explicit tolerance opt-in policy, special-value reject policy, and K-sensitive error diagnostics"
        MandatoryHardGates: "strict FP32 blocks FP16 storage; missing capability blocks candidate; missing fallback blocks non-baseline; missing tolerance blocks FP16 storage; special values block FP16 storage"
        MandatoryDiagnostics: "packed4_tail_count, packed4_padded_lane_count, packed4_mode_budget_denials, packed4_row_major_check_failures, fp16_max_abs_error, fp16_max_rel_error, fp16_aggregate_error, fp16_k_growth, fp16_special_value_rejections, fallback_reason_code_count"
        M19Plan: "M19 should implement Packed4FP32 only, with gate/diagnostic parity from M18 and explicit rejection/fallback reason codes in judgment output"
    }
}
