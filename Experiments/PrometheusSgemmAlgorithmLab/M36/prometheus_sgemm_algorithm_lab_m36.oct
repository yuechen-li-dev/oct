package PrometheusSgemmAlgorithmLab

record M36BufferInvalidationTable {
    Scenario: String[]
    DirtyKeys: String[]
    InvalidateA: Bool[]
    InvalidateB: Bool[]
    InvalidateC: Bool[]
    SafeReuse: String[]
    FalseInvalidationCount: Int[]
    MissedInvalidationCount: Int[]
    RequiredImplementationRule: String[]
}

record M36JudgmentDependencyTable {
    Selector: String[]
    DependencyKeys: String[]
    RecomputeCost: String[]
    CacheSafeNow: Bool[]
    CacheRecommendation: String[]
    StaleDecisionHazard: String[]
}

record M36SelectorCacheRakeTable {
    Selector: String[]
    Scenario: String[]
    DependentDirtyMask: String[]
    RecomputeOrReuse: String[]
    ExpectedCachedValidity: String[]
    StaleDecisionHazard: String[]
    RecommendedCacheStatus: String[]
}

record M36SlotReadinessTable {
    Scenario: String[]
    DirtySlotMask: String[]
    ReadySlotSet: String[]
    FailedSlotSet: String[]
    SchedulerAttentionSlots: String[]
    PollingWorkAvoided: Int[]
    MissedReadinessHazard: String[]
    DuplicateReadinessHazard: String[]
}

record M36FinalRecommendation {
    CurrentDirtyTrackingState: String[]
    BufferInvalidationContract: String[]
    SelectorCachingContract: String[]
    SlotReadinessContract: String[]
    NextMilestoneOrdering: String[]
    DeferredScope: String[]
}

fn M36BufferInvalidationTableFrom() -> M36BufferInvalidationTable {
    return M36BufferInvalidationTable {
        Scenario: [
            "only-m-changes",
            "only-n-changes",
            "only-k-changes",
            "layout-changes",
            "precision-changes",
            "capacity-changes-no-logical-shape-change",
            "shape-repeats-storage-size-changes",
            "packed4-fp16-transition-back-to-scalar"
        ]
        DirtyKeys: [
            "shape.m",
            "shape.n",
            "shape.k",
            "layout.inputA,inputB,outputC",
            "precision.storage,precision.compute",
            "capacity.required_bytes",
            "capacity.required_bytes,shape.repeat",
            "layout.format,precision.storage_mode"
        ]
        InvalidateA: [true, false, true, true, true, true, true, true]
        InvalidateB: [false, true, true, true, true, true, true, true]
        InvalidateC: [true, true, false, true, true, true, true, true]
        SafeReuse: [
            "reuse-B-only",
            "reuse-A-only",
            "reuse-C-only",
            "none",
            "none",
            "none-if-capacity-grows reuse-all-if-capacity-unchanged",
            "none",
            "none"
        ]
        FalseInvalidationCount: [1, 1, 1, 0, 0, 0, 0, 0]
        MissedInvalidationCount: [0, 0, 0, 0, 0, 0, 0, 0]
        RequiredImplementationRule: [
            "A depends on m+k+layout+precision+capacity, B ignores m",
            "B depends on n+k+layout+precision+capacity, A ignores n",
            "k dirties A and B; C only dirties when output representation changes",
            "layout is per-artifact; any participating artifact layout change invalidates that artifact",
            "precision/storage mode change invalidates artifacts that change bytes or interpretation",
            "capacity shortfall must invalidate even when logical shape hash is unchanged",
            "reuse key must include byte capacity class not only logical dimensions",
            "packed/fp16/scalar mode transitions require representation-specific cache namespace"
        ]
    }
}

fn M36JudgmentDependencyTableFrom() -> M36JudgmentDependencyTable {
    return M36JudgmentDependencyTable {
        Selector: [
            "M35 buffering selector",
            "transfer-policy selector",
            "layout/precision selector",
            "full path/compute selector"
        ]
        DependencyKeys: [
            "memory-budget,m35-required-slots,m35-headroom,variance,predictability,starvation-risk,wip-waste,fallback-available",
            "queue-families,dedicated-available,transfer-supported,disabled-by-config,workload-threshold,sync-ownership,fallback-available,upload-policy-flags",
            "sgemm-layout,sgemm-precision,packed4/fp16 eligibility,tolerance facts,fallback-available,shape-family",
            "shape facts,path policy mode,direct/staged gates,readback flags,queue policy outcome,layout/precision outcome,buffering outcome"
        ]
        RecomputeCost: ["medium", "low", "medium", "high"]
        CacheSafeNow: [true, true, false, false]
        CacheRecommendation: [
            "already safe",
            "already safe",
            "safe to implement next",
            "defer"
        ]
        StaleDecisionHazard: [
            "wrong buffering mode and headroom misclassification",
            "wrong queue handoff policy and fallback mismatch",
            "wrong packed4/fp16 pick causing invalid layout or error-budget breach",
            "composed stale decision can violate path legality and mask fallback reasons"
        ]
    }
}

