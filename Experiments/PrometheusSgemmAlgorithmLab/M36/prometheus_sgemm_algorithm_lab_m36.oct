fn M36SlotReadinessTableFrom() -> M36SlotReadinessTable {
    return M36SlotReadinessTable {
        Scenario: [
            "one-slot-becomes-ready",
            "multiple-slots-ready-same-boundary",
            "one-slot-fails-others-continue",
            "slot-invalidates-due-shape-layout",
            "no-slot-changes",
            "repeated-ready-state-same",
            "n-slot-scan-vs-dirty-set-lookup",
            "dirty-slot-mask-overflow-limit",
            "multiple-commits-before-decision-boundary"
        ]
        DirtySlotMask: [
            "0b0001",
            "0b0110",
            "0b1001",
            "0b0010",
            "0b0000",
            "0b0000",
            "dirty-set:{2,7,11}",
            "overflow-flag + spill-list:{9,10}",
            "coalesced-mask:0b0101"
        ]
        ReadySlotSet: ["{0}","{1,2}","{2}","{}","{}","{1}","{2,7,11}","{0..7}","{0,2}"]
        FailedSlotSet: ["{}","{}","{0}","{1}","{}","{}","{}","{}","{}"]
        SchedulerAttentionSlots: ["{0}","{1,2}","{0,2}","{1}","{}","{}","{2,7,11}","{spill-list}","{0,2}"]
        PollingWorkAvoided: [1,0,1,1,2,2,13,6,2]
        MissedReadinessHazard: [
            "if ready transition not marked slot can starve",
            "if one bit dropped scheduler underutilizes available work",
            "if fail bit missed slot may be reused unsafely",
            "if invalidation bit missed stale shape/layout leaks",
            "none",
            "none",
            "if dirty set stale O(N) scan fallback required",
            "if overflow unhandled updates can be dropped",
            "if coalescing loses latest generation readiness may be stale"
        ]
        DuplicateReadinessHazard: [
            "duplicate ready event can double-dispatch",
            "duplicate mask bits can trigger redundant scheduling",
            "duplicate failure handling can over-cleanup",
            "duplicate invalidation can inflate churn counters",
            "none",
            "none",
            "duplicate dirty entries cause repeated checks",
            "overflow replay can duplicate scheduler work",
            "boundary replay can emit same slot twice"
        ]
    }
}

fn M36FinalRecommendationFrom() -> M36FinalRecommendation {
    return M36FinalRecommendation {
        CurrentDirtyTrackingState: [
            "Dominatus tracks key-level dirty masks, domain-level dirty masks, slot-scoped dirty state, and last-commit dirty key queries with staged/visible commit boundaries",
            "M13 already caches M35 buffering and transfer selectors using dependency dirty masks, visible projection guards, and non-zero-mask invalidation",
            "Remaining high-value applications are distinct: buffer invalidation controls allocation lifetime, selector caching controls judgment recompute lifetime, slot readiness controls scheduler polling lifetime"
        ]
        BufferInvalidationContract: [
            "use per-artifact dependency masks: A=(m,k,padded-k,layout,precision,capacity), B=(k,n,padded-k,layout,precision,capacity), C=(m,n,layout,precision,capacity)",
            "dimension-specific invalidation is required; changing n must not dirty A and changing m must not dirty B",
            "always include required-byte-capacity and representation mode in cache key to prevent undersized reuse"
        ]
        SelectorCachingContract: [
            "keep M35 and transfer cache as-is",
            "implement layout/precision selector cache next with explicit mask over layout/precision/tolerance/shape-family keys",
            "defer full path/compute cache until composed dependency proof and multi-commit coalescing guards are implemented"
        ]
        SlotReadinessContract: [
            "represent readiness changes as per-boundary dirty-slot mask plus optional spill-list for N > mask width",
            "track transitions preparing->ready, in-flight->consumed, fail, cleanup->empty, and explicit invalidation",
            "coalesce multiple commits per decision boundary while preserving highest generation and terminal failure/invalid states"
        ]
        NextMilestoneOrdering: [
            "next: native buffer artifact dependency invalidation (A/B/C scoped masks + capacity-class keys)",
            "then: layout/precision selector cache extension",
            "in parallel design-only: slot-ready dirty mask ABI finalized before N-slot/work-stealing implementation"
        ]
        DeferredScope: [
            "defer full path/compute caching until composed-slice migration stabilizes",
            "defer scheduler/work-stealing implementation until slot readiness dirty contract is wired and validated",
            "defer allocator redesign and concurrency changes"
        ]
    }
}
