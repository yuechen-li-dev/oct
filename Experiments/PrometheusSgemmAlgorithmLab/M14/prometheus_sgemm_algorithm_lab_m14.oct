package PrometheusSgemmAlgorithmLab

record M14Synthesis {
    M12ControllerDo: String
    M13ControllerAvoid: String
    ProductRelevantCharacteristics: String
    WinnerSuccessCriteria: String
}

record M14Regime {
    Name: String
    WorkUnits: Int
    TransferSetup: Int
    TransferPerUnit: Int
    ComputePerUnit: Int
    PredictabilityQuality: Int
}

record M14Candidate {
    Name: String
    BaseChunk: Int
    BaseLookahead: Int
    BaseDepth: Int
    WasteBudgetUnits: Int
    RetreatThresholdPct: Int
    RecoverThresholdPct: Int
    HysteresisWindow: Int
    ComplexityScore: Int
}

record M14Metrics {
    TotalCompletionTime: Int
    TransferStallTime: Int
    ComputeIdleTime: Int
    TotalTransferWork: Int
    WastedTransferWork: Int
    AverageChunkSizeUsed: Int
    ModeStability: Int
    RetreatFrequency: Int
}

record M14CaseResult {
    Regime: String
    Candidate: String
    ChunkSize: Int
    Lookahead: Int
    OutstandingDepth: Int
    SpeculationBudget: Int
    RetreatThresholdPct: Int
    TotalCompletionTime: Int
    TransferStallTime: Int
    ComputeIdleTime: Int
    TotalTransferWork: Int
    WastedTransferWork: Int
    AverageChunkSizeUsed: Int
    ModeStability: Int
    RetreatFrequency: Int
    ImplementationComplexityScore: Int
    ProductScore: Int
}

record M14RegimeWinner {
    Regime: String
    WinnerByProductScore: String
    WinnerScore: Int
    BestCompletionTime: Int
    BestWaste: Int
}

record M14HandoffTarget {
    Winner: String
    FailureMode: String
    WhyItMatters: String
    M15RakeTest: String
}

fn M14SynthesisFromM12M13() -> M14Synthesis {
    return M14Synthesis {
        M12ControllerDo: "use bounded overlap with modest lookahead (1..2), bounded outstanding depth, and adaptive chunk sizing with hard min/max bounds where transfer pressure is high"
        M13ControllerAvoid: "do not depend on estimator sophistication alone; Kalman-level prediction complexity did not materially improve completion time and can increase speculative waste"
        ProductRelevantCharacteristics: "boundedness, explainability, waste guardrails, robust cross-regime behavior, low oscillation, and implementation plausibility for Prometheus judgment control"
        WinnerSuccessCriteria: "select candidate with strong cross-regime completion time and waste robustness, stable control transitions, explicit retreat behavior, and manageable implementation complexity"
    }
}

fn M14MinInt(a: Int, b: Int) -> Int { return switch { case a < b => a else => b } }
fn M14MaxInt(a: Int, b: Int) -> Int { return switch { case a > b => a else => b } }
fn M14ClampInt(v: Int, low: Int, high: Int) -> Int {
    return switch {
        case v < low => low
        case v > high => high
        else => v
    }
}

fn M14TransferTime(units: Int, regime: M14Regime) -> Int { return regime.TransferSetup + (units * regime.TransferPerUnit) }
fn M14ComputeTime(units: Int, regime: M14Regime) -> Int { return units * regime.ComputePerUnit }

fn M14MakeRegime(name: String, workUnits: Int, transferSetup: Int, transferPerUnit: Int, computePerUnit: Int, predictabilityQuality: Int) -> M14Regime {
    return M14Regime {
        Name: name
        WorkUnits: workUnits
        TransferSetup: transferSetup
        TransferPerUnit: transferPerUnit
        ComputePerUnit: computePerUnit
        PredictabilityQuality: predictabilityQuality
    }
}

fn M14RegimeTransferBound() -> M14Regime { return M14MakeRegime("transfer-bound", 512, 14, 5, 2, 2) }
fn M14RegimeComputeBound() -> M14Regime { return M14MakeRegime("compute-bound", 512, 6, 1, 6, 1) }
fn M14RegimeBalanced() -> M14Regime { return M14MakeRegime("balanced", 512, 8, 2, 3, 1) }
fn M14RegimePredictabilitySensitive() -> M14Regime { return M14MakeRegime("predictability-sensitive", 512, 10, 3, 2, 3) }

