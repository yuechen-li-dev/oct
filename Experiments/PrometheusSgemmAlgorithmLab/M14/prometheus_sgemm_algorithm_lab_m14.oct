    return M14Candidate {
        Name: "A-conservative-bounded"
        BaseChunk: 16
        BaseLookahead: 1
        BaseDepth: 2
        WasteBudgetUnits: 0
        RetreatThresholdPct: 100
        RecoverThresholdPct: 100
        HysteresisWindow: 0
        ComplexityScore: 2
    }
}

