    return M14Candidate {
        Name: "C-waste-budgeted-speculation"
        BaseChunk: 16
        BaseLookahead: 2
        BaseDepth: 2
        WasteBudgetUnits: 64
        RetreatThresholdPct: 25
        RecoverThresholdPct: 12
        HysteresisWindow: 0
