    return M14Candidate {
        Name: "D-confidence-gated"
        BaseChunk: 16
        BaseLookahead: 2
        BaseDepth: 2
        WasteBudgetUnits: 0
        RetreatThresholdPct: 35
        RecoverThresholdPct: 75
        HysteresisWindow: 0
