    return M14Candidate {
        Name: "E-regime-classified"
        BaseChunk: 16
        BaseLookahead: 1
        BaseDepth: 2
        WasteBudgetUnits: 48
        RetreatThresholdPct: 30
        RecoverThresholdPct: 70
        HysteresisWindow: 0
