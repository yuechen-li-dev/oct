fn M42TransferInteractionContractTable() -> M42TransferInteractionTable {
    let d = M42RunScenario(M42BaseScenario("D-per-worker-plus-transfer", "compute-plus-transfer"))

    let viol0 = M42BaseScenario("D-per-worker-plus-transfer", "compute-plus-transfer")
    let viol = M42RunScenario(M42Scenario {
        Name: viol0.Name
        Candidate: viol0.Candidate
        QueueTopology: viol0.QueueTopology
        BatchSize: viol0.BatchSize
        WorkerCount: viol0.WorkerCount
        ComputeQueueCount: viol0.ComputeQueueCount
        TransferQueueCount: viol0.TransferQueueCount
        QueuesIndependent: viol0.QueuesIndependent
        MemoryBudgetBytes: viol0.MemoryBudgetBytes
        PerWorkerArenaBytes: viol0.PerWorkerArenaBytes
        SharedArenaEnabled: viol0.SharedArenaEnabled
        SharedArenaLockHeld: viol0.SharedArenaLockHeld
        EventRingCapacity: viol0.EventRingCapacity
        CriticalEventsPerTask: viol0.CriticalEventsPerTask
        DiagnosticsEventsPerTask: viol0.DiagnosticsEventsPerTask
        QueueSerializationCost: viol0.QueueSerializationCost
        LockContentionCost: viol0.LockContentionCost
        TransferOverlapBenefit: viol0.TransferOverlapBenefit
        OutputStagingBytesPerEntry: viol0.OutputStagingBytesPerEntry
        DominatusCommitCost: viol0.DominatusCommitCost
        FailureMode: viol0.FailureMode
        FailureEntryId: viol0.FailureEntryId
        SecondaryFailureEntryId: viol0.SecondaryFailureEntryId
        FailureWorkerId: viol0.FailureWorkerId
        InjectCommandOwnershipViolation: false
        InjectQueueOwnershipViolation: true
        InjectFenceOwnershipViolation: false
        InjectOutputOwnershipViolation: false
        InjectDominatusDirectMutation: false
        InjectArenaAccessWithoutLock: false
    })

    return M42TransferInteractionTable {
        Candidate:[d.Candidate, viol.Candidate]
        QueueTopology:[d.QueueTopology, viol.QueueTopology]
        TransferQueueCount:[d.HardwareQueueCount - d.EffectiveWorkers + 1, viol.HardwareQueueCount - viol.EffectiveWorkers + 1]
        TransferOverlapAllowed:[d.BatchFinalState == "SUCCEEDED", viol.BatchFinalState == "SUCCEEDED"]
        ComputeOwnershipPreserved:[d.FirstFailureDetail != "queue-submit-ownership-violation", viol.FirstFailureDetail != "queue-submit-ownership-violation"]
        QueueOwnershipViolationCount:[switch {case d.FirstFailureDetail == "queue-submit-ownership-violation" -> 1 else -> 0}, switch {case viol.FirstFailureDetail == "queue-submit-ownership-violation" -> 1 else -> 0}]
        CompletionTime:[d.CompletionTime, viol.CompletionTime]
    }
}

fn M42RecommendationFromMetrics() -> M42FinalContract {
    let a = M42RunScenario(M42BaseScenario("A-serialized-bridge-baseline", "single-compute"))
    let b = M42RunScenario(M42BaseScenario("B-per-worker-command-single-queue", "single-compute"))
    let c = M42RunScenario(M42BaseScenario("C-true-per-worker-queues", "two-compute"))
    let d = M42RunScenario(M42BaseScenario("D-per-worker-plus-transfer", "compute-plus-transfer"))
    let e = M42RunScenario(M42BaseScenario("E-shared-arena-lock", "two-compute"))

    var best = b.Candidate
    var bestScore = b.ProductScore

    if c.ProductScore > bestScore and c.BatchFinalState == "SUCCEEDED" {best = c.Candidate
        bestScore = c.ProductScore}
    if d.ProductScore > bestScore and d.BatchFinalState == "SUCCEEDED" {best = d.Candidate
        bestScore = d.ProductScore}
    if e.ProductScore > bestScore and e.BatchFinalState == "SUCCEEDED" {best = e.Candidate
        bestScore = e.ProductScore}

    let ready = c.BatchFinalState == "SUCCEEDED" and c.ActualHardwareParallelism and c.EffectiveWorkers > 1

    return M42FinalContract {
        Label: "P11 M12 / PrometheusSgemmAlgorithmLab M42"
        ReadyForTruePerWorkerQueueResources: ready
        FirstImplementationCandidateForM13: best
        CommandResourceOwnershipNeededFirst: true
        SingleQueueFallbackRule: "single-compute or pseudo/shared topology stays serialized bridge mode; no hardware parallelism claim"
        HardwareParallelismRequirement: "claim hardware parallelism only with >=2 independent compute queues plus per-worker ownership and memory budget headroom"
        MandatoryPerWorkerResources: c.RequiredResourceContract
        FailureDrainRule: c.DrainContract
        DominatusRule: c.DominatusContract
        TransferInteractionRule: "dedicated transfer overlap is optional and ownership-gated; transfer does not grant compute queue ownership"
        DiagnosticsContract: "publish execution mode, topology class, hardware queue count, effective workers, worker->queue map, per-worker in-flight/fence/event/failure states, queue drain counts/timeouts, lock contention count, output committed flag"
        SharedArenaDirection: "M13 should implement local per-worker arenas first; keep shared arena lock mode as deferred fallback for memory pressure"
        DeferredScope: "work stealing, SPMC/MPMC, lock-free queues, parallel judgment, broad scheduler redesign, native multi-queue implementation"
        RecommendationComputed: bestScore > 0
    }
}
