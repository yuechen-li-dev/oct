package PrometheusSgemmAlgorithmLab

enum MatMulStrategy {
    Baseline
    IKJ
    KIJ
    Blocked
    BlockedIKJ
    KBlocked
    KBlockedIKJ
    StagedIKJ
}

record MatMulDecision {
    Strategy: String
    BlockSize: Int
    KBlock: Int
}

record StructuralCostSignals {
    OutputTiles: Int
    KChunks: Int
    TempChunkMatrices: Int
    CopyPhases: Int
    ConceptualCopyVolume: Int
    DecompositionDepth: Int
    AccumulationSteps: Int
}

fn MatMulBaseline(A: Matrix<Float>, B: Matrix<Float>) -> Matrix<Float> ! Error {
    let _inputsOk = ValidateMatMulInputs(A, B)?

    var out = Matrix.zeros<Float>(A.rows, B.cols)
    for i in 0 .. A.rows {
        for j in 0 .. B.cols {
            var sum = 0.0
            for k in 0 .. A.cols {
                sum = sum + A[i, k] * B[k, j]
            }
            out[i, j] = sum
        }
    }

    return out
}

fn MatMul_IKJ(A: Matrix<Float>, B: Matrix<Float>) -> Matrix<Float> ! Error {
    let _inputsOk = ValidateMatMulInputs(A, B)?

    var out = Matrix.zeros<Float>(A.rows, B.cols)
    for i in 0 .. A.rows {
        for k in 0 .. A.cols {
            let aValue = A[i, k]
            for j in 0 .. B.cols {
                out[i, j] = out[i, j] + aValue * B[k, j]
            }
        }
    }

    return out
}

fn MatMul_KIJ(A: Matrix<Float>, B: Matrix<Float>) -> Matrix<Float> ! Error {
    let _inputsOk = ValidateMatMulInputs(A, B)?

    var out = Matrix.zeros<Float>(A.rows, B.cols)
    for k in 0 .. A.cols {
        for i in 0 .. A.rows {
            let aValue = A[i, k]
            for j in 0 .. B.cols {
                out[i, j] = out[i, j] + aValue * B[k, j]
            }
        }
    }

    return out
}

fn MatMul_Blocked(A: Matrix<Float>, B: Matrix<Float>, blockSize: Int) -> Matrix<Float> ! Error {
    let _inputsOk = ValidateMatMulInputs(A, B)?
    let _blockOk = ValidateBlockSize(blockSize)?

    var out = Matrix.zeros<Float>(A.rows, B.cols)

    for iBlockIndex in 0 .. A.rows {
        let iBlock = iBlockIndex * blockSize
        if iBlock < A.rows {
            let iEnd = MinInt(iBlock + blockSize, A.rows)
            for jBlockIndex in 0 .. B.cols {
                let jBlock = jBlockIndex * blockSize
                if jBlock < B.cols {
                    let jEnd = MinInt(jBlock + blockSize, B.cols)
                    for i in iBlock .. iEnd {
                        for j in jBlock .. jEnd {
                            var sum = 0.0
                            for k in 0 .. A.cols {
                                sum = sum + A[i, k] * B[k, j]
                            }
                            out[i, j] = sum
                        }
                    }
                }
            }
        }
    }

    return out
}

fn MatMul_Blocked_IKJ(A: Matrix<Float>, B: Matrix<Float>, blockSize: Int) -> Matrix<Float> ! Error {
    let _inputsOk = ValidateMatMulInputs(A, B)?
    let _blockOk = ValidateBlockSize(blockSize)?

    var out = Matrix.zeros<Float>(A.rows, B.cols)

    for iBlockIndex in 0 .. A.rows {
        let iBlock = iBlockIndex * blockSize
        if iBlock < A.rows {
            let iEnd = MinInt(iBlock + blockSize, A.rows)
            for jBlockIndex in 0 .. B.cols {
                let jBlock = jBlockIndex * blockSize
                if jBlock < B.cols {
                    let jEnd = MinInt(jBlock + blockSize, B.cols)
                    for i in iBlock .. iEnd {
                        for k in 0 .. A.cols {
                            let aValue = A[i, k]
                            for j in jBlock .. jEnd {
                                out[i, j] = out[i, j] + aValue * B[k, j]
                            }
                        }
                    }
                }
            }
        }
    }

    return out
}

fn MatMul_KBlocked(A: Matrix<Float>, B: Matrix<Float>, kBlock: Int) -> Matrix<Float> ! Error {
    let _inputsOk = ValidateMatMulInputs(A, B)?
    let _kBlockOk = ValidateKBlockSize(kBlock)?

    var out = Matrix.zeros<Float>(A.rows, B.cols)

    for kBlockIndex in 0 .. A.cols {
        let kStart = kBlockIndex * kBlock
        if kStart < A.cols {
            let kEnd = MinInt(kStart + kBlock, A.cols)
            for i in 0 .. A.rows {
                for j in 0 .. B.cols {
                    var partial = 0.0
                    for k in kStart .. kEnd {
                        partial = partial + A[i, k] * B[k, j]
                    }
                    out[i, j] = out[i, j] + partial
                }
            }
        }
    }

    return out
}

fn MatMul_KBlocked_IKJ(A: Matrix<Float>, B: Matrix<Float>, kBlock: Int) -> Matrix<Float> ! Error {
    let _inputsOk = ValidateMatMulInputs(A, B)?
    let _kBlockOk = ValidateKBlockSize(kBlock)?

    var out = Matrix.zeros<Float>(A.rows, B.cols)

    for kBlockIndex in 0 .. A.cols {
        let kStart = kBlockIndex * kBlock
        if kStart < A.cols {
            let kEnd = MinInt(kStart + kBlock, A.cols)
            for i in 0 .. A.rows {
                for k in kStart .. kEnd {
                    let aValue = A[i, k]
                    for j in 0 .. B.cols {
                        out[i, j] = out[i, j] + aValue * B[k, j]
                    }
                }
            }
        }
    }

    return out
}

fn MatMul_Staged_IKJ(A: Matrix<Float>, B: Matrix<Float>, kBlock: Int) -> Matrix<Float> ! Error {
    let _inputsOk = ValidateMatMulInputs(A, B)?
    let _kBlockOk = ValidateKBlockSize(kBlock)?

    var out = Matrix.zeros<Float>(A.rows, B.cols)

    for kBlockIndex in 0 .. A.cols {
        let kStart = kBlockIndex * kBlock
        if kStart < A.cols {
            let kEnd = MinInt(kStart + kBlock, A.cols)
            let kChunkLen = kEnd - kStart

            let stagedA = StageAChunk(A, kStart, kChunkLen)
            let stagedB = StageBChunk(B, kStart, kChunkLen)

            var partialOut = Matrix.zeros<Float>(A.rows, B.cols)
            for i in 0 .. A.rows {
                for kLocal in 0 .. kChunkLen {
                    let aValue = stagedA[i, kLocal]
                    for j in 0 .. B.cols {
                        partialOut[i, j] = partialOut[i, j] + aValue * stagedB[kLocal, j]
                    }
                }
            }

            for i in 0 .. A.rows {
                for j in 0 .. B.cols {
                    out[i, j] = out[i, j] + partialOut[i, j]
                }
            }
        }
    }

    return out
}

fn StageAChunk(A: Matrix<Float>, kStart: Int, kChunkLen: Int) -> Matrix<Float> {
    var staged = Matrix.zeros<Float>(A.rows, kChunkLen)

    for i in 0 .. A.rows {
        for kLocal in 0 .. kChunkLen {
            staged[i, kLocal] = A[i, kStart + kLocal]
        }
    }

    return staged
}

fn StageBChunk(B: Matrix<Float>, kStart: Int, kChunkLen: Int) -> Matrix<Float> {
    var staged = Matrix.zeros<Float>(kChunkLen, B.cols)

    for kLocal in 0 .. kChunkLen {
        for j in 0 .. B.cols {
            staged[kLocal, j] = B[kStart + kLocal, j]
        }
    }

    return staged
}

fn MatMulWithStrategy(
    A: Matrix<Float>,
    B: Matrix<Float>,
    strategy: MatMulStrategy,
    blockSize: Int,
    kBlock: Int
) -> Matrix<Float> ! Error {
    return switch strategy {
        case MatMulStrategy.Baseline => MatMulBaseline(A, B)?
        case MatMulStrategy.IKJ => MatMul_IKJ(A, B)?
        case MatMulStrategy.KIJ => MatMul_KIJ(A, B)?
        case MatMulStrategy.Blocked => MatMul_Blocked(A, B, blockSize)?
        case MatMulStrategy.BlockedIKJ => MatMul_Blocked_IKJ(A, B, blockSize)?
        case MatMulStrategy.KBlocked => MatMul_KBlocked(A, B, kBlock)?
        case MatMulStrategy.KBlockedIKJ => MatMul_KBlocked_IKJ(A, B, kBlock)?
        case MatMulStrategy.StagedIKJ => MatMul_Staged_IKJ(A, B, kBlock)?
    }
}

fn ChooseStrategy(A: Matrix<Float>, B: Matrix<Float>) -> MatMulStrategy ! Error {
    let _inputsOk = ValidateMatMulInputs(A, B)?

    return DecisionStrategy(ChooseDecision(A.rows, B.cols, A.cols))
}

fn ChooseStrategyUtility(m: Int, n: Int, k: Int) -> MatMulStrategy {
    return DecisionStrategy(ChooseDecision(m, n, k))
}

fn ChooseDecision(m: Int, n: Int, k: Int) -> MatMulDecision {
    let strategy = when utility {
        case MatMulStrategy.KBlocked when true score ScoreKDecomposition(m, n, k)
        case MatMulStrategy.Baseline when true score ScoreSingleCall(m, n, k)
        case MatMulStrategy.Blocked when true score ScoreBlocked(m, n, k)
        else MatMulStrategy.Baseline
    }
    return DecisionForStrategy(strategy, m, n, k)
}

fn ChooseDecisionWithPolicy(m: Int, n: Int, k: Int, hysteresis: Int, minCommit: Int) -> MatMulDecision {
    let strategy = when utility { hysteresis: hysteresis min_commit: minCommit } {
        case MatMulStrategy.KBlocked when true score ScoreKDecomposition(m, n, k)
        case MatMulStrategy.Baseline when true score ScoreSingleCall(m, n, k)
        case MatMulStrategy.Blocked when true score ScoreBlocked(m, n, k)
        else MatMulStrategy.Baseline
    }
    return DecisionForStrategy(strategy, m, n, k)
}

fn ChooseStrategyUtilityWithPolicy(m: Int, n: Int, k: Int, hysteresis: Int, minCommit: Int) -> MatMulStrategy {
    return DecisionStrategy(ChooseDecisionWithPolicy(m, n, k, hysteresis, minCommit))
}

fn DecisionStrategy(decision: MatMulDecision) -> MatMulStrategy {
    return switch decision.Strategy {
        case "Blocked" => MatMulStrategy.Blocked
        case "KBlocked" => MatMulStrategy.KBlocked
        else => MatMulStrategy.Baseline
    }
}

fn DecisionForStrategy(strategy: MatMulStrategy, m: Int, n: Int, k: Int) -> MatMulDecision {
    return switch strategy {
        case MatMulStrategy.Blocked => MatMulDecision {
            Strategy: "Blocked"
            BlockSize: ChooseBlockedBlockSize(m, n, k)
            KBlock: 0
        }
        case MatMulStrategy.KBlocked => MatMulDecision {
            Strategy: "KBlocked"
            BlockSize: 0
            KBlock: ChooseKBlockSize(m, n, k)
        }
        case MatMulStrategy.Baseline => MatMulDecision {
            Strategy: "Baseline"
            BlockSize: 0
            KBlock: 0
        }
        case MatMulStrategy.IKJ => MatMulDecision {
            Strategy: "Baseline"
            BlockSize: 0
            KBlock: 0
        }
        case MatMulStrategy.KIJ => MatMulDecision {
            Strategy: "Baseline"
            BlockSize: 0
            KBlock: 0
        }
        case MatMulStrategy.BlockedIKJ => MatMulDecision {
            Strategy: "Blocked"
            BlockSize: ChooseBlockedBlockSize(m, n, k)
            KBlock: 0
        }
        case MatMulStrategy.KBlockedIKJ => MatMulDecision {
            Strategy: "KBlocked"
            BlockSize: 0
            KBlock: ChooseKBlockSize(m, n, k)
        }
        case MatMulStrategy.StagedIKJ => MatMulDecision {
            Strategy: "Baseline"
            BlockSize: 0
            KBlock: 0
        }
    }
}

fn ChooseBlockedBlockSize(m: Int, n: Int, k: Int) -> Int {
    let area = m * n
    if m <= 12 and n <= 12 and k <= 12 {
        return 2
    }
    if area <= 400 {
        return 4
    }
    if area <= 1024 {
        return 8
    }
    return 16
}

fn ChooseKBlockSize(m: Int, n: Int, k: Int) -> Int {
    let shapeSignal = m + n
    if shapeSignal < 0 {
        return 4
    }
    if k >= 512 {
        return 32
    }
    if k >= 256 {
        return 16
    }
    if k >= 128 {
        return 8
    }
    return 4
}

fn StructuralSignalsForStrategy(
    strategy: MatMulStrategy,
    m: Int,
    n: Int,
    k: Int,
    blockSize: Int,
    kBlock: Int
) -> StructuralCostSignals {
    let safeBlockSize = MaxInt(1, blockSize)
    let safeKBlock = MaxInt(1, kBlock)

    let tilesM = CeilDiv(m, safeBlockSize)
    let tilesN = CeilDiv(n, safeBlockSize)
    let outputTiles = tilesM * tilesN
    let kChunks = CeilDiv(k, safeKBlock)

    return switch strategy {
        case MatMulStrategy.Baseline => StructuralCostSignals {
            OutputTiles: 1
            KChunks: 1
            TempChunkMatrices: 0
            CopyPhases: 0
            ConceptualCopyVolume: 0
            DecompositionDepth: 1
            AccumulationSteps: m * n * k
        }
        case MatMulStrategy.IKJ => StructuralCostSignals {
            OutputTiles: 1
            KChunks: 1
            TempChunkMatrices: 0
            CopyPhases: 0
            ConceptualCopyVolume: 0
            DecompositionDepth: 1
            AccumulationSteps: m * n * k
        }
        case MatMulStrategy.KIJ => StructuralCostSignals {
            OutputTiles: 1
            KChunks: 1
            TempChunkMatrices: 0
            CopyPhases: 0
            ConceptualCopyVolume: 0
            DecompositionDepth: 1
            AccumulationSteps: m * n * k
        }
        case MatMulStrategy.Blocked => StructuralCostSignals {
            OutputTiles: outputTiles
            KChunks: 1
            TempChunkMatrices: 0
            CopyPhases: 0
            ConceptualCopyVolume: 0
            DecompositionDepth: 2
            AccumulationSteps: m * n * k
        }
        case MatMulStrategy.BlockedIKJ => StructuralCostSignals {
            OutputTiles: outputTiles
            KChunks: 1
            TempChunkMatrices: 0
            CopyPhases: 0
            ConceptualCopyVolume: 0
            DecompositionDepth: 2
            AccumulationSteps: m * n * k
        }
        case MatMulStrategy.KBlocked => StructuralCostSignals {
            OutputTiles: 1
            KChunks: kChunks
            TempChunkMatrices: 0
            CopyPhases: 0
            ConceptualCopyVolume: 0
            DecompositionDepth: 2
            AccumulationSteps: m * n * k
        }
        case MatMulStrategy.KBlockedIKJ => StructuralCostSignals {
            OutputTiles: 1
            KChunks: kChunks
            TempChunkMatrices: 0
            CopyPhases: 0
            ConceptualCopyVolume: 0
            DecompositionDepth: 2
            AccumulationSteps: m * n * k
        }
        case MatMulStrategy.StagedIKJ => StructuralCostSignals {
            OutputTiles: 1
            KChunks: kChunks
            TempChunkMatrices: 2 * kChunks
            CopyPhases: 2 * kChunks
            ConceptualCopyVolume: (m * k) + (k * n)
            DecompositionDepth: 3
            AccumulationSteps: m * n * k
        }
    }
}

fn ScoreSingleCall(m: Int, n: Int, k: Int) -> Int {
    let signals = StructuralSignalsForStrategy(MatMulStrategy.Baseline, m, n, k, 1, 1)
    let maxOuter = MaxInt(m, n)
    let minOuter = MaxInt(1, MinInt(m, n))
    let balanceScaled = (maxOuter * 100) / minOuter

    var score = 100
    score = score - signals.DecompositionDepth * 10
    if balanceScaled <= 125 {
        score = score + 15
    }
    if k >= maxOuter * 3 {
        score = score - 35
    }
    return score
}

fn ScoreBlocked(m: Int, n: Int, k: Int) -> Int {
    let blockSize = ChooseBlockedBlockSize(m, n, k)
    let signals = StructuralSignalsForStrategy(MatMulStrategy.Blocked, m, n, k, blockSize, 1)

    var score = 60
    if signals.OutputTiles >= 4 {
        score = score + 45
    }
    if signals.OutputTiles >= 16 {
        score = score + 20
    }
    if k >= MaxInt(m, n) * 3 {
        score = score - 20
    }
    return score
}

fn ScoreKDecomposition(m: Int, n: Int, k: Int) -> Int {
    let kBlock = ChooseKBlockSize(m, n, k)
    let signals = StructuralSignalsForStrategy(MatMulStrategy.KBlocked, m, n, k, 1, kBlock)

    var score = 55
    if signals.KChunks >= 4 {
        score = score + 35
    }
    if signals.KChunks >= 8 {
        score = score + 20
    }
    if m <= 8 and n <= 8 and k <= 16 {
        score = score - 20
    }
    return score
}

fn MeasureStrategy(
    a: Matrix<Float>,
    b: Matrix<Float>,
    strategy: MatMulStrategy,
    blockSize: Int,
    kBlock: Int
) -> Int ! Error {
    let out = MatMulWithStrategy(a, b, strategy, blockSize, kBlock)?
    let signals = StructuralSignalsForStrategy(strategy, a.rows, b.cols, a.cols, blockSize, kBlock)
    return out.rows * out.cols + signals.AccumulationSteps + signals.ConceptualCopyVolume
}

fn CeilDiv(value: Int, divisor: Int) -> Int {
    if divisor <= 0 {
        return 0
    }
    if value <= 0 {
        return 0
    }
    return ((value - 1) / divisor) + 1
}

fn MinInt(a: Int, b: Int) -> Int {
    if a < b {
        return a
    }
    return b
}

fn MaxInt(a: Int, b: Int) -> Int {
    if a > b {
        return a
    }
    return b
}

fn ValidateMatMulInputs(A: Matrix<Float>, B: Matrix<Float>) -> Bool ! Error {
    let aOk = ValidateMatrixShape(A)?
    if not aOk {
        return error("A matrix shape validation failed")
    }
    let bOk = ValidateMatrixShape(B)?
    if not bOk {
        return error("B matrix shape validation failed")
    }

    if A.cols != B.rows {
        return error("matmul requires A columns to equal B rows")
    }

    return true
}

fn ValidateMatrixShape(m: Matrix<Float>) -> Bool ! Error {
    if m.rows <= 0 or m.cols <= 0 {
        return error("matrix dimensions must be > 0")
    }
    return true
}

fn ValidateBlockSize(blockSize: Int) -> Bool ! Error {
    if blockSize <= 0 {
        return error("blockSize must be > 0")
    }
    return true
}

fn ValidateKBlockSize(kBlock: Int) -> Bool ! Error {
    if kBlock <= 0 {
        return error("kBlock must be > 0")
    }
    return true
}

fn ProbeA(r: Int, c: Int) -> Float {
    return Float(r * 101 + c * 3 + 1)
}

fn ProbeB(r: Int, c: Int) -> Float {
    let v = Float(r * 97 + c * 5 + 2)
    let parity = (r + c) - ((r + c) / 2) * 2
    if parity == 0 {
        return -v
    }
    return v
}

fn M6BenchA(m: Int, k: Int) -> Matrix<Float> {
    return Matrix.tabulate(m, k, ProbeA)
}

fn M6BenchB(k: Int, n: Int) -> Matrix<Float> {
    return Matrix.tabulate(k, n, ProbeB)
}

fn M6MeasureSingleCall(m: Int, n: Int, k: Int) -> Int ! Error {
    let a = M6BenchA(m, k)
    let b = M6BenchB(k, n)
    return MeasureStrategy(a, b, MatMulStrategy.Baseline, 0, 0)!
}

fn M6MeasureBlocked(m: Int, n: Int, k: Int, blockSize: Int) -> Int ! Error {
    let a = M6BenchA(m, k)
    let b = M6BenchB(k, n)
    return MeasureStrategy(a, b, MatMulStrategy.Blocked, blockSize, 0)!
}

fn M6MeasureKDecomposition(m: Int, n: Int, k: Int, kBlock: Int) -> Int ! Error {
    let a = M6BenchA(m, k)
    let b = M6BenchB(k, n)
    return MeasureStrategy(a, b, MatMulStrategy.KBlocked, 0, kBlock)!
}
