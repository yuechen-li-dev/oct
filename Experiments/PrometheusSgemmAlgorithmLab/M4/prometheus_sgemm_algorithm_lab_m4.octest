fn StrategyLabel(strategy: MatMulStrategy) -> String {
    return switch strategy {
        case MatMulStrategy.Baseline => "Baseline"
        case MatMulStrategy.IKJ => "IKJ"
        case MatMulStrategy.KIJ => "KIJ"
        case MatMulStrategy.Blocked => "Blocked"
        case MatMulStrategy.BlockedIKJ => "BlockedIKJ"
        case MatMulStrategy.KBlocked => "KBlocked"
        case MatMulStrategy.KBlockedIKJ => "KBlockedIKJ"
        case MatMulStrategy.StagedIKJ => "StagedIKJ"
    }
}

[Benchmark]
fn M4_S2x2_Baseline() -> Void {
    let a = Matrix.tabulate(2, 2, ProbeA)
    let b = Matrix.tabulate(2, 2, ProbeB)
    Print(MeasureStrategy(a, b, MatMulStrategy.Baseline, 8, 16)!)
}

