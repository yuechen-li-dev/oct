fn M4_K16x16x512_Blocked() -> Void {
    let a = Matrix.tabulate(16, 512, ProbeA)
    let b = Matrix.tabulate(512, 16, ProbeB)
    Print(MeasureStrategy(a, b, MatMulStrategy.Blocked, 8, 16)!)
}

