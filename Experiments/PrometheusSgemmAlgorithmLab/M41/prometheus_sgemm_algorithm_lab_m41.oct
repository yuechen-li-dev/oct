        OutputCommitStatus:[one.OutputCommitStatus, two.OutputCommitStatus]
        DrainRule:[one.DrainRule, two.DrainRule]
    }
}

fn M41QueueTopologyContractTable() -> M41QueueTopologyTable {
    let b1 = M41RunScenario(M41Scenario {
        Name: "single-queue"
        Candidate: "B-real-threads-serialized-vulkan"
        BatchSize: 24
        WorkerCount: 4
        HardwareQueueCount: 1
        MemoryBudgetBytes: 1073741824
        PerWorkerArenaBytes: 268435456
        EventRingCapacity: 24
        EventDrainInterval: 4
        DispatchDistribution: "moderate-variable"
        CriticalEventsPerTask: 2
        DiagnosticsEventsPerTask: 2
        FailureMode: "none"
        FailureEntryId: 5
        SecondaryFailureEntryId: 7
        FailureProbabilityMilli: 0
        MutexCost: 2
        QueueSerializationCost: 3
        DominatusCommitCost: 20
        OutputStagingBytesPerEntry: 4096
        SharedArenaEnabled: false
        SharedArenaLockHeld: true
        InjectIllegalPolicyMutation: false
        InjectIllegalDominatusWrite: false
        DispatchBaseCost: 1
    })
    let c2 = M41RunScenario(M41BaseScenario("C-real-threads-per-worker-queues"))
    let c4 = M41RunScenario(M41Scenario {
        Name: "four-queue"
        Candidate: "C-real-threads-per-worker-queues"
        BatchSize: 24
        WorkerCount: 4
        HardwareQueueCount: 4
        MemoryBudgetBytes: 1073741824
        PerWorkerArenaBytes: 268435456
        EventRingCapacity: 24
        EventDrainInterval: 4
        DispatchDistribution: "moderate-variable"
        CriticalEventsPerTask: 2
        DiagnosticsEventsPerTask: 2
        FailureMode: "none"
        FailureEntryId: 5
        SecondaryFailureEntryId: 7
        FailureProbabilityMilli: 0
        MutexCost: 2
        QueueSerializationCost: 3
        DominatusCommitCost: 20
        OutputStagingBytesPerEntry: 4096
        SharedArenaEnabled: false
        SharedArenaLockHeld: true
        InjectIllegalPolicyMutation: false
        InjectIllegalDominatusWrite: false
        DispatchBaseCost: 1
    })
    let cx = M41RunScenario(M41Scenario {
        Name: "compute+transfer"
        Candidate: "C-real-threads-per-worker-queues"
        BatchSize: 24
        WorkerCount: 4
        HardwareQueueCount: 2
        MemoryBudgetBytes: 1073741824
        PerWorkerArenaBytes: 268435456
        EventRingCapacity: 24
        EventDrainInterval: 4
        DispatchDistribution: "moderate-variable"
        CriticalEventsPerTask: 2
        DiagnosticsEventsPerTask: 2
        FailureMode: "none"
        FailureEntryId: 5
        SecondaryFailureEntryId: 7
        FailureProbabilityMilli: 0
        MutexCost: 2
        QueueSerializationCost: 3
        DominatusCommitCost: 20
        OutputStagingBytesPerEntry: 4096
        SharedArenaEnabled: false
        SharedArenaLockHeld: true
        InjectIllegalPolicyMutation: false
        InjectIllegalDominatusWrite: false
        DispatchBaseCost: 1
    })
    return M41QueueTopologyTable {
        Topology:["one-compute-queue", "two-compute-queues", "four-compute-queues", "compute+transfer"]
        Candidate:[b1.Candidate, c2.Candidate, c4.Candidate, cx.Candidate]
        HardwareQueues:[1, 2, 4, 2]
        EffectiveWorkers:[b1.EffectiveWorkers, c2.EffectiveWorkers, c4.EffectiveWorkers, cx.EffectiveWorkers]
        ClaimedHardwareParallelism:[b1.ClaimedHardwareParallelism, c2.ClaimedHardwareParallelism, c4.ClaimedHardwareParallelism, cx.ClaimedHardwareParallelism]
        ActualHardwareParallelism:[b1.ActualHardwareParallelism, c2.ActualHardwareParallelism, c4.ActualHardwareParallelism, cx.ActualHardwareParallelism]
        QueueContract:[
            "single queue: real threads allowed but Vulkan submit must serialize and diagnostics must not claim hardware parallelism",
            "two queues: true parallel execution may be claimed only up to queue count and memory cap",
            "four queues: true parallel execution may be claimed up to effective worker cap",
            "compute+transfer: compute parallelism remains compute-queue bounded"
        ]
    }
}

fn M41ArenaOwnershipContractTable() -> M41ArenaOwnershipTable {
    let local = M41RunScenario(M41BaseScenario("C-real-threads-per-worker-queues"))
    let sharedLocked = M41RunScenario(M41Scenario {
        Name: "shared-locked"
        Candidate: "D-real-threads-shared-arena"
        BatchSize: 24
        WorkerCount: 4
        HardwareQueueCount: 2
        MemoryBudgetBytes: 805306368
        PerWorkerArenaBytes: 268435456
        EventRingCapacity: 24
        EventDrainInterval: 4
        DispatchDistribution: "moderate-variable"
        CriticalEventsPerTask: 2
        DiagnosticsEventsPerTask: 2
        FailureMode: "none"
        FailureEntryId: 5
        SecondaryFailureEntryId: 7
        FailureProbabilityMilli: 0
        MutexCost: 3
        QueueSerializationCost: 3
        DominatusCommitCost: 20
        OutputStagingBytesPerEntry: 4096
        SharedArenaEnabled: true
        SharedArenaLockHeld: true
        InjectIllegalPolicyMutation: false
        InjectIllegalDominatusWrite: false
        DispatchBaseCost: 1
    })
    let sharedUnlocked = M41RunScenario(M41Scenario {
        Name: "shared-unlocked"
        Candidate: "D-real-threads-shared-arena"
        BatchSize: 24
        WorkerCount: 4
        HardwareQueueCount: 2
        MemoryBudgetBytes: 805306368
        PerWorkerArenaBytes: 268435456
        EventRingCapacity: 24
        EventDrainInterval: 4
        DispatchDistribution: "moderate-variable"
        CriticalEventsPerTask: 2
        DiagnosticsEventsPerTask: 2
        FailureMode: "none"
        FailureEntryId: 5
        SecondaryFailureEntryId: 7
        FailureProbabilityMilli: 0
        MutexCost: 3
        QueueSerializationCost: 3
        DominatusCommitCost: 20
        OutputStagingBytesPerEntry: 4096
        SharedArenaEnabled: true
        SharedArenaLockHeld: false
        InjectIllegalPolicyMutation: false
        InjectIllegalDominatusWrite: false
        DispatchBaseCost: 1
    })

    return M41ArenaOwnershipTable {
        Candidate:[local.Candidate, sharedLocked.Candidate, sharedUnlocked.Candidate]
        SharedArenaEnabled:[false, true, true]
        LockHeld:[true, true, false]
        OwnershipConflictCount:[local.OwnershipConflictCount, sharedLocked.OwnershipConflictCount, sharedUnlocked.OwnershipConflictCount]
        ThreadLockOverhead:[local.ThreadLockOverhead, sharedLocked.ThreadLockOverhead, sharedUnlocked.ThreadLockOverhead]
        MemoryPressureMilli:[local.MemoryPressureMilli, sharedLocked.MemoryPressureMilli, sharedUnlocked.MemoryPressureMilli]
        ArenaRule:[local.ArenaRule, sharedLocked.ArenaRule, sharedUnlocked.ArenaRule]
    }
}

fn M41RecommendationFromMetrics() -> M41FinalContract {
    let a = M41RunScenario(M41BaseScenario("A-lane-simulated"))
    let b = M41RunScenario(M41BaseScenario("B-real-threads-serialized-vulkan"))
    let c = M41RunScenario(M41BaseScenario("C-real-threads-per-worker-queues"))

    let chooseB = b.ProductScore >= c.ProductScore - 150 and b.IllegalAccessCount == 0 and b.CriticalOverflowCount == 0
    let chooseC = c.ActualHardwareParallelism and c.IllegalAccessCount == 0 and c.CriticalOverflowCount == 0 and c.ProductScore > b.ProductScore + 150
    let first = switch {
        case chooseC -> "C-real-threads-per-worker-queues"
        case chooseB -> "B-real-threads-serialized-vulkan"
        else -> "A-lane-simulated"
    }
    let ready = a.BatchState == "SUCCEEDED" and b.BatchState == "SUCCEEDED"

    return M41FinalContract {
        Label: "P11 M9 / PrometheusSgemmAlgorithmLab M41"
        ReadyForRealWorkers: ready
        FirstImplementationCandidate: first
        M10Direction: switch {
            case first == "B-real-threads-serialized-vulkan" -> "implement real worker threads first with serialized Vulkan execution bridge"
            case first == "C-real-threads-per-worker-queues" -> "implement true per-worker queue/resource path"
            else -> "remain lane-simulated until hazards are addressed"
        }
        WorkerForbidden: b.WorkerForbiddenRule
        EventOverflowPolicy: b.EventPolicyRule
        FailureDrainPolicy: b.DrainRule
        OrderedCommitPolicy: "workers may complete out-of-order internally; publish caller-visible outputs only via single atomic commit in entry-id order"
        SingleQueueDegradeRule: "with one compute queue, keep real worker threads if desired but serialize queue submit or collapse effective Vulkan workers to one and do not claim hardware parallelism"
        ArenaOwnershipRule: "per-worker arenas are exclusive in local mode; shared bank requires explicit ownership lock"
        DeferredScope: "work stealing, SPMC/MPMC shared queues, lock-free runtime queues, parallel judgment, cross-worker arena borrowing without lock"
        RecommendationComputed: true
    }
}
