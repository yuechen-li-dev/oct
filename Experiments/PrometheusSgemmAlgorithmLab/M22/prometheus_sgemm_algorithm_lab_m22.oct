package PrometheusSgemmAlgorithmLab

record M22Scenario {
    CaseName: String
    Profile: String
    KDim: Int
    StrictFP32: Bool
    ToleranceKnown: Bool
    ToleranceMaxAbsMilli: Int
    ToleranceMaxRelPPM: Int
    FP16StorageCapability: Bool
    FallbackAvailable: Bool
    HasSpecialValues: Bool
}

record M22MetricRow {
    CaseName: String
    Profile: String
    KDim: Int
    MaxAbsoluteError: Int
    MaxRelativeError: Int
    AggregateError: Int
    WorstCaseElementIndex: Int
    KErrorGrowth: Int
    CancellationRisk: Int
}

record M22PolicyRow {
    CaseName: String
    CandidateEligibility: Bool
    StrictFP32GatePass: Bool
    ToleranceKnownGatePass: Bool
    TolerancePass: Bool
    SpecialValueGatePass: Bool
    CapabilityGatePass: Bool
    FallbackReason: String
    SelectedCandidate: String
}

record M22RoundTripTable {
    CaseName: String[]
    Profile: String[]
    MaxAbsoluteError: Int[]
    MaxRelativeError: Int[]
    AggregateError: Int[]
    WorstCaseElementIndex: Int[]
}

record M22MagnitudeEdgeTable {
    CaseName: String[]
    Profile: String[]
    MaxAbsoluteError: Int[]
    MaxRelativeError: Int[]
    AggregateError: Int[]
    CancellationRisk: Int[]
}

record M22KGrowthTable {
    CaseName: String[]
    KDim: Int[]
    MaxAbsoluteError: Int[]
    KErrorGrowth: Int[]
    AggregateError: Int[]
}

record M22CancellationTable {
    CaseName: String[]
    Profile: String[]
    CancellationRisk: Int[]
    MaxAbsoluteError: Int[]
    MaxRelativeError: Int[]
    AggregateError: Int[]
}

record M22PolicyGateTable {
    CaseName: String[]
    CandidateEligibility: Bool[]
    StrictFP32GatePass: Bool[]
    ToleranceKnownGatePass: Bool[]
    TolerancePass: Bool[]
    SpecialValueGatePass: Bool[]
    CapabilityGatePass: Bool[]
    FallbackReason: String[]
    SelectedCandidate: String[]
}

record M22FinalRecommendation {
    ImplementSoon: String
    AutomaticDefault: String
    RequiresExplicitToleranceOptIn: String
    MandatoryGates: String
    MandatoryDiagnostics: String
    NextMilestone: String
}

fn M22AbsInt(v: Int) -> Int {
    return switch {
        case v < 0 => -v
        else => v
    }
}

fn M22MaxInt(a: Int, b: Int) -> Int {
    return switch {
        case a > b => a
        else => b
    }
}

fn M22QuantStepMilli(v: Int) -> Int {
    let a = M22AbsInt(v)
    return switch {
        case a <= 2 => 8
        case a <= 64 => 4
        case a <= 1000 => 8
        case a <= 8000 => 32
        case a <= 64000 => 128
        else => 256
    }
}

fn M22RoundNearest(v: Int, quantStep: Int) -> Int {
    if quantStep <= 0 { return v }
    return switch {
        case v >= 0 => ((v + (quantStep / 2)) / quantStep) * quantStep
        else => -(((-v + (quantStep / 2)) / quantStep) * quantStep)
    }
}

fn M22FP16QuantizeMilli(v: Int) -> Int {
    let a = M22AbsInt(v)
    if a > 65504000 { return 65504000 }
    if a < 2 { return 0 }
    let quantStep = M22QuantStepMilli(v)
    return M22RoundNearest(v, quantStep)
}

fn M22SampleProfile(profile: String) -> Int[] {
    return switch {
        case profile == "roundtrip-balanced" => [1, -1, 3, -3, 15, -15, 1000, -1000, 8193, -8193]
        case profile == "very-small" => [0, 1, -1, 2, -2, 3, -3, 4, -4, 5]
        case profile == "large" => [32000, -32000, 48000, -48000, 65500, -65500, 70000, -70000, 90000, -90000]
        case profile == "mixed-magnitude" => [1, -1, 8, -8, 65, -65, 1001, -1001, 32768, -32768]
        case profile == "near-zero" => [0, 1, -1, 0, 2, -2, 1, -1, 3, -3]
        case profile == "negative-heavy" => [-4, -8, -16, -32, -64, -128, -256, -512, -1024, -2048]
        case profile == "cancellation-heavy" => [1023, -1021, 2047, -2045, 4095, -4093, 8191, -8189, 16383, -16381]
        else => [4, -4, 12, -12, 36, -36, 144, -144, 576, -576]
    }
}

fn M22CancellationRiskPPM(samples: Int[]) -> Int {
    var sumAbs = 0
    var signed = 0
    for i in 0 .. Len(samples) {
        sumAbs = sumAbs + M22AbsInt(samples[i])
        signed = signed + samples[i]
    }
    if sumAbs <= 0 { return 0 }
    return ((sumAbs - M22AbsInt(signed)) * 1000000) / sumAbs
}

fn M22MetricsForScenario(s: M22Scenario) -> M22MetricRow {
    let samples = M22SampleProfile(s.Profile)
    var maxAbs = 0
    var maxRel = 0
    var agg = 0
    var worst = -1

    for i in 0 .. Len(samples) {
        let original = samples[i]
        let quant = M22FP16QuantizeMilli(original)
        let absErr = M22AbsInt(original - quant)
        let rel = (absErr * 1000000) / M22MaxInt(M22AbsInt(original), 1)
        agg = agg + absErr
        if absErr > maxAbs {
            maxAbs = absErr
            worst = i
        }
        if rel > maxRel {
            maxRel = rel
        }
    }

    let cancellationRisk = M22CancellationRiskPPM(samples)
    let kGrowth = (maxAbs * M22MaxInt(s.KDim, 1) * M22MaxInt(cancellationRisk, 1)) / 1000000

    return M22MetricRow {
        CaseName: s.CaseName
        Profile: s.Profile
        KDim: s.KDim
        MaxAbsoluteError: maxAbs
        MaxRelativeError: maxRel
        AggregateError: agg
        WorstCaseElementIndex: worst
        KErrorGrowth: kGrowth
        CancellationRisk: cancellationRisk
    }
}

fn M22FallbackReason(s: M22Scenario, metrics: M22MetricRow) -> String {
    let strictPass = not s.StrictFP32
    let toleranceKnown = s.ToleranceKnown
    let tolerancePass = toleranceKnown and metrics.MaxAbsoluteError <= s.ToleranceMaxAbsMilli and metrics.MaxRelativeError <= s.ToleranceMaxRelPPM
    let specialPass = not s.HasSpecialValues
    let capabilityPass = s.FP16StorageCapability and s.FallbackAvailable

    return switch {
        case not strictPass => "FP16_STRICT_FP32"
        case not toleranceKnown => "FP16_TOLERANCE_UNKNOWN"
        case not specialPass => "FP16_SPECIAL_VALUE"
        case not tolerancePass => "FP16_TOLERANCE_EXCEEDED"
        case not s.FP16StorageCapability => "FP16_CAPABILITY_MISSING"
        case not s.FallbackAvailable => "FALLBACK_REQUIRED"
        else => "none"
    }
}

fn M22PolicyForScenario(s: M22Scenario) -> M22PolicyRow {
    let metrics = M22MetricsForScenario(s)
    let strictPass = not s.StrictFP32
    let toleranceKnown = s.ToleranceKnown
    let tolerancePass = toleranceKnown and metrics.MaxAbsoluteError <= s.ToleranceMaxAbsMilli and metrics.MaxRelativeError <= s.ToleranceMaxRelPPM
    let specialPass = not s.HasSpecialValues
    let capabilityPass = s.FP16StorageCapability and s.FallbackAvailable

    let eligible = strictPass and toleranceKnown and tolerancePass and specialPass and capabilityPass
    let selected = switch {
        case eligible => "FP16StorageFP32Accum"
        else => "ScalarFP32"
    }

    return M22PolicyRow {
        CaseName: s.CaseName
        CandidateEligibility: eligible
        StrictFP32GatePass: strictPass
        ToleranceKnownGatePass: toleranceKnown
        TolerancePass: tolerancePass
        SpecialValueGatePass: specialPass
        CapabilityGatePass: capabilityPass
        FallbackReason: M22FallbackReason(s, metrics)
        SelectedCandidate: selected
    }
}

fn M22RoundTripScenarios() -> M22Scenario[] {
    return [
        M22Scenario { CaseName: "roundtrip-baseline" Profile: "roundtrip-balanced" KDim: 64 StrictFP32: false ToleranceKnown: true ToleranceMaxAbsMilli: 300 ToleranceMaxRelPPM: 180000 FP16StorageCapability: true FallbackAvailable: true HasSpecialValues: false },
        M22Scenario { CaseName: "roundtrip-near-zero" Profile: "near-zero" KDim: 64 StrictFP32: false ToleranceKnown: true ToleranceMaxAbsMilli: 300 ToleranceMaxRelPPM: 180000 FP16StorageCapability: true FallbackAvailable: true HasSpecialValues: false },
        M22Scenario { CaseName: "roundtrip-mixed" Profile: "mixed-magnitude" KDim: 128 StrictFP32: false ToleranceKnown: true ToleranceMaxAbsMilli: 300 ToleranceMaxRelPPM: 180000 FP16StorageCapability: true FallbackAvailable: true HasSpecialValues: false }
    ]
}

