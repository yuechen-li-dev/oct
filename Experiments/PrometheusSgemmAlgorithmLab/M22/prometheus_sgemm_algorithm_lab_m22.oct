    return [
        M22Scenario { CaseName: "edge-very-small" Profile: "very-small" KDim: 64 StrictFP32: false ToleranceKnown: true ToleranceMaxAbsMilli: 200 ToleranceMaxRelPPM: 300000 FP16StorageCapability: true FallbackAvailable: true HasSpecialValues: false },
        M22Scenario { CaseName: "edge-large" Profile: "large" KDim: 64 StrictFP32: false ToleranceKnown: true ToleranceMaxAbsMilli: 300 ToleranceMaxRelPPM: 50000 FP16StorageCapability: true FallbackAvailable: true HasSpecialValues: false },
        M22Scenario { CaseName: "edge-negative" Profile: "negative-heavy" KDim: 64 StrictFP32: false ToleranceKnown: true ToleranceMaxAbsMilli: 300 ToleranceMaxRelPPM: 120000 FP16StorageCapability: true FallbackAvailable: true HasSpecialValues: false },
        M22Scenario { CaseName: "edge-mixed" Profile: "mixed-magnitude" KDim: 64 StrictFP32: false ToleranceKnown: true ToleranceMaxAbsMilli: 300 ToleranceMaxRelPPM: 120000 FP16StorageCapability: true FallbackAvailable: true HasSpecialValues: false }
    ]
}

