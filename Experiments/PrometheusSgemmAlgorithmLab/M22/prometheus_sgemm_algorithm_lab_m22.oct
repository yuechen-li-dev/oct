    return [
        M22Scenario { CaseName: "k-small" Profile: "roundtrip-balanced" KDim: 16 StrictFP32: false ToleranceKnown: true ToleranceMaxAbsMilli: 200 ToleranceMaxRelPPM: 150000 FP16StorageCapability: true FallbackAvailable: true HasSpecialValues: false },
        M22Scenario { CaseName: "k-medium" Profile: "roundtrip-balanced" KDim: 128 StrictFP32: false ToleranceKnown: true ToleranceMaxAbsMilli: 200 ToleranceMaxRelPPM: 150000 FP16StorageCapability: true FallbackAvailable: true HasSpecialValues: false },
        M22Scenario { CaseName: "k-large" Profile: "roundtrip-balanced" KDim: 512 StrictFP32: false ToleranceKnown: true ToleranceMaxAbsMilli: 200 ToleranceMaxRelPPM: 150000 FP16StorageCapability: true FallbackAvailable: true HasSpecialValues: false },
        M22Scenario { CaseName: "k-very-large" Profile: "roundtrip-balanced" KDim: 2048 StrictFP32: false ToleranceKnown: true ToleranceMaxAbsMilli: 200 ToleranceMaxRelPPM: 150000 FP16StorageCapability: true FallbackAvailable: true HasSpecialValues: false }
    ]
}

fn M22CancellationScenarios() -> M22Scenario[] {
    return [
        M22Scenario { CaseName: "cancel-light" Profile: "mixed-magnitude" KDim: 256 StrictFP32: false ToleranceKnown: true ToleranceMaxAbsMilli: 220 ToleranceMaxRelPPM: 150000 FP16StorageCapability: true FallbackAvailable: true HasSpecialValues: false },
        M22Scenario { CaseName: "cancel-heavy" Profile: "cancellation-heavy" KDim: 256 StrictFP32: false ToleranceKnown: true ToleranceMaxAbsMilli: 220 ToleranceMaxRelPPM: 150000 FP16StorageCapability: true FallbackAvailable: true HasSpecialValues: false }
    ]
}

fn M22PolicyGateScenarios() -> M22Scenario[] {
    return [
        M22Scenario { CaseName: "policy-pass-explicit" Profile: "mixed-magnitude" KDim: 128 StrictFP32: false ToleranceKnown: true ToleranceMaxAbsMilli: 1000 ToleranceMaxRelPPM: 1000000 FP16StorageCapability: true FallbackAvailable: true HasSpecialValues: false },
        M22Scenario { CaseName: "policy-strict-fp32" Profile: "mixed-magnitude" KDim: 128 StrictFP32: true ToleranceKnown: true ToleranceMaxAbsMilli: 300 ToleranceMaxRelPPM: 200000 FP16StorageCapability: true FallbackAvailable: true HasSpecialValues: false },
        M22Scenario { CaseName: "policy-tolerance-missing" Profile: "mixed-magnitude" KDim: 128 StrictFP32: false ToleranceKnown: false ToleranceMaxAbsMilli: 0 ToleranceMaxRelPPM: 0 FP16StorageCapability: true FallbackAvailable: true HasSpecialValues: false },
        M22Scenario { CaseName: "policy-tolerance-exceeded" Profile: "mixed-magnitude" KDim: 128 StrictFP32: false ToleranceKnown: true ToleranceMaxAbsMilli: 4 ToleranceMaxRelPPM: 1000 FP16StorageCapability: true FallbackAvailable: true HasSpecialValues: false },
        M22Scenario { CaseName: "policy-special-value" Profile: "mixed-magnitude" KDim: 128 StrictFP32: false ToleranceKnown: true ToleranceMaxAbsMilli: 300 ToleranceMaxRelPPM: 200000 FP16StorageCapability: true FallbackAvailable: true HasSpecialValues: true },
        M22Scenario { CaseName: "policy-capability-missing" Profile: "mixed-magnitude" KDim: 128 StrictFP32: false ToleranceKnown: true ToleranceMaxAbsMilli: 1000 ToleranceMaxRelPPM: 1000000 FP16StorageCapability: false FallbackAvailable: true HasSpecialValues: false },
        M22Scenario { CaseName: "policy-fallback-missing" Profile: "mixed-magnitude" KDim: 128 StrictFP32: false ToleranceKnown: true ToleranceMaxAbsMilli: 1000 ToleranceMaxRelPPM: 1000000 FP16StorageCapability: true FallbackAvailable: false HasSpecialValues: false }
    ]
}

fn M22MetricsRows(scenarios: M22Scenario[]) -> M22MetricRow[] {
    var rows = [M22MetricsForScenario(scenarios[0])]
    for i in 1 .. Len(scenarios) {
        rows = Append(rows, M22MetricsForScenario(scenarios[i]))
    }
    return rows
}

fn M22PolicyRows() -> M22PolicyRow[] {
    let scenarios = M22PolicyGateScenarios()
    var rows = [M22PolicyForScenario(scenarios[0])]
    for i in 1 .. Len(scenarios) {
        rows = Append(rows, M22PolicyForScenario(scenarios[i]))
    }
    return rows
}

fn M22RoundTripTableFrom(rows: M22MetricRow[]) -> M22RoundTripTable {
    var names = [rows[0].CaseName]
    var profiles = [rows[0].Profile]
    var maxAbs = [rows[0].MaxAbsoluteError]
    var maxRel = [rows[0].MaxRelativeError]
    var agg = [rows[0].AggregateError]
    var worst = [rows[0].WorstCaseElementIndex]
    for i in 1 .. Len(rows) {
        names = Append(names, rows[i].CaseName)
        profiles = Append(profiles, rows[i].Profile)
        maxAbs = Append(maxAbs, rows[i].MaxAbsoluteError)
        maxRel = Append(maxRel, rows[i].MaxRelativeError)
        agg = Append(agg, rows[i].AggregateError)
        worst = Append(worst, rows[i].WorstCaseElementIndex)
    }
    return M22RoundTripTable { CaseName: names Profile: profiles MaxAbsoluteError: maxAbs MaxRelativeError: maxRel AggregateError: agg WorstCaseElementIndex: worst }
}

fn M22MagnitudeEdgeTableFrom(rows: M22MetricRow[]) -> M22MagnitudeEdgeTable {
    var names = [rows[0].CaseName]
    var profiles = [rows[0].Profile]
    var maxAbs = [rows[0].MaxAbsoluteError]
    var maxRel = [rows[0].MaxRelativeError]
    var agg = [rows[0].AggregateError]
    var cancel = [rows[0].CancellationRisk]
    for i in 1 .. Len(rows) {
        names = Append(names, rows[i].CaseName)
        profiles = Append(profiles, rows[i].Profile)
        maxAbs = Append(maxAbs, rows[i].MaxAbsoluteError)
        maxRel = Append(maxRel, rows[i].MaxRelativeError)
        agg = Append(agg, rows[i].AggregateError)
        cancel = Append(cancel, rows[i].CancellationRisk)
    }
    return M22MagnitudeEdgeTable { CaseName: names Profile: profiles MaxAbsoluteError: maxAbs MaxRelativeError: maxRel AggregateError: agg CancellationRisk: cancel }
}

fn M22KGrowthTableFrom(rows: M22MetricRow[]) -> M22KGrowthTable {
    var names = [rows[0].CaseName]
    var k = [rows[0].KDim]
    var maxAbs = [rows[0].MaxAbsoluteError]
    var growth = [rows[0].KErrorGrowth]
    var agg = [rows[0].AggregateError]
    for i in 1 .. Len(rows) {
        names = Append(names, rows[i].CaseName)
        k = Append(k, rows[i].KDim)
        maxAbs = Append(maxAbs, rows[i].MaxAbsoluteError)
        growth = Append(growth, rows[i].KErrorGrowth)
        agg = Append(agg, rows[i].AggregateError)
    }
    return M22KGrowthTable { CaseName: names KDim: k MaxAbsoluteError: maxAbs KErrorGrowth: growth AggregateError: agg }
}

fn M22CancellationTableFrom(rows: M22MetricRow[]) -> M22CancellationTable {
    var names = [rows[0].CaseName]
    var profiles = [rows[0].Profile]
    var risk = [rows[0].CancellationRisk]
    var maxAbs = [rows[0].MaxAbsoluteError]
    var maxRel = [rows[0].MaxRelativeError]
    var agg = [rows[0].AggregateError]
    for i in 1 .. Len(rows) {
        names = Append(names, rows[i].CaseName)
        profiles = Append(profiles, rows[i].Profile)
        risk = Append(risk, rows[i].CancellationRisk)
        maxAbs = Append(maxAbs, rows[i].MaxAbsoluteError)
        maxRel = Append(maxRel, rows[i].MaxRelativeError)
        agg = Append(agg, rows[i].AggregateError)
    }
    return M22CancellationTable { CaseName: names Profile: profiles CancellationRisk: risk MaxAbsoluteError: maxAbs MaxRelativeError: maxRel AggregateError: agg }
}

fn M22PolicyGateTableFrom(rows: M22PolicyRow[]) -> M22PolicyGateTable {
    var names = [rows[0].CaseName]
    var eligible = [rows[0].CandidateEligibility]
    var strict = [rows[0].StrictFP32GatePass]
    var known = [rows[0].ToleranceKnownGatePass]
    var pass = [rows[0].TolerancePass]
    var special = [rows[0].SpecialValueGatePass]
    var capability = [rows[0].CapabilityGatePass]
    var reason = [rows[0].FallbackReason]
    var selected = [rows[0].SelectedCandidate]

    for i in 1 .. Len(rows) {
        names = Append(names, rows[i].CaseName)
        eligible = Append(eligible, rows[i].CandidateEligibility)
        strict = Append(strict, rows[i].StrictFP32GatePass)
        known = Append(known, rows[i].ToleranceKnownGatePass)
        pass = Append(pass, rows[i].TolerancePass)
        special = Append(special, rows[i].SpecialValueGatePass)
        capability = Append(capability, rows[i].CapabilityGatePass)
        reason = Append(reason, rows[i].FallbackReason)
        selected = Append(selected, rows[i].SelectedCandidate)
    }

    return M22PolicyGateTable {
        CaseName: names
        CandidateEligibility: eligible
        StrictFP32GatePass: strict
        ToleranceKnownGatePass: known
        TolerancePass: pass
        SpecialValueGatePass: special
        CapabilityGatePass: capability
        FallbackReason: reason
        SelectedCandidate: selected
    }
}

fn M22FinalRecommendationSummary() -> M22FinalRecommendation {
    return M22FinalRecommendation {
        ImplementSoon: "Yes, but only behind explicit tolerance policy gates and deterministic diagnostics; never as implicit default."
        AutomaticDefault: "No. Automatic selection is unsafe for strict-FP32, tolerance-unknown, and special-value contexts."
        RequiresExplicitToleranceOptIn: "Yes. Tolerance must be explicit, known, and passed against measured FP32->FP16->FP32 drift metrics."
        MandatoryGates: "strict_fp32_off, tolerance_known, tolerance_pass(max_abs+max_rel), special_value_reject, fp16_capability, fallback_available"
        MandatoryDiagnostics: "MaxAbsoluteError, MaxRelativeError, AggregateError, WorstCaseElementIndex, KErrorGrowth, CancellationRisk, TolerancePass, FallbackReason, SelectedCandidate"
        NextMilestone: "M23 should wire these gates/reason-codes into judgment-engine selection and add runtime observability parity before any implementation-by-default discussion."
    }
}
