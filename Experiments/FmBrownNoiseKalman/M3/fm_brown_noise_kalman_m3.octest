package FmBrownNoiseKalman

import IO

[Fact]
[Suite("Experiments.FmBrownNoiseKalman.M3")]
[Suite("Experiments.FmBrownNoiseKalman.M3.FlowSmoke")]
fn M3FlowReachesDone() -> Void ! Error {
    let run = RunM3OctomataFixedKalman(M3TinyCase())?
    Assert.True(run.Trace.DoneReached, "done reached")
}

[Fact]
[Suite("Experiments.FmBrownNoiseKalman.M3")]
[Suite("Experiments.FmBrownNoiseKalman.M3.FlowSmoke")]
fn M3RecoveredAndInnovationLengthsMatchSampleCount() -> Void ! Error {
    let run = RunM3OctomataFixedKalman(M3TinyCase())?
    let expected = M3SampleCount(run.Case)
    Assert.Equal(expected, Len(run.Octomata.Recovered), "octomata recovered length")
    Assert.Equal(expected, Len(run.Octomata.Innovation), "octomata innovation length")
}

[Fact]
[Suite("Experiments.FmBrownNoiseKalman.M3")]
[Suite("Experiments.FmBrownNoiseKalman.M3.FlowSmoke")]
fn M3ProceduralAndOctomataEquivalentWithinTolerance() -> Void ! Error {
    let run = RunM3OctomataFixedKalman(M3TinyCase())?
    Assert.True(run.MaxOutputDiff <= run.ToleranceUsed, "max recovered abs diff")
    Assert.True(run.MaxInnovationDiff <= run.ToleranceUsed, "max innovation abs diff")
    Assert.True(Abs(run.Metrics[0].OutputSNRDb - run.Metrics[1].OutputSNRDb) <= run.ToleranceUsed, "output snr diff")
    Assert.True(Abs(run.Metrics[0].Nrmse - run.Metrics[1].Nrmse) <= run.ToleranceUsed, "nrmse diff")
    Assert.True(Abs(run.Metrics[0].WhitenessCost - run.Metrics[1].WhitenessCost) <= run.ToleranceUsed, "whiteness diff")
}

[Fact]
[Suite("Experiments.FmBrownNoiseKalman.M3")]
[Suite("Experiments.FmBrownNoiseKalman.M3.FlowSmoke")]
fn M3MetricsFiniteAndTraceContainsExpectedStates() -> Void ! Error {
    let run = RunM3OctomataFixedKalman(M3TinyCase())?
    for i in 0..Len(run.Metrics) {
        Assert.True(Abs(run.Metrics[i].OutputSNRDb) < 1e300, "finite output snr")
        Assert.True(Abs(run.Metrics[i].Nrmse) < 1e300, "finite nrmse")
        Assert.True(Abs(run.Metrics[i].WhitenessCost) < 1e300, "finite whiteness")
        Assert.True(Abs(run.Metrics[i].Correlation) <= 1.0 + 1e-9, "finite correlation")
    }

    Assert.True(run.Trace.TickCount > 0, "state history non-empty")
    Assert.True(run.Trace.InitializeCount > 0, "initialize present")
    Assert.True(run.Trace.PredictCount > 0, "predict present")
    Assert.True(run.Trace.ObserveCount > 0, "observe present")
    Assert.True(run.Trace.ComputeGainCount > 0, "compute gain present")
    Assert.True(run.Trace.CorrectCount > 0, "correct present")
    Assert.True(run.Trace.RecordCount > 0, "record present")
    Assert.True(run.Trace.AdvanceCount > 0, "advance present")
    Assert.True(run.Trace.DoneCount > 0, "done present")
}

[Fact]
[Suite("Experiments.FmBrownNoiseKalman.M3")]
[Suite("Experiments.FmBrownNoiseKalman.M3.FlowSmoke")]
fn M3BoardSnapshotPathExercised() -> Void ! Error {
    let run = RunM3OctomataFixedKalman(M3TinyCase())?
    Assert.Equal("RealOctomataScalarBoardWithBoardSnapshot", run.Trace.RepresentationKind, "representation kind")
    Assert.Equal(run.Trace.SampleCount, run.Trace.RecoveredCount, "snapshot recovered count")
    Assert.Equal(run.Trace.SampleCount, run.Trace.InnovationCount, "snapshot innovation count")
}

[Artifact]
[Suite("Experiments.FmBrownNoiseKalman.M3")]
[Suite("Experiments.FmBrownNoiseKalman.M3.Artifacts")]
fn M3ArtifactsWrite() -> Void ! Error {
    let _ = M3ArtifactWriteAll()
    let octagon = IO.ReadLines("Experiments/FmBrownNoiseKalman/M3/m3_octomata_kalman_report.octagon")?
    let md = IO.ReadLines("Experiments/FmBrownNoiseKalman/M3/m3_octomata_kalman_report.md")?
    let csv = IO.ReadLines("Experiments/FmBrownNoiseKalman/M3/metrics.csv")?
    let json = IO.Load("Experiments/FmBrownNoiseKalman/M3/metrics.json")?
    Assert.True(Len(octagon) > 0, "octagon written")
    Assert.True(Len(md) > 0, "markdown written")
    Assert.True(Len(csv) > 0, "csv written")
    Assert.True(Len(json) > 0, "json written")
}
