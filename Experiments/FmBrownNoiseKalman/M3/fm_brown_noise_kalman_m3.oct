package FmBrownNoiseKalman

import Shared
import String
import Artifact
import Markdown
import Json

record M3Case {
    SampleRate: Float
    Duration: Float
    MessageHz: Float
    InputSNRDb: Float
    Seed: Int
}

record M3StateMachineResult {
    Recovered: Float[]
    Innovation: Float[]
    DoneReached: Bool
}

record M3TraceSummary {
    RepresentationKind: String
    TickCount: Int
    InitializeCount: Int
    PredictCount: Int
    ObserveCount: Int
    ComputeGainCount: Int
    CorrectCount: Int
    RecordCount: Int
    AdvanceCount: Int
    DoneCount: Int
    DoneReached: Bool
    FirstState: String
    LastState: String
    SampleCount: Int
    FirstInnovation: Float
    LastInnovation: Float
}

record M3MetricRow {
    Method: String
    OutputSNRDb: Float
    Nrmse: Float
    WhitenessCost: Float
}

record M3Run {
    Case: M3Case
    Clean: Float[]
    Observed: Float[]
    Procedural: Shared.KalmanResult
    Octomata: M3StateMachineResult
    Trace: M3TraceSummary
    Metrics: M3MetricRow[]
    MaxOutputDiff: Float
    MaxInnovationDiff: Float
}

record M3OctagonReport {
    title: String
    goal: String
    representationChoice: String
    stateMachine: String[]
    trace: M3TraceSummary
    metrics: M3MetricRow[]
    equivalence: String[]
    limitations: String[]
    next: String
}

record M3MetricTable {
    method: String[]
    outputSNRDb: String[]
    nrmse: String[]
    whitenessCost: String[]
}

record M3CsvRow {
    method: String
    outputSNRDb: String
    nrmse: String
    whitenessCost: String
}

flow M3KalmanMachine(observed: Float[]) -> M3StateMachineResult {
    board {
        Index: Int
        Z: Float
        X0: Float
        X1: Float
        P00: Float
        P11: Float
        X0Pred: Float
        X1Pred: Float
        P00Pred: Float
        P11Pred: Float
        InnovationY: Float
        S: Float
        K0: Float
        K1: Float
        Recovered: Float[]
        Innovation: Float[]
    }

    state Initialize {
        board.Index = 0
        board.X0 = 0.0
        board.X1 = 0.0
        board.P00 = 1.0
        board.P11 = 1.0
        board.Recovered = []
        board.Innovation = []
        goto Predict
    }

    state Predict {
        when {
            case board.Index >= Len(observed) -> goto Done
            else -> goto Observe
        }
    }

    state Observe {
        board.Z = observed[board.Index]
        board.X0Pred = board.X0 + board.X1
        board.X1Pred = board.X1
        board.P00Pred = board.P00 + board.P11 + 1e-3
        board.P11Pred = board.P11 + 1e-2
        goto ComputeGain
    }

    state ComputeGain {
        board.InnovationY = board.Z - board.X0Pred
        board.S = board.P00Pred + 0.1 + 1.0
        board.K0 = board.P00Pred / board.S
        board.K1 = board.P11Pred / board.S
        goto Correct
    }

    state Correct {
        board.X0 = board.X0Pred + board.K0 * board.InnovationY
        board.X1 = board.X1Pred + board.K1 * board.InnovationY
        board.P00 = (1.0 - board.K0) * board.P00Pred
        board.P11 = (1.0 - board.K1) * board.P11Pred
        goto Record
    }

    state Record {
        board.Recovered = Append(board.Recovered, board.X0)
        board.Innovation = Append(board.Innovation, board.InnovationY)
        goto Advance
    }

    state Advance {
        board.Index = board.Index + 1
        goto Predict
    }

    state Done {
        return M3StateMachineResult {
            Recovered: board.Recovered
            Innovation: board.Innovation
            DoneReached: true
        }
    }
}

fn M3TinyCase() -> M3Case {
    return M3Case { SampleRate: 2000.0 Duration: 0.5 MessageHz: 25.0 InputSNRDb: -12.0 Seed: 12345 }
}

fn M3SampleCount(c: M3Case) -> Int {
    return FloorToInt(c.SampleRate * c.Duration)
}

fn M3BuildClean(c: M3Case) -> Float[] {
    let n = M3SampleCount(c)
    var clean: Float[] = []
    for i in 0..n {
        let x = Float(i) / c.SampleRate
        clean = Append(clean, Sin(2.0 * Pi() * c.MessageHz * x))
    }
    return Shared.NormalizeRms(Shared.RemoveMean(clean), 1.0)
}

fn M3CountState(history: String[], stateName: String) -> Int {
    var count = 0
    for i in 0..Len(history) {
        if history[i] == stateName { count = count + 1 }
    }
    return count
}

fn M3MaxAbsDiff(a: Float[], b: Float[]) -> Float {
    var max = 0.0
    for i in 0..Len(a) {
        let d = Abs(a[i] - b[i])
        if d > max {
            max = d
        }
    }
    return max
}

fn RunM3OctomataFixedKalman(c: M3Case) -> M3Run ! Error {
    let clean = M3BuildClean(c)
    let observed = Shared.AddNoiseAtSnr(clean, Shared.GenerateBrownNoise(Len(clean), c.Seed), c.InputSNRDb)
    let procedural = Shared.FixedWhiteKalmanFilter(observed)

    let machine = M3KalmanMachine(observed)
    while Complete(machine) == false {
        Step(machine)
    }
    let octomata = Result(machine)!
    let history = StateHistory(machine)

    let metrics = [
        M3MetricRow {
            Method: "Procedural"
            OutputSNRDb: Shared.MeasureSnrDb(clean, Shared.Sub(clean, procedural.Recovered))
            Nrmse: Shared.Nrmse(clean, procedural.Recovered)
            WhitenessCost: Shared.WhitenessCost(procedural.Innovation)
        },
        M3MetricRow {
            Method: "OctomataFlow"
            OutputSNRDb: Shared.MeasureSnrDb(clean, Shared.Sub(clean, octomata.Recovered))
            Nrmse: Shared.Nrmse(clean, octomata.Recovered)
            WhitenessCost: Shared.WhitenessCost(octomata.Innovation)
        }
    ]

    let trace = M3TraceSummary {
        RepresentationKind: "OctomataFlow"
        TickCount: Len(history)
        InitializeCount: M3CountState(history, "Initialize")
        PredictCount: M3CountState(history, "Predict")
        ObserveCount: M3CountState(history, "Observe")
        ComputeGainCount: M3CountState(history, "ComputeGain")
        CorrectCount: M3CountState(history, "Correct")
        RecordCount: M3CountState(history, "Record")
        AdvanceCount: M3CountState(history, "Advance")
        DoneCount: M3CountState(history, "Done")
        DoneReached: octomata.DoneReached
        FirstState: if Len(history) > 0 { history[0] } else { "" }
        LastState: if Len(history) > 0 { history[Len(history) - 1] } else { "" }
        SampleCount: Len(clean)
        FirstInnovation: if Len(octomata.Innovation) > 0 { octomata.Innovation[0] } else { 0.0 }
        LastInnovation: if Len(octomata.Innovation) > 0 { octomata.Innovation[Len(octomata.Innovation) - 1] } else { 0.0 }
    }

    let maxOut = M3MaxAbsDiff(procedural.Recovered, octomata.Recovered)
    let maxInnov = M3MaxAbsDiff(procedural.Innovation, octomata.Innovation)

    return M3Run {
        Case: c
        Clean: clean
        Observed: observed
        Procedural: procedural
        Octomata: octomata
        Trace: trace
        Metrics: metrics
        MaxOutputDiff: maxOut
        MaxInnovationDiff: maxInnov
    }
}

fn M3ArtifactWriteAll() -> Int {
    let run = RunM3OctomataFixedKalman(M3TinyCase())!
    let octagon = M3OctagonReport {
        title: "FM Brown-Noise Kalman M3 explicit-state representation"
        goal: "Represent fixed Kalman as explicit Octomata state machine and compare with procedural baseline on deterministic tiny case."
        representationChoice: "Real Octomata flow/state syntax used (no manual fallback)."
        stateMachine: ["Initialize", "Predict", "Observe", "ComputeGain", "Correct", "Record", "Advance", "Done"]
        trace: run.Trace
        metrics: run.Metrics
        equivalence: [
            String.Concat(["max|output_diff|=", String.From<Float>(run.MaxOutputDiff)]),
            String.Concat(["max|innovation_diff|=", String.From<Float>(run.MaxInnovationDiff)])
        ]
        limitations: ["Fixed white-noise Kalman only in M3", "No adaptive AR(1) in this pass"]
        next: "Add adaptive AR(1) explicit-state variant after fixed representation stabilizes."
    }

    var methods: String[] = []
    var outputSnrs: String[] = []
    var nrmses: String[] = []
    var whiteness: String[] = []
    for i in 0..Len(run.Metrics) {
        methods = Append(methods, run.Metrics[i].Method)
        outputSnrs = Append(outputSnrs, String.From<Float>(run.Metrics[i].OutputSNRDb))
        nrmses = Append(nrmses, String.From<Float>(run.Metrics[i].Nrmse))
        whiteness = Append(whiteness, String.From<Float>(run.Metrics[i].WhitenessCost))
    }
    let metricTable = M3MetricTable { method: methods outputSNRDb: outputSnrs nrmse: nrmses whitenessCost: whiteness }

    let doneText = if run.Trace.DoneReached { "true" } else { "false" }
    let traceKeys = ["representationKind", "doneReached", "sampleCount", "tickCount", "firstState", "lastState", "firstInnovation", "lastInnovation"]
    let traceVals = [run.Trace.RepresentationKind, doneText, String.From<Int>(run.Trace.SampleCount), String.From<Int>(run.Trace.TickCount), run.Trace.FirstState, run.Trace.LastState, String.From<Float>(run.Trace.FirstInnovation), String.From<Float>(run.Trace.LastInnovation)]

    let md = Markdown.Report([
        Markdown.Title("FM Brown-Noise Kalman M3: explicit-state / Octomata representation"),
        Markdown.Subtitle("Deterministic tiny-case equivalence against procedural baseline"),
        Markdown.Section("Experiment goal", [Markdown.Paragraph("Represent a fixed Kalman estimator as explicit state-machine phases and verify equivalence to a procedural baseline.")]),
        Markdown.Section("Representation choice", [Markdown.Callout("info", ["Real Octomata flow/state was sufficient for this experiment; manual fallback was not required."])]),
        Markdown.Section("State-machine phases", [Markdown.Bullets(["Initialize", "Predict", "Observe", "ComputeGain", "Correct", "Record", "Advance", "Done"])]),
        Markdown.Section("Equivalence metrics", [Markdown.Table(metricTable)]),
        Markdown.Section("Trace summary", [Markdown.KeyValueTable(traceKeys, traceVals)]),
        Markdown.Section("Limitations", [Markdown.Bullets(["No adaptive AR(1) in this pass", "No parameter tuning; representation/inspectability only"])]),
        Markdown.Section("Next recommendation", [Markdown.Bullets(["Add adaptive AR(1) variant with same explicit-state phases", "If needed, add compact transition histogram artifacts"] )])
    ])

    var csvRows: String[][] = [["method", "outputSNRDb", "nrmse", "whitenessCost"]]
    for i in 0..Len(run.Metrics) {
        let m = run.Metrics[i]
        csvRows = Append(csvRows, [m.Method, String.From<Float>(m.OutputSNRDb), String.From<Float>(m.Nrmse), String.From<Float>(m.WhitenessCost)])
    }

    Artifact.WriteOctagon("Experiments/FmBrownNoiseKalman/M3/m3_octomata_kalman_report.octagon", octagon )
    Artifact.WriteMarkdown("Experiments/FmBrownNoiseKalman/M3/m3_octomata_kalman_report.md", md )
    Artifact.WriteCsv("Experiments/FmBrownNoiseKalman/M3/metrics.csv", csvRows )
    Artifact.WriteJson("Experiments/FmBrownNoiseKalman/M3/metrics.json", Json.Object("{}"))
    return 0
}
