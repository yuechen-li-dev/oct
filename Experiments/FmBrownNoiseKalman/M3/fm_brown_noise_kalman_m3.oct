package FmBrownNoiseKalman

import Shared
import String
import Artifact
import Markdown
import Json

record M3Case {
    SampleRate: Float
    Duration: Float
    MessageHz: Float
    InputSNRDb: Float
    Seed: Int
}

record M3StateMachineResult {
    Recovered: Float[]
    Innovation: Float[]
    DoneReached: Bool
}

record M3TraceSummary {
    RepresentationKind: String
    TickCount: Int
    InitializeCount: Int
    PredictCount: Int
    ObserveCount: Int
    ComputeGainCount: Int
    CorrectCount: Int
    RecordCount: Int
    AdvanceCount: Int
    DoneCount: Int
    DoneReached: Bool
    FirstState: String
    LastState: String
    SampleCount: Int
    RecoveredCount: Int
    InnovationCount: Int
    FirstRecovered: Float
    LastRecovered: Float
    FirstInnovation: Float
    LastInnovation: Float
}

record M3MetricRow {
    Method: String
    OutputSNRDb: Float
    Nrmse: Float
    WhitenessCost: Float
    Correlation: Float
}

record M3Run {
    Case: M3Case
    Clean: Float[]
    Observed: Float[]
    Procedural: Shared.KalmanResult
    Octomata: M3StateMachineResult
    Trace: M3TraceSummary
    Metrics: M3MetricRow[]
    MaxOutputDiff: Float
    MaxInnovationDiff: Float
    ToleranceUsed: Float
}

flow M3KalmanMachine(observed: Float[]) -> Bool {
    board {
        Index: Int
        SampleCount: Int
        Measurement: Float
        Estimate: Float
        Velocity: Float
        Covariance: Float
        VelocityCovariance: Float
        PredictedEstimate: Float
        PredictedVelocity: Float
        PredictedCovariance: Float
        PredictedVelocityCovariance: Float
        Innovation: Float
        Gain: Float
        VelocityGain: Float
        RecoveredCurrent: Float
        RecordReady: Bool
        DoneFlag: Bool
    }

    state Initialize {
        board.Index = 0
        board.SampleCount = Len(observed)
        board.Measurement = 0.0
        board.Estimate = 0.0
        board.Velocity = 0.0
        board.Covariance = 1.0
        board.VelocityCovariance = 1.0
        board.PredictedEstimate = 0.0
        board.PredictedVelocity = 0.0
        board.PredictedCovariance = 1.0
        board.PredictedVelocityCovariance = 1.0
        board.Innovation = 0.0
        board.Gain = 0.0
        board.VelocityGain = 0.0
        board.RecoveredCurrent = 0.0
        board.RecordReady = false
        board.DoneFlag = false
        goto Predict
    }

    state Predict {
        board.RecordReady = false
        when {
            case board.Index >= board.SampleCount -> goto Done
            else -> goto Observe
        }
    }

    state Observe {
        board.Measurement = observed[board.Index]
        board.PredictedEstimate = board.Estimate + board.Velocity
        board.PredictedVelocity = board.Velocity
        board.PredictedCovariance = board.Covariance + board.VelocityCovariance + 1e-3
        board.PredictedVelocityCovariance = board.VelocityCovariance + 1e-2
        goto ComputeGain
    }

    state ComputeGain {
        board.Innovation = board.Measurement - board.PredictedEstimate
        let s = board.PredictedCovariance + 0.1 + 1.0
        board.Gain = board.PredictedCovariance / s
        board.VelocityGain = board.PredictedVelocityCovariance / s
        goto Correct
    }

    state Correct {
        board.Estimate = board.PredictedEstimate + board.Gain * board.Innovation
        board.Velocity = board.PredictedVelocity + board.VelocityGain * board.Innovation
        board.Covariance = (1.0 - board.Gain) * board.PredictedCovariance
        board.VelocityCovariance = (1.0 - board.VelocityGain) * board.PredictedVelocityCovariance
        goto Record
    }

    state Record {
        board.RecoveredCurrent = board.Estimate
        board.RecordReady = true
        goto Advance
    }

    state Advance {
        board.Index = board.Index + 1
        suspend
        goto Predict
    }

    state Done {
        board.DoneFlag = true
        return true
    }
}

fn M3TinyCase() -> M3Case {
    return M3Case { SampleRate: 2000.0 Duration: 0.5 MessageHz: 25.0 InputSNRDb: -12.0 Seed: 12345 }
}

fn M3SampleCount(c: M3Case) -> Int {
    return FloorToInt(c.SampleRate * c.Duration)
}

fn M3BuildClean(c: M3Case) -> Float[] {
    let n = M3SampleCount(c)
    var clean: Float[] = []
    var x = 0.0
    let dx = 1.0 / c.SampleRate
    for i in 0..n {
        clean = Append(clean, Sin(2.0 * Pi() * c.MessageHz * x))
        x = x + dx
    }
    return Shared.NormalizeRms(Shared.RemoveMean(clean), 1.0)
}

fn M3CountState(history: String[], stateName: String) -> Int {
    var count = 0
    for i in 0..Len(history) {
        if history[i] == stateName { count = count + 1 }
    }
    return count
}

fn M3MaxAbsDiff(a: Float[], b: Float[]) -> Float {
    var max = 0.0
    for i in 0..Len(a) {
        let d = Abs(a[i] - b[i])
        if d > max { max = d }
    }
    return max
}

fn RunM3OctomataFixedKalman(c: M3Case) -> M3Run ! Error {
    let clean = M3BuildClean(c)
    let observed = Shared.AddNoiseAtSnr(clean, Shared.GenerateBrownNoise(Len(clean), c.Seed), c.InputSNRDb)
    let procedural = Shared.FixedWhiteKalmanFilter(observed)

    let machine = M3KalmanMachine(observed)
    var recovered: Float[] = []
    var innovation: Float[] = []

    while Complete(machine) == false {
        Step(machine)
        let snap = BoardSnapshot(machine)!
        if snap.RecordReady {
            recovered = Append(recovered, snap.RecoveredCurrent)
            innovation = Append(innovation, snap.Innovation)
        }
    }

    let _ = Result(machine)!
    let history = StateHistory(machine)
    let finalSnap = BoardSnapshot(machine)!

    let octomata = M3StateMachineResult {
        Recovered: recovered
        Innovation: innovation
        DoneReached: finalSnap.DoneFlag
    }

    let metrics = [
        M3MetricRow {
            Method: "Procedural"
            OutputSNRDb: Shared.MeasureSnrDb(clean, Shared.Sub(clean, procedural.Recovered))
            Nrmse: Shared.Nrmse(clean, procedural.Recovered)
            WhitenessCost: Shared.WhitenessCost(procedural.Innovation)
            Correlation: Shared.Correlation(clean, procedural.Recovered)
        },
        M3MetricRow {
            Method: "OctomataFlow"
            OutputSNRDb: Shared.MeasureSnrDb(clean, Shared.Sub(clean, octomata.Recovered))
            Nrmse: Shared.Nrmse(clean, octomata.Recovered)
            WhitenessCost: Shared.WhitenessCost(octomata.Innovation)
            Correlation: Shared.Correlation(clean, octomata.Recovered)
        }
    ]

    let trace = M3TraceSummary {
        RepresentationKind: "RealOctomataScalarBoardWithBoardSnapshot"
        TickCount: Len(history)
        InitializeCount: M3CountState(history, "Initialize")
        PredictCount: M3CountState(history, "Predict")
        ObserveCount: M3CountState(history, "Observe")
        ComputeGainCount: M3CountState(history, "ComputeGain")
        CorrectCount: M3CountState(history, "Correct")
        RecordCount: M3CountState(history, "Record")
        AdvanceCount: M3CountState(history, "Advance")
        DoneCount: M3CountState(history, "Done")
        DoneReached: octomata.DoneReached
        FirstState: if Len(history) > 0 { history[0] } else { "" }
        LastState: if Len(history) > 0 { history[Len(history) - 1] } else { "" }
        SampleCount: Len(clean)
        RecoveredCount: Len(octomata.Recovered)
        InnovationCount: Len(octomata.Innovation)
        FirstRecovered: if Len(octomata.Recovered) > 0 { octomata.Recovered[0] } else { 0.0 }
        LastRecovered: if Len(octomata.Recovered) > 0 { octomata.Recovered[Len(octomata.Recovered) - 1] } else { 0.0 }
        FirstInnovation: if Len(octomata.Innovation) > 0 { octomata.Innovation[0] } else { 0.0 }
        LastInnovation: if Len(octomata.Innovation) > 0 { octomata.Innovation[Len(octomata.Innovation) - 1] } else { 0.0 }
    }

    let tolerance = 1e-9

    return M3Run {
        Case: c
        Clean: clean
        Observed: observed
        Procedural: procedural
        Octomata: octomata
        Trace: trace
        Metrics: metrics
        MaxOutputDiff: M3MaxAbsDiff(procedural.Recovered, octomata.Recovered)
        MaxInnovationDiff: M3MaxAbsDiff(procedural.Innovation, octomata.Innovation)
        ToleranceUsed: tolerance
    }
}

fn M3ArtifactWriteAll() -> Int {
    let run = RunM3OctomataFixedKalman(M3TinyCase())!

    let report = Markdown.Report([
        Markdown.Title("FM Brown-Noise Kalman M3"),
        Markdown.Subtitle("Real Octomata scalar-board Kalman representation using BoardSnapshot"),
        Markdown.Section("Goal", [Markdown.KeyValueTable(["goal"], ["Can a Kalman-style estimator loop be expressed as explicit Octomata flow states while matching a procedural baseline on a deterministic tiny case?"])]),
        Markdown.Section("Representation", [Markdown.KeyValueTable(["representation", "boardObservation", "arraysPlacement", "compiledBoardSnapshot"], [run.Trace.RepresentationKind, "BoardSnapshot(machine)! read-only observation", "Recovered/innovation arrays are external accumulators", "Supported: interpreted+compiled for M0 scalar-board fields"]) ]),
        Markdown.Section("State-machine phases", [Markdown.Bullets(["Initialize", "Predict", "Observe", "ComputeGain", "Correct", "Record", "Advance", "Done"])]),
        Markdown.Section("Equivalence metrics", [Markdown.KeyValueTable(["tolerance", "maxRecoveredAbsDiff", "maxInnovationAbsDiff"], [String.From<Float>(run.ToleranceUsed), String.From<Float>(run.MaxOutputDiff), String.From<Float>(run.MaxInnovationDiff)])]),
        Markdown.Section("Trace summary", [Markdown.KeyValueTable(["doneReached", "sampleCount", "tickCount", "recoveredCount", "innovationCount", "firstState", "lastState", "firstRecovered", "lastRecovered", "firstInnovation", "lastInnovation"], [ToString(run.Trace.DoneReached), String.From<Int>(run.Trace.SampleCount), String.From<Int>(run.Trace.TickCount), String.From<Int>(run.Trace.RecoveredCount), String.From<Int>(run.Trace.InnovationCount), run.Trace.FirstState, run.Trace.LastState, String.From<Float>(run.Trace.FirstRecovered), String.From<Float>(run.Trace.LastRecovered), String.From<Float>(run.Trace.FirstInnovation), String.From<Float>(run.Trace.LastInnovation)])]),
        Markdown.Section("Limitations", [Markdown.Callout("note", ["Fixed white-Kalman baseline only in M3 first pass.", "Tiny deterministic direct-message equivalence case only.", "No adaptive AR(1) variant yet.", "No real carrier/IQ/FM receiver path in M3.", "No real audio pipeline in M3.", "No board arrays were used by design (arrays remain unsupported on board fields)."])]),
        Markdown.Section("Recommendation", [Markdown.KeyValueTable(["next"], ["Add adaptive AR(1) Octomata variant reusing this scalar-board + BoardSnapshot architecture (compiled-supported for scalar board fields)."])])
    ])

    Artifact.WriteOctagon("Experiments/FmBrownNoiseKalman/M3/m3_octomata_kalman_report.octagon", run)
    Artifact.WriteMarkdown("Experiments/FmBrownNoiseKalman/M3/m3_octomata_kalman_report.md", report)
    Artifact.WriteCsv("Experiments/FmBrownNoiseKalman/M3/metrics.csv", [["method", "outputSNRDb", "nrmse", "whitenessCost", "correlation"], [run.Metrics[0].Method, String.From<Float>(run.Metrics[0].OutputSNRDb), String.From<Float>(run.Metrics[0].Nrmse), String.From<Float>(run.Metrics[0].WhitenessCost), String.From<Float>(run.Metrics[0].Correlation)], [run.Metrics[1].Method, String.From<Float>(run.Metrics[1].OutputSNRDb), String.From<Float>(run.Metrics[1].Nrmse), String.From<Float>(run.Metrics[1].WhitenessCost), String.From<Float>(run.Metrics[1].Correlation)]])
    Artifact.WriteJson("Experiments/FmBrownNoiseKalman/M3/metrics.json", Json.Object(String.Concat(["{\"tolerance\":", String.From<Float>(run.ToleranceUsed), ",\"maxOutputDiff\":", String.From<Float>(run.MaxOutputDiff), ",\"maxInnovationDiff\":", String.From<Float>(run.MaxInnovationDiff), "}"])))
    return 0
}
