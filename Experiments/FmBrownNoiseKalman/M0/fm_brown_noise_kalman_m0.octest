package FmBrownNoiseKalman

[Fact]
fn M0aBrownNoisePsdSlopeSanity() -> Void {
    let n = 2048
    let b = GenerateBrownNoise(n, 12345)
    var x: Float[] = []
    var y: Float[] = []
    for k in 8..160 {
        let p = BandPower(b, k)
        x = Append(x, Log10(Float(k)))
        y = Append(y, Log10(p + 1e-12))
    }
    let slope = LinearSlope(x, y)
    Print("M0a slope=" + ToString(slope))
    Assert.True(slope <= -1.6 and slope >= -2.4, "brown noise PSD slope should be in [-2.4,-1.6]")
}

[Fact]
fn M0bTinySnrCalibration() -> Void {
    let n = 1000
    var clean: Float[] = []
    for i in 0..n {
        clean = Append(clean, Sin(2.0 * Pi() * 25.0 * Float(i) / 2000.0))
    }
    let noise = GenerateBrownNoise(n, 12345)
    let noisy = AddNoiseAtSnr(clean, noise, -12.0)
    let measured = MeasureSnrDb(clean, Sub(noisy, clean))
    Print("M0b snr=" + ToString(measured))
    Assert.True(Abs(measured + 12.0) <= 0.25, "SNR calibration must be within 0.25 dB")
}

[Fact]
fn M0cTinyFmRoundtripNoNoise() -> Void {
    let sampleRate = 2000.0
    let duration = 0.5
    let n = FloorToInt(sampleRate * duration)

    var clean: Float[] = []
    for i in 0..n {
        let t = Float(i) / sampleRate
        clean = Append(clean, Sin(2.0 * Pi() * 25.0 * t))
    }

    let fm = FmModulate(clean, sampleRate, 250.0, 50.0)
    let demod = FmDemodulate(fm, sampleRate)

    let trim = 128
    let cw = NormalizeRms(RemoveMean(Window(clean, trim, n - trim)), 1.0)
    let dw = NormalizeRms(RemoveMean(Window(demod, trim, n - trim)), 1.0)
    let c = Correlation(cw, dw)
    let e = Nrmse(cw, dw)
    Print("M0c corr=" + ToString(c) + " nrmse=" + ToString(e))

    Assert.True(c > 0.99, "FM no-noise round trip correlation should exceed 0.99")
    Assert.True(e < 0.10, "FM no-noise round trip NRMSE should stay below 0.10")
}

[Fact]
fn M0dTinyDirectMessageBrownNoiseFiltering() -> Void {
    let n = 1000
    var clean: Float[] = []
    for i in 0..n {
        clean = Append(clean, Sin(2.0 * Pi() * 25.0 * Float(i) / 2000.0))
    }
    let noisy = AddNoiseAtSnr(clean, GenerateBrownNoise(n, 12345), -12.0)
    let fixed = FixedWhiteKalmanFilter(noisy)
    let adaptive = AdaptiveAr1ColoredNoiseKalmanFilter(noisy)
    let fixedN = Nrmse(clean, fixed.Recovered)
    let adaptiveN = Nrmse(clean, adaptive.Recovered)
    Print("M0d fixedN=" + ToString(fixedN) + " adaptiveN=" + ToString(adaptiveN))
    Assert.True(fixedN >= 0.0 and adaptiveN >= 0.0, "tiny direct filtering should complete")
}

fn BandPower(x: Float[], k: Int) -> Float {
    var re = 0.0
    var im = 0.0
    let n = Float(Len(x))
    for i in 0..Len(x) {
        let a = 2.0 * Pi() * Float(k) * Float(i) / n
        re = re + x[i] * Cos(a)
        im = im - x[i] * Sin(a)
    }
    return (re * re + im * im) / n
}

fn LinearSlope(x: Float[], y: Float[]) -> Float {
    let mx = Mean(x)
    let my = Mean(y)
    var num = 0.0
    var den = 0.0
    for i in 0..Len(x) {
        num = num + (x[i] - mx) * (y[i] - my)
        den = den + (x[i] - mx) * (x[i] - mx)
    }
    return num / (den + 1e-12)
}

fn Window(x: Float[], start: Int, endExclusive: Int) -> Float[] {
    var out: Float[] = []
    for i in start..endExclusive {
        out = Append(out, x[i])
    }
    return out
}

record MetricArtifactRow {
    Method: String
    OutputSNRDb: Float
    Nrmse: Float
    Correlation: Float
    WhitenessCost: Float
    FinalA: Float
}

record RecoveredSignalRow {
    Time: Float
    CleanMessage: Float
    NoisyDemodulated: Float
    Lowpass: Float
    FixedKF: Float
    AdaptiveKF: Float
}

record InnovationRow {
    FixedKFInnovation: Float
    AdaptiveKFInnovation: Float
}

[Artifact]
fn M0ArtifactMetricsOctagon() -> Void {
    let r = RunM0ExperimentTiny()
    var rows: MetricArtifactRow[] = []
    for i in 0..Len(r.Metrics) {
        let m = r.Metrics[i]
        rows = Append(rows, MetricArtifactRow { Method: m.Method OutputSNRDb: m.OutputSNRDb Nrmse: m.Nrmse Correlation: m.Correlation WhitenessCost: m.WhitenessCost FinalA: m.FinalA })
    }
    let _ = WriteOctagon("Experiments/FmBrownNoiseKalman/M0/m0_metrics.octagon", rows)
}

[Artifact]
fn M0ArtifactRecoveredSignalsOctagon() -> Void {
    let r = RunM0ExperimentTiny()
    let n = if Len(r.CleanMessage) < 1000 { Len(r.CleanMessage) } else { 1000 }
    var rows: RecoveredSignalRow[] = []
    for i in 0..n {
        rows = Append(rows, RecoveredSignalRow { Time: Float(i) / 2000.0 CleanMessage: r.CleanMessage[i] NoisyDemodulated: r.NoisyDemodulated[i] Lowpass: r.Lowpass[i] FixedKF: r.FixedKF[i] AdaptiveKF: r.AdaptiveKF[i] })
    }
    let _ = WriteOctagon("Experiments/FmBrownNoiseKalman/M0/m0_recovered_signals.octagon", rows)
}

[Artifact]
fn M0ArtifactInnovationsOctagon() -> Void {
    let r = RunM0ExperimentTiny()
    let n = if Len(r.FixedInnovation) < 1000 { Len(r.FixedInnovation) } else { 1000 }
    var rows: InnovationRow[] = []
    for i in 0..n {
        rows = Append(rows, InnovationRow { FixedKFInnovation: r.FixedInnovation[i] AdaptiveKFInnovation: r.AdaptiveInnovation[i] })
    }
    let _ = WriteOctagon("Experiments/FmBrownNoiseKalman/M0/m0_innovations.octagon", rows)
}


