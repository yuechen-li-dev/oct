package FmBrownNoiseKalman

[Fact]
fn M0aBrownNoisePsdSlopeSanity() -> Void {
    let n = 4000
    let b = GenerateBrownNoise(n, 12345)
    var x: Float[] = []
    var y: Float[] = []
    for k in 1..81 {
        let f = Float(k)
        let p = BandPower(b, k)
        x = Append(x, Log10(f))
        y = Append(y, Log10(p + 1e-12))
    }
    let slope = LinearSlope(x, y)
    Assert.True(slope <= -1.6 and slope >= -2.4, "brown noise PSD slope should be in [-2.4,-1.6]")
}

[Fact]
fn M0bSnrCalibration() -> Void {
    let n = 4000
    var clean: Float[] = []
    for i in 0..n { clean = Append(clean, Sin(2.0 * Pi() * 100.0 * Float(i) / 8000.0)) }
    let noise = GenerateBrownNoise(n, 12345)
    let noisy = AddNoiseAtSnr(clean, noise, -12.0)
    let measured = MeasureSnrDb(clean, Sub(noisy, clean))
    Assert.True(Abs(measured + 12.0) <= 0.25, "SNR calibration must be within 0.25 dB")
}

[Fact]
fn M0cFmRoundtripNoNoise() -> Void {
    let n = 4000
    var clean: Float[] = []
    for i in 0..n { clean = Append(clean, Sin(2.0 * Pi() * 100.0 * Float(i) / 8000.0)) }
    let fm = FmModulate(clean, 8000.0, 1000.0, 250.0)
    let demod = FmDemodulate(fm, 8000.0)
    let c = Correlation(clean, demod)
    Assert.True(c > 0.99, "FM no-noise round trip correlation should exceed 0.99")
}

[Fact]
fn M0dDirectMessageBrownNoiseFiltering() -> Void {
    let n = 4000
    var clean: Float[] = []
    for i in 0..n { clean = Append(clean, Sin(2.0 * Pi() * 100.0 * Float(i) / 8000.0)) }
    let noisy = AddNoiseAtSnr(clean, GenerateBrownNoise(n, 12345), -12.0)
    let fixed = FixedWhiteKalmanFilter(noisy)
    let adaptive = AdaptiveAr1ColoredNoiseKalmanFilter(noisy)
    let fixedN = Nrmse(clean, fixed.Recovered)
    let adaptiveN = Nrmse(clean, adaptive.Recovered)
    Assert.True(adaptiveN <= fixedN, "adaptive should not be worse than fixed on direct noisy message")
}

[Fact]
fn M0eFullFmBrownNoiseComparison() -> Void ! Error {
    let r = RunM0Experiment()
    let fixed = r.Metrics[2]
    let adaptive = r.Metrics[3]
    Assert.True(adaptive.OutputSNRDb >= fixed.OutputSNRDb + 2.0, "adaptive SNR must beat fixed by >= 2 dB")
    Assert.True(adaptive.Nrmse <= fixed.Nrmse * 0.85, "adaptive NRMSE must be <= 0.85x fixed")
    Assert.True(adaptive.WhitenessCost <= fixed.WhitenessCost * 0.5, "adaptive whiteness cost must be <= 0.5x fixed")
    Assert.True(adaptive.FinalA >= 0.75, "adaptive learned a must be >= 0.75")
}

fn BandPower(x: Float[], k: Int) -> Float {
    var re = 0.0
    var im = 0.0
    let n = Float(Len(x))
    for i in 0..Len(x) {
        let a = 2.0 * Pi() * Float(k) * Float(i) / n
        re = re + x[i] * Cos(a)
        im = im - x[i] * Sin(a)
    }
    return (re * re + im * im) / n
}

fn LinearSlope(x: Float[], y: Float[]) -> Float {
    let mx = Mean(x)
    let my = Mean(y)
    var num = 0.0
    var den = 0.0
    for i in 0..Len(x) { num = num + (x[i] - mx) * (y[i] - my)
    den = den + (x[i] - mx) * (x[i] - mx) }
    return num / (den + 1e-12)
}


record MetricArtifactRow {
    Method: String
    OutputSNRDb: Float
    Nrmse: Float
    Correlation: Float
    WhitenessCost: Float
    FinalA: Float
}

record RecoveredSignalRow {
    Time: Float
    CleanMessage: Float
    NoisyDemodulated: Float
    Lowpass: Float
    FixedKF: Float
    AdaptiveKF: Float
}

record InnovationRow {
    FixedKFInnovation: Float
    AdaptiveKFInnovation: Float
}

[Artifact]
fn M0ArtifactMetricsOctagon() -> Void ! Error {
    let r = RunM0Experiment()
    var rows: MetricArtifactRow[] = []
    for i in 0..Len(r.Metrics) {
        let m = r.Metrics[i]
        rows = Append(rows, MetricArtifactRow {
            Method: m.Method
            OutputSNRDb: m.OutputSNRDb
            Nrmse: m.Nrmse
            Correlation: m.Correlation
            WhitenessCost: m.WhitenessCost
            FinalA: m.FinalA
        })
    }
    let _ = WriteOctagon("Experiments/FmBrownNoiseKalman/M0/m0_metrics.octagon", rows)
}

[Artifact]
fn M0ArtifactRecoveredSignalsOctagon() -> Void ! Error {
    let r = RunM0Experiment()
    let n = Len(r.CleanMessage)
    var rows: RecoveredSignalRow[] = []
    for i in 0..n {
        rows = Append(rows, RecoveredSignalRow {
            Time: Float(i) / 8000.0
            CleanMessage: r.CleanMessage[i]
            NoisyDemodulated: r.NoisyDemodulated[i]
            Lowpass: r.Lowpass[i]
            FixedKF: r.FixedKF[i]
            AdaptiveKF: r.AdaptiveKF[i]
        })
    }
    let _ = WriteOctagon("Experiments/FmBrownNoiseKalman/M0/m0_recovered_signals.octagon", rows)
}

[Artifact]
fn M0ArtifactInnovationsOctagon() -> Void ! Error {
    let r = RunM0Experiment()
    var rows: InnovationRow[] = []
    for i in 0..Len(r.FixedInnovation) {
        rows = Append(rows, InnovationRow { FixedKFInnovation: r.FixedInnovation[i] AdaptiveKFInnovation: r.AdaptiveInnovation[i] })
    }
    let _ = WriteOctagon("Experiments/FmBrownNoiseKalman/M0/m0_innovations.octagon", rows)
}
