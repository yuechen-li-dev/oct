package Manifest

record PackageManifest {
    Name: String
    Version: String
    Description: String
    Dependencies: Dependency[]
}

record Dependency {
    Name: String
    VersionRequirement: String
}

fn Manifest() -> PackageManifest {
    return PackageManifest {
        Name: "MechanicsShaftDesignProbe"
        Version: "0.1.0"
        Description: "Compact deterministic shaft design probe using Mechanics M0 through M2"
        Dependencies: [
            Dependency { Name: "OctStd" VersionRequirement: "0.1.0" },
            Dependency { Name: "Mechanics" VersionRequirement: "0.6.0" }
        ]
    }
}
