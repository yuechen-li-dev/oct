package OctErgonomicsLabM1

import String
import IO

[Suite("Experiments.OctErgonomicsLab.M1")]
[Suite("Experiments.OctErgonomicsLab.M1.FlowSmoke")]
[Fact]
fn RealOctomataScalarBoardRunsAndHistoryIsStateNamesOnly() -> Void {
    let result = RunRealOctomataProbe()
    Assert.True(result.DoneReached, "real probe flow should complete")
    Assert.Equal("ScalarBoardOctomataWithExternalAccumulators", result.Representation, "probe should use scalar board snapshots")
    Assert.Equal("", result.MissingSurface, "surface is now available")
    Assert.True(Len(result.Recovered) > 0, "real probe should accumulate recovered values")
    Assert.True(result.HistoryCount > 0, "state history should still be available")
}

[Suite("Experiments.OctErgonomicsLab.M1")]
[Suite("Experiments.OctErgonomicsLab.M1.FlowSmoke")]
[Fact]
fn ManualFallbackAccumulatesPerStepArrays() -> Void {
    let result = RunManualExplicitStateLoopFallback()
    Assert.Equal("ManualExplicitStateLoopFallback", result.Representation, "fallback label must be explicit")
    Assert.True(result.DoneReached, "fallback should reach done")
    Assert.Equal(3, Len(result.Recovered), "recovered length should match sample count")
    Assert.Equal(3, Len(result.Innovations), "innovation length should match sample count")
}

[Suite("Experiments.OctErgonomicsLab.M1")]
[Suite("Experiments.OctErgonomicsLab.M1.FlowSmoke")]
[Fact]
fn ResultBangOnlyAfterCompletionInRealFlow() -> Void {
    let machine = ScalarBoardProbe([1.0, 2.0, 3.0])
    while Complete(machine) == false {
        Step(machine)
    }
    let value = Result(machine)!
    Assert.True(value > 0.0, "result bang should be used only after completion")
}

[Suite("Experiments.OctErgonomicsLab.M1")]
[Suite("Experiments.OctErgonomicsLab.M1.Artifacts")]
[Artifact]
fn ArtifactM1Probe() -> Void {
    GenerateM1Artifacts()
}
