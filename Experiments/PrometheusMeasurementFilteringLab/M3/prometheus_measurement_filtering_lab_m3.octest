package PrometheusMeasurementFilteringLab

[Fact]
fn M3Reproducibility() -> Void {
    let a = M3ScoreMatrix(1337, 96)
    let b = M3ScoreMatrix(1337, 96)
    Assert.Equal(Len(a), Len(b), "same seed score length")
    Assert.True(a[0].CompositeScore == b[0].CompositeScore, "deterministic ranking inputs")
}

[Fact]
fn M3FilterOutputLength() -> Void {
    let regimes = M3Regimes()
    let candidates = M3Candidates()

    for ri in 0..Len(regimes) {
        let series = M3GenerateSeries(700 + ri, 80, regimes[ri])
        for ci in 0..Len(candidates) {
            let output = M3ApplyCandidate(candidates[ci], series.Measurements)
            Assert.Equal(Len(output), Len(series.Measurements), "one output per input")
        }
    }
}

[Fact]
fn M3EmaConstantInputStable() -> Void {
    let xs = [10.0, 10.0, 10.0, 10.0, 10.0]
    let ema = M3ApplyCandidate(
        M3Candidate {
            Name: "ema-0.2"
            Kind: "ema"
            ParamA: 0.2
            ParamB: 0.0
            Complexity: 1
            DiagnosticValue: 3
        },
        xs
    )
    Assert.True(Abs(ema[4] - 10.0) < 0.0001, "ema holds constant input")
}

[Fact]
fn M3MedianSuppressesSpike() -> Void {
    let x = [10.0, 10.0, 10.0, 20.0, 10.0, 10.0]
    let median = M3ApplyCandidate(
        M3Candidate {
            Name: "median-3"
            Kind: "median"
            ParamA: 3.0
            ParamB: 0.0
            Complexity: 2
            DiagnosticValue: 4
        },
        x
    )
    Assert.True(Abs(median[3] - 10.0) < Abs(x[3] - 10.0), "median suppresses isolated spike")
}

[Fact]
fn M3HysteresisHoldBehavior() -> Void {
    let x = [10.0, 10.03, 10.04, 10.12]
    let hysteresis = M3ApplyCandidate(
        M3Candidate {
            Name: "hysteresis-0.05"
            Kind: "hysteresis"
            ParamA: 0.05
            ParamB: 0.0
            Complexity: 1
            DiagnosticValue: 5
        },
        x
    )
    Assert.True(hysteresis[1] == hysteresis[0] and hysteresis[2] == hysteresis[0], "inside-band values hold")
}

[Fact]
fn M3HybridNonDegenerateBounded() -> Void {
    let series = M3GenerateSeries(999, 96, M3Regimes()[5])
    let output = M3ApplyCandidate(
        M3Candidate {
            Name: "hybrid-median5-ema02"
            Kind: "hybrid-medema"
            ParamA: 5.0
            ParamB: 0.2
            Complexity: 4
            DiagnosticValue: 5
        },
        series.Measurements
    )
    Assert.True(M3MeanAbsStep(output) > 0.0, "hybrid output non-degenerate")
    Assert.True(Abs(output[95] - series.TrueValues[95]) < 4.0, "hybrid bounded near truth")
}

[Fact]
fn M3DominationFixtureOrReal() -> Void {
    let dominated = M3DominatedCandidates(M3ScoreMatrix(1337, 96))
    Assert.True(Len(dominated) > 0, "domination logic should detect at least one dominated candidate")
}

[Fact]
fn M3SelectedSetDeterministic() -> Void {
    let selected1 = M3SelectedImplementationSet(M3ScoreMatrix(1337, 96))
    let selected2 = M3SelectedImplementationSet(M3ScoreMatrix(1337, 96))
    Assert.Equal(Len(selected1), Len(selected2), "same selected set length")
    Assert.True(selected1[0] == selected2[0], "deterministic selected set")
}

[Artifact]
fn EmitM3ParameterRakeScores() -> Void {
    let _ = WriteOctagon("Experiments/PrometheusMeasurementFilteringLab/M3/m3_parameter_rake_scores.octagon", M3ScoreMatrix(1337, 96))
}

[Artifact]
fn EmitM3FilterContracts() -> Void {
    let _ = WriteOctagon("Experiments/PrometheusMeasurementFilteringLab/M3/m3_filter_contracts.octagon", M3Contracts())
}

[Artifact]
fn EmitM3SelectedImplementationSet() -> Void {
    let scores = M3ScoreMatrix(1337, 96)
    let selected = M3SelectedImplementationSet(scores)
    let _ = WriteOctagon("Experiments/PrometheusMeasurementFilteringLab/M3/m3_selected_implementation_set.octagon", selected)
}

[Artifact]
fn EmitM3DominatedFilters() -> Void {
    let scores = M3ScoreMatrix(1337, 96)
    let dominated = M3DominatedCandidates(scores)
    let _ = WriteOctagon("Experiments/PrometheusMeasurementFilteringLab/M3/m3_dominated_filters.octagon", dominated)
}

[Artifact]
fn EmitM3FinalRecommendation() -> Void {
    let scores = M3ScoreMatrix(1337, 96)
    let selected = M3SelectedImplementationSet(scores)
    let _ = WriteOctagon("Experiments/PrometheusMeasurementFilteringLab/M3/m3_final_recommendation.octagon", selected)
}
