[M3Contract {
    Name: "EMA"
    StateFields: "initialized, estimate, sample_count"
    Params: "alpha in {0.1,0.2,0.4,0.6}"
    InitBehavior: "first sample seeds estimate"
    UpdateBehavior: "estimate=alpha*x+(1-alpha)*estimate"
    ResetBehavior: "clear initialized/estimate/count"
    Diagnostics: "estimate,residual,sample_count,stability,confidence proxy"
    JudgmentWhen: "stable/moderate jitter and drift with low spike rate"
    Weaknesses: "spike sensitivity unless alpha is small"
}, M3Contract {
    Name: "SlidingMedian"
    StateFields: "window buffer,count,index"
    Params: "window in {3,5,9}"
    InitBehavior: "partial window until full"
    UpdateBehavior: "insert sample then median(window)"
    ResetBehavior: "clear buffer,index,count"
    Diagnostics: "estimate,window_count,residual,outlier suppression proxy"
    JudgmentWhen: "spike-heavy and mixed-hostile data"
    Weaknesses: "lag and buffer maintenance"
}, M3Contract {
    Name: "TrimmedMean"
    StateFields: "window buffer,count,index"
    Params: "(5,1),(9,1),(9,2)"
    InitBehavior: "partial window until full"
    UpdateBehavior: "sort, trim tails, average interior"
    ResetBehavior: "clear buffer,index,count"
    Diagnostics: "estimate,trimmed_count,residual,outlier suppression proxy"
    JudgmentWhen: "moderate spikes with smoother response preference"
    Weaknesses: "sorting and trim complexity"
}, M3Contract {
    Name: "HysteresisDeadband"
    StateFields: "initialized,estimate,last_update_tick,update_count"
    Params: "band in {0.05,0.10,0.20}"
    InitBehavior: "first sample seeds estimate"
    UpdateBehavior: "update only when |measurement-estimate| > band"
    ResetBehavior: "clear initialized and counters"
    Diagnostics: "estimate,update_count,hold_count,residual"
    JudgmentWhen: "stable signals where hold behavior is preferred"
    Weaknesses: "can mask slow drift and small real transitions"
}, M3Contract {
    Name: "HybridMedianEmaAndRejectEma"
    StateFields: "stage1 state + ema state"
    Params: "median3/5+ema0.2 and reject{1,2}+ema0.2"
    InitBehavior: "initialize stage1 then ema"
    UpdateBehavior: "stage1 denoise then ema"
    ResetBehavior: "clear both stage states"
    Diagnostics: "residual,outlier_count,stage outputs,sample_count"
    JudgmentWhen: "mixed-hostile regimes with spikes+jitter"
    Weaknesses: "highest implementation complexity"
}]
