package PrometheusMeasurementFilteringLab

[Fact]
fn M2UniformBounds() -> Void {
    let xs = M2CollectFloat01(1337, 2000)
    for i in 0..Len(xs) {
        Assert.True(xs[i] >= 0.0, "RandFloat01 lower bound")
        Assert.True(xs[i] < 1.0, "RandFloat01 upper bound")
    }
}

[Fact]
fn M2BernoulliExtremes() -> Void {
    let allFalse = M2BernoulliSummary(1500, 1000, 0.0)
    let allTrue = M2BernoulliSummary(1501, 1000, 1.0)
    Assert.Equal(0, allFalse.TrueCount, "p=0 should produce only false")
    Assert.Equal(1000, allTrue.TrueCount, "p=1 should produce only true")
}

[Fact]
fn M2BernoulliProbabilitySanity() -> Void {
    let s = M2BernoulliSummary(1502, 2000, 0.5)
    Assert.True(s.ObservedProbability >= 0.40 and s.ObservedProbability <= 0.60, "p=0.5 must be in broad sanity band")
}

[Fact]
fn M2NormalSanity() -> Void {
    let xs = M2CollectNormal(1600, 3000, 0.0, 1.0)
    let s = M2Summarize(xs)
    Assert.True(s.Mean >= -0.2 and s.Mean <= 0.2, "normal mean sanity")
    Assert.True(s.Variance >= 0.5 and s.Variance <= 1.5, "normal variance sanity")
    Assert.True(s.CountPositive > 0 and s.CountNegative > 0, "normal should have both signs")
}

[Fact]
fn M2SpikeSanity() -> Void {
    let s = M2SpikeSummary(1700, 2000, 0.1, 4.0)
    Assert.True(s.ObservedSpikeProbability >= 0.03 and s.ObservedSpikeProbability <= 0.20, "spike probability broad sanity")
    Assert.True(s.PositiveSpikeCount > 0 and s.NegativeSpikeCount > 0, "spike signs should both occur")
}

[Fact]
fn M2StateThreading() -> Void {
    let s = M2StateThreadingSummary()
    Assert.True(s.SameSeedMatch, "same seed must match")
    Assert.True(s.DifferentSeedDiffers, "different seed should differ")
    Assert.True(s.OldStateRepeatWorks, "reusing old state should repeat same next sample")
}

[Artifact]
fn EmitM2RandomCoreSummary() -> Void {
    let _status = WriteOctagon("Experiments/PrometheusMeasurementFilteringLab/M2/m2_random_core_summary.octagon", [
        M2Summarize(M2CollectFloat01(1337, 2000)),
        M2Summarize(M2CollectFloatRange(1338, 2000, -1.0, 1.0)),
        M2Summarize(M2CollectNormal(1339, 3000, 0.0, 1.0))
    ])
}

[Artifact]
fn EmitM2RandomDistributionSamples() -> Void {
    let _status = WriteOctagon("Experiments/PrometheusMeasurementFilteringLab/M2/m2_random_distribution_samples.octagon", [
        M2BernoulliSummary(1400, 2000, 0.25),
        M2BernoulliSummary(1401, 2000, 0.5),
        M2BernoulliSummary(1402, 2000, 0.75),
        M2SpikeSummary(1403, 2000, 0.1, 4.0),
        M2Summarize(M2CollectJitter(1404, 2000, 0.05)),
        M2StateThreadingSummary()
    ])
}

[Artifact]
fn EmitM2RandomHistogramSummary() -> Void {
    let _status = WriteOctagon("Experiments/PrometheusMeasurementFilteringLab/M2/m2_random_histogram_summary.octagon", [
        M2UniformBuckets(M2CollectFloat01(1500, 2000)),
        M2NormalBuckets(M2CollectNormal(1501, 3000, 0.0, 1.0)),
        M2DriftWalk(1502, 500, 0.0, 0.05)
    ])
}

[Artifact]
fn EmitM2FinalVerdict() -> Void {
    let u01 = M2Summarize(M2CollectFloat01(1900, 2000))
    let ur = M2Summarize(M2CollectFloatRange(1901, 2000, -1.0, 1.0))
    let n = M2Summarize(M2CollectNormal(1902, 3000, 0.0, 1.0))
    let b = M2BernoulliSummary(1903, 2000, 0.5)
    let sp = M2SpikeSummary(1904, 2000, 0.1, 4.0)
    let jitter = M2Summarize(M2CollectJitter(1905, 2000, 0.05))
    let st = M2StateThreadingSummary()
    let _status = WriteOctagon("Experiments/PrometheusMeasurementFilteringLab/M2/m2_final_verdict.octagon", [
        u01.Mean >= 0.45 and u01.Mean <= 0.55,
        u01.Min >= 0.0 and u01.Max < 1.0,
        ur.Mean >= -0.1 and ur.Mean <= 0.1,
        n.Mean >= -0.2 and n.Mean <= 0.2,
        n.Variance >= 0.5 and n.Variance <= 1.5,
        b.ObservedProbability >= 0.40 and b.ObservedProbability <= 0.60,
        sp.ObservedSpikeProbability >= 0.03 and sp.ObservedSpikeProbability <= 0.20,
        jitter.Min >= -0.05 and jitter.Max < 0.05,
        st.SameSeedMatch and st.DifferentSeedDiffers and st.OldStateRepeatWorks
    ])
}
