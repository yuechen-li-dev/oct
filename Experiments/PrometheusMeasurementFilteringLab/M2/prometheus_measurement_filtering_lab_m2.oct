package PrometheusMeasurementFilteringLab

import Random

record ScalarSummary {
    SampleCount: Int
    Min: Float
    Max: Float
    Mean: Float
    Variance: Float
    CountZero: Int
    CountPositive: Int
    CountNegative: Int
}

record BernoulliSummary {
    SampleCount: Int
    TrueCount: Int
    ObservedProbability: Float
}

record SpikeSummary {
    SampleCount: Int
    ZeroCount: Int
    PositiveSpikeCount: Int
    NegativeSpikeCount: Int
}

record StateThreadingSummary {
    SameSeedMatch: Bool
    DifferentSeedDiffers: Bool
    ReusedStateRepeats: Bool
    AdvancedStateDiffers: Bool
}

// Jitter, Spike and DriftStep were composites in the Random v1 library layer,
// which Random v2 replaced. This experiment characterizes Random v1, so the
// three composites are kept here exactly as v1 defined them, on the v1 native
// draws, and its recorded results do not change. The experiment moves to
// Random v2 with the other experiments in ladder milestone M6
// (internal/random/RANDOM_V2_LADDER.md).

fn M2JitterV1(rng: Random.Rng, amplitude: Float) -> Float {
    return Random.RandFloatRange(rng, 0.0 - amplitude, amplitude).Value
}

fn M2SpikeV1(rng: Random.Rng, probability: Float, amplitude: Float) -> Float {
    if probability == 0.0 {
        return 0.0
    }
    if probability == 1.0 {
        let signAlways = Random.RandBernoulli(rng, 0.5)
        return if signAlways.Value { amplitude } else { 0.0 - amplitude }
    }

    let trigger = Random.RandBernoulli(rng, probability)
    if trigger.Value == false {
        return 0.0
    }

    let sign = Random.RandBernoulli(trigger.Next, 0.5)
    return if sign.Value { amplitude } else { 0.0 - amplitude }
}

fn M2DriftStepV1(rng: Random.Rng, current: Float, stepStddev: Float) -> Float {
    return current + Random.RandNormal(rng, 0.0, stepStddev).Value
}

fn M2CollectFloat01(seed: Int, n: Int) -> Float[] {
    var out: Float[] = []
    for i in 0..n {
        let draw = Random.RandFloat01(Random.RngSeed(seed * 10007 + i * 37 + 1))
        out = Append(out, draw.Value)
    }
    return out
}

fn M2CollectFloatRange(seed: Int, n: Int, min: Float, max: Float) -> Float[] {
    var out: Float[] = []
    for i in 0..n {
        let draw = Random.RandFloatRange(Random.RngSeed(seed * 10007 + i * 37 + 2), min, max)
        out = Append(out, draw.Value)
    }
    return out
}

fn M2CollectNormal(seed: Int, n: Int, mean: Float, stddev: Float) -> Float[] {
    var out: Float[] = []
    for i in 0..n {
        let draw = Random.RandNormal(Random.RngSeed(seed * 10007 + i * 37 + 3), mean, stddev)
        out = Append(out, draw.Value)
    }
    return out
}

fn M2CollectJitter(seed: Int, n: Int, amplitude: Float) -> Float[] {
    var out: Float[] = []
    for i in 0..n {
        out = Append(out, M2JitterV1(Random.RngSeed(seed * 10007 + i * 37 + 4), amplitude))
    }
    return out
}

fn M2CollectSpike(seed: Int, n: Int, probability: Float, amplitude: Float) -> Float[] {
    var out: Float[] = []
    for i in 0..n {
        out = Append(out, M2SpikeV1(Random.RngSeed(seed * 10007 + i * 37 + 5), probability, amplitude))
    }
    return out
}

fn M2DriftWalk(seed: Int, n: Int, start: Float, stepStddev: Float) -> Float[] {
    var out: Float[] = []
    var current = start
    for i in 0..n {
        current = M2DriftStepV1(Random.RngSeed(seed * 10007 + i * 37 + 6), current, stepStddev)
        out = Append(out, current)
    }
    return out
}

fn M2Summarize(xs: Float[]) -> ScalarSummary {
    var min = xs[0]
    var max = xs[0]
    var sum = 0.0
    var zero = 0
    var positive = 0
    var negative = 0

    for i in 0..Len(xs) {
        let v = xs[i]
        if v < min { min = v }
        if v > max { max = v }
        if v == 0.0 { zero = zero + 1 }
        if v > 0.0 { positive = positive + 1 }
        if v < 0.0 { negative = negative + 1 }
        sum = sum + v
    }

    let mean = sum / Float(Len(xs))
    var sq = 0.0
    for i in 0..Len(xs) {
        let d = xs[i] - mean
        sq = sq + d * d
    }

    return ScalarSummary {
        SampleCount: Len(xs)
        Min: min
        Max: max
        Mean: mean
        Variance: sq / Float(Len(xs))
        CountZero: zero
        CountPositive: positive
        CountNegative: negative
    }
}

fn M2BernoulliSummary(seed: Int, n: Int, p: Float) -> BernoulliSummary {
    var trueCount = 0
    for i in 0..n {
        let draw = Random.RandBernoulli(Random.RngSeed(seed * 10007 + i * 37 + 7), p)
        if draw.Value { trueCount = trueCount + 1 }
    }

    return BernoulliSummary {
        SampleCount: n
        TrueCount: trueCount
        ObservedProbability: Float(trueCount) / Float(n)
    }
}

fn M2SpikeSummary(seed: Int, n: Int, probability: Float, amplitude: Float) -> SpikeSummary {
    let xs = M2CollectSpike(seed, n, probability, amplitude)
    var zero = 0
    var positive = 0
    var negative = 0

    for i in 0..Len(xs) {
        if xs[i] == 0.0 { zero = zero + 1 }
        if xs[i] > 0.0 { positive = positive + 1 }
        if xs[i] < 0.0 { negative = negative + 1 }
    }

    return SpikeSummary {
        SampleCount: n
        ZeroCount: zero
        PositiveSpikeCount: positive
        NegativeSpikeCount: negative
    }
}

fn M2SameFloats(a: Float[], b: Float[]) -> Bool {
    if Len(a) != Len(b) { return false }
    for i in 0..Len(a) {
        if a[i] != b[i] { return false }
    }
    return true
}

fn M2StateThreadingSummary() -> StateThreadingSummary {
    let first = M2CollectFloat01(1234, 12)
    let sameSeed = M2CollectFloat01(1234, 12)
    let differentSeed = M2CollectFloat01(4321, 12)

    let r0 = Random.RngSeed(777)
    let draw1 = Random.RandFloat01(r0)
    let draw1Again = Random.RandFloat01(r0)
    let draw2 = Random.RandFloat01(draw1.Next)

    return StateThreadingSummary {
        SameSeedMatch: M2SameFloats(first, sameSeed)
        DifferentSeedDiffers: not M2SameFloats(first, differentSeed)
        ReusedStateRepeats: draw1.Value == draw1Again.Value
        AdvancedStateDiffers: draw2.Value != draw1.Value
    }
}
