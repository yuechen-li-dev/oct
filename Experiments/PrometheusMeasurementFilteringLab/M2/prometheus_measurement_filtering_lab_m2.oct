package PrometheusMeasurementFilteringLab

import Random

record ScalarSummary {
    SampleCount: Int
    Min: Float
    Max: Float
    Mean: Float
    Variance: Float
    CountZero: Int
    CountPositive: Int
    CountNegative: Int
}

record BernoulliSummary {
    SampleCount: Int
    TrueCount: Int
    ObservedProbability: Float
}

record SpikeSummary {
    SampleCount: Int
    ZeroCount: Int
    PositiveSpikeCount: Int
    NegativeSpikeCount: Int
}

record StreamSummary {
    SameSeedMatch: Bool
    DifferentSeedDiffers: Bool
    SameIndexRepeats: Bool
    NextIndexDiffers: Bool
    ForksDiffer: Bool
}

// Every collector draws from its own stream, forked by name from the seed.
// Draw i is a function of that stream and of i, so nothing is threaded from
// one draw to the next and no collector can disturb another.
fn M2Stream(seed: Int, source: String) -> Random.Stream {
    return Random.Fork(Random.Seeded(seed), source)
}

fn M2CollectFloat01(seed: Int, n: Int) -> Float[] {
    return Random.Units(M2Stream(seed, "unit"), n)
}

fn M2CollectFloatRange(seed: Int, n: Int, min: Float, max: Float) -> Float[] {
    let range = M2Stream(seed, "range")
    var out: Float[] = []
    for i in 0..n {
        out = Append(out, Random.Between(range, i, min, max))
    }
    return out
}

fn M2CollectNormal(seed: Int, n: Int, mean: Float, stddev: Float) -> Float[] {
    return Random.Normals(M2Stream(seed, "normal"), n, mean, stddev)
}

fn M2CollectJitter(seed: Int, n: Int, amplitude: Float) -> Float[] {
    let jitter = M2Stream(seed, "jitter")
    var out: Float[] = []
    for i in 0..n {
        out = Append(out, Random.Between(jitter, i, -amplitude, amplitude))
    }
    return out
}

fn M2CollectSpike(seed: Int, n: Int, probability: Float, amplitude: Float) -> Float[] {
    let spikes = M2Stream(seed, "spike")
    var out: Float[] = []
    for i in 0..n {
        out = Append(out, Random.Spike(spikes, i, probability, amplitude))
    }
    return out
}

fn M2DriftWalk(seed: Int, n: Int, start: Float, stepStddev: Float) -> Float[] {
    let drift = M2Stream(seed, "drift")
    var out: Float[] = []
    var current = start
    for i in 0..n {
        current = current + Random.Normal(drift, i, 0.0, stepStddev)
        out = Append(out, current)
    }
    return out
}

fn M2Summarize(xs: Float[]) -> ScalarSummary {
    var min = xs[0]
    var max = xs[0]
    var sum = 0.0
    var zero = 0
    var positive = 0
    var negative = 0

    for i in 0..Len(xs) {
        let v = xs[i]
        if v < min { min = v }
        if v > max { max = v }
        if v == 0.0 { zero = zero + 1 }
        if v > 0.0 { positive = positive + 1 }
        if v < 0.0 { negative = negative + 1 }
        sum = sum + v
    }

    let mean = sum / Float(Len(xs))
    var sq = 0.0
    for i in 0..Len(xs) {
        let d = xs[i] - mean
        sq = sq + d * d
    }

    return ScalarSummary {
        SampleCount: Len(xs)
        Min: min
        Max: max
        Mean: mean
        Variance: sq / Float(Len(xs))
        CountZero: zero
        CountPositive: positive
        CountNegative: negative
    }
}

fn M2BernoulliSummary(seed: Int, n: Int, p: Float) -> BernoulliSummary {
    let chance = M2Stream(seed, "chance")
    var trueCount = 0
    for i in 0..n {
        if Random.Chance(chance, i, p) { trueCount = trueCount + 1 }
    }

    return BernoulliSummary {
        SampleCount: n
        TrueCount: trueCount
        ObservedProbability: Float(trueCount) / Float(n)
    }
}

fn M2SpikeSummary(seed: Int, n: Int, probability: Float, amplitude: Float) -> SpikeSummary {
    let xs = M2CollectSpike(seed, n, probability, amplitude)
    var zero = 0
    var positive = 0
    var negative = 0

    for i in 0..Len(xs) {
        if xs[i] == 0.0 { zero = zero + 1 }
        if xs[i] > 0.0 { positive = positive + 1 }
        if xs[i] < 0.0 { negative = negative + 1 }
    }

    return SpikeSummary {
        SampleCount: n
        ZeroCount: zero
        PositiveSpikeCount: positive
        NegativeSpikeCount: negative
    }
}

fn M2SameFloats(a: Float[], b: Float[]) -> Bool {
    if Len(a) != Len(b) { return false }
    for i in 0..Len(a) {
        if a[i] != b[i] { return false }
    }
    return true
}

fn M2StreamSummary() -> StreamSummary {
    let first = M2CollectFloat01(1234, 12)
    let sameSeed = M2CollectFloat01(1234, 12)
    let differentSeed = M2CollectFloat01(4321, 12)

    let root = Random.Seeded(777)
    let draw = Random.Unit(root, 0)
    let drawAgain = Random.Unit(root, 0)
    let nextDraw = Random.Unit(root, 1)
    let left = Random.Unit(Random.Fork(root, "left"), 0)
    let right = Random.Unit(Random.Fork(root, "right"), 0)

    return StreamSummary {
        SameSeedMatch: M2SameFloats(first, sameSeed)
        DifferentSeedDiffers: not M2SameFloats(first, differentSeed)
        SameIndexRepeats: draw == drawAgain
        NextIndexDiffers: nextDraw != draw
        ForksDiffer: left != right
    }
}
