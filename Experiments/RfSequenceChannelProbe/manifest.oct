package Manifest

record PackageManifest {
    Name: String
    Version: String
    Description: String
    Dependencies: Dependency[]
}

record Dependency {
    Name: String
    VersionRequirement: String
}

fn Manifest() -> PackageManifest {
    return PackageManifest {
        Name: "RfSequenceChannelProbe"
        Version: "0.1.0"
        Description: "Sequence-oriented RF channel ergonomics probe using RF M0a helpers"
        Dependencies: [
            Dependency { Name: "OctStd" VersionRequirement: "0.1.0" },
            Dependency { Name: "RF" VersionRequirement: "0.1.0" }
        ]
    }
}
