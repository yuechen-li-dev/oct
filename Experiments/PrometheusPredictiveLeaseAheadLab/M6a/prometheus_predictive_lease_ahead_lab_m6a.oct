            TickSample { Tick:1 Confidence:0.58 Warmup:true PredictedReady:false ActualReady:true RuntimeUnsafe:false ResourcePressure:false OutstandingDepth:0 MemoryBudgetOk:true },
            TickSample { Tick:2 Confidence:0.45 Warmup:false PredictedReady:false ActualReady:true RuntimeUnsafe:false ResourcePressure:false OutstandingDepth:0 MemoryBudgetOk:true }
        ]
    }
    if s == ScenarioType.PredictionMiss {
        return [
            TickSample { Tick:0 Confidence:0.84 Warmup:false PredictedReady:true ActualReady:true RuntimeUnsafe:false ResourcePressure:false OutstandingDepth:0 MemoryBudgetOk:true },
            TickSample { Tick:1 Confidence:0.86 Warmup:false PredictedReady:true ActualReady:false RuntimeUnsafe:false ResourcePressure:false OutstandingDepth:0 MemoryBudgetOk:true },
            TickSample { Tick:2 Confidence:0.83 Warmup:false PredictedReady:true ActualReady:false RuntimeUnsafe:false ResourcePressure:false OutstandingDepth:0 MemoryBudgetOk:true },
            TickSample { Tick:3 Confidence:0.80 Warmup:false PredictedReady:true ActualReady:true RuntimeUnsafe:false ResourcePressure:false OutstandingDepth:0 MemoryBudgetOk:true }
        ]
    }
    if s == ScenarioType.StepChange {
        return [
            TickSample { Tick:0 Confidence:0.86 Warmup:false PredictedReady:true ActualReady:true RuntimeUnsafe:false ResourcePressure:false OutstandingDepth:0 MemoryBudgetOk:true },
            TickSample { Tick:1 Confidence:0.85 Warmup:false PredictedReady:true ActualReady:true RuntimeUnsafe:false ResourcePressure:false OutstandingDepth:0 MemoryBudgetOk:true },
            TickSample { Tick:2 Confidence:0.82 Warmup:false PredictedReady:true ActualReady:false RuntimeUnsafe:false ResourcePressure:false OutstandingDepth:0 MemoryBudgetOk:true },
            TickSample { Tick:3 Confidence:0.70 Warmup:false PredictedReady:true ActualReady:false RuntimeUnsafe:false ResourcePressure:false OutstandingDepth:0 MemoryBudgetOk:true },
            TickSample { Tick:4 Confidence:0.78 Warmup:false PredictedReady:true ActualReady:true RuntimeUnsafe:false ResourcePressure:false OutstandingDepth:0 MemoryBudgetOk:true }
        ]
    }
    if s == ScenarioType.ResourcePressure {
        return [
            TickSample { Tick:0 Confidence:0.86 Warmup:false PredictedReady:true ActualReady:true RuntimeUnsafe:false ResourcePressure:true OutstandingDepth:2 MemoryBudgetOk:false },
            TickSample { Tick:1 Confidence:0.87 Warmup:false PredictedReady:true ActualReady:true RuntimeUnsafe:false ResourcePressure:true OutstandingDepth:2 MemoryBudgetOk:false },
            TickSample { Tick:2 Confidence:0.88 Warmup:false PredictedReady:true ActualReady:true RuntimeUnsafe:false ResourcePressure:true OutstandingDepth:2 MemoryBudgetOk:false }
        ]
    }
    if s == ScenarioType.FalsePositiveSpike {
        return [
            TickSample { Tick:0 Confidence:0.40 Warmup:false PredictedReady:false ActualReady:false RuntimeUnsafe:false ResourcePressure:false OutstandingDepth:0 MemoryBudgetOk:true },
            TickSample { Tick:1 Confidence:0.90 Warmup:false PredictedReady:true ActualReady:false RuntimeUnsafe:false ResourcePressure:false OutstandingDepth:0 MemoryBudgetOk:true },
            TickSample { Tick:2 Confidence:0.42 Warmup:false PredictedReady:false ActualReady:false RuntimeUnsafe:false ResourcePressure:false OutstandingDepth:0 MemoryBudgetOk:true },
            TickSample { Tick:3 Confidence:0.44 Warmup:false PredictedReady:false ActualReady:true RuntimeUnsafe:false ResourcePressure:false OutstandingDepth:0 MemoryBudgetOk:true }
