        return [
            TickSample { Tick:0 Confidence:0.86 Warmup:false PredictedReady:true ActualReady:true RuntimeUnsafe:false ResourcePressure:false OutstandingDepth:0 MemoryBudgetOk:true },
            TickSample { Tick:1 Confidence:0.87 Warmup:false PredictedReady:true ActualReady:true RuntimeUnsafe:false ResourcePressure:false OutstandingDepth:0 MemoryBudgetOk:true },
            TickSample { Tick:2 Confidence:0.88 Warmup:false PredictedReady:true ActualReady:true RuntimeUnsafe:false ResourcePressure:false OutstandingDepth:0 MemoryBudgetOk:true },
            TickSample { Tick:3 Confidence:0.89 Warmup:false PredictedReady:true ActualReady:true RuntimeUnsafe:false ResourcePressure:false OutstandingDepth:0 MemoryBudgetOk:true },
            TickSample { Tick:4 Confidence:0.88 Warmup:false PredictedReady:true ActualReady:true RuntimeUnsafe:false ResourcePressure:false OutstandingDepth:0 MemoryBudgetOk:true }
