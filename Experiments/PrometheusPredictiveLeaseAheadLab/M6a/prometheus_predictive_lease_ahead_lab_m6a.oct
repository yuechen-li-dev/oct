package PrometheusPredictiveLeaseAheadLabM6a

enum PreStageState { None Eligible Submitted Ready Cancelled Expired Wasted Matured }
enum ReservationState { None Requested Reserved Denied Cancelled Expired Matured }
enum PreStageCostLevel { Low Medium }
enum ScenarioType { StableHighConfidence WarmupLowConfidence PredictionMiss StepChange ResourcePressure FalsePositiveSpike MixedHostile }
enum PolicyKind { BaselineReservationOnly Greedy ConfidenceGated ConfidenceCorrectionGated FullDominatus }

record TickSample {
    Tick: Int
    Confidence: Float
    Warmup: Bool
    PredictedReady: Bool
    ActualReady: Bool
    RuntimeUnsafe: Bool
    ResourcePressure: Bool
    OutstandingDepth: Int
    MemoryBudgetOk: Bool
}

record RakeConfig {
    Name: String
    ConfidenceThreshold: Float
    RecentMissWindow: Int
    MaxPrestageLeadTicks: Int
    CostLevel: PreStageCostLevel
}

record PolicyConfig {
    Name: String
    Kind: PolicyKind
}

record PreStageEntry {
    Valid: Bool
    RequestId: Int
    IssuedTick: Int
    TargetTick: Int
    State: PreStageState
    Confidence: Float
    Cost: Float
    Benefit: Float
    Cancelled: Bool
    Wasted: Bool
}

record ScenarioMetrics {
    Scenario: String
    Policy: String
    Rake: String
    OpportunityBenefit: Float
    Waste: Float
    FalseStageRate: Float
    MissAmplification: Float
    RecoveryTime: Float
    SafetyCompliance: Float
    CompositeScore: Float
    SubmittedCount: Int
    MaturedCount: Int
    CancelledCount: Int
    WastedCount: Int
    BlockedLowConfidence: Int
    BlockedWarmup: Int
    BlockedRecentMiss: Int
    BlockedHardGate: Int
    BlockedResourcePressure: Int
    BlockedLeadWindow: Int
    BlockedReservationState: Int
}

fn CostValue(level: PreStageCostLevel) -> Float {
    if level == PreStageCostLevel.Low { return 1.0 }
    return 2.0
}

fn BaseRake() -> RakeConfig { return RakeConfig { Name:"th075_m5_lead2_low" ConfidenceThreshold:0.75 RecentMissWindow:5 MaxPrestageLeadTicks:2 CostLevel:PreStageCostLevel.Low } }

fn PolicyBaseline() -> PolicyConfig { return PolicyConfig { Name:"A-reservation-only" Kind:PolicyKind.BaselineReservationOnly } }
fn PolicyGreedy() -> PolicyConfig { return PolicyConfig { Name:"B-greedy-prestage" Kind:PolicyKind.Greedy } }
fn PolicyConfidence() -> PolicyConfig { return PolicyConfig { Name:"C-confidence-gated" Kind:PolicyKind.ConfidenceGated } }
fn PolicyConfCorrection() -> PolicyConfig { return PolicyConfig { Name:"D-confidence+correction" Kind:PolicyKind.ConfidenceCorrectionGated } }
fn PolicyDominatus() -> PolicyConfig { return PolicyConfig { Name:"E-full-dominatus" Kind:PolicyKind.FullDominatus } }

fn AllPolicies() -> PolicyConfig[] { return [PolicyBaseline(), PolicyGreedy(), PolicyConfidence(), PolicyConfCorrection(), PolicyDominatus()] }

