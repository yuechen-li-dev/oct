package Manifest

record PackageManifest {
    Name: String
    Version: String
    Description: String
    Authors: String[]
    Date: String
    Kind: String
    EntryMilestone: String
    Dependencies: Dependency[]
}

record Dependency {
    Name: String
    VersionRequirement: String
}

fn Manifest() -> PackageManifest {
    return PackageManifest {
        Name: "PrometheusNumericalHeterogeneityLab"
        Version: "0.1.0"
        Description: "Synthetic identification and shadow-control lab for Prometheus numerical heterogeneity"
        Authors: ["Codex"]
        Date: "2026-07-16"
        Kind: "experiment"
        EntryMilestone: "M0"
        Dependencies: [Dependency { Name: "OctStd" VersionRequirement: "0.1.0" }]
    }
}
