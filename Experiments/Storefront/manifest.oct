package Manifest

record PackageManifest {
    Name: String
    Version: String
    Description: String
    Dependencies: Dependency[]
}

record Dependency {
    Name: String
    VersionRequirement: String
}

fn Manifest() -> PackageManifest {
    return PackageManifest {
        Name: "Storefront"
        Version: "0.1.0"
        Description: "Storefront M0-M5 headless UI probes for composition, typed coordinates, event families, separation, explicit slot data, and catalog/grid data tables"
        Dependencies: [Dependency { Name: "OctStd" VersionRequirement: "0.1.0" }]
    }
}
