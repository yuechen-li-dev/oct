package Manifest

record PackageManifest {
    Name: String
    Version: String
    Description: String
    Authors: String[]
    Date: String
    Dependencies: Dependency[]
}

record Dependency {
    Name: String
    VersionRequirement: String
}

fn Manifest() -> PackageManifest {
    return PackageManifest {
        Name: "Storefront"
        Version: "0.1.0"
        Authors: ["Codex"]
        Date: "2026-06-15"
        Description: "Storefront M0-M7 headless UI probes for composition, typed coordinates, event families, separation, explicit slot/grid and catalog data tables, direct dispatch-table behavior modeling, pure mapping-table cleanup, and top-level source-structure formalization"
        Dependencies: [Dependency { Name: "OctStd" VersionRequirement: "0.1.0" }]
    }
}
