package StorefrontM1

[Fact]
fn StorefrontM1ViewRendersDeterministically() -> Void {
    let first = Signature(View(Init()))
    let second = Signature(View(Init()))

    Assert.True(Len(first) > 0, "view should produce opaque UI signature")
    Assert.Equal(first, second, "same state should render same signature")
}

[Fact]
fn StorefrontM1SelectionAndCartFlowWorks() -> Void {
    let mounted = MountUI(View(Init()))

    let emitCategory = Emit(mounted, CategoryDeskEvent()) !
    Assert.Equal(0, emitCategory, "category event should emit")
    let categoryEvents = DrainEvents(mounted)
    Assert.Equal(1, Len(categoryEvents), "category click should enqueue one event")

    var model = Init()
    model = Update(model, categoryEvents[0])
    Assert.Equal("desk", model.SelectedCategory, "category state should update")

    let emitSelect = Emit(mounted, SelectHarborBoardEvent()) !
    Assert.Equal(0, emitSelect, "product inspect event should emit")
    let selectEvents = DrainEvents(mounted)
    Assert.Equal(1, Len(selectEvents), "inspect click should enqueue one event")

    model = Update(model, selectEvents[0])
    Assert.Equal("harbor-board", model.SelectedProduct, "selected product should update")

    let emitAdd = Emit(mounted, AddHarborBoardEvent()) !
    Assert.Equal(0, emitAdd, "add-to-cart should emit")
    let addEvents = DrainEvents(mounted)
    Assert.Equal(1, Len(addEvents), "add click should enqueue one event")

    model = Update(model, addEvents[0])
    Assert.Near(1.0, model.CartCount, 0.000001, "cart count should increase")

    let patched = PatchUI(mounted, View(model))
    Assert.Equal(0, patched, "patch with updated model should succeed")

    Assert.Equal(0, UnmountUI(mounted), "unmount should succeed")
}

[Fact]
fn StorefrontM1FilterAndFeaturedTogglesArePredictable() -> Void {
    var model = Init()

    model = Update(model, ToggleNewEvent())
    model = Update(model, ToggleInStockEvent())
    model = Update(model, ToggleBestSellerEvent())
    model = Update(model, SortPriceEvent())
    model = Update(model, FeaturedCableLabEvent())

    Assert.True(model.NewOnly, "new filter should toggle on")
    Assert.True(model.InStockOnly, "in-stock filter should toggle on")
    Assert.True(model.BestSellerOnly, "best-seller filter should toggle on")
    Assert.Equal("price", model.SortBy, "sort should update")
    Assert.Equal("Cable Lab", model.FeaturedTab, "featured tab should switch")

    let signature = Signature(View(model))
    Assert.True(Len(signature) > 0, "view should still render after toggles")
}
