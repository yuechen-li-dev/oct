package StorefrontM0

record Mount {
    Handle: Int
}

record UIBox {
    Kind: String
    X: Float
    Y: Float
    Width: Float
    Height: Float
    Left: Float
    Top: Float
    Right: Float
    Bottom: Float
}

record Product {
    Id: String
    Title: String
    Subtitle: String
    Price: Float
    Badge: String
    Category: String
}

record StoreState {
    SelectedNav: String
    SelectedCategory: String
    SortBy: String
    NewOnly: Bool
    InStockOnly: Bool
    BestSellerOnly: Bool
    FeaturedTab: String
    SelectedProduct: String
    CartCount: Float
}

fn Text(content: String) -> UI { return UIText(content) }
fn Button(label: String, event: String, enabled: Bool) -> UI { return UIButton(label, event, enabled) }
fn Row(children: UI[]) -> UI { return UIRow(children) }
fn Column(children: UI[]) -> UI { return UIColumn(children) }
fn Canvas(children: UI[]) -> UI { return UICanvas(children) }

fn AbsoluteBox(x: Float, y: Float, width: Float, height: Float) -> UIBox {
    return UIBox {
        Kind: "absolute"
        X: x
        Y: y
        Width: width
        Height: height
        Left: 0.0
        Top: 0.0
        Right: 0.0
        Bottom: 0.0
    }
}

fn AnchoredBox(left: Float, top: Float, right: Float, bottom: Float) -> UIBox {
    return UIBox {
        Kind: "anchored"
        X: 0.0
        Y: 0.0
        Width: 0.0
        Height: 0.0
        Left: left
        Top: top
        Right: right
        Bottom: bottom
    }
}

fn Place(box: UIBox, child: UI) -> UI {
    if box.Kind == "absolute" {
        return UIPlaceAbsolute(box.X, box.Y, box.Width, box.Height, child)
    }

    return UIPlaceAnchored(box.Left, box.Top, box.Right, box.Bottom, child)
}

fn MountUI(root: UI) -> Mount { return Mount { Handle: UIMount(root) } }
fn PatchUI(mount: Mount, next: UI) -> Int { return UIPatch(mount.Handle, next) }
fn UnmountUI(mount: Mount) -> Int { return UIUnmount(mount.Handle) }
fn Emit(mount: Mount, event: String) -> Int ! Error { return UIEmit(mount.Handle, event)? }
fn DrainEvents(mount: Mount) -> String[] { return UIDrainEvents(mount.Handle) }
fn Signature(node: UI) -> String { return UISignature(node) }

fn Init() -> StoreState {
    return StoreState {
        SelectedNav: "Shop"
        SelectedCategory: "all"
        SortBy: "featured"
        NewOnly: false
        InStockOnly: false
        BestSellerOnly: false
        FeaturedTab: "Desk Kits"
        SelectedProduct: ""
        CartCount: 0.0
    }
}

fn View(model: StoreState) -> UI {
    let HeaderTop = 0.01
    let HeaderBottom = 0.09
    let AnnouncementTop = 0.095
    let AnnouncementBottom = 0.13
    let HeroTop = 0.14
    let HeroBottom = 0.28
    let FiltersTop = 0.30
    let FiltersBottom = 0.78
    let GridTop = 0.30
    let GridBottom = 0.78
    let SupportTop = 0.80
    let SupportBottom = 0.91
    let FooterTop = 0.92

    let CardX0 = 320.0
    let CardX1 = 570.0
    let CardX2 = 820.0
    let CardY0 = 236.0
    let CardY1 = 408.0
    let CardWidth = 232.0
    let CardHeight = 158.0

    return Canvas([
        Place(AnchoredBox(0.01, HeaderTop, 0.99, HeaderBottom), HeaderBar(model)),
        Place(AnchoredBox(0.01, AnnouncementTop, 0.99, AnnouncementBottom), AnnouncementStrip()),
        Place(AnchoredBox(0.01, HeroTop, 0.99, HeroBottom), HeroBlock(model)),
        Place(AnchoredBox(0.01, FiltersTop, 0.26, FiltersBottom), FilterRail(model)),
        Place(AnchoredBox(0.27, GridTop, 0.99, GridBottom), ProductAreaHeader(model)),

        Place(AbsoluteBox(CardX0, CardY0, CardWidth, CardHeight), ProductCardSlot(HarborBoard(), SelectHarborBoardEvent(), AddHarborBoardEvent(), model)),
        Place(AbsoluteBox(CardX1, CardY0, CardWidth, CardHeight), ProductCardSlot(LinenNotebook(), SelectLinenNotebookEvent(), AddLinenNotebookEvent(), model)),
        Place(AbsoluteBox(CardX2, CardY0, CardWidth, CardHeight), ProductCardSlot(CableDock(), SelectCableDockEvent(), AddCableDockEvent(), model)),

        Place(AbsoluteBox(CardX0, CardY1, CardWidth, CardHeight), ProductCardSlot(FocusTimer(), SelectFocusTimerEvent(), AddFocusTimerEvent(), model)),
        Place(AbsoluteBox(CardX1, CardY1, CardWidth, CardHeight), ProductCardSlot(CorkTray(), SelectCorkTrayEvent(), AddCorkTrayEvent(), model)),
        Place(AbsoluteBox(CardX2, CardY1, CardWidth, CardHeight), ProductCardSlot(SteelRuler(), SelectSteelRulerEvent(), AddSteelRulerEvent(), model)),

        Place(AnchoredBox(0.27, SupportTop, 0.99, SupportBottom), SupportBand(model)),
        Place(AnchoredBox(0.01, FooterTop, 0.99, 0.99), Footer(model))
    ])
}

fn HeaderBar(model: StoreState) -> UI {
    return Row([
        Text("Northline Supply Co."),
        NavItem("Shop", NavShopEvent(), model.SelectedNav == "Shop"),
        NavItem("Bundles", NavBundlesEvent(), model.SelectedNav == "Bundles"),
        NavItem("Journal", NavJournalEvent(), model.SelectedNav == "Journal"),
        NavItem("Support", NavSupportEvent(), model.SelectedNav == "Support"),
        Text("Search: brass ruler, desk mat, cable dock"),
        Text("Cart " + FormatFloat(model.CartCount, 0) + " items")
    ])
}

fn AnnouncementStrip() -> UI {
    return Row([
        Text("Studio Dispatch: New modular desktop kits landed this week."),
        Text("Ships from Portland within 48 hours.")
    ])
}

fn HeroBlock(model: StoreState) -> UI {
    return Column([
        SectionHeader("Purpose-built tools for calm workspaces", "Northline curates desk hardware, notebooks, and cable order systems for focused daily use."),
        Row([
            FeatureBlock("Featured", "Desk Starter Grid", "Three-piece setup for cable control + writing flow."),
            FeatureBlock("Collection", "Analog Workflow", "Timer, ruler, and grid notebook for tactile planning."),
            FeatureBlock("Status", "Active category: " + CategoryLabel(model.SelectedCategory), "Sort: " + SortLabel(model.SortBy))
        ])
    ])
}

fn FilterRail(model: StoreState) -> UI {
    return Column([
        SectionHeader("Browse", "Choose category and list behavior."),
        Text("Category"),
        FilterChip("All", CategoryAllEvent(), model.SelectedCategory == "all"),
        FilterChip("Desk Gear", CategoryDeskEvent(), model.SelectedCategory == "desk"),
        FilterChip("Stationery", CategoryPaperEvent(), model.SelectedCategory == "paper"),
        FilterChip("Cable", CategoryCableEvent(), model.SelectedCategory == "cable"),
        Text("Flags"),
        FilterChip("New arrivals", ToggleNewEvent(), model.NewOnly),
        FilterChip("In stock", ToggleInStockEvent(), model.InStockOnly),
        FilterChip("Best sellers", ToggleBestSellerEvent(), model.BestSellerOnly),
        Text("Sort"),
        FilterChip("Featured", SortFeaturedEvent(), model.SortBy == "featured"),
        FilterChip("Price low-high", SortPriceEvent(), model.SortBy == "price"),
        FilterChip("Newest", SortNewestEvent(), model.SortBy == "newest")
    ])
}

fn ProductAreaHeader(model: StoreState) -> UI {
    return Row([
        SectionHeader("Catalog", "Selected: " + CategoryLabel(model.SelectedCategory) + " · " + ActiveFilterSummary(model)),
        Button("Desk Kits", FeaturedDeskKitsEvent(), model.FeaturedTab != "Desk Kits"),
        Button("Notebook Sets", FeaturedNotebookSetsEvent(), model.FeaturedTab != "Notebook Sets"),
        Button("Cable Lab", FeaturedCableLabEvent(), model.FeaturedTab != "Cable Lab"),
        Text("Featured strip: " + model.FeaturedTab)
    ])
}

fn ProductCardSlot(product: Product, selectEvent: String, addEvent: String, model: StoreState) -> UI {
    if CategoryVisible(model.SelectedCategory, product.Category) {
        return ProductCard(product, selectEvent, addEvent, model)
    }

    return Column([
        Text("Filtered out"),
        Text(product.Title),
        Text("Category: " + CategoryLabel(product.Category))
    ])
}

fn ProductCard(product: Product, selectEvent: String, addEvent: String, model: StoreState) -> UI {
    let selected = model.SelectedProduct == product.Id
    let selectedLine = SelectionLabel(selected)

    return Column([
        Row([
            Text("[Box Art: " + product.Category + "]"),
            PriceBadge(product.Price)
        ]),
        Text(product.Title),
        Text(product.Subtitle),
        Text("Badge: " + product.Badge + " · " + selectedLine),
        Row([
            Button("Inspect", selectEvent, true),
            Button("Add to cart", addEvent, true)
        ])
    ])
}

fn SupportBand(model: StoreState) -> UI {
    return Row([
        FeatureBlock("Why Northline", "Small-batch hardware", "Every item is field-tested in studio desks before release."),
        FeatureBlock("Customer notes", "Cable Dock solved my daily tangle", "R. Kim, Seattle"),
        FeatureBlock("Journal", "Five-minute reset routine", "How teams use analog timers with notebook blocks.")
    ])
}

fn Footer(model: StoreState) -> UI {
    return Row([
        FooterColumn("Shop", ["Desk Gear", "Stationery", "Cable Management"]),
        FooterColumn("Company", ["About", "Journal", "Wholesale"]),
        FooterColumn("Help", ["Shipping", "Returns", "Contact"]),
        Text("Selected product: " + SelectedProductLabel(model.SelectedProduct))
    ])
}

fn NavItem(label: String, event: String, selected: Bool) -> UI {
    return Button(label, event, not selected)
}

fn FilterChip(label: String, event: String, active: Bool) -> UI {
    if active {
        return Button("● " + label, event, true)
    }

    return Button("○ " + label, event, true)
}

fn PriceBadge(amount: Float) -> UI {
    return Text("$" + FormatFloat(amount, 2))
}

fn SectionHeader(title: String, subtitle: String) -> UI {
    return Column([
        Text(title),
        Text(subtitle)
    ])
}

fn FeatureBlock(tag: String, title: String, body: String) -> UI {
    return Column([
        Text(tag),
        Text(title),
        Text(body)
    ])
}

fn FooterColumn(title: String, links: String[]) -> UI {
    return Column([
        Text(title),
        Text(links[0]),
        Text(links[1]),
        Text(links[2])
    ])
}

fn Update(model: StoreState, event: String) -> StoreState {
    if event == NavShopEvent() { return WithNav(model, "Shop") }
    if event == NavBundlesEvent() { return WithNav(model, "Bundles") }
    if event == NavJournalEvent() { return WithNav(model, "Journal") }
    if event == NavSupportEvent() { return WithNav(model, "Support") }

    if event == CategoryAllEvent() { return WithCategory(model, "all") }
    if event == CategoryDeskEvent() { return WithCategory(model, "desk") }
    if event == CategoryPaperEvent() { return WithCategory(model, "paper") }
    if event == CategoryCableEvent() { return WithCategory(model, "cable") }

    if event == ToggleNewEvent() { return WithNewOnly(model, not model.NewOnly) }
    if event == ToggleInStockEvent() { return WithInStockOnly(model, not model.InStockOnly) }
    if event == ToggleBestSellerEvent() { return WithBestSellerOnly(model, not model.BestSellerOnly) }

    if event == SortFeaturedEvent() { return WithSort(model, "featured") }
    if event == SortPriceEvent() { return WithSort(model, "price") }
    if event == SortNewestEvent() { return WithSort(model, "newest") }

    if event == FeaturedDeskKitsEvent() { return WithFeaturedTab(model, "Desk Kits") }
    if event == FeaturedNotebookSetsEvent() { return WithFeaturedTab(model, "Notebook Sets") }
    if event == FeaturedCableLabEvent() { return WithFeaturedTab(model, "Cable Lab") }

    if event == SelectHarborBoardEvent() { return WithSelectedProduct(model, "harbor-board") }
    if event == SelectLinenNotebookEvent() { return WithSelectedProduct(model, "linen-notebook") }
    if event == SelectCableDockEvent() { return WithSelectedProduct(model, "cable-dock") }
    if event == SelectFocusTimerEvent() { return WithSelectedProduct(model, "focus-timer") }
    if event == SelectCorkTrayEvent() { return WithSelectedProduct(model, "cork-tray") }
    if event == SelectSteelRulerEvent() { return WithSelectedProduct(model, "steel-ruler") }

    if event == AddHarborBoardEvent() { return WithCartCount(model, model.CartCount + 1.0) }
    if event == AddLinenNotebookEvent() { return WithCartCount(model, model.CartCount + 1.0) }
    if event == AddCableDockEvent() { return WithCartCount(model, model.CartCount + 1.0) }
    if event == AddFocusTimerEvent() { return WithCartCount(model, model.CartCount + 1.0) }
    if event == AddCorkTrayEvent() { return WithCartCount(model, model.CartCount + 1.0) }
    if event == AddSteelRulerEvent() { return WithCartCount(model, model.CartCount + 1.0) }

    return model
}

fn WithNav(model: StoreState, value: String) -> StoreState {
    return StoreState {
        SelectedNav: value
        SelectedCategory: model.SelectedCategory
        SortBy: model.SortBy
        NewOnly: model.NewOnly
        InStockOnly: model.InStockOnly
        BestSellerOnly: model.BestSellerOnly
        FeaturedTab: model.FeaturedTab
        SelectedProduct: model.SelectedProduct
        CartCount: model.CartCount
    }
}

fn WithCategory(model: StoreState, value: String) -> StoreState {
    return StoreState {
        SelectedNav: model.SelectedNav
        SelectedCategory: value
        SortBy: model.SortBy
        NewOnly: model.NewOnly
        InStockOnly: model.InStockOnly
        BestSellerOnly: model.BestSellerOnly
        FeaturedTab: model.FeaturedTab
        SelectedProduct: model.SelectedProduct
        CartCount: model.CartCount
    }
}

fn WithSort(model: StoreState, value: String) -> StoreState {
    return StoreState {
        SelectedNav: model.SelectedNav
        SelectedCategory: model.SelectedCategory
        SortBy: value
        NewOnly: model.NewOnly
        InStockOnly: model.InStockOnly
        BestSellerOnly: model.BestSellerOnly
        FeaturedTab: model.FeaturedTab
        SelectedProduct: model.SelectedProduct
        CartCount: model.CartCount
    }
}

fn WithNewOnly(model: StoreState, value: Bool) -> StoreState {
    return StoreState {
        SelectedNav: model.SelectedNav
        SelectedCategory: model.SelectedCategory
        SortBy: model.SortBy
        NewOnly: value
        InStockOnly: model.InStockOnly
        BestSellerOnly: model.BestSellerOnly
        FeaturedTab: model.FeaturedTab
        SelectedProduct: model.SelectedProduct
        CartCount: model.CartCount
    }
}

fn WithInStockOnly(model: StoreState, value: Bool) -> StoreState {
    return StoreState {
        SelectedNav: model.SelectedNav
        SelectedCategory: model.SelectedCategory
        SortBy: model.SortBy
        NewOnly: model.NewOnly
        InStockOnly: value
        BestSellerOnly: model.BestSellerOnly
        FeaturedTab: model.FeaturedTab
        SelectedProduct: model.SelectedProduct
        CartCount: model.CartCount
    }
}

fn WithBestSellerOnly(model: StoreState, value: Bool) -> StoreState {
    return StoreState {
        SelectedNav: model.SelectedNav
        SelectedCategory: model.SelectedCategory
        SortBy: model.SortBy
        NewOnly: model.NewOnly
        InStockOnly: model.InStockOnly
        BestSellerOnly: value
        FeaturedTab: model.FeaturedTab
        SelectedProduct: model.SelectedProduct
        CartCount: model.CartCount
    }
}

fn WithFeaturedTab(model: StoreState, value: String) -> StoreState {
    return StoreState {
        SelectedNav: model.SelectedNav
        SelectedCategory: model.SelectedCategory
        SortBy: model.SortBy
        NewOnly: model.NewOnly
        InStockOnly: model.InStockOnly
        BestSellerOnly: model.BestSellerOnly
        FeaturedTab: value
        SelectedProduct: model.SelectedProduct
        CartCount: model.CartCount
    }
}

fn WithSelectedProduct(model: StoreState, value: String) -> StoreState {
    return StoreState {
        SelectedNav: model.SelectedNav
        SelectedCategory: model.SelectedCategory
        SortBy: model.SortBy
        NewOnly: model.NewOnly
        InStockOnly: model.InStockOnly
        BestSellerOnly: model.BestSellerOnly
        FeaturedTab: model.FeaturedTab
        SelectedProduct: value
        CartCount: model.CartCount
    }
}

fn WithCartCount(model: StoreState, value: Float) -> StoreState {
    return StoreState {
        SelectedNav: model.SelectedNav
        SelectedCategory: model.SelectedCategory
        SortBy: model.SortBy
        NewOnly: model.NewOnly
        InStockOnly: model.InStockOnly
        BestSellerOnly: model.BestSellerOnly
        FeaturedTab: model.FeaturedTab
        SelectedProduct: model.SelectedProduct
        CartCount: value
    }
}

fn CategoryVisible(selected: String, category: String) -> Bool {
    if selected == "all" { return true }
    return selected == category
}

fn ActiveFilterSummary(model: StoreState) -> String {
    let newState = ToggleLabel(model.NewOnly)
    let stockState = ToggleLabel(model.InStockOnly)
    let bestState = ToggleLabel(model.BestSellerOnly)
    return "new=" + newState + ", stock=" + stockState + ", best=" + bestState + ", sort=" + SortLabel(model.SortBy)
}

fn ToggleLabel(active: Bool) -> String {
    if active { return "on" }
    return "off"
}

fn SelectionLabel(selected: Bool) -> String {
    if selected { return "selected" }
    return "not selected"
}

fn CategoryLabel(category: String) -> String {
    if category == "all" { return "All" }
    if category == "desk" { return "Desk Gear" }
    if category == "paper" { return "Stationery" }
    if category == "cable" { return "Cable" }
    return category
}

fn SortLabel(value: String) -> String {
    if value == "featured" { return "Featured" }
    if value == "price" { return "Price low-high" }
    if value == "newest" { return "Newest" }
    return value
}

fn SelectedProductLabel(value: String) -> String {
    if value == "" { return "none" }
    return value
}

