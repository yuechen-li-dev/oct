package Manifest

record PackageManifest {
    Name: String
    Version: String
    Description: String
    Authors: String[]
    Date: String
    Dependencies: Dependency[]
}

record Dependency {
    Name: String
    VersionRequirement: String
}

fn Manifest() -> PackageManifest {
    return PackageManifest {
        Name: "MainValid"
        Version: "0.1.0"
        Authors: ["Codex"]
        Date: "2026-06-15"
        Description: "M34 controlled convergence boundary probe with bounded early-exit policy"
        Dependencies: [Dependency { Name: "OctStd" VersionRequirement: "0.1.0" }]
    }
}
