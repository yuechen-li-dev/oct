package MainValid

record Vec2 {
    X: Float
    Y: Float
}

record ConstitutiveResponseField2D {
    TT: Float
    NN: Float
    TN: Float
    Probe: Vec2
    ModeName: String
    Mode: Int
}

record ConstitutiveBoundaryReport {
    NoVsScalarHorizontalL1: Float
    NoVsScalarVerticalL1: Float
    NoVsScalarDiagonalL1: Float
    NoVsScalarOppositeDiagonalL1: Float
    NoVsCouplingDiagonalL1: Float
    NoVsCouplingOppositeDiagonalL1: Float
    ScalarVsCouplingDiagonalL1: Float
    ScalarVsCouplingOppositeDiagonalL1: Float
    DiagonalAsymmetryNoAuthority: Float
    DiagonalAsymmetryScalarAuthority: Float
    DiagonalAsymmetryCouplingAuthority: Float
    ScalarBoundaryVsInteriorGap: Float
    CouplingBoundaryVsInteriorGap: Float
    TransportedDiagonalVariationNoAuthority: Float
    StaticDiagonalVariationNoAuthority: Float
    AuthorityRule: String
    SeparationVerdict: String
    NextBoundary: String
}

fn Dot(a: Vec2, b: Vec2) -> Float {
    return a.X * b.X + a.Y * b.Y
}

fn Magnitude(v: Vec2) -> Float {
    return Sqrt(v.X * v.X + v.Y * v.Y)
}

fn Normalize(v: Vec2) -> Vec2 {
    let m = Magnitude(v)
    if m <= 0.000001 {
        return Vec2 { X: 1.0 Y: 0.0 }
    }
    return Vec2 { X: v.X / m Y: v.Y / m }
}

fn TangentFromNormal(n: Vec2) -> Vec2 {
    return Vec2 { X: 0.0 - n.Y Y: n.X }
}

fn IsInsideCircle(i: Int, j: Int) -> Bool {
    let x = Float(i) - 2.5
    let y = Float(j) - 2.5
    return x * x + y * y <= 5.0
}

fn TransportedMaterialNormal(i: Int, j: Int) -> Vec2 {
    let x = Float(i) - 2.5
    let y = Float(j) - 2.5
    return Normalize(Vec2 { X: x Y: y })
}

fn TransportedMaterialTangent(i: Int, j: Int) -> Vec2 {
    return TangentFromNormal(TransportedMaterialNormal(i, j))
}

fn StaticMaterialTangent() -> Vec2 {
    return Vec2 { X: 1.0 Y: 0.0 }
}

fn StaticMaterialNormal() -> Vec2 {
    return Vec2 { X: 0.0 Y: 1.0 }
}

fn AuthorityField(i: Int, j: Int) -> Float {
    return 0.2 + 0.05 * Float(i) + 0.02 * Float(j)
}

// Strongest M26 local constitutive baseline retained exactly:
// off-axis signed local coupling with mixed-sign threshold asymmetry.
fn EvaluateOffAxisBaseline(probe: Vec2, t: Vec2, n: Vec2, R: ConstitutiveResponseField2D) -> Float {
    let pt = Dot(probe, t)
    let pn = Dot(probe, n)
    let base = R.TT * Abs(pt) + R.NN * Abs(pn)

    let mixedSign = pt * pn < 0.0
    let aboveThresholdPt = Abs(pt) > 0.2
    let aboveThresholdPn = Abs(pn) > 0.2
    let aboveThreshold = if aboveThresholdPt {
        aboveThresholdPn
    } else {
        false
    }
    let asymmetryScale = if mixedSign {
        if aboveThreshold { 1.5 } else { 1.0 }
    } else {
        1.0
    }

    let coupling = asymmetryScale * R.TN * (pt * pn)
    return base + coupling
}

fn EvaluateAuthorityModulatedConstitutiveResponse(field: ConstitutiveResponseField2D, useStaticFrame: Bool, i: Int, j: Int) -> Float {
    if IsInsideCircle(i, j) == false {
        return 0.0
    }

    let t = if useStaticFrame { StaticMaterialTangent() } else { TransportedMaterialTangent(i, j) }
    let n = if useStaticFrame { StaticMaterialNormal() } else { TransportedMaterialNormal(i, j) }

    let pt = Dot(field.Probe, t)
    let pn = Dot(field.Probe, n)
    let baseOnly = field.TT * Abs(pt) + field.NN * Abs(pn)

    let mixedSign = pt * pn < 0.0
    let aboveThresholdPt = Abs(pt) > 0.2
    let aboveThresholdPn = Abs(pn) > 0.2
    let aboveThreshold = if aboveThresholdPt {
        aboveThresholdPn
    } else {
        false
    }
    let asymmetryScale = if mixedSign {
        if aboveThreshold { 1.5 } else { 1.0 }
    } else {
        1.0
    }
    let couplingOnly = asymmetryScale * field.TN * (pt * pn)

    let authorityWeight = AuthorityField(i, j)

    if field.Mode == 0 {
        return EvaluateOffAxisBaseline(field.Probe, t, n, field)
    }

    if field.Mode == 1 {
        return authorityWeight * (baseOnly + couplingOnly)
    }

    return baseOnly + authorityWeight * couplingOnly
}

fn BuildNoAuthorityResponseField(probe: Vec2) -> ConstitutiveResponseField2D {
    return ConstitutiveResponseField2D {
        TT: 1.8
        NN: 0.2
        TN: 0.15
        Probe: probe
        ModeName: "NoAuthority"
        Mode: 0
    }
}

fn BuildScalarAuthorityResponseField(probe: Vec2) -> ConstitutiveResponseField2D {
    return ConstitutiveResponseField2D {
        TT: 1.8
        NN: 0.2
        TN: 0.15
        Probe: probe
        ModeName: "ScalarWholeResponseWeight"
        Mode: 1
    }
}

fn BuildCouplingAuthorityResponseField(probe: Vec2) -> ConstitutiveResponseField2D {
    return ConstitutiveResponseField2D {
        TT: 1.8
        NN: 0.2
        TN: 0.15
        Probe: probe
        ModeName: "CouplingOnlyWeight"
        Mode: 2
    }
}

fn L1Difference(fieldA: ConstitutiveResponseField2D, staticA: Bool, fieldB: ConstitutiveResponseField2D, staticB: Bool) -> Float {
    var total = 0.0
    for i in 0..6 {
        for j in 0..6 {
            let a = EvaluateAuthorityModulatedConstitutiveResponse(fieldA, staticA, i, j)
            let b = EvaluateAuthorityModulatedConstitutiveResponse(fieldB, staticB, i, j)
            total = total + Abs(a - b)
        }
    }
    return total
}

fn ResponseSum(field: ConstitutiveResponseField2D, useStaticFrame: Bool) -> Float {
    var total = 0.0
    for i in 0..6 {
        for j in 0..6 {
            total = total + EvaluateAuthorityModulatedConstitutiveResponse(field, useStaticFrame, i, j)
        }
    }
    return total
}

fn SpatialVariation(field: ConstitutiveResponseField2D, useStaticFrame: Bool) -> Float {
    var sum = 0.0
    var count = 0
    for i in 0..6 {
        for j in 0..6 {
            if IsInsideCircle(i, j) {
                sum = sum + EvaluateAuthorityModulatedConstitutiveResponse(field, useStaticFrame, i, j)
                count = count + 1
            }
        }
    }

    let mean = sum / Float(count)
    var l1 = 0.0
    for i in 0..6 {
        for j in 0..6 {
            if IsInsideCircle(i, j) {
                let v = EvaluateAuthorityModulatedConstitutiveResponse(field, useStaticFrame, i, j)
                l1 = l1 + Abs(v - mean)
            }
        }
    }
    return l1
}

fn IsBoundaryLocal(i: Int, j: Int) -> Bool {
    let x = Float(i) - 2.5
    let y = Float(j) - 2.5
    let radius = Sqrt(x * x + y * y)
    return Abs(radius - Sqrt(5.0)) <= 1.0
}

fn BoundaryInteriorGap(field: ConstitutiveResponseField2D) -> Float {
    var boundarySum = 0.0
    var boundaryCount = 0
    var interiorSum = 0.0
    var interiorCount = 0

    for i in 0..6 {
        for j in 0..6 {
            if IsInsideCircle(i, j) {
                let v = EvaluateAuthorityModulatedConstitutiveResponse(field, false, i, j)
                if IsBoundaryLocal(i, j) {
                    boundarySum = boundarySum + v
                    boundaryCount = boundaryCount + 1
                } else {
                    interiorSum = interiorSum + v
                    interiorCount = interiorCount + 1
                }
            }
        }
    }

    let boundaryMean = boundarySum / Float(boundaryCount)
    let interiorMean = interiorSum / Float(interiorCount)
    return Abs(boundaryMean - interiorMean)
}

fn CompareAuthorityParticipationModes() -> ConstitutiveBoundaryReport {
    let horizontal = Normalize(Vec2 { X: 1.0 Y: 0.0 })
    let vertical = Normalize(Vec2 { X: 0.0 Y: 1.0 })
    let diagonal = Normalize(Vec2 { X: 1.0 Y: 1.0 })
    let oppositeDiagonal = Normalize(Vec2 { X: 1.0 Y: 0.0 - 1.0 })

    let noHorizontal = BuildNoAuthorityResponseField(horizontal)
    let scalarHorizontal = BuildScalarAuthorityResponseField(horizontal)

    let noVertical = BuildNoAuthorityResponseField(vertical)
    let scalarVertical = BuildScalarAuthorityResponseField(vertical)

    let noDiagonal = BuildNoAuthorityResponseField(diagonal)
    let scalarDiagonal = BuildScalarAuthorityResponseField(diagonal)
    let couplingDiagonal = BuildCouplingAuthorityResponseField(diagonal)

    let noOppositeDiagonal = BuildNoAuthorityResponseField(oppositeDiagonal)
    let scalarOppositeDiagonal = BuildScalarAuthorityResponseField(oppositeDiagonal)
    let couplingOppositeDiagonal = BuildCouplingAuthorityResponseField(oppositeDiagonal)

    let noVsScalarHorizontalL1 = L1Difference(noHorizontal, false, scalarHorizontal, false)
    let noVsScalarVerticalL1 = L1Difference(noVertical, false, scalarVertical, false)
    let noVsScalarDiagonalL1 = L1Difference(noDiagonal, false, scalarDiagonal, false)
    let noVsScalarOppositeDiagonalL1 = L1Difference(noOppositeDiagonal, false, scalarOppositeDiagonal, false)

    let noVsCouplingDiagonalL1 = L1Difference(noDiagonal, false, couplingDiagonal, false)
    let noVsCouplingOppositeDiagonalL1 = L1Difference(noOppositeDiagonal, false, couplingOppositeDiagonal, false)

    let scalarVsCouplingDiagonalL1 = L1Difference(scalarDiagonal, false, couplingDiagonal, false)
    let scalarVsCouplingOppositeDiagonalL1 = L1Difference(scalarOppositeDiagonal, false, couplingOppositeDiagonal, false)

    let diagonalAsymmetryNoAuthority = Abs(ResponseSum(noDiagonal, false) - ResponseSum(noOppositeDiagonal, false))
    let diagonalAsymmetryScalarAuthority = Abs(ResponseSum(scalarDiagonal, false) - ResponseSum(scalarOppositeDiagonal, false))
    let diagonalAsymmetryCouplingAuthority = Abs(ResponseSum(couplingDiagonal, false) - ResponseSum(couplingOppositeDiagonal, false))

    let scalarBoundaryVsInteriorGap = BoundaryInteriorGap(scalarDiagonal)
    let couplingBoundaryVsInteriorGap = BoundaryInteriorGap(couplingDiagonal)

    let staticDiagonalVariationNoAuthority = SpatialVariation(noDiagonal, true)
    let transportedDiagonalVariationNoAuthority = SpatialVariation(noDiagonal, false)

    return ConstitutiveBoundaryReport {
        NoVsScalarHorizontalL1: noVsScalarHorizontalL1
        NoVsScalarVerticalL1: noVsScalarVerticalL1
        NoVsScalarDiagonalL1: noVsScalarDiagonalL1
        NoVsScalarOppositeDiagonalL1: noVsScalarOppositeDiagonalL1
        NoVsCouplingDiagonalL1: noVsCouplingDiagonalL1
        NoVsCouplingOppositeDiagonalL1: noVsCouplingOppositeDiagonalL1
        ScalarVsCouplingDiagonalL1: scalarVsCouplingDiagonalL1
        ScalarVsCouplingOppositeDiagonalL1: scalarVsCouplingOppositeDiagonalL1
        DiagonalAsymmetryNoAuthority: diagonalAsymmetryNoAuthority
        DiagonalAsymmetryScalarAuthority: diagonalAsymmetryScalarAuthority
        DiagonalAsymmetryCouplingAuthority: diagonalAsymmetryCouplingAuthority
        ScalarBoundaryVsInteriorGap: scalarBoundaryVsInteriorGap
        CouplingBoundaryVsInteriorGap: couplingBoundaryVsInteriorGap
        TransportedDiagonalVariationNoAuthority: transportedDiagonalVariationNoAuthority
        StaticDiagonalVariationNoAuthority: staticDiagonalVariationNoAuthority
        AuthorityRule: "M27 explicit policy: mode A authority excluded from constitutive participation, mode B scalar authority weights whole local response, mode C authority weights only off-axis/signed coupling contribution."
        SeparationVerdict: "M27 verdict: field separation survives; authority enters constitutive participation only through explicit local policy pathways."
        NextBoundary: "Next boundary after M27: keep locality and probe slightly richer local tensor-like coupling surfaces under coupling-specific authority modulation before any first tiny global solve."
    }
}

fn ProbeConstitutiveBoundary() -> ConstitutiveBoundaryReport {
    return CompareAuthorityParticipationModes()
}

[Fact]
fn ContinuumM27ConstructsThreeAuthorityParticipationModesDeterministically() -> Void {
    let diagonal = Normalize(Vec2 { X: 1.0 Y: 1.0 })

    let noAuthority = BuildNoAuthorityResponseField(diagonal)
    let scalar = BuildScalarAuthorityResponseField(diagonal)
    let coupling = BuildCouplingAuthorityResponseField(diagonal)

    Assert.Near(1.8, noAuthority.TT, 0.000001, "M26 baseline TT is retained")
    Assert.Near(0.2, noAuthority.NN, 0.000001, "M26 baseline NN is retained")
    Assert.Near(0.15, noAuthority.TN, 0.000001, "M26 baseline TN is retained")

    Assert.Equal(noAuthority.Mode, 0, "mode A deterministic")
    Assert.Equal(scalar.Mode, 1, "mode B deterministic")
    Assert.Equal(coupling.Mode, 2, "mode C deterministic")
}

[Fact]
fn ContinuumM27AuthorityModulationAddsMeasurableConstitutiveSignal() -> Void {
    let report = ProbeConstitutiveBoundary()

    Assert.True(report.NoVsScalarHorizontalL1 > 0.01, "scalar authority changes horizontal constitutive participation")
    Assert.True(report.NoVsScalarVerticalL1 > 0.01, "scalar authority changes vertical constitutive participation")
    Assert.True(report.NoVsScalarDiagonalL1 > 0.01, "scalar authority changes diagonal constitutive participation")
    Assert.True(report.NoVsCouplingDiagonalL1 > 0.01, "coupling-specific authority changes diagonal constitutive participation")
}

[Fact]
fn ContinuumM27ScalarAndCouplingSpecificAuthorityAreNotEquivalent() -> Void {
    let report = ProbeConstitutiveBoundary()

    Assert.True(report.ScalarVsCouplingDiagonalL1 > 0.01, "scalar and coupling-specific authority differ on diagonal probe")
    Assert.True(report.ScalarVsCouplingOppositeDiagonalL1 > 0.01, "scalar and coupling-specific authority differ on opposite-diagonal probe")

    let scalarDeviationFromNo = Abs(report.DiagonalAsymmetryScalarAuthority - report.DiagonalAsymmetryNoAuthority)
    let couplingDeviationFromNo = Abs(report.DiagonalAsymmetryCouplingAuthority - report.DiagonalAsymmetryNoAuthority)
    Assert.True(couplingDeviationFromNo < scalarDeviationFromNo, "coupling-specific authority better preserves constitutive diagonal-family semantics than blanket scalar weighting")
}

[Fact]
fn ContinuumM27DiagonalProbeFamilyAndBoundaryRegionExposeAuthorityDifferences() -> Void {
    let report = ProbeConstitutiveBoundary()

    Assert.True(report.NoVsScalarDiagonalL1 > 0.01, "diagonal probe exposes scalar-authority signal")
    Assert.True(report.NoVsScalarOppositeDiagonalL1 > 0.01, "opposite-diagonal probe exposes scalar-authority signal")
    Assert.True(report.NoVsCouplingDiagonalL1 > 0.01 and report.NoVsCouplingOppositeDiagonalL1 > 0.01, "diagonal-family probes expose coupling-specific authority signal")
    Assert.True(report.ScalarVsCouplingDiagonalL1 > 0.01 and report.ScalarVsCouplingOppositeDiagonalL1 > 0.01, "diagonal-family probes clearly separate scalar and coupling-specific authority policies")

    Assert.True(report.CouplingBoundaryVsInteriorGap > 0.0001, "coupling-specific mode shows boundary/interior contrast")
    Assert.True(Abs(report.ScalarBoundaryVsInteriorGap - report.CouplingBoundaryVsInteriorGap) > 0.0001, "scalar and coupling-specific authority produce measurably different boundary/interior participation behavior")
}

[Fact]
fn ContinuumM27TransportedDirectionRemainsUsefulAndFieldSeparationSurvives() -> Void {
    let report = ProbeConstitutiveBoundary()

    Assert.Near(0.0, report.StaticDiagonalVariationNoAuthority, 0.000001, "static direction still collapses local diagonal structure")
    Assert.True(report.TransportedDiagonalVariationNoAuthority > report.StaticDiagonalVariationNoAuthority, "transported material direction remains spatially coherent and useful")

    let a00 = AuthorityField(0, 0)
    let a55 = AuthorityField(5, 5)
    Assert.True(a55 > a00, "authority carrier remains independent and measurable")

    Assert.True(Contains(report.AuthorityRule, "explicit policy"), "authority entry remains explicit and documented")
    Assert.True(Contains(report.SeparationVerdict, "field separation survives"), "field separation remains intelligible")
    Assert.True(Contains(report.NextBoundary, "before any first tiny global solve"), "report keeps no-solver/no-global-solve boundary explicit")
}
