package ContinuumComputabilityBoundary

record ContinuumProblem2D {
    BodyWidth: Float
    BodyHeight: Float
    Query: String
}

record FiniteSites2D {
    X: Float[]
    Y: Float[]
}

record SiteUnknowns2D {
    Ux: Float[]
    Uy: Float[]
    IsSolved: Bool[]
}

record LoweredProblem2D {
    Source: ContinuumProblem2D
    Sites: FiniteSites2D
    Unknowns: SiteUnknowns2D
    QueryTarget: String
}

record SiteFluxRelation2D {
    I: Int[]
    J: Int[]
    Dx: Float[]
    Dy: Float[]
    Amount: Float[]
}

record SiteFluxBalance2D {
    IncomingAmount: Float[]
    OutgoingAmount: Float[]
    NetAmount: Float[]
    NetVectorX: Float[]
    NetVectorY: Float[]
}

record CouplingBoundaryReport {
    CouplingRelationChosen: String
    FluxLikeDefinition: String
    PointOnlyWhatItCanExpress: String
    FluxCarrierWhatItAdds: String
    BalanceCapabilityUnlocked: String
    PairDefinition: String
    PairDefinitionRequiredTopology: Bool
    IsTopologyRequiredNow: Bool
    NextMissingPiece: String
    Recommendation: String
}

fn TinyCantileverProblem(query: String) -> ContinuumProblem2D {
    return ContinuumProblem2D {
        BodyWidth: 2.0
        BodyHeight: 1.0
        Query: query
    }
}

fn TinyBodySites(problem: ContinuumProblem2D) -> FiniteSites2D {
    return FiniteSites2D {
        X: [0.5 * problem.BodyWidth, 0.5 * problem.BodyWidth, 1.0 * problem.BodyWidth, 1.0 * problem.BodyWidth]
        Y: [0.5 * problem.BodyHeight, 1.0 * problem.BodyHeight, 0.5 * problem.BodyHeight, 1.0 * problem.BodyHeight]
    }
}

fn AttachUnknownsToSites(sites: FiniteSites2D) -> SiteUnknowns2D {
    let _ = sites

    return SiteUnknowns2D {
        Ux: [0.0, 0.0, 0.0, 0.0]
        Uy: [0.0, 0.0, 0.0, 0.0]
        IsSolved: [false, false, false, false]
    }
}

fn LowerContinuumProblem2D(problem: ContinuumProblem2D) -> LoweredProblem2D {
    let sites = TinyBodySites(problem)
    let unknowns = AttachUnknownsToSites(sites)

    return LoweredProblem2D {
        Source: problem
        Sites: sites
        Unknowns: unknowns
        QueryTarget: "SiteUnknownDisplacement"
    }
}

fn BuildDirectedFluxPairs(sites: FiniteSites2D) -> SiteFluxRelation2D {
    let _ = sites

    return SiteFluxRelation2D {
        I: [0, 1, 0, 2]
        J: [1, 3, 2, 3]
        Dx: [0.0, 1.0, 1.0, 0.0]
        Dy: [1.0, 0.0, 0.0, 1.0]
        Amount: [2.0, 1.5, 0.5, 1.0]
    }
}

fn AccumulateDirectedFluxBalance(lowered: LoweredProblem2D, flux: SiteFluxRelation2D) -> SiteFluxBalance2D {
    let _ = lowered

    var incomingAmount = [0.0, 0.0, 0.0, 0.0]
    var outgoingAmount = [0.0, 0.0, 0.0, 0.0]
    var netAmount = [0.0, 0.0, 0.0, 0.0]
    var netVectorX = [0.0, 0.0, 0.0, 0.0]
    var netVectorY = [0.0, 0.0, 0.0, 0.0]

    for p in 0..Len(flux.I) {
        let i = flux.I[p]
        let j = flux.J[p]
        let amount = flux.Amount[p]
        let vx = amount * flux.Dx[p]
        let vy = amount * flux.Dy[p]

        outgoingAmount[i] = outgoingAmount[i] + amount
        incomingAmount[j] = incomingAmount[j] + amount

        netAmount[i] = netAmount[i] + amount
        netAmount[j] = netAmount[j] - amount

        netVectorX[i] = netVectorX[i] + vx
        netVectorY[i] = netVectorY[i] + vy
        netVectorX[j] = netVectorX[j] - vx
        netVectorY[j] = netVectorY[j] - vy
    }

    return SiteFluxBalance2D {
        IncomingAmount: incomingAmount
        OutgoingAmount: outgoingAmount
        NetAmount: netAmount
        NetVectorX: netVectorX
        NetVectorY: netVectorY
    }
}

fn ProbeCouplingBoundary(lowered: LoweredProblem2D, flux: SiteFluxRelation2D) -> CouplingBoundaryReport {
    let _ = lowered
    let _ = flux

    return CouplingBoundaryReport {
        CouplingRelationChosen: "DirectedScalarTransferAlongPair"
        FluxLikeDefinition: "Each pair entry (i->j) carries a scalar transfer amount with explicit direction vector (dx, dy); amount is interpreted as directed outgoing transfer from i and incoming transfer to j."
        PointOnlyWhatItCanExpress: "Point-only coupling over sites can store unknown slots and site values, but cannot by itself encode directed transfer amount, transfer orientation, or incoming-vs-outgoing semantics."
        FluxCarrierWhatItAdds: "Directed transfer meaning is first-class: who sends, who receives, how much is transferred, and along which direction."
        BalanceCapabilityUnlocked: "Per-site incoming, outgoing, and net transfer accumulation is computable directly from pair entries without introducing a solver or global assembly."
        PairDefinition: "Pairs remain an explicit finite list (I,J,Dx,Dy,Amount) = {(0,1,0,1,2.0), (1,3,1,0,1.5), (0,2,1,0,0.5), (2,3,0,1,1.0)}."
        PairDefinitionRequiredTopology: false
        IsTopologyRequiredNow: false
        NextMissingPiece: "Principled pair/interface selection is the next boundary; minimal topology pressure appears when pair sets must represent neighborhood correctness beyond manual lists."
        Recommendation: "Use directed flux-like pair carriers as the first interaction primitive for balance-shaped probes, while staying explicit and pre-topology until pair selection quality becomes the bottleneck."
    }
}
