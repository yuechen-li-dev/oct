package ContinuumComputabilityBoundary

[Fact]
fn ContinuumBoundaryM3BuildsDirectedFluxPairs() -> Void {
    let lowered = LowerContinuumProblem2D(TinyCantileverProblem("SolveForField"))
    let flux = BuildDirectedFluxPairs(lowered.Sites)

    Assert.Equal(4, Len(flux.I), "directed pair count")
    Assert.Equal(0, flux.I[0], "first source")
    Assert.Equal(1, flux.J[0], "first target")
    Assert.Near(0.0, flux.Dx[0], 0.0001, "first direction x")
    Assert.Near(1.0, flux.Dy[0], 0.0001, "first direction y")
    Assert.Near(1.0, flux.Dy[3], 0.0001, "last direction y")
    Assert.Near(1.5, flux.Amount[1], 0.0001, "second transfer amount")
}

[Fact]
fn ContinuumBoundaryM3AccumulatesDirectedBalanceAtSites() -> Void {
    let lowered = LowerContinuumProblem2D(TinyCantileverProblem("SolveForField"))
    let flux = BuildDirectedFluxPairs(lowered.Sites)
    let balance = AccumulateDirectedFluxBalance(lowered, flux)

    Assert.Near(2.5, balance.OutgoingAmount[0], 0.0001, "site 0 outgoing amount")
    Assert.Near(2.0, balance.IncomingAmount[1], 0.0001, "site 1 incoming amount")
    Assert.Near(0.5, balance.NetAmount[2], 0.0001, "site 2 net amount")
    Assert.Near(-2.5, balance.NetAmount[3], 0.0001, "site 3 net amount")
    Assert.Near(0.5, balance.NetVectorX[0], 0.0001, "site 0 net vector x")
    Assert.Near(-2.0, balance.NetVectorY[1], 0.0001, "site 1 net vector y")
    Assert.Near(-1.5, balance.NetVectorX[3], 0.0001, "site 3 net vector x")
}

[Fact]
fn ContinuumBoundaryM3DirectedBalanceIsDeterministic() -> Void {
    let lowered = LowerContinuumProblem2D(TinyCantileverProblem("SolveForField"))
    let flux = BuildDirectedFluxPairs(lowered.Sites)

    let first = AccumulateDirectedFluxBalance(lowered, flux)
    let second = AccumulateDirectedFluxBalance(lowered, flux)

    Assert.Near(first.NetAmount[0], second.NetAmount[0], 0.0001, "repeat call same net amount")
    Assert.Near(first.NetVectorY[2], second.NetVectorY[2], 0.0001, "repeat call same vector")
    Assert.Near(first.IncomingAmount[3], second.IncomingAmount[3], 0.0001, "repeat call same incoming")
}

[Fact]
fn ContinuumBoundaryM3BoundaryReportComparesPointVsFlux() -> Void {
    let lowered = LowerContinuumProblem2D(TinyCantileverProblem("SolveForField"))
    let flux = BuildDirectedFluxPairs(lowered.Sites)
    let boundary = ProbeCouplingBoundary(lowered, flux)

    Assert.Equal("DirectedScalarTransferAlongPair", boundary.CouplingRelationChosen, "chosen relation")
    Assert.True(Contains(boundary.FluxLikeDefinition, "scalar transfer amount"), "flux meaning is explicit")
    Assert.True(Contains(boundary.PointOnlyWhatItCanExpress, "cannot by itself encode directed transfer amount"), "point-only limitation is explicit")
    Assert.True(Contains(boundary.FluxCarrierWhatItAdds, "who sends, who receives"), "flux comparison is explicit")
    Assert.True(Contains(boundary.BalanceCapabilityUnlocked, "incoming, outgoing, and net transfer"), "balance capability is explicit")
    Assert.True(Contains(boundary.PairDefinition, "explicit finite list"), "pair policy is explicit")
    Assert.Equal(false, boundary.PairDefinitionRequiredTopology, "pair definition does not need topology")
    Assert.Equal(false, boundary.IsTopologyRequiredNow, "topology still not required")
    Assert.True(Contains(boundary.NextMissingPiece, "pair/interface selection"), "next boundary is explicit")
}
