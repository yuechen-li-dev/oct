package ContinuumComputabilityBoundary

[Fact]
fn ContinuumBoundaryM3BuildsExplicitSitePairRelation() -> Void {
    let lowered = LowerContinuumProblem2D(TinyCantileverProblem("SolveForField"))
    let pairs = BuildMinimalSitePairs(lowered.Sites)

    Assert.Equal(4, Len(pairs.I), "pair count")
    Assert.Equal(0, pairs.I[0], "first pair i")
    Assert.Equal(1, pairs.J[0], "first pair j")
    Assert.Equal(2, pairs.I[3], "last pair i")
    Assert.Equal(3, pairs.J[3], "last pair j")
    Assert.Near(1.0, pairs.Weight[2], 0.0001, "unit weight remains explicit")
}

[Fact]
fn ContinuumBoundaryM3EvaluatesPairwiseCouplingWithoutSolve() -> Void {
    let base = LowerContinuumProblem2D(TinyCantileverProblem("SolveForField"))
    let trial = LowerWithSiteUnknowns(base, [0.0, 0.5, 1.0, 1.5], [0.2, 0.2, -0.1, 0.4])
    let pairs = BuildMinimalSitePairs(trial.Sites)
    let coupling = EvaluateSiteCoupling(trial, pairs)

    Assert.Near(0.5, coupling.PairDeltaUx[0], 0.0001, "delta ux over pair (0,1)")
    Assert.Near(1.0, coupling.PairDeltaUx[1], 0.0001, "delta ux over pair (1,3)")
    Assert.Near(-0.3, coupling.PairDeltaUy[2], 0.0001, "delta uy over pair (0,2)")
    Assert.Near(0.5, coupling.PairDeltaUy[3], 0.0001, "delta uy over pair (2,3)")
    Assert.Equal(0, coupling.PairI[0], "coupling retains source index")
    Assert.Equal(3, coupling.PairJ[3], "coupling retains destination index")
}

[Fact]
fn ContinuumBoundaryM3CouplingEvaluationIsDeterministic() -> Void {
    let base = LowerContinuumProblem2D(TinyCantileverProblem("SolveForField"))
    let trial = LowerWithSiteUnknowns(base, [0.3, 0.7, 0.9, 1.1], [0.0, 0.1, 0.2, 0.3])
    let pairs = BuildMinimalSitePairs(trial.Sites)

    let first = EvaluateSiteCoupling(trial, pairs)
    let second = EvaluateSiteCoupling(trial, pairs)

    Assert.Near(first.PairDeltaUx[0], second.PairDeltaUx[0], 0.0001, "repeat call same ux delta")
    Assert.Near(first.PairDeltaUy[1], second.PairDeltaUy[1], 0.0001, "repeat call same uy delta")
    Assert.Equal(first.PairI[2], second.PairI[2], "repeat call same index map")
    Assert.Equal(first.PairJ[2], second.PairJ[2], "repeat call same index map")
}

[Fact]
fn ContinuumBoundaryM3BoundaryReportAnswersCouplingQuestions() -> Void {
    let lowered = LowerContinuumProblem2D(TinyCantileverProblem("SolveForField"))
    let pairs = BuildMinimalSitePairs(lowered.Sites)
    let boundary = ProbeCouplingBoundary(lowered, pairs)

    Assert.Equal("PairwiseDifferenceDeltaUij", boundary.CouplingRelationChosen, "chosen relation")
    Assert.True(Contains(boundary.WhyMinimal, "Δu_ij"), "minimality rationale")
    Assert.True(Contains(boundary.PairDefinition, "explicit finite index lists"), "pair definition documented")
    Assert.Equal(false, boundary.PairDefinitionRequiredTopology, "pair definition does not need topology")
    Assert.True(Contains(boundary.CapabilityUnlocked, "Site-to-site interaction"), "new capability is explicit")
    Assert.True(Contains(boundary.StillImpossible, "No consistent global operator"), "boundary keeps unsolved limits explicit")
    Assert.Equal(false, boundary.IsTopologyRequiredNow, "topology still deferrable in this pass")
    Assert.True(Contains(boundary.NextMissingPiece, "A) better pair-selection policy"), "next-piece options are explicit")
}
