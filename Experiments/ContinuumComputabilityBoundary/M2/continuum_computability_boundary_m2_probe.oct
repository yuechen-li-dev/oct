package ContinuumComputabilityBoundary

record ContinuumProblem2D {
    BodyWidth: Float
    BodyHeight: Float
    Query: String
}

record FiniteSites2D {
    X: Float[]
    Y: Float[]
}

record SiteUnknowns2D {
    Ux: Float[]
    Uy: Float[]
    IsSolved: Bool[]
}

record LoweredProblem2D {
    Source: ContinuumProblem2D
    Sites: FiniteSites2D
    Unknowns: SiteUnknowns2D
    QueryTarget: String
}

record SiteConstraintAttachment2D {
    IsUxConstrained: Bool[]
    IsUyConstrained: Bool[]
    PrescribedUx: Float[]
    PrescribedUy: Float[]
}

record SiteConstraintResidual2D {
    UxResidual: Float[]
    UyResidual: Float[]
    ActiveUx: Bool[]
    ActiveUy: Bool[]
}

record DiscreteRelationBoundaryReport {
    RelationChosen: String
    CapabilityUnlocked: String
    RequiredTopology: Bool
    RemainingBoundary: String
    Recommendation: String
}

fn TinyCantileverProblem(query: String) -> ContinuumProblem2D {
    return ContinuumProblem2D {
        BodyWidth: 2.0
        BodyHeight: 1.0
        Query: query
    }
}

fn TinyBodySites(problem: ContinuumProblem2D) -> FiniteSites2D {
    return FiniteSites2D {
        X: [0.5 * problem.BodyWidth, 0.5 * problem.BodyWidth, 1.0 * problem.BodyWidth, 1.0 * problem.BodyWidth]
        Y: [0.5 * problem.BodyHeight, 1.0 * problem.BodyHeight, 0.5 * problem.BodyHeight, 1.0 * problem.BodyHeight]
    }
}

fn AttachUnknownsToSites(sites: FiniteSites2D) -> SiteUnknowns2D {
    let _ = sites

    return SiteUnknowns2D {
        Ux: [0.0, 0.0, 0.0, 0.0]
        Uy: [0.0, 0.0, 0.0, 0.0]
        IsSolved: [false, false, false, false]
    }
}

fn LowerContinuumProblem2D(problem: ContinuumProblem2D) -> LoweredProblem2D {
    let sites = TinyBodySites(problem)
    let unknowns = AttachUnknownsToSites(sites)

    return LoweredProblem2D {
        Source: problem
        Sites: sites
        Unknowns: unknowns
        QueryTarget: "SiteUnknownDisplacement"
    }
}

fn AttachCantileverConstraintToSites(lowered: LoweredProblem2D) -> SiteConstraintAttachment2D {
    let sites = lowered.Sites

    var isUxConstrained = [false, false, false, false]
    var isUyConstrained = [false, false, false, false]
    var prescribedUx = [0.0, 0.0, 0.0, 0.0]
    var prescribedUy = [0.0, 0.0, 0.0, 0.0]

    for i in 0..Len(sites.X) {
        if sites.X[i] <= 1.0 {
            isUxConstrained[i] = true
            isUyConstrained[i] = true
            prescribedUx[i] = 0.0
            prescribedUy[i] = 0.0
        }
    }

    return SiteConstraintAttachment2D {
        IsUxConstrained: isUxConstrained
        IsUyConstrained: isUyConstrained
        PrescribedUx: prescribedUx
        PrescribedUy: prescribedUy
    }
}

fn EvaluateConstraintResidualAtSites(lowered: LoweredProblem2D, attachment: SiteConstraintAttachment2D) -> SiteConstraintResidual2D {
    let unknowns = lowered.Unknowns

    var uxResidual = [0.0, 0.0, 0.0, 0.0]
    var uyResidual = [0.0, 0.0, 0.0, 0.0]

    for i in 0..Len(unknowns.Ux) {
        if attachment.IsUxConstrained[i] {
            uxResidual[i] = unknowns.Ux[i] - attachment.PrescribedUx[i]
        }

        if attachment.IsUyConstrained[i] {
            uyResidual[i] = unknowns.Uy[i] - attachment.PrescribedUy[i]
        }
    }

    return SiteConstraintResidual2D {
        UxResidual: uxResidual
        UyResidual: uyResidual
        ActiveUx: attachment.IsUxConstrained
        ActiveUy: attachment.IsUyConstrained
    }
}

fn LowerWithSiteUnknowns(lowered: LoweredProblem2D, ux: Float[], uy: Float[]) -> LoweredProblem2D {
    return LoweredProblem2D {
        Source: lowered.Source
        Sites: lowered.Sites
        Unknowns: SiteUnknowns2D {
            Ux: ux
            Uy: uy
            IsSolved: [false, false, false, false]
        }
        QueryTarget: lowered.QueryTarget
    }
}

fn ProbeDiscreteRelationBoundary(lowered: LoweredProblem2D) -> DiscreteRelationBoundaryReport {
    let _ = lowered

    return DiscreteRelationBoundaryReport {
        RelationChosen: "SiteConstraintResidualWithoutTopology"
        CapabilityUnlocked: "A typed residual-like constraint mismatch can be evaluated at each constrained site unknown slot."
        RequiredTopology: false
        RemainingBoundary: "No site-to-site coupling operator exists; equilibrium-style interaction still requires an explicit coupling commitment."
        Recommendation: "Run one more narrow pass that introduces the first explicit coupling relation and only then decide whether topology is mandatory."
    }
}
