package Manifest

record PackageManifest {
    Name: String
    Version: String
    Description: String
    Dependencies: Dependency[]
}

record Dependency {
    Name: String
    VersionRequirement: String
}

fn Manifest() -> PackageManifest {
    return PackageManifest {
        Name: "RfMultipathRicianProbe"
        Version: "0.1.0"
        Description: "Deterministic RF M1 probe for shadowing, Rician fading, and TDL multipath composition"
        Dependencies: [
            Dependency { Name: "OctStd" VersionRequirement: "0.1.0" },
            Dependency { Name: "RF" VersionRequirement: "0.1.0" }
        ]
    }
}
