package Main

[Benchmark]
fn M1_TinyDirectBaseline_M002_N002_K002() -> Void {
    let a = Matrix.fill(2, 2, 1.25)
    let b = Matrix.fill(2, 2, -0.75)
    PROMETHEUS {
        let c = a @ b
        ConsumeMatrix(c)
    }
}

