[Benchmark]
fn MatrixMulPrometheus_M001_N001_K001() -> Void {
    let a = matrix[[-2.00]]
    let b = matrix[[-2.00]]
    PROMETHEUS {
        let c = a @ b
        ConsumeMatrix(c)
    }
}

