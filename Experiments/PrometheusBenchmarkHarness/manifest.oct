package Manifest

record PackageManifest {
    Name: String
    Version: String
    Description: String
    Dependencies: Dependency[]
}

record Dependency {
    Name: String
    VersionRequirement: String
}

fn Manifest() -> PackageManifest {
    return PackageManifest {
        Name: "PrometheusBenchmarkHarness"
        Version: "0.1.0"
        Description: "P5b M0 harness-validation experiment for compiled benchmark execution and reporting"
        Dependencies: [
            Dependency { Name: "OctStd" VersionRequirement: "0.1.0" }
        ]
    }
}
