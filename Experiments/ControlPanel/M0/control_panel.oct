package ControlPanel

record Mount {
    Handle: Int
}

record PanelState {
    PowerOn: Bool
    Mode: String
    Setpoint: Float
    Output: Float
}

fn Text(content: String) -> UI {
    return UIText(content)
}

fn Button(label: String, event: String, enabled: Bool) -> UI {
    return UIButton(label, event, enabled)
}

fn Column(children: UI[]) -> UI {
    return UIColumn(children)
}

fn Row(children: UI[]) -> UI {
    return UIRow(children)
}

fn MountUI(root: UI) -> Mount {
    return Mount { Handle: UIMount(root) }
}

fn PatchUI(mount: Mount, next: UI) -> Int {
    return UIPatch(mount.Handle, next)
}

fn UnmountUI(mount: Mount) -> Int {
    return UIUnmount(mount.Handle)
}

fn Emit(mount: Mount, event: String) -> Int ! Error {
    return UIEmit(mount.Handle, event)?
}

fn DrainEvents(mount: Mount) -> String[] {
    return UIDrainEvents(mount.Handle)
}

fn Signature(node: UI) -> String {
    return UISignature(node)
}

fn Init() -> PanelState {
    let initial = PanelState {
        PowerOn: false
        Mode: "paused"
        Setpoint: 1.0
        Output: 0.0
    }
    return Recompute(initial)
}

fn View(model: PanelState) -> UI {
    let startEnabled = model.PowerOn and model.Mode != "running"
    return Column([
        Text("Power: " + PowerLabel(model.PowerOn)),
        Text("Mode: " + model.Mode),
        Text("Setpoint: " + FormatFloat(model.Setpoint, 1)),
        Text("Output: " + FormatFloat(model.Output, 1)),
        Row([
            Button("Power On", PowerOnEvent(), model.PowerOn == false),
            Button("Power Off", PowerOffEvent(), model.PowerOn)
        ]),
        Row([
            Button("Start", StartEvent(), startEnabled),
            Button("Pause", PauseEvent(), model.Mode == "running"),
            Button("Reset", ResetEvent(), true)
        ]),
        Row([
            Button("Setpoint +", SetpointIncrementEvent(), true),
            Button("Setpoint -", SetpointDecrementEvent(), model.Setpoint > 0.0)
        ])
    ])
}

fn Update(model: PanelState, event: String) -> PanelState {
    if event == PowerOnEvent() {
        return Recompute(PanelState {
            PowerOn: true
            Mode: model.Mode
            Setpoint: model.Setpoint
            Output: model.Output
        })
    }

    if event == PowerOffEvent() {
        return Recompute(PanelState {
            PowerOn: false
            Mode: "paused"
            Setpoint: model.Setpoint
            Output: 0.0
        })
    }

    if event == StartEvent() {
        if model.PowerOn {
            return Recompute(PanelState {
                PowerOn: model.PowerOn
                Mode: "running"
                Setpoint: model.Setpoint
                Output: model.Output
            })
        }
        return model
    }

    if event == PauseEvent() {
        return Recompute(PanelState {
            PowerOn: model.PowerOn
            Mode: "paused"
            Setpoint: model.Setpoint
            Output: model.Output
        })
    }

    if event == ResetEvent() {
        return Init()
    }

    if event == SetpointIncrementEvent() {
        return Recompute(PanelState {
            PowerOn: model.PowerOn
            Mode: model.Mode
            Setpoint: model.Setpoint + 0.5
            Output: model.Output
        })
    }

    if event == SetpointDecrementEvent() {
        var next = model.Setpoint - 0.5
        if next < 0.0 {
            next = 0.0
        }

        return Recompute(PanelState {
            PowerOn: model.PowerOn
            Mode: model.Mode
            Setpoint: next
            Output: model.Output
        })
    }

    return model
}

fn Recompute(model: PanelState) -> PanelState {
    if model.PowerOn and model.Mode == "running" {
        return PanelState {
            PowerOn: model.PowerOn
            Mode: model.Mode
            Setpoint: model.Setpoint
            Output: model.Setpoint * 0.8
        }
    }

    return PanelState {
        PowerOn: model.PowerOn
        Mode: model.Mode
        Setpoint: model.Setpoint
        Output: 0.0
    }
}

fn PowerLabel(powerOn: Bool) -> String {
    if powerOn {
        return "On"
    }

    return "Off"
}

fn PowerOnEvent() -> String {
    return "panel.power.on"
}

fn PowerOffEvent() -> String {
    return "panel.power.off"
}

fn StartEvent() -> String {
    return "panel.mode.start"
}

fn PauseEvent() -> String {
    return "panel.mode.pause"
}

fn ResetEvent() -> String {
    return "panel.reset"
}

fn SetpointIncrementEvent() -> String {
    return "panel.setpoint.increment"
}

fn SetpointDecrementEvent() -> String {
    return "panel.setpoint.decrement"
}
