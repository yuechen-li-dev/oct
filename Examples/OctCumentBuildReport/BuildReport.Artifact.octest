package OctCumentBuildReport

import Artifact
import Document

[Fact]
fn EngineeringReportM1SemanticWitness() -> Void {
    let doc = BuildReport()
    Assert.Equal("Aetheris Build Report", doc.Metadata.Title, "engineering metadata")
    Assert.True(doc.Style.Body.SpaceAfterPt == 4.0, "professional theme")
    Assert.Equal(0, Len(Document.ValidateFor(doc, Document.Format.Docx)), "docx capability")
    let markdown = Document.ToMarkdown(doc)
    Assert.True(Len(markdown) > 20, "engineering figure, caption, and references rendered")
}

[Artifact]
fn Build() -> Void {
    let doc = BuildReport()
    Artifact.Markdown("aetheris_build_report.md", doc)
    Artifact.Docx("aetheris_build_report.docx", doc)
}
