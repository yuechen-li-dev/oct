package Main

import UI

// The setpoint is a thermodynamic temperature in kelvin. The `C` literal
// suffix is authoring sugar that lowers to kelvin (20.0C == 293.15K).
record Thermostat {
    Setpoint: Float<K>
    Heating: Bool
}

fn Init() -> Thermostat {
    return Thermostat {
        Setpoint: 20.0C
        Heating: false
    }
}

// Everything the UI can ask for. Update handles each case; a new message
// without a case is a compile error.
enum Msg {
    Raise
    Lower
    ToggleHeating
}

fn Update(model: Thermostat, msg: Msg) -> Thermostat {
    return match msg {
        case Msg.Raise => model with { Setpoint: model.Setpoint + 0.5K }
        case Msg.Lower => model with { Setpoint: model.Setpoint - 0.5K }
        case Msg.ToggleHeating => model with { Heating: not model.Heating }
    }
}

// Status badge: orange while heating, neutral while idle.
fn StatusStyle(heating: Bool) -> UI.Style {
    if heating {
        return UI.DefaultStyle() with {
            Background: UI.Rgb(255, 152, 0)
            Foreground: UI.Rgb(255, 255, 255)
            BorderColor: UI.Rgb(194, 108, 0)
            Radius: 4px
        }
    }
    return UI.DefaultStyle() with {
        Background: UI.Rgb(236, 239, 244)
        Foreground: UI.Rgb(60, 66, 80)
        BorderColor: UI.Rgb(205, 210, 220)
        Radius: 4px
    }
}

fn View(model: Thermostat) -> UI<Msg> {
    // Display in Celsius: strip the unit, then offset from kelvin.
    let celsius = BaseUnit(model.Setpoint) - 273.15
    let status = if model.Heating { "heating" } else { "idle" }
    return UI.Stack(UI.Vertical() with { Gap: 8.0 px  Padding: UI.InsetsAll(16px) }, [
        UI.Text("Setpoint: " + FormatFloat(celsius, 1) + " °C"),
        UI.Styled(StatusStyle(model.Heating), UI.Text("Status: " + status)),
        UI.Stack(UI.Horizontal() with { Gap: 8.0 px }, [
            UI.Button("Lower", Msg.Lower, celsius > 5.0),
            UI.Button("Raise", Msg.Raise, celsius < 30.0),
            UI.Button("Toggle heating", Msg.ToggleHeating, true)
        ])
    ])
}
