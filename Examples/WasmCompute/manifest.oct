package Manifest

record PackageManifest {
    Name: String
    Version: String
    Description: String
    Authors: String[]
    Date: String
    Dependencies: Dependency[]
}

record Dependency {
    Name: String
    VersionRequirement: String
}

fn Manifest() -> PackageManifest {
    return PackageManifest {
        Name: "WasmCompute"
        Version: "0.1.0"
        Authors: ["Codex"]
        Date: "2026-09-15"
        Description: "Direct current-MIR to WebAssembly numeric and control-flow example"
        Dependencies: []
    }
}
