namespace Prometheus.Examples;

stream ReductionAttributeIO {
    [binding(0)] A: readonly array<f32>;
    [binding(1)] C: readwrite array<f32>;
}

shader ReductionAttributes {
    resources ReductionAttributeIO;

    fn Sum4() -> f32 {
        return [unroll] sum i in 0u..4u { A[i] };
    }

    fn Product4() -> f32 {
        return [loop] product i in 0u..4u { A[i] + 1.0 };
    }

    stage compute [numthreads(1, 1, 1)] fn CS() -> void {
        let total: f32 = [unroll] sum i in 0u..4u { A[i] };
        let productValue: f32 = [loop] product i in 0u..4u { A[i] + 1.0 };
        C[0u] = total + productValue + Sum4() + Product4();
        return;
    }
}
