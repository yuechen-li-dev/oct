record MicroParams {
    M: u32;
    N: u32;
    Row: u32;
    Col: u32;
}

concept MicroConfig {
    Outputs: {
        M: u32 = 2u;
        N: u32 = 2u;
    };
    UseBias: bool = true;
}

config Micro2x2: MicroConfig {}

template<C: MicroConfig>
shader ComptimeForSgemmMicroKernel {
    resources {
        [binding(0)] C: readwrite array<f32>;
    }

    stage compute [numthreads(1, 1, 1)] fn CS(params: MicroParams) -> void {
        var Acc: reg_tile<f32, C.Outputs.M, C.Outputs.N> = reg_tile_zero();
        var CView: matrix_view<f32> = row_major(C, params.M, params.N);

        comptime for i in 0u..C.Outputs.M {
            comptime for j in 0u..C.Outputs.N {
                comptime if C.UseBias and not (i == 0u and j == 0u) {
                    Acc[i, j] = Acc[i, j] + 1.0;
                } else {
                    Acc[i, j] = Acc[i, j] + 2.0;
                }
            }
        }

        comptime for i in 0u..C.Outputs.M {
            comptime for j in 0u..C.Outputs.N {
                CView[params.Row + i, params.Col + j] = Acc[i, j];
            }
        }
        return;
    }
}

compile ComptimeForSgemmMicroKernel<Micro2x2> as ComptimeForSgemmMicroKernel2x2;
