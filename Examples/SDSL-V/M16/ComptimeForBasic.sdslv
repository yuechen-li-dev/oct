shader ComptimeForBasic {
    stage compute [numthreads(1, 1, 1)] fn CS() -> void {
        let Acc: reg_tile<f32, 2u, 2u> = reg_tile_zero();

        comptime for i in 0u..2u {
            comptime for j in 0u..2u {
                Acc[i, j] = Acc[i, j] + 1.0;
            }
        }
        return;
    }
}
