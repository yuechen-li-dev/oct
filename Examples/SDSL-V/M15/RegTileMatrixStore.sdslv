record StoreParams {
    M: u32;
    N: u32;
}

shader RegTileMatrixStore {
    resources {
        [binding(0)] C: readwrite array<f32>;
    }

    stage compute [numthreads(1, 1, 1)] fn CS(params: StoreParams) -> void {
        let Acc: reg_tile<f32, 2u, 2u> = reg_tile_zero();
        let CView: matrix_view<f32> = row_major(C, params.M, params.N);

        Acc[0u, 0u] = 1.0;
        Acc[0u, 1u] = 2.0;
        Acc[1u, 0u] = 3.0;
        Acc[1u, 1u] = 4.0;

        CView[0u, 0u] = Acc[0u, 0u];
        CView[0u, 1u] = Acc[0u, 1u];
        CView[1u, 0u] = Acc[1u, 0u];
        CView[1u, 1u] = Acc[1u, 1u];
        return;
    }
}
