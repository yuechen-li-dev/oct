record LoadFacts {
    linear: u32;
    row: u32;
    col: u32;
    valid: bool;
}

record DeriveRecordParams {
    Limit: u32;
    TileK: u32;
}

shader DeriveRecordBasic {
    resources {
        A: readonly array<f32>;
        C: readwrite array<f32>;
    }

    stage compute [numthreads(1, 1, 1)] fn CS(params: DeriveRecordParams) -> void {
        let AView: matrix_view<f32> = row_major(A, params.Limit, params.TileK);
        let CView: matrix_view<f32> = row_major(C, params.Limit, params.TileK);
        let load: LoadFacts = derive {
            linear = GroupThreadID.x;
            row = linear / params.TileK;
            col = linear % params.TileK;
            valid = row < params.Limit and col < params.TileK;
        };

        when {
            case load.valid -> {
                let value: f32 =
                    read AView[load.row, load.col]
                        when load.valid
                        else 0.0;
                write CView[load.row, load.col] =
                    value
                    when load.valid;
            }
            else -> {
                return;
            }
        }

        return;
    }
}
