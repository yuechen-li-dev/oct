[Fact]
fn ScalarAssertions() -> void {
    Assert.True(true);
    Assert.False(false);
    Assert.Equal(true, true);
    Assert.Equal(7, 7);
    Assert.Equal(7u, 7u);
    Assert.Equal(1.0, 1.0);
    Assert.NotEqual(7u, 8u);
    Assert.Near(1.0, 1.0001, 0.01);
}

[Theory]
[InlineData(1u, 2u)]
[InlineData(4u, 5u)]
fn TheoryArithmetic(value: u32, expected: u32) -> void {
    let result: u32 = value + 1u;
    Assert.Equal(expected, result);
}
