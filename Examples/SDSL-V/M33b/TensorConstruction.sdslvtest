fn Encode2(i: u32, j: u32) -> u32 {
    return i * 10u + j;
}

fn Encode3(i: u32, j: u32, k: u32) -> u32 {
    return i * 100u + j * 10u + k;
}

fn Encode4(a: u32, b: u32, c: u32, d: u32) -> u32 {
    return a * 1000u + b * 100u + c * 10u + d;
}

fn AddBias(value: u32, bias: u32) -> u32 {
    return value + bias;
}

fn SelectUInt(flag: bool, whenTrue: u32, whenFalse: u32) -> u32 {
    if flag {
        return whenTrue;
    }
    return whenFalse;
}

fn MatmulB(k: u32, j: u32) -> u32 {
    if k == 0u {
        if j == 0u { return 1u; }
        if j == 1u { return 0u; }
        if j == 2u { return 2u; }
        return 1u;
    }
    if k == 1u {
        if j == 0u { return 3u; }
        if j == 1u { return 1u; }
        if j == 2u { return 0u; }
        return 2u;
    }
    if j == 0u { return 1u; }
    if j == 1u { return 4u; }
    if j == 2u { return 5u; }
    return 0u;
}

[Fact]
fn Rank1Fill() -> void {
    let values: ndarray<u32, [4u]> = Fill(9u);

    Assert.Equal(9u, values[0u], "Rank1Fill must preserve its declared invariant");
    Assert.Equal(9u, values[1u], "Rank1Fill must preserve its declared invariant");
    Assert.Equal(9u, values[2u], "Rank1Fill must preserve its declared invariant");
    Assert.Equal(9u, values[3u], "Rank1Fill must preserve its declared invariant");
}

[Fact]
fn Rank2Fill() -> void {
    let values: ndarray<u32, [2u, 3u]> = Fill(7u);

    Assert.Equal(7u, values[0u, 0u], "Rank2Fill must preserve its declared invariant");
    Assert.Equal(7u, values[0u, 2u], "Rank2Fill must preserve its declared invariant");
    Assert.Equal(7u, values[1u, 0u], "Rank2Fill must preserve its declared invariant");
    Assert.Equal(7u, values[1u, 2u], "Rank2Fill must preserve its declared invariant");
}

[Fact]
fn Rank4Fill() -> void {
    let values: ndarray<u32, [2u, 2u, 2u, 3u]> = Fill(3u);

    Assert.Equal(3u, values[0u, 0u, 0u, 0u], "Rank4Fill must preserve its declared invariant");
    Assert.Equal(3u, values[0u, 1u, 1u, 2u], "Rank4Fill must preserve its declared invariant");
    Assert.Equal(3u, values[1u, 0u, 1u, 1u], "Rank4Fill must preserve its declared invariant");
    Assert.Equal(3u, values[1u, 1u, 1u, 2u], "Rank4Fill must preserve its declared invariant");
}

[Fact]
fn Rank1Generate() -> void {
    let values: ndarray<u32, [4u]> = Generate[i](i * 2u + 1u);

    Assert.Equal(1u, values[0u], "Rank1Generate must preserve its declared invariant");
    Assert.Equal(3u, values[1u], "Rank1Generate must preserve its declared invariant");
    Assert.Equal(5u, values[2u], "Rank1Generate must preserve its declared invariant");
    Assert.Equal(7u, values[3u], "Rank1Generate must preserve its declared invariant");
}

[Fact]
fn Rank2CoordinateGeneration() -> void {
    let values: ndarray<u32, [2u, 3u]> = Generate[i, j](Encode2(i, j));

    Assert.Equal(0u, values[0u, 0u], "Rank2CoordinateGeneration must preserve its declared invariant");
    Assert.Equal(1u, values[0u, 1u], "Rank2CoordinateGeneration must preserve its declared invariant");
    Assert.Equal(2u, values[0u, 2u], "Rank2CoordinateGeneration must preserve its declared invariant");
    Assert.Equal(10u, values[1u, 0u], "Rank2CoordinateGeneration must preserve its declared invariant");
    Assert.Equal(11u, values[1u, 1u], "Rank2CoordinateGeneration must preserve its declared invariant");
    Assert.Equal(12u, values[1u, 2u], "Rank2CoordinateGeneration must preserve its declared invariant");
}

[Fact]
fn Rank3Generation() -> void {
    let values: ndarray<u32, [2u, 2u, 3u]> = Generate[i, j, k](Encode3(i, j, k));

    Assert.Equal(0u, values[0u, 0u, 0u], "Rank3Generation must preserve its declared invariant");
    Assert.Equal(12u, values[0u, 1u, 2u], "Rank3Generation must preserve its declared invariant");
    Assert.Equal(101u, values[1u, 0u, 1u], "Rank3Generation must preserve its declared invariant");
    Assert.Equal(112u, values[1u, 1u, 2u], "Rank3Generation must preserve its declared invariant");
}

[Fact]
fn Rank4CoordinateEncoding() -> void {
    let values: ndarray<u32, [2u, 2u, 2u, 3u]> = Generate[a, b, c, d](Encode4(a, b, c, d));

    Assert.Equal(0u, values[0u, 0u, 0u, 0u], "Rank4CoordinateEncoding must preserve its declared invariant");
    Assert.Equal(1u, values[0u, 0u, 0u, 1u], "Rank4CoordinateEncoding must preserve its declared invariant");
    Assert.Equal(2u, values[0u, 0u, 0u, 2u], "Rank4CoordinateEncoding must preserve its declared invariant");
    Assert.Equal(1112u, values[1u, 1u, 1u, 2u], "Rank4CoordinateEncoding must preserve its declared invariant");
}

[Fact]
fn IdentityMatrixGeneration() -> void {
    let values: ndarray<u32, [3u, 3u]> = Generate[i, j](SelectUInt(i == j, 1u, 0u));

    Assert.Equal(1u, values[0u, 0u], "IdentityMatrixGeneration must preserve its declared invariant");
    Assert.Equal(0u, values[0u, 1u], "IdentityMatrixGeneration must preserve its declared invariant");
    Assert.Equal(0u, values[0u, 2u], "IdentityMatrixGeneration must preserve its declared invariant");
    Assert.Equal(0u, values[1u, 0u], "IdentityMatrixGeneration must preserve its declared invariant");
    Assert.Equal(1u, values[1u, 1u], "IdentityMatrixGeneration must preserve its declared invariant");
    Assert.Equal(0u, values[1u, 2u], "IdentityMatrixGeneration must preserve its declared invariant");
    Assert.Equal(0u, values[2u, 0u], "IdentityMatrixGeneration must preserve its declared invariant");
    Assert.Equal(0u, values[2u, 1u], "IdentityMatrixGeneration must preserve its declared invariant");
    Assert.Equal(1u, values[2u, 2u], "IdentityMatrixGeneration must preserve its declared invariant");
}

[Fact]
[TestInputUInt(5u, 7u, 11u)]
fn FillExactlyOnceSemantics() -> void {
    var counter: u32 = 0u;
    let index: u32 = 1u;
    let values: ndarray<u32, [2u, 2u]> = Fill(
        read TestInput.UInt[HLSL<u32>(counter, index) {
            counter = counter + 1u;
            return index;
        }]
            when index < TestInput.Length
            else 99u
    );

    Assert.Equal(1u, counter, "FillExactlyOnceSemantics must preserve its declared invariant");
    Assert.Equal(7u, values[0u, 0u], "FillExactlyOnceSemantics must preserve its declared invariant");
    Assert.Equal(7u, values[0u, 1u], "FillExactlyOnceSemantics must preserve its declared invariant");
    Assert.Equal(7u, values[1u, 0u], "FillExactlyOnceSemantics must preserve its declared invariant");
    Assert.Equal(7u, values[1u, 1u], "FillExactlyOnceSemantics must preserve its declared invariant");
}

[Fact]
fn GenerateExactlyOncePerCoordinate() -> void {
    var counter: u32 = 0u;
    let values: ndarray<u32, [2u, 3u]> = Generate[i, j](
        HLSL<u32>(counter, i, j) {
            counter = counter + 1u;
            return counter * 100u + i * 10u + j;
        }
    );

    Assert.Equal(6u, counter, "GenerateExactlyOncePerCoordinate must preserve its declared invariant");
    Assert.Equal(100u, values[0u, 0u], "GenerateExactlyOncePerCoordinate must preserve its declared invariant");
    Assert.Equal(201u, values[0u, 1u], "GenerateExactlyOncePerCoordinate must preserve its declared invariant");
    Assert.Equal(302u, values[0u, 2u], "GenerateExactlyOncePerCoordinate must preserve its declared invariant");
    Assert.Equal(410u, values[1u, 0u], "GenerateExactlyOncePerCoordinate must preserve its declared invariant");
    Assert.Equal(511u, values[1u, 1u], "GenerateExactlyOncePerCoordinate must preserve its declared invariant");
    Assert.Equal(612u, values[1u, 2u], "GenerateExactlyOncePerCoordinate must preserve its declared invariant");
}

[Fact]
[TestInputUInt(5u, 7u, 11u)]
fn GuardedReadGenerateBody() -> void {
    var counter: u32 = 0u;
    let values: ndarray<u32, [4u]> = Generate[i](
        read TestInput.UInt[HLSL<u32>(counter, i) {
            counter = counter + 1u;
            return i;
        }]
            when i < TestInput.Length
            else 99u
    );

    Assert.Equal(3u, counter, "GuardedReadGenerateBody must preserve its declared invariant");
    Assert.Equal(5u, values[0u], "GuardedReadGenerateBody must preserve its declared invariant");
    Assert.Equal(7u, values[1u], "GuardedReadGenerateBody must preserve its declared invariant");
    Assert.Equal(11u, values[2u], "GuardedReadGenerateBody must preserve its declared invariant");
    Assert.Equal(99u, values[3u], "GuardedReadGenerateBody must preserve its declared invariant");
}

[Fact]
fn InlineHlslGenerateBody() -> void {
    let bias: u32 = 3u;
    let values: ndarray<u32, [2u, 2u]> = Generate[i, j](
        HLSL<u32>(bias, i, j) {
            return (bias << 8u) | (i << 4u) | j;
        }
    );

    Assert.Equal(768u, values[0u, 0u], "InlineHlslGenerateBody must preserve its declared invariant");
    Assert.Equal(769u, values[0u, 1u], "InlineHlslGenerateBody must preserve its declared invariant");
    Assert.Equal(784u, values[1u, 0u], "InlineHlslGenerateBody must preserve its declared invariant");
    Assert.Equal(785u, values[1u, 1u], "InlineHlslGenerateBody must preserve its declared invariant");
}

[Fact]
fn OuterCaptureOrdinaryCallAndConditionalBody() -> void {
    let bias: u32 = 40u;
    let values: ndarray<u32, [2u, 2u]> = Generate[i, j](
        AddBias(SelectUInt(i == j, Encode2(i, j), 7u), bias)
    );

    Assert.Equal(40u, values[0u, 0u], "OuterCaptureOrdinaryCallAndConditionalBody must preserve its declared invariant");
    Assert.Equal(47u, values[0u, 1u], "OuterCaptureOrdinaryCallAndConditionalBody must preserve its declared invariant");
    Assert.Equal(47u, values[1u, 0u], "OuterCaptureOrdinaryCallAndConditionalBody must preserve its declared invariant");
    Assert.Equal(51u, values[1u, 1u], "OuterCaptureOrdinaryCallAndConditionalBody must preserve its declared invariant");
}

[Fact]
fn DenseLiteralParity() -> void {
    let denseFill: ndarray<u32, [2u, 2u]> = [7u, 7u, 7u, 7u];
    let filled: ndarray<u32, [2u, 2u]> = Fill(7u);
    let denseGenerate: ndarray<u32, [2u, 2u]> = [0u, 1u, 10u, 11u];
    let generated: ndarray<u32, [2u, 2u]> = Generate[i, j](Encode2(i, j));

    Assert.Equal(denseFill[0u, 0u], filled[0u, 0u], "DenseLiteralParity must preserve its declared invariant");
    Assert.Equal(denseFill[0u, 1u], filled[0u, 1u], "DenseLiteralParity must preserve its declared invariant");
    Assert.Equal(denseFill[1u, 0u], filled[1u, 0u], "DenseLiteralParity must preserve its declared invariant");
    Assert.Equal(denseFill[1u, 1u], filled[1u, 1u], "DenseLiteralParity must preserve its declared invariant");
    Assert.Equal(denseGenerate[0u, 0u], generated[0u, 0u], "DenseLiteralParity must preserve its declared invariant");
    Assert.Equal(denseGenerate[0u, 1u], generated[0u, 1u], "DenseLiteralParity must preserve its declared invariant");
    Assert.Equal(denseGenerate[1u, 0u], generated[1u, 0u], "DenseLiteralParity must preserve its declared invariant");
    Assert.Equal(denseGenerate[1u, 1u], generated[1u, 1u], "DenseLiteralParity must preserve its declared invariant");
}

[Fact]
fn TensorOperationConsumingGeneratedNDArray() -> void {
    let input: ndarray<u32, [2u, 3u]> = Generate[i, j](Encode2(i, j));
    var output: ndarray<u32, [2u, 3u]> = Fill(0u);
    tensor output[i, j] = input[i, j] * 2u + 1u;

    Assert.Equal(1u, output[0u, 0u], "TensorOperationConsumingGeneratedNDArray must preserve its declared invariant");
    Assert.Equal(3u, output[0u, 1u], "TensorOperationConsumingGeneratedNDArray must preserve its declared invariant");
    Assert.Equal(5u, output[0u, 2u], "TensorOperationConsumingGeneratedNDArray must preserve its declared invariant");
    Assert.Equal(21u, output[1u, 0u], "TensorOperationConsumingGeneratedNDArray must preserve its declared invariant");
    Assert.Equal(23u, output[1u, 1u], "TensorOperationConsumingGeneratedNDArray must preserve its declared invariant");
    Assert.Equal(25u, output[1u, 2u], "TensorOperationConsumingGeneratedNDArray must preserve its declared invariant");
}

[Fact]
fn MatrixMultiplicationUsingGeneratedOperands() -> void {
    let A: ndarray<u32, [2u, 3u]> = Generate[i, k](i * 3u + k + 1u);
    let B: ndarray<u32, [3u, 4u]> = Generate[k, j](MatmulB(k, j));
    var C: ndarray<u32, [2u, 4u]> = Fill(0u);
    tensor C[i, j] = Sum[k](A[i, k] * B[k, j]);

    Assert.Equal(10u, C[0u, 0u], "MatrixMultiplicationUsingGeneratedOperands must preserve its declared invariant");
    Assert.Equal(14u, C[0u, 1u], "MatrixMultiplicationUsingGeneratedOperands must preserve its declared invariant");
    Assert.Equal(17u, C[0u, 2u], "MatrixMultiplicationUsingGeneratedOperands must preserve its declared invariant");
    Assert.Equal(5u, C[0u, 3u], "MatrixMultiplicationUsingGeneratedOperands must preserve its declared invariant");
    Assert.Equal(25u, C[1u, 0u], "MatrixMultiplicationUsingGeneratedOperands must preserve its declared invariant");
    Assert.Equal(29u, C[1u, 1u], "MatrixMultiplicationUsingGeneratedOperands must preserve its declared invariant");
    Assert.Equal(38u, C[1u, 2u], "MatrixMultiplicationUsingGeneratedOperands must preserve its declared invariant");
    Assert.Equal(14u, C[1u, 3u], "MatrixMultiplicationUsingGeneratedOperands must preserve its declared invariant");
}

[WorkgroupSize(4, 1, 1)]
[DispatchGroups(2, 1, 1)]
[Fact]
fn MultipleInvocationsRemainStable() -> void {
    let base: u32 = DispatchThreadID.x * 10u;
    let values: ndarray<u32, [2u]> = Generate[i](base + i);

    Assert.Equal(DispatchThreadID.x * 10u, values[0u], "MultipleInvocationsRemainStable must preserve its declared invariant");
    Assert.Equal(DispatchThreadID.x * 10u + 1u, values[1u], "MultipleInvocationsRemainStable must preserve its declared invariant");
}
