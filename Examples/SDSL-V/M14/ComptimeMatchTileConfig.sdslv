namespace Examples.SDSLV.M14;

stream ComputeThread {
    DispatchId: uint3;
    GroupId: uint3;
    GroupThreadId: uint3;
    GroupIndex: u32;
}

stream DemoIO {
    [binding(0)] A: readonly array<f32>;
    [binding(1)] C: readwrite array<f32>;
}

record Params {
    Count: u32;
}

concept TileConfig {
    Threads: {
        X: u32 = 16u;
        Y: u32 = 1u;
    };
    Tile: {
        M: u32 = 16u;
        N: u32 = 16u;
        K: u32 = 16u;
    };
    UseFastPath: bool = true;
}

config Tile16: TileConfig {
    Threads.X => 16u;
    Threads.Y => 1u;
    Tile.M => 16u;
    Tile.N => 16u;
    Tile.K => 16u;
    UseFastPath => true;
}

template<C: TileConfig>
shader M14ComptimeMatchTileConfig {
    resources DemoIO;
    workgroup Tile: tile<f32, C.Tile.M, C.Tile.K>;

    stage compute [numthreads(C.Threads.X, C.Threads.Y, 1u)] fn CS(thread: ComputeThread, params: Params) -> void {
        let index: u32 = thread.DispatchId.x;
        let value: f32 = 0.0;

        comptime match C.Tile.K {
            8u => {
                static assert false;
                let droppedK: u32 = 8u;
            }
            16u => {
                comptime let LocalK: u32 = 16u;
                static assert LocalK == C.Tile.K;
                if index < params.Count {
                    value = A[index];
                }
            }
            else => {
                static assert false;
                let fallbackK: u32 = 0u;
            }
        }

        comptime match C.UseFastPath {
            true => {
                static assert C.UseFastPath == true;
            }
            false => {
                static assert false;
            }
        }

        if index < params.Count {
            C[index] = value;
        }
        return;
    }
}

compile M14ComptimeMatchTileConfig<Tile16> as M14ComptimeMatchTileConfig16;
