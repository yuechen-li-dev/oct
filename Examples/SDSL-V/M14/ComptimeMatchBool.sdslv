namespace Examples.SDSLV.M14;

shader M14ComptimeMatchBool {
    stage compute [numthreads(1, 1, 1)] fn CS() -> void {
        comptime let UseFastPath: bool = true;

        comptime match UseFastPath {
            true => {
                static assert UseFastPath == true;
                let scale: f32 = 1.0;
            }
            false => {
                static assert false;
                let scale: f32 = 0.5;
            }
        }
        return;
    }
}
