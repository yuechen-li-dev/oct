namespace Sdslv.AttentionSpace.Equivalence;

type QueryHead = float4 @space(zimage.attention.query_head);
type KeyHead = float4 @space(zimage.attention.key_head);
type ValueHead = float4 @space(zimage.attention.value_head);
type PositionedQueryHead = float4 @space(zimage.attention.positioned_query_head);
type PositionedKeyHead = float4 @space(zimage.attention.positioned_key_head);
type Score = float4 @space(zimage.attention.score);
type Probability = float4 @space(zimage.attention.probability);
type Output = float4 @space(zimage.attention.output);

stream ComputeThread {
    DispatchId: uint3;
    GroupId: uint3;
    GroupThreadId: uint3;
    GroupIndex: u32;
}

stream EquivalenceIO {
    [binding(0)] Input: readonly array<f32>;
    [binding(1)] OutputBuffer: readwrite array<f32>;
}

fn ProjectQuery(value: float4) -> QueryHead { return float4(value.x, value.y, value.z, value.w); }
fn ProjectKey(value: float4) -> KeyHead { return float4(value.x, value.y, value.z, value.w); }
fn ProjectValue(value: float4) -> ValueHead { return float4(value.x, value.y, value.z, value.w); }
fn ApplyQueryRoPE(value: QueryHead) -> PositionedQueryHead { return float4(value.x, value.y, value.z, value.w); }
fn ApplyKeyRoPE(value: KeyHead) -> PositionedKeyHead { return float4(value.x, value.y, value.z, value.w); }
fn Pair(query: PositionedQueryHead, key: PositionedKeyHead) -> Score { return float4(query.x * key.x, query.y * key.y, query.z * key.z, query.w * key.w); }
fn NormalizeScores(value: Score) -> Probability { return float4(value.x, value.y, value.z, value.w); }
fn AggregateValues(probability: Probability, value: ValueHead) -> Output { return float4(probability.x * value.x, probability.y * value.y, probability.z * value.z, probability.w * value.w); }

shader GroupedSpaceEquivalence {
    resources EquivalenceIO;
    stage compute [numthreads(1u, 1u, 1u)] fn CS(thread: ComputeThread) -> void {
        let input: float4 = float4(Input[0u], Input[1u], Input[2u], Input[3u]);
        let scoreValue: Score = Pair(ApplyQueryRoPE(ProjectQuery(input)), ApplyKeyRoPE(ProjectKey(input)));
        let probability: Probability = NormalizeScores(scoreValue);
        let output: Output = AggregateValues(probability, ProjectValue(input));
        OutputBuffer[thread.GroupIndex] = output.x;
        return;
    }
}
