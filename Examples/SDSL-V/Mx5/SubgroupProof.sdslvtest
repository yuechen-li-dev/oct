// Mx5 uses SDSL-V's established typed HLSL escape hatch for the two pending
// M5b wave operations.  The source remains compiler-owned through normal
// SDSL-V parsing, validation, HLSL emission, DXC, SPIR-V validation, and the
// native assertion host.
[WorkgroupSize(32, 1, 1)]
[DispatchGroups(2, 1, 1)]
[Fact]
 [TestInputUInt(31u)]
fn ProductionSubgroupMaximumAndShuffle() -> void {
    let maximum: f32 = HLSL<f32> {
        return WaveActiveMax(float(DispatchThreadID.x % 32u));
    };
    let sourceLane: u32 = read TestInput.UInt[0u] when 0u < TestInput.Length else 31u;
    let sourceZero: f32 = HLSL<f32> {
        uint subgroup = DispatchThreadID.x / 32u;
        uint lane = DispatchThreadID.x % 32u;
        return WaveReadLaneAt(float(subgroup * 100u + lane), 0u);
    };
    let sourceThirtyOne: f32 = HLSL<f32> {
        uint subgroup = DispatchThreadID.x / 32u;
        uint lane = DispatchThreadID.x % 32u;
        return WaveReadLaneAt(float(subgroup * 100u + lane), 31u);
    };
    let dynamicSource: f32 = HLSL<f32>(sourceLane) {
        uint subgroup = DispatchThreadID.x / 32u;
        uint lane = DispatchThreadID.x % 32u;
        return WaveReadLaneAt(float(subgroup * 100u + lane), sourceLane);
    };
    let expectedZero: f32 = HLSL<f32> { return float((DispatchThreadID.x / 32u) * 100u); };
    let expectedThirtyOne: f32 = HLSL<f32> { return float((DispatchThreadID.x / 32u) * 100u + 31u); };
    Assert.Equal(maximum, 31.0, "subgroup floating maximum must be real wave arithmetic");
    Assert.Equal(sourceZero, expectedZero, "shuffle source lane zero must remain in its subgroup");
    Assert.Equal(sourceThirtyOne, expectedThirtyOne, "shuffle source lane thirty-one must remain in its subgroup");
    Assert.Equal(dynamicSource, expectedThirtyOne, "subgroup-uniform dynamic shuffle source must match the canonical source-lane loop");
}
