FROM golang:1.25 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/oct-mcp ./cmd/oct-mcp

FROM gcr.io/distroless/base-debian12:nonroot
COPY --from=build /out/oct-mcp /usr/local/bin/oct-mcp
COPY --from=build /src/Libraries /opt/oct-runtime/Libraries
USER nonroot:nonroot
ENV OCT_MCP_RUNTIME_ROOT=/opt/oct-runtime
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/oct-mcp"]
CMD ["serve", "--listen", ":8080"]
