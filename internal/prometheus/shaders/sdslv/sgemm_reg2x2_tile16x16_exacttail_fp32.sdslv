namespace Prometheus.Kernels;

stream ComputeThread {
    DispatchId: uint3;
    GroupId: uint3;
    GroupThreadId: uint3;
    GroupIndex: u32;
}

stream SgemmIO {
    [binding(0)] A: readonly array<f32>;
    [binding(1)] B: readonly array<f32>;
    [binding(2)] C: readwrite array<f32>;
}

record SgemmParams {
    m: u32;
    n: u32;
    k: u32;
}

concept RegBlockedSgemmConfig {
    Threads: {
        X: u32;
        Y: u32;
    };

    OutputsPerInvocation: {
        M: u32;
        N: u32;
    };

    Tile: {
        M: u32 = Threads.X * OutputsPerInvocation.M;
        N: u32 = Threads.Y * OutputsPerInvocation.N;
        K: u32;
    };

    Unroll: {
        K: u32 = Tile.K;
    };

    require Threads.X * Threads.Y <= 1024u;
    require Tile.M == Threads.X * OutputsPerInvocation.M;
    require Tile.N == Threads.Y * OutputsPerInvocation.N;
    require Unroll.K == Tile.K;
}

config Reg2x2Tile16x16ExactTailFp32: RegBlockedSgemmConfig {
    Threads.X => 8u;
    Threads.Y => 8u;
    OutputsPerInvocation.M => 2u;
    OutputsPerInvocation.N => 2u;
    Tile.K => 16u;
}

template<C: RegBlockedSgemmConfig>
shader SgemmReg2x2Tile16x16ExactTailFp32 {
    resources SgemmIO;

    static assert C.Threads.X * C.Threads.Y <= 1024u;
    static assert C.Tile.M == C.Threads.X * C.OutputsPerInvocation.M;
    static assert C.Tile.N == C.Threads.Y * C.OutputsPerInvocation.N;
    static assert C.Unroll.K == C.Tile.K;

    workgroup TileA: tile<f32, C.Tile.M, C.Tile.K>;
    workgroup TileB: tile<f32, C.Tile.K, C.Tile.N>;

    stage compute [numthreads(C.Threads.X, C.Threads.Y, 1u)] fn CS(thread: ComputeThread, params: SgemmParams) -> void {
        let localRow: u32 = thread.GroupThreadId.x;
        let localCol: u32 = thread.GroupThreadId.y;
        let localThreadLinear: u32 = localRow * C.Threads.Y + localCol;
        let groupBaseRow: u32 = thread.GroupId.x * C.Tile.M;
        let groupBaseCol: u32 = thread.GroupId.y * C.Tile.N;
        let baseRow: u32 = groupBaseRow + localRow * C.OutputsPerInvocation.M;
        let baseCol: u32 = groupBaseCol + localCol * C.OutputsPerInvocation.N;
        let localRow2: u32 = localRow * C.OutputsPerInvocation.M;
        let localCol2: u32 = localCol * C.OutputsPerInvocation.N;
        let Acc: reg_tile<f32, C.OutputsPerInvocation.M, C.OutputsPerInvocation.N> = reg_tile_zero();
        let AView: matrix_view<f32> = row_major(A, params.m, params.k);
        let BView: matrix_view<f32> = row_major(B, params.k, params.n);
        let CView: matrix_view<f32> = row_major(C, params.m, params.n);
        let tileCount: u32 = (params.k + C.Tile.K - 1u) / C.Tile.K;
        let fullOutputTile: bool =
            groupBaseRow + C.Tile.M <= params.m and
            groupBaseCol + C.Tile.N <= params.n;

        [loop]
        for tile in 0u..tileCount {
            let tileBaseK: u32 = tile * C.Tile.K;
            let fullTile: bool =
                fullOutputTile and
                tileBaseK + C.Tile.K <= params.k;

            when {
                case fullTile -> {
                    TileA[(localThreadLinear * 4u + 0u) / C.Tile.K, (localThreadLinear * 4u + 0u) % C.Tile.K] =
                        AView[
                            groupBaseRow + ((localThreadLinear * 4u + 0u) / C.Tile.K),
                            tileBaseK + ((localThreadLinear * 4u + 0u) % C.Tile.K)
                        ];
                    TileB[(localThreadLinear * 4u + 0u) / C.Tile.K, (localThreadLinear * 4u + 0u) % C.Tile.K] =
                        BView[
                            tileBaseK + ((localThreadLinear * 4u + 0u) / C.Tile.K),
                            groupBaseCol + ((localThreadLinear * 4u + 0u) % C.Tile.K)
                        ];
                    TileA[(localThreadLinear * 4u + 1u) / C.Tile.K, (localThreadLinear * 4u + 1u) % C.Tile.K] =
                        AView[
                            groupBaseRow + ((localThreadLinear * 4u + 1u) / C.Tile.K),
                            tileBaseK + ((localThreadLinear * 4u + 1u) % C.Tile.K)
                        ];
                    TileB[(localThreadLinear * 4u + 1u) / C.Tile.K, (localThreadLinear * 4u + 1u) % C.Tile.K] =
                        BView[
                            tileBaseK + ((localThreadLinear * 4u + 1u) / C.Tile.K),
                            groupBaseCol + ((localThreadLinear * 4u + 1u) % C.Tile.K)
                        ];
                    TileA[(localThreadLinear * 4u + 2u) / C.Tile.K, (localThreadLinear * 4u + 2u) % C.Tile.K] =
                        AView[
                            groupBaseRow + ((localThreadLinear * 4u + 2u) / C.Tile.K),
                            tileBaseK + ((localThreadLinear * 4u + 2u) % C.Tile.K)
                        ];
                    TileB[(localThreadLinear * 4u + 2u) / C.Tile.K, (localThreadLinear * 4u + 2u) % C.Tile.K] =
                        BView[
                            tileBaseK + ((localThreadLinear * 4u + 2u) / C.Tile.K),
                            groupBaseCol + ((localThreadLinear * 4u + 2u) % C.Tile.K)
                        ];
                    TileA[(localThreadLinear * 4u + 3u) / C.Tile.K, (localThreadLinear * 4u + 3u) % C.Tile.K] =
                        AView[
                            groupBaseRow + ((localThreadLinear * 4u + 3u) / C.Tile.K),
                            tileBaseK + ((localThreadLinear * 4u + 3u) % C.Tile.K)
                        ];
                    TileB[(localThreadLinear * 4u + 3u) / C.Tile.K, (localThreadLinear * 4u + 3u) % C.Tile.K] =
                        BView[
                            tileBaseK + ((localThreadLinear * 4u + 3u) / C.Tile.K),
                            groupBaseCol + ((localThreadLinear * 4u + 3u) % C.Tile.K)
                        ];
                }
                else -> {
                    let aValue0: f32 =
                        read AView[
                                groupBaseRow + ((localThreadLinear * 4u + 0u) / C.Tile.K),
                                tileBaseK + ((localThreadLinear * 4u + 0u) % C.Tile.K)
                            ]
                            when groupBaseRow + ((localThreadLinear * 4u + 0u) / C.Tile.K) < params.m and
                                 tileBaseK + ((localThreadLinear * 4u + 0u) % C.Tile.K) < params.k
                            else 0.0;
                    let bValue0: f32 =
                        read BView[
                                tileBaseK + ((localThreadLinear * 4u + 0u) / C.Tile.K),
                                groupBaseCol + ((localThreadLinear * 4u + 0u) % C.Tile.K)
                            ]
                            when tileBaseK + ((localThreadLinear * 4u + 0u) / C.Tile.K) < params.k and
                                 groupBaseCol + ((localThreadLinear * 4u + 0u) % C.Tile.K) < params.n
                            else 0.0;
                    let aValue1: f32 =
                        read AView[
                                groupBaseRow + ((localThreadLinear * 4u + 1u) / C.Tile.K),
                                tileBaseK + ((localThreadLinear * 4u + 1u) % C.Tile.K)
                            ]
                            when groupBaseRow + ((localThreadLinear * 4u + 1u) / C.Tile.K) < params.m and
                                 tileBaseK + ((localThreadLinear * 4u + 1u) % C.Tile.K) < params.k
                            else 0.0;
                    let bValue1: f32 =
                        read BView[
                                tileBaseK + ((localThreadLinear * 4u + 1u) / C.Tile.K),
                                groupBaseCol + ((localThreadLinear * 4u + 1u) % C.Tile.K)
                            ]
                            when tileBaseK + ((localThreadLinear * 4u + 1u) / C.Tile.K) < params.k and
                                 groupBaseCol + ((localThreadLinear * 4u + 1u) % C.Tile.K) < params.n
                            else 0.0;
                    let aValue2: f32 =
                        read AView[
                                groupBaseRow + ((localThreadLinear * 4u + 2u) / C.Tile.K),
                                tileBaseK + ((localThreadLinear * 4u + 2u) % C.Tile.K)
                            ]
                            when groupBaseRow + ((localThreadLinear * 4u + 2u) / C.Tile.K) < params.m and
                                 tileBaseK + ((localThreadLinear * 4u + 2u) % C.Tile.K) < params.k
                            else 0.0;
                    let bValue2: f32 =
                        read BView[
                                tileBaseK + ((localThreadLinear * 4u + 2u) / C.Tile.K),
                                groupBaseCol + ((localThreadLinear * 4u + 2u) % C.Tile.K)
                            ]
                            when tileBaseK + ((localThreadLinear * 4u + 2u) / C.Tile.K) < params.k and
                                 groupBaseCol + ((localThreadLinear * 4u + 2u) % C.Tile.K) < params.n
                            else 0.0;
                    let aValue3: f32 =
                        read AView[
                                groupBaseRow + ((localThreadLinear * 4u + 3u) / C.Tile.K),
                                tileBaseK + ((localThreadLinear * 4u + 3u) % C.Tile.K)
                            ]
                            when groupBaseRow + ((localThreadLinear * 4u + 3u) / C.Tile.K) < params.m and
                                 tileBaseK + ((localThreadLinear * 4u + 3u) % C.Tile.K) < params.k
                            else 0.0;
                    let bValue3: f32 =
                        read BView[
                                tileBaseK + ((localThreadLinear * 4u + 3u) / C.Tile.K),
                                groupBaseCol + ((localThreadLinear * 4u + 3u) % C.Tile.K)
                            ]
                            when tileBaseK + ((localThreadLinear * 4u + 3u) / C.Tile.K) < params.k and
                                 groupBaseCol + ((localThreadLinear * 4u + 3u) % C.Tile.K) < params.n
                            else 0.0;

                    TileA[(localThreadLinear * 4u + 0u) / C.Tile.K, (localThreadLinear * 4u + 0u) % C.Tile.K] = aValue0;
                    TileB[(localThreadLinear * 4u + 0u) / C.Tile.K, (localThreadLinear * 4u + 0u) % C.Tile.K] = bValue0;
                    TileA[(localThreadLinear * 4u + 1u) / C.Tile.K, (localThreadLinear * 4u + 1u) % C.Tile.K] = aValue1;
                    TileB[(localThreadLinear * 4u + 1u) / C.Tile.K, (localThreadLinear * 4u + 1u) % C.Tile.K] = bValue1;
                    TileA[(localThreadLinear * 4u + 2u) / C.Tile.K, (localThreadLinear * 4u + 2u) % C.Tile.K] = aValue2;
                    TileB[(localThreadLinear * 4u + 2u) / C.Tile.K, (localThreadLinear * 4u + 2u) % C.Tile.K] = bValue2;
                    TileA[(localThreadLinear * 4u + 3u) / C.Tile.K, (localThreadLinear * 4u + 3u) % C.Tile.K] = aValue3;
                    TileB[(localThreadLinear * 4u + 3u) / C.Tile.K, (localThreadLinear * 4u + 3u) % C.Tile.K] = bValue3;
                }
            }

            WorkgroupMemoryBarrierWithSync();

            [unroll]
            for kk in 0u..C.Unroll.K {
                comptime for oi in 0u..C.OutputsPerInvocation.M {
                    comptime for oj in 0u..C.OutputsPerInvocation.N {
                        Acc[oi, oj] =
                            Acc[oi, oj] +
                            TileA[localRow2 + oi, kk] * TileB[kk, localCol2 + oj];
                    }
                }
            }

            WorkgroupMemoryBarrierWithSync();
        }

        when {
            case fullOutputTile -> {
                comptime for oi in 0u..C.OutputsPerInvocation.M {
                    comptime for oj in 0u..C.OutputsPerInvocation.N {
                        CView[baseRow + oi, baseCol + oj] = Acc[oi, oj];
                    }
                }
            }
            else -> {
                comptime for oi in 0u..C.OutputsPerInvocation.M {
                    comptime for oj in 0u..C.OutputsPerInvocation.N {
                        write CView[baseRow + oi, baseCol + oj] = Acc[oi, oj]
                            when baseRow + oi < params.m and baseCol + oj < params.n;
                    }
                }
            }
        }
        return;
    }
}

compile SgemmReg2x2Tile16x16ExactTailFp32<Reg2x2Tile16x16ExactTailFp32> as SgemmReg2x2Tile16x16ExactTailFp32Kernel;
