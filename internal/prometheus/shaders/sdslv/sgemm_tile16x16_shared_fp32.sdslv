namespace Prometheus.Kernels;

stream ComputeThread {
    DispatchId: uint3;
    GroupId: uint3;
    GroupThreadId: uint3;
    GroupIndex: u32;
}

stream SgemmIO {
    [binding(0)] A: readonly array<f32>;
    [binding(1)] B: readonly array<f32>;
    [binding(2)] C: readwrite array<f32>;
}

record SgemmParams {
    m: u32;
    n: u32;
    k: u32;
}

concept SharedTileSgemmConfig {
    Threads: {
        X: u32;
        Y: u32;
    };

    OutputsPerInvocation: {
        M: u32 = 1u;
        N: u32 = 1u;
    };

    Tile: {
        M: u32 = Threads.X * OutputsPerInvocation.M;
        N: u32 = Threads.Y * OutputsPerInvocation.N;
        K: u32;
    };

    Unroll: {
        K: u32 = Tile.K;
    };

    Padding: {
        K: u32! = 0u;
    };

    require Threads.X * Threads.Y <= 1024u;
    require Tile.M == Threads.X * OutputsPerInvocation.M;
    require Tile.N == Threads.Y * OutputsPerInvocation.N;
    require Unroll.K == Tile.K;
}

config Tile16x16SharedFp32: SharedTileSgemmConfig {
    Threads.X => 16u;
    Threads.Y => 16u;
    Tile.K => 16u;
}

template<C: SharedTileSgemmConfig>
shader SgemmTileSharedFp32 {
    resources SgemmIO;

    static assert C.Threads.X * C.Threads.Y <= 1024u;
    static assert C.Tile.M == C.Threads.X * C.OutputsPerInvocation.M;
    static assert C.Tile.N == C.Threads.Y * C.OutputsPerInvocation.N;
    static assert C.Unroll.K == C.Tile.K;

    workgroup TileA: tile<f32, C.Tile.M, C.Tile.K>;
    workgroup TileB: tile<f32, C.Tile.K, C.Tile.N>;

    stage compute [numthreads(C.Threads.X, C.Threads.Y, 1u)] fn CS(thread: ComputeThread, params: SgemmParams) -> void {
        let localRow: u32 = thread.GroupThreadId.x;
        let localCol: u32 = thread.GroupThreadId.y;
        let row: u32 = thread.GroupId.x * C.Tile.M + localRow;
        let col: u32 = thread.GroupId.y * C.Tile.N + localCol;
        let acc: f32 = 0.0;
        let AView: matrix_view<f32> = row_major(A, params.m, params.k);
        let BView: matrix_view<f32> = row_major(B, params.k, params.n);
        let CView: matrix_view<f32> = row_major(C, params.m, params.n);
        let tileCount: u32 = (params.k + C.Tile.K - 1u) / C.Tile.K;

        [loop]
        for tile in 0u..tileCount {
            let tileBaseK: u32 = tile * C.Tile.K;
            let aCol: u32 = tileBaseK + localCol;
            let bRow: u32 = tileBaseK + localRow;
            let aValue: f32 = 0.0;
            let bValue: f32 = 0.0;

            if row < params.m and aCol < params.k {
                aValue = AView[row, aCol];
            }
            if bRow < params.k and col < params.n {
                bValue = BView[bRow, col];
            }

            TileA[localRow, localCol] = aValue;
            TileB[localRow, localCol] = bValue;

            WorkgroupMemoryBarrierWithSync();

            [unroll]
            for kk in 0u..C.Unroll.K {
                acc = acc + TileA[localRow, kk] * TileB[kk, localCol];
            }

            WorkgroupMemoryBarrierWithSync();
        }

        if row < params.m and col < params.n {
            CView[row, col] = acc;
        }
        return;
    }
}

compile SgemmTileSharedFp32<Tile16x16SharedFp32> as SgemmTile16x16SharedFp32;
