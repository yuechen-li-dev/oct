namespace Prometheus.Production.ZImage;

stream FusedQkvIO {
    [binding(0)] Modulated: readonly array<f32>;
    [binding(1)] QkvWeightF16: readonly array<u32>;
    [binding(2)] Qkv: readwrite array<f32>;
}

record FusedQkvParams { TokenCount: u32; ModelWidth: u32; OutputWidth: u32; Reserved: u32; }

// Fixed Z-Image contraction only: [1024,3840] x [3840,11520]. The cached
// operand is row-major [in,out], so output 0..3839 is Q, 3840..7679 is K,
// and 7680..11519 is V. Every packed binary16 lane expands directly to f32.
shader Nr0FusedQkv {
    resources FusedQkvIO;
    workgroup InputTile: tile<f32, 16u, 16u>;
    workgroup WeightTile: tile<f32, 16u, 16u>;

    stage compute [numthreads(8u, 8u, 1u)] fn CS(params: FusedQkvParams) -> void {
        let localToken: u32 = GroupThreadID.x;
        let localOutput: u32 = GroupThreadID.y;
        let localLinear: u32 = localToken * 8u + localOutput;
        let groupToken: u32 = GroupID.x * 16u;
        let groupOutput: u32 = GroupID.y * 16u;
        let token: u32 = groupToken + localToken * 2u;
        let output: u32 = groupOutput + localOutput * 2u;
        var values: reg_tile<f32, 2u, 2u> = reg_tile_zero();
        let tileCount: u32 = 240u;
        [loop]
        for tile in 0u..tileCount {
            let tileBase: u32 = tile * 16u;
            comptime for lane in 0u..4u {
                let tileIndex: u32 = localLinear * 4u + lane;
                let tileRow: u32 = tileIndex / 16u;
                let tileColumn: u32 = tileIndex % 16u;
                let weightElement: u32 = (tileBase + tileRow) * 11520u + groupOutput + tileColumn;
                let weightLanes: float2 = Unpack<F16x2>(QkvWeightF16[weightElement / 2u]);
                var weight: f32 = weightLanes.x;
                if (weightElement % 2u) != 0u { weight = weightLanes.y; }
                InputTile[tileRow, tileColumn] = Modulated[(groupToken + tileRow) * 3840u + tileBase + tileColumn];
                WeightTile[tileRow, tileColumn] = weight;
            }
            WorkgroupMemoryBarrierWithSync();
            [unroll]
            for channel in 0u..16u {
                comptime for tokenLane in 0u..2u {
                    comptime for outputLane in 0u..2u {
                        values[tokenLane, outputLane] = values[tokenLane, outputLane] +
                            InputTile[localToken * 2u + tokenLane, channel] *
                            WeightTile[channel, localOutput * 2u + outputLane];
                    }
                }
            }
            WorkgroupMemoryBarrierWithSync();
        }
        comptime for tokenLane in 0u..2u {
            comptime for outputLane in 0u..2u {
                Qkv[(token + tokenLane) * 11520u + output + outputLane] = values[tokenLane, outputLane];
            }
        }
        return;
    }
}
