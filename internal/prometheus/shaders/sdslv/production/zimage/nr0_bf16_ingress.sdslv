namespace Prometheus.Production.ZImage;
import "../shared/Bf16.sdslv" as Bf16;

// ABI-only ingress. Packed BF16 payload words are widened by moving the exact
// sixteen source bits into the high half of an IEEE-754 binary32 bit pattern.
// This source performs no model arithmetic and owns no model witness boundary.
stream Bf16IngressIO {
    [binding(0)] InputBF16: readonly array<u32>;
    [binding(1)] TimestepBF16: readonly array<u32>;
    [binding(2)] InputF32: readwrite array<f32>;
    [binding(3)] TimestepF32: readwrite array<f32>;
}

record Bf16IngressParams {
    InputElements: u32;
    TimestepElements: u32;
}

shader Nr0Bf16Ingress {
    resources Bf16IngressIO;

    stage compute [numthreads(256u, 1u, 1u)] fn CS(params: Bf16IngressParams) -> void {
        let lane: u32 = DispatchThreadID.x;
        if lane < params.InputElements {
            InputF32[lane] = Bf16.WidenBF16(InputBF16[lane / 2u], lane);
        }
        if lane < params.TimestepElements {
            TimestepF32[lane] = Bf16.WidenBF16(TimestepBF16[lane / 2u], lane);
        }
        return;
    }
}
