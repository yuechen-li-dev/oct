namespace Prometheus.Production.ZImage;

space zimage.noise_refiner {
    FfnNormalizedEmbedding: float4;
    FfnHiddenW1: float4;
    FfnHiddenW3: float4;
}

fn ProjectW1(value: FfnNormalizedEmbedding) -> FfnHiddenW1 { return float4(value.x, value.y, value.z, value.w); }
fn ProjectW3(value: FfnNormalizedEmbedding) -> FfnHiddenW3 { return float4(value.x, value.y, value.z, value.w); }

stream FfnW1W3IO {
    [binding(0)] FfnInput: readonly array<f32>;
    [binding(1)] W1F16: readonly array<u32>;
    [binding(2)] W3F16: readonly array<u32>;
    [binding(3)] W3PartA: readwrite array<f32>;
    [binding(4)] W3PartB: readwrite array<f32>;
    [binding(5)] W3PartC: readwrite array<f32>;
    [binding(6)] W1: readwrite array<f32>;
}

record FfnProjectionParams { TokenCount: u32; ModelWidth: u32; HiddenWidth: u32; Reserved: u32; }

// One fixed contraction writes independent O19 W1 and W3 witnesses. Cache
// layout is row-major [in,out]; Unpack expands IEEE binary16 directly to f32.
shader Nr0FfnW1W3 {
    resources FfnW1W3IO;

    stage compute [numthreads(8u, 8u, 1u)] fn CS(params: FfnProjectionParams) -> void {
        let token: u32 = DispatchThreadID.x;
        let output: u32 = DispatchThreadID.y;
        if token >= params.TokenCount or output >= params.HiddenWidth { return; }
        var w1: f32 = 0.0;
        var w3: f32 = 0.0;
        for channel in 0u..params.ModelWidth {
            let element: u32 = channel * params.HiddenWidth + output;
            let w1Lanes: float2 = Unpack<F16x2>(W1F16[element / 2u]);
            let w3Lanes: float2 = Unpack<F16x2>(W3F16[element / 2u]);
            var w1Weight: f32 = w1Lanes.x;
            var w3Weight: f32 = w3Lanes.x;
            if (element % 2u) != 0u { w1Weight = w1Lanes.y; w3Weight = w3Lanes.y; }
            let input: f32 = FfnInput[token * params.ModelWidth + channel];
            w1 = w1 + input * w1Weight;
            w3 = w3 + input * w3Weight;
        }
        let index: u32 = token * params.HiddenWidth + output;
        W1[index] = w1;
        if index < 3932160u { W3PartA[index] = w3; }
        if index >= 3932160u and index < 7864320u { W3PartB[index - 3932160u] = w3; }
        if index >= 7864320u { W3PartC[index - 7864320u] = w3; }
        return;
    }
}
