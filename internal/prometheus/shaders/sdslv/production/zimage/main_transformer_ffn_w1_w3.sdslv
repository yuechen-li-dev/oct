namespace Prometheus.Production.ZImage;

space zimage.main_transformer {
    JointFfnNormalizedEmbedding: float4;
    JointFfnHiddenW1: float4;
    JointFfnHiddenW3: float4;
}

stream MainTransformerFfnW1W3IO {
    [binding(0)] FfnInput: readonly array<f32>;
    [binding(1)] W1F16: readonly array<u32>;
    [binding(2)] W3F16: readonly array<u32>;
    [binding(3)] W3PartA: readwrite array<f32>;
    [binding(4)] W3PartB: readwrite array<f32>;
    [binding(5)] W3PartC: readwrite array<f32>;
    [binding(6)] W1: readwrite array<f32>;
}

record MainTransformerFfnProjectionParams { TokenCount: u32; ModelWidth: u32; HiddenWidth: u32; Reserved: u32; }

// The three W3 views are fixed native buffer aliases sized for 1056*10240
// entries. They preserve W3's independent audit lifetime without allocating a
// second full hidden tensor.
shader MainTransformerFfnW1W3 {
    resources MainTransformerFfnW1W3IO;
    workgroup InputTile: tile<f32, 16u, 16u>;
    workgroup W1Tile: tile<f32, 16u, 16u>;
    workgroup W3Tile: tile<f32, 16u, 16u>;

    stage compute [numthreads(8u, 8u, 1u)] fn CS(params: MainTransformerFfnProjectionParams) -> void {
        let localToken: u32 = GroupThreadID.x;
        let localOutput: u32 = GroupThreadID.y;
        let localLinear: u32 = localToken * 8u + localOutput;
        let groupToken: u32 = GroupID.x * 16u;
        let groupOutput: u32 = GroupID.y * 16u;
        let token: u32 = groupToken + localToken * 2u;
        let output: u32 = groupOutput + localOutput * 2u;
        var w1: reg_tile<f32, 2u, 2u> = reg_tile_zero();
        var w3: reg_tile<f32, 2u, 2u> = reg_tile_zero();
        let tileCount: u32 = 240u;
        [loop]
        for tile in 0u..tileCount {
            let tileBase: u32 = tile * 16u;
            comptime for lane in 0u..4u {
                let tileIndex: u32 = localLinear * 4u + lane;
                let tileRow: u32 = tileIndex / 16u;
                let tileColumn: u32 = tileIndex % 16u;
                let weightElement: u32 = (tileBase + tileRow) * 10240u + groupOutput + tileColumn;
                let w1Lanes: float2 = Unpack<F16x2>(W1F16[weightElement / 2u]);
                let w3Lanes: float2 = Unpack<F16x2>(W3F16[weightElement / 2u]);
                var w1Weight: f32 = w1Lanes.x;
                var w3Weight: f32 = w3Lanes.x;
                if (weightElement % 2u) != 0u { w1Weight = w1Lanes.y; w3Weight = w3Lanes.y; }
                InputTile[tileRow, tileColumn] = FfnInput[(groupToken + tileRow) * 3840u + tileBase + tileColumn];
                W1Tile[tileRow, tileColumn] = w1Weight;
                W3Tile[tileRow, tileColumn] = w3Weight;
            }
            WorkgroupMemoryBarrierWithSync();
            [unroll]
            for channel in 0u..16u {
                comptime for tokenLane in 0u..2u {
                    comptime for outputLane in 0u..2u {
                        w1[tokenLane, outputLane] = w1[tokenLane, outputLane] +
                            InputTile[localToken * 2u + tokenLane, channel] * W1Tile[channel, localOutput * 2u + outputLane];
                        w3[tokenLane, outputLane] = w3[tokenLane, outputLane] +
                            InputTile[localToken * 2u + tokenLane, channel] * W3Tile[channel, localOutput * 2u + outputLane];
                    }
                }
            }
            WorkgroupMemoryBarrierWithSync();
        }
        comptime for tokenLane in 0u..2u {
            comptime for outputLane in 0u..2u {
                let index: u32 = (token + tokenLane) * 10240u + output + outputLane;
                W1[index] = w1[tokenLane, outputLane];
                if index < 4055040u { W3PartA[index] = w3[tokenLane, outputLane]; }
                if index >= 4055040u and index < 8110080u { W3PartB[index - 4055040u] = w3[tokenLane, outputLane]; }
                if index >= 8110080u { W3PartC[index - 8110080u] = w3[tokenLane, outputLane]; }
            }
        }
        return;
    }
}
