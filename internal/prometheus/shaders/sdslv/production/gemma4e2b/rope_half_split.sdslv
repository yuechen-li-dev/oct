// Gemma 4 E2B M1 model-private RoPE. Inputs and outputs are flattened
// [token, head, component] BF16-reexpanded FP32 values. The cosine and sine
// tables are the accepted BF16 fixture values, also re-expanded to FP32. Each
// output reads both original half-pair members, so reuse can never introduce an
// in-place hazard.
namespace Prometheus.Production.Gemma4E2BM1;

stream RopeIO {
    [binding(0)] Input: readonly array<f32>;
    [binding(1)] Cosine: readonly array<f32>;
    [binding(2)] Sine: readonly array<f32>;
    [binding(3)] Output: readwrite array<f32>;
}

record RopeParams {
    TokenCount: u32;
    HeadCount: u32;
    HeadDim: u32;
    Reserved0: u32;
    Reserved1: u32;
    Reserved2: u32;
    Reserved3: u32;
    Reserved4: u32;
}

fn RoundtripBF16(value: f32) -> f32 {
    return HLSL<f32>(value) {
        uint bits = asuint(value); uint exponent = bits & 0x7f800000u;
        uint mantissa = bits & 0x007fffffu;
        if (exponent == 0x7f800000u) {
            if (mantissa == 0u) return value;
            return asfloat((((bits >> 16u) | 0x0040u) << 16u));
        }
        return asfloat(((bits + 0x00007fffu + ((bits >> 16u) & 1u)) >> 16u) << 16u);
    };
}

shader Gemma4E2BM1RopeHalfSplit {
    resources RopeIO;
    stage compute [numthreads(256u, 1u, 1u)] fn CS(params: RopeParams) -> void {
        let element: u32 = DispatchThreadID.x;
        let total: u32 = params.TokenCount * params.HeadCount * params.HeadDim;
        if element < total {
            let component: u32 = element % params.HeadDim;
            let half: u32 = params.HeadDim / 2u;
            let frequency_index: u32 = component % half;
            let token: u32 = element / (params.HeadCount * params.HeadDim);
            var pair_element: u32 = element - half;
            if component < half { pair_element = element + half; }
            let source: f32 = Input[element];
            let pair_source: f32 = Input[pair_element];
            let table_element: u32 = token * params.HeadDim + frequency_index;
            let cosine: f32 = Cosine[table_element];
            let sine: f32 = Sine[table_element];
            // The accepted portable BF16 authority rounds each product and
            // the final sum/difference at the positional boundary.
            let first_product: f32 = RoundtripBF16(source * cosine);
            let second_product: f32 = RoundtripBF16(pair_source * sine);
            var transformed: f32 = RoundtripBF16(first_product - second_product);
            if component >= half { transformed = RoundtripBF16(first_product + second_product); }
            Output[element] = transformed;
        }
        return;
    }
}
