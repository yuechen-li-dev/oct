// M28 benchmark/test-only proof of the explicit foreign-language boundary.
// Bitcast<u32> and WorkgroupBarrier are available; HLSL is deliberate here.
shader InlineHlslBitCastProof {
stage compute [numthreads(1, 1, 1)] fn CS() -> void {
let bits: u32 = HLSL<u32> { return asuint(1.0); };
HLSL { GroupMemoryBarrierWithGroupSync(); }
return;
}
}
