namespace Prometheus.Production.Reduction;

stream ComputeThread {
    DispatchId: uint3;
    GroupId: uint3;
    GroupThreadId: uint3;
    GroupIndex: u32;
}

stream ReductionIO {
    [binding(0)] Input: readonly array<f32>;
    [binding(1)] Auxiliary0: readwrite array<f32>;
    [binding(2)] Auxiliary1: readwrite array<f32>;
    [binding(3)] Output: readwrite array<f32>;
}

record ReductionParams {
    RowCount: u32;
    ElementsPerRow: u32;
    PartialsPerRow: u32;
    InputRowStride: u32;
    ChunkElements: u32;
    TotalElements: u32;
    StageRole: u32;
    Reserved: u32;
}

shader SoftmaxFused {
    resources ReductionIO;
    workgroup Shared: array<f32, 256u>;

    stage compute [numthreads(256u, 1u, 1u)] fn CS(thread: ComputeThread, params: ReductionParams) -> void {
        let localIndex: u32 = thread.GroupIndex;
        HLSL {
            // One workgroup owns exactly one logical row. Wave operations only
            // reduce within a subgroup; lane zero of each subgroup writes one
            // partial to workgroup memory, and subgroup zero merges those
            // partials. No cross-workgroup synchronization is assumed.
            const uint row = GroupID.x;
            const uint inputRowBase = row * params.InputRowStride;
            const uint outputRowBase = row * params.ElementsPerRow;
            const uint lane = WaveGetLaneIndex();
            const uint laneCount = WaveGetLaneCount();
            const uint subgroupIndex = localIndex / laneCount;
            const uint subgroupCount = (256u + laneCount - 1u) / laneCount;

            float localMaximum = -3.402823466e+38F;
            for (uint column = localIndex; column < params.ElementsPerRow; column += 256u) {
                localMaximum = max(localMaximum, Input[inputRowBase + column]);
            }
            const float subgroupMaximum = WaveActiveMax(localMaximum);
            if (lane == 0u) {
                Shared[subgroupIndex] = subgroupMaximum;
            }
            GroupMemoryBarrierWithGroupSync();

            float workgroupMaximum = -3.402823466e+38F;
            if (subgroupIndex == 0u) {
                const float subgroupMaximum = lane < subgroupCount ? Shared[lane] : -3.402823466e+38F;
                workgroupMaximum = WaveReadLaneFirst(WaveActiveMax(subgroupMaximum));
                if (lane == 0u) {
                    Shared[0u] = workgroupMaximum;
                }
            }
            GroupMemoryBarrierWithGroupSync();
            workgroupMaximum = Shared[0u];

            float localDenominator = 0.0F;
            for (uint column = localIndex; column < params.ElementsPerRow; column += 256u) {
                localDenominator += exp(Input[inputRowBase + column] - workgroupMaximum);
            }
            const float subgroupDenominator = WaveActiveSum(localDenominator);
            if (lane == 0u) {
                Shared[subgroupIndex] = subgroupDenominator;
            }
            GroupMemoryBarrierWithGroupSync();

            float denominator = 0.0F;
            if (subgroupIndex == 0u) {
                const float subgroupDenominator = lane < subgroupCount ? Shared[lane] : 0.0F;
                denominator = WaveReadLaneFirst(WaveActiveSum(subgroupDenominator));
                if (lane == 0u) {
                    Shared[0u] = denominator;
                }
            }
            GroupMemoryBarrierWithGroupSync();
            denominator = Shared[0u];
            for (uint column = localIndex; column < params.ElementsPerRow; column += 256u) {
                Output[outputRowBase + column] = exp(Input[inputRowBase + column] - workgroupMaximum) / denominator;
            }
        }
        return;
    }
}
