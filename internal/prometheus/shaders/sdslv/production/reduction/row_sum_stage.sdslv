namespace Prometheus.Production.Reduction;

stream ComputeThread {
    DispatchId: uint3;
    GroupId: uint3;
    GroupThreadId: uint3;
    GroupIndex: u32;
}

stream ReductionIO {
    [binding(0)] Input: readonly array<f32>;
    [binding(1)] Auxiliary0: readwrite array<f32>;
    [binding(2)] Auxiliary1: readwrite array<f32>;
    [binding(3)] Output: readwrite array<f32>;
}

record ReductionParams {
    RowCount: u32;
    ElementsPerRow: u32;
    PartialsPerRow: u32;
    InputRowStride: u32;
    ChunkElements: u32;
    TotalElements: u32;
    StageRole: u32;
    Reserved: u32;
}

enum ReductionLane {
    Idle;
    Active { Partner: f32; }
}

shader RowSumStage {
    resources ReductionIO;
    workgroup Shared: array<f32, 256u>;

    fn SelectLane(index: u32, stride: u32) -> ReductionLane {
        if index < stride {
            return ReductionLane.Active { Partner: Shared[index + stride] };
        }
        return ReductionLane.Idle;
    }

    stage compute [numthreads(256u, 1u, 1u)] fn CS(thread: ComputeThread, params: ReductionParams) -> void {
        let group: u32 = thread.GroupId.x;
        let row: u32 = group / params.PartialsPerRow;
        let partial: u32 = group - row * params.PartialsPerRow;
        let begin: u32 = partial * params.ChunkElements;
        let requestedEnd: u32 = begin + params.ChunkElements;
        var end: u32 = requestedEnd;
        if end > params.ElementsPerRow {
            end = params.ElementsPerRow;
        }

        var value: f32 = 0.0;
        for element in begin + thread.GroupIndex..end step 256u {
            value = value + Input[row * params.InputRowStride + element];
        }
        Shared[thread.GroupIndex] = value;
        WorkgroupMemoryBarrierWithSync();

        var stride: u32 = 128u;
        for round in 0u..8u step 1u {
            let lane: ReductionLane = SelectLane(thread.GroupIndex, stride);
            let reduced: f32 = match lane {
                ReductionLane.Idle => Shared[thread.GroupIndex]
                ReductionLane.Active(payload) => Shared[thread.GroupIndex] + payload.Partner
            };
            if thread.GroupIndex < stride {
                Shared[thread.GroupIndex] = reduced;
            }
            WorkgroupMemoryBarrierWithSync();
            stride = stride / 2u;
        }
        if thread.GroupIndex < 1u {
            Output[group] = Shared[0u];
        }
        return;
    }
}
