vdmir module Prometheus.Audit
record SgemmParams
  field m: u32
  field n: u32
  field k: u32
stream SgemmIO
resource readonly A: array<f32> bundle SgemmIO binding(0,0)
resource readonly B: array<f32> bundle SgemmIO binding(1,0)
resource readwrite C: array<f32> bundle SgemmIO binding(2,0)
function CS -> void emitted SgemmB2x2_CS
  param params: record SgemmParams
  local a00: f32
  local a01: f32
  local a10: f32
  local a11: f32
  local av0: f32
  local av1: f32
  local bv0: f32
  local bv1: f32
  local c0: u32
  local c1: u32
  local kk: u32
  local r0: u32
  local r1: u32
  let r0: u32 = (DispatchThreadID.x * 2u)
  let r1: u32 = (r0 + 1u)
  let c0: u32 = (DispatchThreadID.y * 2u)
  let c1: u32 = (c0 + 1u)
  let a00: f32 = 0.0
  let a01: f32 = 0.0
  let a10: f32 = 0.0
  let a11: f32 = 0.0
  for kk: u32 in 0u..params.k step 1
    let av0: f32 = guarded_read(A[((r0 * params.k) + kk)] when (r0 < params.m) else 0.0)
    let av1: f32 = guarded_read(A[((r1 * params.k) + kk)] when (r1 < params.m) else 0.0)
    let bv0: f32 = guarded_read(B[((kk * params.n) + c0)] when (c0 < params.n) else 0.0)
    let bv1: f32 = guarded_read(B[((kk * params.n) + c1)] when (c1 < params.n) else 0.0)
    assign a00 = (a00 + (av0 * bv0))
    assign a01 = (a01 + (av0 * bv1))
    assign a10 = (a10 + (av1 * bv0))
    assign a11 = (a11 + (av1 * bv1))
  guarded_write C[((r0 * params.n) + c0)] = a00 when ((r0 < params.m) && (c0 < params.n))
  guarded_write C[((r0 * params.n) + c1)] = a01 when ((r0 < params.m) && (c1 < params.n))
  guarded_write C[((r1 * params.n) + c0)] = a10 when ((r1 < params.m) && (c0 < params.n))
  guarded_write C[((r1 * params.n) + c1)] = a11 when ((r1 < params.m) && (c1 < params.n))
  return
entry compute SgemmB2x2_CS numthreads(8,8,1)
  function CS
  param params: record SgemmParams
  builtin DispatchThreadID: uint3 semantic SV_DispatchThreadID referenced=true
  builtin GroupThreadID: uint3 semantic SV_GroupThreadID referenced=false
  builtin GroupID: uint3 semantic SV_GroupID referenced=false
  builtin GroupIndex: u32 semantic SV_GroupIndex referenced=false
