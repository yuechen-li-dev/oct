namespace Prometheus.Audit;
stream SgemmIO { [binding(0)] A: readonly array<f32>; [binding(1)] B: readonly array<f32>; [binding(2)] C: readwrite array<f32>; }
record SgemmParams { m: u32; n: u32; k: u32; }
shader SgemmB2x2 {
resources SgemmIO;
stage compute [numthreads(8, 8, 1)] fn CS(params: SgemmParams) -> void {
let r0: u32 = DispatchThreadID.x * 2u; let r1: u32 = r0 + 1u;
let c0: u32 = DispatchThreadID.y * 2u; let c1: u32 = c0 + 1u;
var a00: f32 = 0.0; var a01: f32 = 0.0; var a10: f32 = 0.0; var a11: f32 = 0.0;
for kk in 0u..params.k {
let av0: f32 = read A[r0 * params.k + kk] when r0 < params.m else 0.0;
let av1: f32 = read A[r1 * params.k + kk] when r1 < params.m else 0.0;
let bv0: f32 = read B[kk * params.n + c0] when c0 < params.n else 0.0;
let bv1: f32 = read B[kk * params.n + c1] when c1 < params.n else 0.0;
a00 = a00 + av0 * bv0; a01 = a01 + av0 * bv1; a10 = a10 + av1 * bv0; a11 = a11 + av1 * bv1;
}
write C[r0 * params.n + c0] = a00 when r0 < params.m and c0 < params.n;
write C[r0 * params.n + c1] = a01 when r0 < params.m and c1 < params.n;
write C[r1 * params.n + c0] = a10 when r1 < params.m and c0 < params.n;
write C[r1 * params.n + c1] = a11 when r1 < params.m and c1 < params.n;
return;
}}
