namespace Prometheus.Audit;
stream HalfIO { [binding(0)] A: readonly array<u32>; [binding(1)] B: readonly array<u32>; [binding(2)] C: readwrite array<f32>; }
record SgemmParams { m:u32; n:u32; k:u32; }
shader SgemmFp16StorageFp32Accum { resources HalfIO;
stage compute [numthreads(8,8,1)] fn CS(params:SgemmParams)->void {
let row:u32=DispatchThreadID.x; let col:u32=DispatchThreadID.y; if row>=params.m{return;} if col>=params.n{return;} let acc:f32=0.0;
for kk in 0u..params.k { let ai:u32=row*params.k+kk; let bi:u32=kk*params.n+col; let aw:u32=A[ai/2u]; let bw:u32=B[bi/2u];
let av:float2=HLSL<float2>{ return f16tof32(uint2(aw & 65535u, aw >> 16u)); };
let bv:float2=HLSL<float2>{ return f16tof32(uint2(bw & 65535u, bw >> 16u)); };
let a:f32=HLSL<f32>{ return (ai & 1u) == 0u ? av.x : av.y; }; let b:f32=HLSL<f32>{ return (bi & 1u) == 0u ? bv.x : bv.y; }; acc=acc+a*b; }
C[row*params.n+col]=acc; return; }}
