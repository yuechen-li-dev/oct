package Manifest

record PackageManifest {
    Name: String
    Version: String
    Description: String
    Dependencies: Dependency[]
    Authors: String[]
    Date: String
    Kind: String
}

record Dependency {
    Name: String
    VersionRequirement: String
}

record ModelBlock {
    Name: String
    Assembly: String
    Parameters: String
    Cache: String
    Oracle: String
}

record ResidentStream {
    Role: String
    Producer: String
    SemanticAbi: String
    Dtype: String
    Tokens: Int
    Width: Int
    Layout: String
    Bytes: Int
    Generation: String
    Lifetime: String
    Consumers: String
    Mutability: String
    Alias: String
    Transport: String
}

record ModelManifest {
    Name: String
    Revision: String
    Checkpoint: String
    Runtime: String
    Precision: String
    InputAbi: String
    OutputAbi: String
    Blocks: ModelBlock[]
    Flow: String
    Export: String
    AuditProfile: String
    ResidentStreams: ResidentStream[]
}

fn Manifest() -> PackageManifest {
    return PackageManifest {
        Name: "ZImageTurboCompiledModel"
        Version: "0.1.0"
        Description: "Resolved-source declaration for the EVT-2 compiled Z-Image Turbo subset."
        Dependencies: []
        Authors: ["yuechen-li-dev"]
        Date: "2026-07-19"
        Kind: "pure"
    }
}

