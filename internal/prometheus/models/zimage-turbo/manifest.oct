        InputAbi: "ModelEmbedding.FP32"
        OutputAbi: "ModelEmbedding.FP32"
        Blocks: [
            ModelBlock {
                Name: "NoiseRefiner0"
                Assembly: "NoiseRefiner"
                Parameters: "noise_refiner.0"
