        Name: "ZImageTurbo"
        Revision: "f332072aa78be7aecdf3ee76d5c247082da564a6"
        Checkpoint: "sha256:2407613050b809ffdff18a4ac99af83ea6b95443ecebdf80e064a79c825574a6"
        Runtime: "Prometheus.Vulkan"
        Precision: "ZImageReferenceFp32"
