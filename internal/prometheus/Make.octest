package Main

import Make

[Fact]
fn ProductionPlanUsesRealBuildTarget() -> Void {
    Assert.Equal("TestNative", Plan().Default, "native smoke is the production default")
}

[Fact]
fn ProductionPlanStagesDeclarativeShaderPackage() -> Void {
    let target = Plan().CommandTargets[0]
    Assert.Equal("StageShaderPackage", target.Name, "the Oct build owns shader package staging")
    Assert.Equal("go", target.Program, "the build calls the typed Oct CLI rather than PowerShell generation")
    Assert.Equal("../../out/prometheus/native/SerialCanonical/shaders/manifest.json", target.Outputs[0], "the staged package is colocated with the native variant")
}

[Fact]
fn NativePlanDeclaresVariantIsolation() -> Void {
    let targets = NativePlan().Targets
    Assert.Equal("SerialCanonical", targets[0].Variant, "default objects have an explicit identity")
    Assert.Equal("M5bSubgroupOwnedExperimental", targets[5].Variant, "experimental objects do not reuse default identity")
    Assert.Equal(Make.NativeKind.ObjectSet, targets[0].Kind, "common C sources are reusable objects")
}

[Fact]
fn NativePlanRetainsManifestInventory() -> Void {
    Assert.Equal("native/native_manifest.json", NativePlan().Targets[0].Manifest, "object set declares canonical inventory")
}
