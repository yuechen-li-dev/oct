package Main

import Make

[Fact]
fn ProductionPlanUsesRealBuildTarget() -> Void {
    Assert.Equal("TestNative", Plan().Default, "native smoke is the production default")
}

[Fact]
fn NativePlanDeclaresVariantIsolation() -> Void {
    let targets = NativePlan().Targets
    Assert.Equal("SerialCanonical", targets[0].Variant, "default objects have an explicit identity")
    Assert.Equal("M5bSubgroupOwnedExperimental", targets[5].Variant, "experimental objects do not reuse default identity")
    Assert.Equal(Make.NativeKind.ObjectSet, targets[0].Kind, "common C sources are reusable objects")
}
