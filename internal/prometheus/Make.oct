fn TestNativeTargetDependency() -> String {
    let target = Make.PhonyTarget {
        Name: "TestNative"
        Deps: ["PrometheusDogfoodFlow"]
    }
    return target.Deps[0]
}

fn ListEnvironment() -> Int {
    return 10
}

fn CheckTools() -> Int {
    return 10
}

fn Clean() -> Int {
    return 10
}

flow PrometheusDogfoodFlow() -> Int {
    state DetectPlatform {
        goto CheckTools
    }

    state CheckTools {
        goto PrepareVulkan
    }

    state PrepareVulkan {
        goto BuildNative
    }

    state BuildNative {
        goto RunSmokeHarness
    }

    state RunSmokeHarness {
        goto Done
    }

    state Done {
        return 0
    }

    state Failed {
        return 10
    }
}
