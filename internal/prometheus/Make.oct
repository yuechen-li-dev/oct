package Main

import Make

fn DogfoodConfig() -> Make.Config {
    return Make.DefaultConfig() with {
        Profile: "PrometheusDogfood"
        StateDir: ".octmake/prometheus"
        Trace: true
        Staleness: Make.Staleness.Timestamp
    }
}

fn LinuxDogfoodConfig() -> Make.Config {
    return DogfoodConfig() with {
        Profile: "PrometheusDogfoodLinux"
    }
}

fn WindowsDogfoodConfig() -> Make.Config {
    return DogfoodConfig() with {
        Profile: "PrometheusDogfoodWindows"
    }
}

fn PrometheusDogfoodMaxSteps() -> Int {
    return 16
}

fn Plan() -> Make.Plan {
    return Make.Plan {
        Default: "TestNative"
        Config: DogfoodConfig()
        CommandTargets: [
            Make.CommandTarget {
                Name: "BuildPrometheus"
                Inputs: ["native/build_stub.sh", "native/build_windows.cmd"]
                Outputs: ["../../out/prometheus/native/marionette_tests", "../../out/prometheus/native/marionette_tests.exe"]
                Deps: ["CheckTools"]
                Program: "bash"
                Args: ["internal/prometheus/native/build_stub.sh"]
                Cwd: "../.."
                Env: []
            },
            Make.CommandTarget {
                Name: "RunHarness"
                Inputs: ["../../out/prometheus/native/marionette_tests"]
                Outputs: []
                Deps: ["BuildPrometheus"]
                Program: "out/prometheus/native/marionette_tests"
                Args: ["PrometheusNativeHarness_Smoke"]
                Cwd: "../.."
                Env: []
            }
        ]
        FunctionTargets: [
            Make.FunctionTarget {
                Name: "ListEnvironment"
                Inputs: []
                Outputs: []
                Deps: []
                Function: "ListEnvironment"
            },
            Make.FunctionTarget {
                Name: "CheckTools"
                Inputs: []
                Outputs: []
                Deps: ["ListEnvironment"]
                Function: "CheckTools"
            },
            Make.FunctionTarget {
                Name: "Clean"
                Inputs: []
                Outputs: []
                Deps: []
                Function: "Clean"
            }
        ]
        FlowTargets: [
            Make.FlowTarget {
                Name: "PrometheusDogfoodFlow"
                Inputs: []
                Outputs: []
                Deps: []
                Flow: "PrometheusDogfoodFlow"
                MaxSteps: PrometheusDogfoodMaxSteps()
            }
        ]
        PhonyTargets: [
            Make.PhonyTarget {
                Name: "TestNative"
                Deps: ["PrometheusDogfoodFlow"]
            }
        ]
    }
}

fn CommandTargetCount() -> Int { return 2 }

fn FunctionTargetCount() -> Int { return 3 }

fn FlowTargetCount() -> Int { return 1 }

fn PhonyTargetCount() -> Int { return 1 }

