record Profile {
    Name: String
}

record KeyedOneFieldValue {
    Profile: Profile
}

record table KeyedOneField {
    Key: String
    Value: KeyedOneFieldValue
}

// Json.Load<KeyedOneField>("keyed_one_field.json")?
//
// Choices:
//   $: keyed table
//     record: 0.86 = few members 1.00 x 0.86
//     keyed table: 2.64 = keys read as data 2.00 x 1.00 + values share a type 0.50 x 1.00 + many members 1.00 x 0.14
//   $["u-100"].profile: record
//     record: 3.00 = keys read as field names 2.00 x 1.00 + few members 1.00 x 1.00
//     keyed table: 0.50 = values share a type 0.50 x 1.00
