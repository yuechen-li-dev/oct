record Point {
    X: Int
}

record BPoint {
    Z: Int
}

record Point2 {
    W: Int
}

record Point3 {
    Y: Int
}

record B {
    Point: Point3
}

record NameNeedsANumber {
    Point: Point
    BPoint: BPoint
    Point2: Point2
    B: B
}

