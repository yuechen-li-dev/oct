concept ReservedNamesString {
    A: Int
}

concept ReservedNamesOption {
    B: Int
}

record table ReservedNamesMatrix {
    C: Int
}

concept ReservedNames {
    String: ReservedNamesString
    Option: ReservedNamesOption
    Matrix: ReservedNamesMatrix
}

