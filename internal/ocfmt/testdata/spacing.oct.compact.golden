fn Arrows(k:Int)->Int{
    return switch k{case 1->2 else->3}
}

flow Counter(limit:Int)->Int{
    board{
        Count:Int
    }
    state Start{
        board.Count=0
        goto Run
    }
    state Run{
        board.Count=board.Count+1
        if board.Count>=limit{return board.Count}
        goto Run
    }
}

fn Names(state:Machine,step:Int,flow:Int)->Int{
    let next=state.Count+step
    let cell=state[0]
    let scaled=flow*step
    return next-step
}
