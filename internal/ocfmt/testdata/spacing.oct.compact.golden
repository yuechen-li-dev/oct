fn Braces()->Vec2{
    let p=Vec2{X:1.0 Y:-2.0}
    while p.X<0.0{}
    let q=p with{X:3.0}
    let label=if p.X>0.0{"right"} else{"left"}
    return Vec2{X:p.X Y:q.Y}
}

fn Fallible(raw:String)->Int!Error{
    let first=Parse(raw)!
    let second=Parse(raw)?
    let third=Parse(raw)!+1
    let ok=first!=second
    return Check(first)!
}

