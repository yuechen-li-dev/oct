[Fact]
fn TrueFailure() -> void { Assert.True(false); }

[Fact]
fn FalseFailure() -> void { Assert.False(true); }

[Fact]
fn EqualBoolFailure() -> void { Assert.Equal(true, false); }

[Fact]
fn EqualIntFailure() -> void { Assert.Equal(-7, 7); }

[Fact]
fn EqualUIntFailure() -> void { Assert.Equal(7u, 8u); }

[Fact]
fn EqualFloatFailure() -> void { Assert.Equal(1.0, 1.5); }

[Fact]
fn NotEqualFailure() -> void { Assert.NotEqual(7u, 7u); }

[Fact]
fn NearFailure() -> void { Assert.Near(1.0, 1.5, 0.1); }

[Fact]
fn FirstFailureWins() -> void { Assert.Equal(1u, 2u); Assert.Equal(3u, 4u); }

[Theory]
[InlineData(1u)]
[InlineData(2u)]
fn RowSpecificFailure(value: u32) -> void { Assert.Equal(1u, value); }
