package Specimen

concept Threshold = Int {
    Require(Self >= 0, "a theorem threshold must be non-negative")
}

go fn StrictlyAbove(value: Int, threshold: Int) -> Bool

go fn Residual(trace: Int, dimension: Int, threshold: Int) -> Int

fn StaticThresholdAndDimensionContract() -> Void {
    let boundary: Threshold = 0
    Require(boundary >= 0, "the equality boundary is an admissible threshold")
    Require(14 - 3 * 4 == 2, "dimension-sensitive residual arithmetic must remain stable")
}
