# ------------------------------
coverage.out
*.coverprofile
profile.cov
cpu.pprof
mem.pprof
*.pprof

# ------------------------------
# Go workspace files
# ------------------------------
go.work
go.work.sum

# ------------------------------
# Environment / local config
# ------------------------------
.env
.env.*
!.env.example

# ------------------------------
# Editor / IDE
# ------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# ------------------------------
# OS junk
# ------------------------------
.DS_Store
Thumbs.db

# ------------------------------
# Oct / repo-local generated artifacts
# ------------------------------
*.octbin
*.bench.cpu.pprof
*.gen.go
*.mir

# Dist / temp output
dist/
.tmp/
temp/
out/

