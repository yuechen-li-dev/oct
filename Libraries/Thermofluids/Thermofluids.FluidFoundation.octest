package Thermofluids

[Fact]
fn WaterDensityAndSpecificWeightHaveExpectedScale() -> Void {
    let rho = Density(1000.0kg, 1.0m^3)!
    let gamma = SpecificWeight(rho, 9.80665m/s^2)!
    Assert.Near(1000.0, rho / (1.0kg/m^3), 0.000001, "water density")
    Assert.Near(9806.65, gamma / (1.0kg/m^2/s^2), 0.001, "water specific weight")
}

[Fact]
fn HydrostaticPressureAndBuoyancyShareRhoG() -> Void {
    let pressure = HydrostaticPressure(1000.0kg/m^3, 9.81m/s^2, 2.0m)!
    let buoyancy = BuoyantForce(1000.0kg/m^3, 9.81m/s^2, 0.002m^3)!
    Assert.Near(19620.0, pressure / (1.0kg/m/s^2), 0.001, "two metres of water head")
    Assert.Near(19.62, buoyancy / (1.0kg*m/s^2), 0.000001, "two litres displaced")
}

[Fact]
fn ContinuityDoublesVelocityWhenAreaHalves() -> Void {
    let outlet = ContinuityVelocity(0.02m^2, 3.0m/s, 0.01m^2)!
    let flow = VolumeFlowRate(0.02m^2, 3.0m/s)!
    let massFlow = MassFlowRate(1000.0kg/m^3, flow)!
    Assert.Near(6.0, outlet / (1.0m/s), 0.000000001, "incompressible continuity")
    Assert.Near(0.06, flow / (1.0m^3/s), 0.000000001, "volume flow")
    Assert.Near(60.0, massFlow / (1.0kg/s), 0.000000001, "mass flow")
}

[Fact]
fn BernoulliTermsAllCarryPressure() -> Void {
    let dynamic = DynamicPressure(1000.0kg/m^3, 4.0m/s)!
    let total = BernoulliTotalPressure(100000.0kg/m/s^2, 1000.0kg/m^3, 4.0m/s, 9.81m/s^2, 2.0m)!
    Assert.Near(8000.0, dynamic / (1.0kg/m/s^2), 0.000001, "dynamic pressure")
    Assert.Near(127620.0, total / (1.0kg/m/s^2), 0.001, "static plus dynamic plus elevation pressure")
}

[Fact]
fn PressureHeadInvertsHydrostaticPressure() -> Void {
    let pressure = HydrostaticPressure(1000.0kg/m^3, 9.81m/s^2, 3.0m)!
    let head = PressureHead(pressure, 1000.0kg/m^3, 9.81m/s^2)!
    Assert.Near(3.0, head / 1.0m, 0.000000001, "pressure head inverse")
}

[Fact]
fn HydraulicDiameterForCircularPipeReturnsDiameter() -> Void {
    let diameter = 0.1m
    let area = Pi() * diameter * diameter / 4.0
    let perimeter = Pi() * diameter
    let hydraulic = HydraulicDiameter(area, perimeter)!
    Assert.Near(0.1, hydraulic / 1.0m, 0.000000001, "4A/P for circle")
}

[Fact]
fn LaminarFrictionAndDarcyDropCompose() -> Void {
    let friction = LaminarPipeFrictionFactor(1000.0)!
    let drop = DarcyWeisbachPressureDrop(friction, 10.0m, 0.1m, 1000.0kg/m^3, 1.0m/s)!
    Assert.Near(0.064, friction, 0.000000001, "64 over Reynolds")
    Assert.Near(3200.0, drop / (1.0kg/m/s^2), 0.000001, "Darcy pressure drop")
}

[Fact]
fn HaalandCorrelationReturnsPlausibleTurbulentFactor() -> Void {
    let smooth = HaalandFrictionFactor(100000.0, 0.0)!
    let rough = HaalandFrictionFactor(100000.0, 0.01)!
    Assert.True(smooth > 0.015 and smooth < 0.02, "smooth-pipe Haaland scale")
    Assert.True(rough > smooth, "roughness increases Darcy friction factor")
}

[Fact]
fn FluidFoundationRejectsUnsupportedDomains() -> Void {
    Assert.Error(Density(1.0kg, 0.0m^3), "zero volume")
    Assert.Error(ContinuityVelocity(1.0m^2, 1.0m/s, 0.0m^2), "zero outlet area")
    Assert.Error(LaminarPipeFrictionFactor(3000.0), "transition is outside laminar formula")
    Assert.Error(HaalandFrictionFactor(3000.0, 0.0), "transition is outside Haaland policy")
}
