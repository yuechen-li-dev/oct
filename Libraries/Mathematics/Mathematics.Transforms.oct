package Mathematics

/// Reference implementation: computes the 1D discrete Fourier transform using radix-2 Cooley-Tukey.
///
/// This pure Oct implementation is kept as the readable/textbook oracle path.
/// Production programs should prefer the fft(...) builtin.
///
/// Convention (forward, unnormalized):
/// X[k] = Sum_{n=0}^{N-1} x[n] * exp(-j*2*pi*k*n/N)
///
/// Input policy (M1):
/// - Len(x) > 0
/// - Len(x) is a power of two
///
/// Rejects invalid input with Error.
fn FastFourierTransform(x: Complex[]) -> Complex[] ! Error {
    let transformed = FFTWithDirection(x, false)?
    return transformed
}

/// Computes the inverse 1D discrete Fourier transform using radix-2 Cooley-Tukey.
///
/// Convention (inverse, normalized by N):
/// x[n] = (1/N) * Sum_{k=0}^{N-1} X[k] * exp(+j*2*pi*k*n/N)
///
/// Input policy (M1):
/// - Len(X) > 0
/// - Len(X) is a power of two
///
/// Rejects invalid input with Error.
fn IFFT(X: Complex[]) -> Complex[] ! Error {
    let reconstructed = FFTWithDirection(X, true)?
    return reconstructed
}

fn FFTWithDirection(valuesIn: Complex[], inverse: Bool) -> Complex[] ! Error {
    let ok = ValidateFFTInput(valuesIn)?

    let n = Len(valuesIn)
    var values = CopyComplexArray(valuesIn)

    for i in 0 .. n {
        let j = ReverseBits(i, n)
        if j > i {
            let tmp = values[i]
            values[i] = values[j]
            values[j] = tmp
        }
    }

    var span = 2
    while span <= n {
        let halfSpan = span / 2
        let angleSign = switch {
            case inverse => 1.0
            else => 0.0 - 1.0
        }

        let phaseStep = angleSign * 2.0 * Pi() / span

        var blockStart = 0
        while blockStart < n {
            for j in 0 .. halfSpan {
                let angle = phaseStep * j
                let twiddle = Complex(Cos(angle), Sin(angle))

                let odd = values[blockStart + j + halfSpan]
                let t = twiddle * odd

                let even = values[blockStart + j]

                values[blockStart + j] = even + t
                values[blockStart + j + halfSpan] = even - t
            }

            blockStart = blockStart + span
        }

        span = span * 2
    }

    if inverse {
        let scale = 1.0 / n

        for k in 0 .. n {
            values[k] = values[k] * scale
        }
    }

    return values
}

fn ValidateFFTInput(values: Complex[]) -> Bool ! Error {
    let n = Len(values)

    let nonEmpty = ValidateFFTLength(n)?

    if not IsPowerOfTwo(n) {
        return error("FastFourierTransform/IFFT require power-of-two input length")
    }

    return true
}

fn ValidateFFTLength(length: Int) -> Bool ! Error {
    if length <= 0 {
        return error("FastFourierTransform/IFFT require non-empty input")
    }

    return true
}

fn IsPowerOfTwo(value: Int) -> Bool {
    if value <= 0 {
        return false
    }

    var n = value
    while n > 1 {
        if not IsEven(n) {
            return false
        }

        n = n / 2
    }

    return true
}

fn ReverseBits(index: Int, width: Int) -> Int {
    var value = index
    var reversed = 0
    var n = width

    while n > 1 {
        let lowBit = value - (value / 2) * 2
        reversed = reversed * 2 + lowBit
        value = value / 2
        n = n / 2
    }

    return reversed
}

fn CopyComplexArray(values: Complex[]) -> Complex[] {
    var out = [values[0]]

    for i in 1 .. Len(values) {
        out = Append(out, values[i])
    }

    return out
}
