package Mathematics

record ComplexVector {
    Real: Float[]
    Imag: Float[]
}

/// Computes the 1D discrete Fourier transform using radix-2 Cooley-Tukey.
///
/// Convention (forward, unnormalized):
/// X[k] = Sum_{n=0}^{N-1} x[n] * exp(-j*2*pi*k*n/N)
///
/// Input policy (M1):
/// - Len(x.Real) > 0
/// - Len(x.Real) == Len(x.Imag)
/// - Len(x.Real) is a power of two
///
/// Rejects invalid input with Error.
fn FFT(x: ComplexVector) -> ComplexVector ! Error {
    let transformed = FFTWithDirection(x, false)?
    return transformed
}

/// Computes the inverse 1D discrete Fourier transform using radix-2 Cooley-Tukey.
///
/// Convention (inverse, normalized by N):
/// x[n] = (1/N) * Sum_{k=0}^{N-1} X[k] * exp(+j*2*pi*k*n/N)
///
/// Input policy (M1):
/// - Len(X.Real) > 0
/// - Len(X.Real) == Len(X.Imag)
/// - Len(X.Real) is a power of two
///
/// Rejects invalid input with Error.
fn IFFT(X: ComplexVector) -> ComplexVector ! Error {
    let reconstructed = FFTWithDirection(X, true)?
    return reconstructed
}

fn FFTWithDirection(valuesIn: ComplexVector, inverse: Bool) -> ComplexVector ! Error {
    let ok = ValidateFFTInput(valuesIn)?

    let n = Len(valuesIn.Real)
    var real = CopyFloatArray(valuesIn.Real)
    var imag = CopyFloatArray(valuesIn.Imag)

    var i = 0
    while i < n {
        let j = ReverseBits(i, n)
        if j > i {
            let tmpReal = real[i]
            let tmpImag = imag[i]
            real[i] = real[j]
            imag[i] = imag[j]
            real[j] = tmpReal
            imag[j] = tmpImag
        }
        i = i + 1
    }

    var span = 2
    while span <= n {
        let halfSpan = span / 2
        let angleSign = switch {
            case inverse => 1.0
            else => 0.0 - 1.0
        }

        let phaseStep = angleSign * 2.0 * Pi() / span

        var blockStart = 0
        while blockStart < n {
            var j = 0
            while j < halfSpan {
                let angle = phaseStep * j
                let wReal = Cos(angle)
                let wImag = Sin(angle)

                let oddReal = real[blockStart + j + halfSpan]
                let oddImag = imag[blockStart + j + halfSpan]

                let tReal = wReal * oddReal - wImag * oddImag
                let tImag = wReal * oddImag + wImag * oddReal

                let evenReal = real[blockStart + j]
                let evenImag = imag[blockStart + j]

                real[blockStart + j] = evenReal + tReal
                imag[blockStart + j] = evenImag + tImag

                real[blockStart + j + halfSpan] = evenReal - tReal
                imag[blockStart + j + halfSpan] = evenImag - tImag
                j = j + 1
            }

            blockStart = blockStart + span
        }

        span = span * 2
    }

    if inverse {
        let scale = 1.0 / n

        var k = 0
        while k < n {
            real[k] = real[k] * scale
            imag[k] = imag[k] * scale
            k = k + 1
        }
    }

    return ComplexVector { Real: real Imag: imag }
}

fn ValidateFFTInput(values: ComplexVector) -> Bool ! Error {
    let nReal = Len(values.Real)
    let nImag = Len(values.Imag)

    let nonEmpty = ValidateFFTLength(nReal)?

    if nReal != nImag {
        return error("FFT/IFFT require matching real/imag lengths")
    }

    if not IsPowerOfTwo(nReal) {
        return error("FFT/IFFT require power-of-two input length")
    }

    return true
}

fn ValidateFFTLength(length: Int) -> Bool ! Error {
    if length <= 0 {
        return error("FFT/IFFT require non-empty input")
    }

    return true
}

fn IsPowerOfTwo(value: Int) -> Bool {
    if value <= 0 {
        return false
    }

    var n = value
    while n > 1 {
        if not IsEven(n) {
            return false
        }

        n = n / 2
    }

    return true
}

fn ReverseBits(index: Int, width: Int) -> Int {
    var value = index
    var reversed = 0
    var n = width

    while n > 1 {
        let lowBit = value - (value / 2) * 2
        reversed = reversed * 2 + lowBit
        value = value / 2
        n = n / 2
    }

    return reversed
}

fn CopyFloatArray(values: Float[]) -> Float[] {
    var out = [values[0]]

    var i = 1
    while i < Len(values) {
        out = Append(out, values[i])
        i = i + 1
    }

    return out
}
