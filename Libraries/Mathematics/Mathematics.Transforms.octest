package Mathematics

fn NearComplexAt(expected: Complex[], actual: Complex[], i: Int, tolerance: Float, message: String) -> Void {
    Assert.Near(Real(expected[i]), Real(actual[i]), tolerance, message + " (real)")
    Assert.Near(Imag(expected[i]), Imag(actual[i]), tolerance, message + " (imag)")
}

[Fact]
fn FFTRejectsInvalidLengthPolicy() -> Void {
    match ValidateFFTLength(0) {
        ok(v) => { Assert.True(false, "empty input must fail") }
        err(e) => { }
    }

    match FFT([Complex(1.0, 0.0), Complex(2.0, 0.0), Complex(3.0, 0.0)]) {
        ok(v) => { Assert.True(false, "non-power-of-two length must fail") }
        err(e) => { }
    }
}

[Fact]
fn FFTLengthOneAndLengthPreservation() -> Void {
    let unit = [Complex(2.5, 0.0 - 1.5)]
    let spectrum = FFT(unit)!
    Assert.Equal(1, Len(spectrum), "FFT must preserve length")
    NearComplexAt(unit, spectrum, 0, 0.000000001, "length-1 fft should be identity")

    let vector = [Complex(1.0, 2.0), Complex(3.0, 4.0), Complex(5.0, 6.0), Complex(7.0, 8.0)]
    let transformed = FFT(vector)!
    Assert.Equal(Len(vector), Len(transformed), "FFT output length must match input")
}

[Fact]
fn FFTMatchesImpulseAndConstantCases() -> Void {
    let impulse = [Complex(1.0, 0.0), Complex(0.0, 0.0), Complex(0.0, 0.0), Complex(0.0, 0.0)]
    let impulseSpectrum = FFT(impulse)!

    let expectedImpulseSpectrum = [Complex(1.0, 0.0), Complex(1.0, 0.0), Complex(1.0, 0.0), Complex(1.0, 0.0)]
    NearComplexAt(expectedImpulseSpectrum, impulseSpectrum, 0, 0.000001, "impulse bin 0")
    NearComplexAt(expectedImpulseSpectrum, impulseSpectrum, 1, 0.000001, "impulse bin 1")
    NearComplexAt(expectedImpulseSpectrum, impulseSpectrum, 2, 0.000001, "impulse bin 2")
    NearComplexAt(expectedImpulseSpectrum, impulseSpectrum, 3, 0.000001, "impulse bin 3")

    let constant = [Complex(2.0, 0.0), Complex(2.0, 0.0), Complex(2.0, 0.0), Complex(2.0, 0.0)]
    let constantSpectrum = FFT(constant)!
    let expectedConstantSpectrum = [Complex(8.0, 0.0), Complex(0.0, 0.0), Complex(0.0, 0.0), Complex(0.0, 0.0)]
    NearComplexAt(expectedConstantSpectrum, constantSpectrum, 0, 0.000001, "constant dc bin")
    NearComplexAt(expectedConstantSpectrum, constantSpectrum, 1, 0.000001, "constant bin 1")
    NearComplexAt(expectedConstantSpectrum, constantSpectrum, 2, 0.000001, "constant bin 2")
    NearComplexAt(expectedConstantSpectrum, constantSpectrum, 3, 0.000001, "constant bin 3")
}

[Fact]
fn FFTConventionSignAndNormalizationAreLocked() -> Void {
    let x = [Complex(0.0, 0.0), Complex(1.0, 0.0), Complex(0.0, 0.0), Complex(0.0, 0.0)]
    let X = FFT(x)!

    let expected = [Complex(1.0, 0.0), Complex(0.0, 0.0 - 1.0), Complex(0.0 - 1.0, 0.0), Complex(0.0, 1.0)]
    NearComplexAt(expected, X, 0, 0.000001, "k=0")
    NearComplexAt(expected, X, 1, 0.000001, "k=1 uses negative exponential sign")
    NearComplexAt(expected, X, 2, 0.000001, "k=2")
    NearComplexAt(expected, X, 3, 0.000001, "k=3")

    let recovered = IFFT(X)!
    NearComplexAt(x, recovered, 0, 0.000001, "ifft reconstruction n=0")
    NearComplexAt(x, recovered, 1, 0.000001, "ifft reconstruction n=1")
    NearComplexAt(x, recovered, 2, 0.000001, "ifft reconstruction n=2")
    NearComplexAt(x, recovered, 3, 0.000001, "ifft reconstruction n=3")
}

[Fact]
fn IFFTRoundTripNonTrivialSequence() -> Void {
    let signal = [
        Complex(0.5, 0.0 - 0.25),
        Complex(1.0, 0.75),
        Complex(0.0 - 0.5, 0.5),
        Complex(0.25, 0.0 - 1.0),
        Complex(2.0, 0.0),
        Complex(0.0 - 1.5, 0.25),
        Complex(0.75, 1.25),
        Complex(0.0, 0.0 - 0.5)
    ]

    let spectrum = FFT(signal)!
    let reconstructed = IFFT(spectrum)!

    var i = 0
    while i < Len(signal) {
        NearComplexAt(signal, reconstructed, i, 0.000001, "ifft(fft(x)) ~= x")
        i = i + 1
    }
}

[Fact]
fn FFTComposableFrequencyWorkflow() -> Void {
    let signal = [Complex(1.0, 0.0), Complex(0.0 - 1.0, 0.0), Complex(1.0, 0.0), Complex(0.0 - 1.0, 0.0)]

    let spectrum = FFT(signal)!
    let dominantMagnitude = Max(
        Max(Abs(spectrum[0]), Abs(spectrum[1])),
        Max(Abs(spectrum[2]), Abs(spectrum[3]))
    )
    Assert.True(dominantMagnitude > 2.0, "FFT spectrum should expose dominant bin magnitude")

    let filtered = [spectrum[0], Complex(0.0, 0.0), spectrum[2], Complex(0.0, 0.0)]

    let reconstructed = IFFT(filtered)!
    Assert.Equal(4, Len(reconstructed), "IFFT output length must be preserved after spectral edits")
    Assert.True(Abs(reconstructed[0]) > 0.5, "frequency-domain edits should produce deterministic time-domain output")
}
