package Mathematics

import Numerics

/// Compatibility textbook name for Numerics.CentralDiff.
fn DifferentiateCentral(f: fn(Float) -> Float, x: Float, h: Float) -> Float ! Error {
    let ok = ValidateDerivativeStep(h)?
    return Numerics.CentralDiff(f, x, h)?
}

/// Compatibility wrapper for Numerics.Trapezoid that preserves zero-width and reversed intervals.
fn IntegrateTrapezoidal(f: fn(Float) -> Float, a: Float, b: Float, n: Int) -> Float ! Error {
    let ok = ValidateIntegrationSegments(n)?

    if a == b {
        return 0.0
    }

    if a < b {
        return Numerics.Trapezoid(f, a, b, n)?
    }
    return 0.0 - Numerics.Trapezoid(f, b, a, n)?
}

/// Compatibility wrapper for Numerics.Simpson that preserves zero-width and reversed intervals.
fn IntegrateSimpson(f: fn(Float) -> Float, a: Float, b: Float, n: Int) -> Float ! Error {
    let ok = ValidateSimpsonSegments(n)?

    if a == b {
        return 0.0
    }

    if a < b {
        return Numerics.Simpson(f, a, b, n)?
    }
    return 0.0 - Numerics.Simpson(f, b, a, n)?
}

fn ValidateDerivativeStep(h: Float) -> Bool ! Error {
    if h <= 0.0 {
        return error("DifferentiateCentral requires h > 0")
    }

    return true
}

fn ValidateIntegrationSegments(n: Int) -> Bool ! Error {
    if n <= 0 {
        return error("integration requires n > 0")
    }

    return true
}

fn ValidateSimpsonSegments(n: Int) -> Bool ! Error {
    let ok = ValidateIntegrationSegments(n)?

    if not IsEven(n) {
        return error("IntegrateSimpson requires even n")
    }

    return true
}

fn IsEven(value: Int) -> Bool {
    return (value / 2) * 2 == value
}
