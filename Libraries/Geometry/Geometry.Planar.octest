package Geometry

fn InvalidRuntimeLength() -> Float < m > {
    return - 1m
}

[Fact]
fn Distance2DHandCheck() -> Void {
    let d = Distance2D(0m, 0m, 3m, 4m)
    Assert.Near(5.0, d / 1m, 0.000001, "2D distance should satisfy 3-4-5 relation")
}

[Fact]
fn PlanarAreaAndCircumferenceHandChecks() -> Void {
    let circleArea = CircleArea(2m) !
    let circleCirc = CircleCircumference(2m) !
    let rectArea = RectangleArea(3m, 4m) !
    let triArea = TriangleArea(6m, 4m) !

    Assert.Near(Pi() * 4.0, circleArea / 1m ^ 2, 0.000001, "circle area hand-check")
    Assert.Near(4.0 * Pi(), circleCirc / 1m, 0.000001, "circle circumference hand-check")
    Assert.True(rectArea == 12m ^ 2, "rectangle area hand-check")
    Assert.Near(12.0, triArea / 1m ^ 2, 0.000001, "triangle area hand-check")
}

[Fact]
fn PlanarZeroDimensionPolicy() -> Void {
    Assert.Near(0.0, CircleArea(0m) !/ 1m ^ 2, 0.000001, "zero radius circle area should be zero")
    Assert.Near(0.0, CircleCircumference(0m) !/ 1m, 0.000001, "zero radius circumference should be zero")
    Assert.Near(0.0, RectangleArea(0m, 5m) !/ 1m ^ 2, 0.000001, "zero width rectangle area should be zero")
    Assert.Near(0.0, TriangleArea(7m, 0m) !/ 1m ^ 2, 0.000001, "zero height triangle area should be zero")
}

[Fact]
fn PlanarNegativeDimensionsRejected() -> Void {
    Assert.Error(NonNegativeLength(InvalidRuntimeLength()), "negative dimensions must fail checked construction")
}

[Fact]
fn RuntimeLengthAdmissionIsReusable() -> Void ! Error {
    let raw = 3m
    let admitted = NonNegativeLength(raw) ?
    let circle = CircleArea(admitted) !
    let sphere = SphereVolume(admitted) !
    Assert.True(circle > 0m ^ 2, "admitted length is reusable for planar geometry")
    Assert.True(sphere > 0m ^ 3, "admitted length is reusable for solid geometry")
}

[Fact]
fn PlanarComposabilityChain() -> Void {
    let d = Distance2D(1m, 2m, 4m, 6m)
    let radius = NonNegativeLength(d) !
    let sweptArea = CircleArea(radius) !
    let scaled = sweptArea / 2.0

    Assert.Near(5.0, d / 1m, 0.000001, "distance in chain should remain correct")
    Assert.True(scaled > 0m ^ 2, "derived area expression should remain physically meaningful")
}

[Fact]
fn OrientationExplainsTurnDirectionAndCollinearity() -> Void {
    let origin = Point2D { X: 0.0m Y: 0.0m }
    let east = Point2D { X: 2.0m Y: 0.0m }
    let north = Point2D { X: 0.0m Y: 2.0m }
    let fartherEast = Point2D { X: 4.0m Y: 0.0m }

    Assert.Equal(1, Orientation2D(origin, east, north), "left turn should be counter-clockwise")
    Assert.Equal(-1, Orientation2D(origin, north, east), "right turn should be clockwise")
    Assert.Equal(0, Orientation2D(origin, east, fartherEast), "points on one line should be collinear")
}

[Fact]
fn PolygonShoelaceAreaAndCentroidMatchRectangle() -> Void {
    let xs: Float<m>[] = [0.0m, 4.0m, 4.0m, 0.0m]
    let ys: Float<m>[] = [0.0m, 0.0m, 2.0m, 2.0m]
    let area = PolygonArea(xs, ys)!
    let centroid = PolygonCentroid(xs, ys)!

    Assert.Near(8.0m^2, area, 0.000001m^2, "shoelace area should match width times height")
    Assert.Near(2.0m, centroid.X, 0.000001m, "rectangle centroid x should be centered")
    Assert.Near(1.0m, centroid.Y, 0.000001m, "rectangle centroid y should be centered")

    let reversedXs: Float<m>[] = [0.0m, 4.0m, 4.0m, 0.0m]
    let reversedYs: Float<m>[] = [2.0m, 2.0m, 0.0m, 0.0m]
    Assert.Near(area, PolygonArea(reversedXs, reversedYs)!, 0.000001m^2, "area should not depend on winding")
}

[Fact]
fn PolygonOperationsRejectMalformedAndDegenerateInputs() -> Void {
    let shortXs: Float<m>[] = [0.0m, 1.0m]
    let shortYs: Float<m>[] = [0.0m, 1.0m]
    Assert.Error(PolygonArea(shortXs, shortYs), "fewer than three vertices must fail")

    let xs: Float<m>[] = [0.0m, 1.0m, 2.0m]
    let ys: Float<m>[] = [0.0m, 0.0m, 0.0m]
    Assert.Error(PolygonCentroid(xs, ys), "zero-area polygon has undefined centroid")
}
