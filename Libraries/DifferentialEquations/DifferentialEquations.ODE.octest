package DifferentialEquations

fn InvalidRuntimeODEStep() -> Float { return 0.0 }
fn InvalidRuntimeODEStepCount() -> Int { return 0 }

fn DerivativeIdentity(t: Float, y: Float) -> Float {
    return y
}

[Fact]
fn EulerStepMatchesExplicitFormula() -> Void {
    let next = EulerStep(DerivativeIdentity, 0.0, 4.0, 0.25)
    Assert.Near(5.0, next, 0.000001, "euler step should compute y + dt * f(t,y)")
}

[Fact]
fn RK4StepImprovesAccuracyOnExponentialGrowth() -> Void {
    let dt = 0.1
    let exact = Exp(dt)

    let euler = EulerStep(DerivativeIdentity, 0.0, 1.0, dt)
    let rk4 = RK4Step(DerivativeIdentity, 0.0, 1.0, dt)

    let eulerError = Abs(exact - euler)
    let rk4Error = Abs(exact - rk4)

    Assert.True(rk4Error < eulerError, "rk4 step should be more accurate than euler step for y'=y")
}

[Fact]
fn EulerMidpointAndRK4FormAccuracyProgression() -> Void {
    let dt = 0.2
    let exact = Exp(dt)
    let euler = EulerStep(DerivativeIdentity, 0.0, 1.0, dt)
    let midpoint = MidpointStep(DerivativeIdentity, 0.0, 1.0, dt)
    let rk4 = RK4Step(DerivativeIdentity, 0.0, 1.0, dt)

    Assert.True(Abs(exact - midpoint) < Abs(exact - euler), "midpoint should improve on Euler for y'=y")
    Assert.True(Abs(exact - rk4) < Abs(exact - midpoint), "RK4 should improve on midpoint for y'=y")
}

[Fact]
fn MidpointSolveReturnsExpectedGridAndRejectsInvalidSetup() -> Void {
    let solution = MidpointSolve(DerivativeIdentity, 1.0, 2.0, 0.25, 4)
    Assert.Equal(5, Len(solution.Times), "solution should include initial state")
    Assert.Equal(5, Len(solution.Values), "solution values should align with times")
    Assert.Near(2.0, solution.Times[4], 0.000001, "four steps should reach t=2")
    Assert.True(solution.Values[4] > solution.Values[0], "positive exponential slope should grow")
    Assert.Error(ODEStep(InvalidRuntimeODEStep()), "zero step must fail at admission")
    Assert.Error(ODEStepCount(InvalidRuntimeODEStepCount()), "non-positive step count must fail at admission")
}

[Fact]
fn EulerAndRK4SolveReturnExpectedShapeAndBoundaries() -> Void {
    let steps = 5
    let dt = 0.2
    let t0 = 1.5
    let y0 = 3.0

    let euler = EulerSolve(DerivativeIdentity, t0, y0, dt, steps)
    let rk4 = RK4Solve(DerivativeIdentity, t0, y0, dt, steps)

    Assert.Equal(steps + 1, Len(euler.Times), "euler times length should include initial condition")
    Assert.Equal(steps + 1, Len(euler.Values), "euler values length should include initial condition")
    Assert.Equal(steps + 1, Len(rk4.Times), "rk4 times length should include initial condition")
    Assert.Equal(steps + 1, Len(rk4.Values), "rk4 values length should include initial condition")

    Assert.Near(t0, euler.Times[0], 0.000001, "first euler time should match initial time")
    Assert.Near(y0, euler.Values[0], 0.000001, "first euler value should match initial value")
    Assert.Near(t0 + dt * steps, euler.Times[steps], 0.000001, "last euler time should match final step")
    var expectedEuler = y0
    var i = 0
    while i < steps {
        expectedEuler = expectedEuler * (1.0 + dt)
        i = i + 1
    }

    Assert.Near(expectedEuler, euler.Values[steps], 0.000001, "euler y'=y should match explicit discrete recurrence")

    Assert.Near(t0, rk4.Times[0], 0.000001, "first rk4 time should match initial time")
    Assert.Near(y0, rk4.Values[0], 0.000001, "first rk4 value should match initial value")
    Assert.Near(t0 + dt * steps, rk4.Times[steps], 0.000001, "last rk4 time should match final step")
}

[Fact]
fn RK4SolveBeatsEulerOnSameGridForYPrimeEqualsY() -> Void {
    let dt = 0.2
    let steps = 10
    let exact = Exp(dt * steps)

    let euler = EulerSolve(DerivativeIdentity, 0.0, 1.0, dt, steps)
    let rk4 = RK4Solve(DerivativeIdentity, 0.0, 1.0, dt, steps)

    let eulerLast = euler.Values[steps]
    let rk4Last = rk4.Values[steps]

    let eulerError = Abs(exact - eulerLast)
    let rk4Error = Abs(exact - rk4Last)

    Assert.True(eulerLast > 1.0, "euler should move in positive direction for y'=y with positive dt")
    Assert.True(rk4Error < eulerError, "rk4 solve should be more accurate than euler solve on same dt and steps")
}

[Fact]
fn StepAndSolveRejectInvalidDtAndSteps() -> Void {
    Assert.Error(ValidateStepInputs(InvalidRuntimeODEStep()), "shared ODE step Concept rejects zero")
    Assert.Error(ValidateSolveInputs(0.1, InvalidRuntimeODEStepCount()), "shared ODE step-count Concept rejects zero")
}

[Fact]
fn SolverOutputComposesInExpressionChain() -> Void {
    let solution = RK4Solve(DerivativeIdentity, 0.0, 1.0, 0.25, 4)
    let finalValue = solution.Values[Len(solution.Values) - 1]
    let normalized = finalValue / solution.Times[Len(solution.Times) - 1]

    Assert.True(finalValue > 0.0, "rk4 output should compose with arithmetic expressions")
    Assert.True(normalized > 0.0, "solver output should remain deterministic in expression chains")
}
