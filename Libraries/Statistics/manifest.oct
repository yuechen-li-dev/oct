package Manifest

record PackageManifest {
    Name: String
    Version: String
    Description: String
    Authors: String[]
    Date: String
    Dependencies: Dependency[]
}

record Dependency {
    Name: String
    VersionRequirement: String
}

fn Manifest() -> PackageManifest {
    return PackageManifest {
        Name: "Statistics"
        Version: "0.1.0"
        Authors: ["Codex", "Claude"]
        Date: "2026-07-17"
        Description: "Descriptive statistics and bounded evidence-fitted utility models"
        Dependencies: [
            Dependency { Name: "OctStd" VersionRequirement: "0.1.0" },
            Dependency { Name: "LinearAlgebra" VersionRequirement: "0.1.0" }
        ]
    }
}
