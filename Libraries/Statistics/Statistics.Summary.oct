package Statistics

// StatSummary holds a complete descriptive summary of a dataset.
record StatSummary {
    N: Int
    Min: Float
    Max: Float
    Range: Float
    Mean: Float
    Median: Float
    Variance: Float
    StandardDeviation: Float
    SampleVariance: Float
    SampleStandardDeviation: Float
    P25: Float
    P75: Float
    IQR: Float
    Skewness: Float
}

// Summarize computes a complete descriptive summary of a dataset.
fn Summarize(xs: Float[]) -> StatSummary {
    let n = Len(xs)
    Assert.True(n > 0, "Summarize requires at least one value")

    let sorted = SortedCopy(xs)
    let mn = sorted[0]
    let mx = sorted[n - 1]
    let rng = mx - mn
    let mean = Mean(xs)
    let median = Median(xs)
    let variance = Variance(xs)
    let sd = StandardDeviation(xs)
    let p25 = Percentile(xs, 25.0)
    let p75 = Percentile(xs, 75.0)
    let iqr = p75 - p25

    // Sample variance and stddev (n-1 denominator)
    var sv = 0.0
    var ssd = 0.0
    if n >= 2 {
        sv = SampleVariance(xs)
        ssd = SampleStandardDeviation(xs)
    }

    // Skewness: (1/n) * sum((xi - mean)^3) / stddev^3
    // Returns 0 if stddev is 0 (constant sequence)
    var skewness = 0.0
    if sd > 0.0 {
        var skewAccum = 0.0
        for i in 0 .. n {
            let d = (xs[i] - mean) / sd
            skewAccum = skewAccum + d * d * d
        }
        skewness = skewAccum / n
    }

    return StatSummary {
        N: n
        Min: mn
        Max: mx
        Range: rng
        Mean: mean
        Median: median
        Variance: variance
        StandardDeviation: sd
        SampleVariance: sv
        SampleStandardDeviation: ssd
        P25: p25
        P75: p75
        IQR: iqr
        Skewness: skewness
    }
}

// ZScores normalizes a dataset to zero mean and unit standard deviation.
// Returns an error if the dataset is constant (stddev = 0).
fn ZScores(xs: Float[]) -> Float[] ! Error {
    let n = Len(xs)
    Assert.True(n > 0, "ZScores requires at least one value")

    let mean = Mean(xs)
    let sd = StandardDeviation(xs)

    if sd == 0.0 {
        return error("z-scores require a non-constant sequence")
    }

    let z0 = (xs[0] - mean) / sd
    var out = [z0]
    for i in 1 .. n {
        let z = (xs[i] - mean) / sd
        out = Append(out, z)
    }

    return out
}

// MinOf returns the minimum value in the array.
fn MinOf(xs: Float[]) -> Float {
    let n = Len(xs)
    Assert.True(n > 0, "MinOf requires at least one value")

    var mn = xs[0]
    for i in 1 .. n {
        if xs[i] < mn {
            mn = xs[i]
        }
    }

    return mn
}

// MaxOf returns the maximum value in the array.
fn MaxOf(xs: Float[]) -> Float {
    let n = Len(xs)
    Assert.True(n > 0, "MaxOf requires at least one value")

    var mx = xs[0]
    for i in 1 .. n {
        if xs[i] > mx {
            mx = xs[i]
        }
    }

    return mx
}

// RangeOf returns the difference between max and min.
fn RangeOf(xs: Float[]) -> Float {
    let mn = MinOf(xs)
    let mx = MaxOf(xs)
    return mx - mn
}

// IQR returns the interquartile range (P75 - P25).
fn IQR(xs: Float[]) -> Float {
    let p25 = Percentile(xs, 25.0)
    let p75 = Percentile(xs, 75.0)
    return p75 - p25
}
