package Algorithms

fn MakeScale(factor: Float) -> fn(Float) -> Float {
    return fn(value: Float) -> Float with {
        factor: factor
    } {
        return value * factor
    }
}

fn MakeAtLeast(limit: Int) -> fn(Int) -> Bool {
    return fn(value: Int) -> Bool with {
        limit: limit
    } {
        return value >= limit
    }
}

flow FilterWithEscapedCallable(values: Int[], limit: Int) -> Int {
    state Run {
        let predicate = MakeAtLeast(limit)
        let accepted = Filter<Int>(values, predicate)
        return Len(accepted)
    }
}

flow FilterWithCapturedParameter(values: Int[], predicate: fn(Int) -> Bool) -> Int {
    state Run {
        let accepted = Filter<Int>(values, predicate)
        return Len(accepted)
    }
}

flow FilterWithActivationCapture(values: Int[], limit: Int) -> Int {
    state Run {
        let threshold = limit
        let predicate = fn(value: Int) -> Bool with {
            threshold: threshold
        } {
            return value >= threshold
        }
        let accepted = Filter<Int>(values, predicate)
        return Len(accepted)
    }
}

[Fact]
fn FlowConsumesEscapedAndExplicitlyCapturedCallables() -> Void {
    let escapedMachine = FilterWithEscapedCallable([1, 4, 6], 4)
    Step(escapedMachine)
    Assert.Equal(2, Result(escapedMachine)!, "FLOW should pass escaped callable to generic Filter")

    let threshold = 5
    let captured = fn(value: Int) -> Bool with {
        threshold: threshold
    } {
        return value >= threshold
    }
    let capturedMachine = FilterWithCapturedParameter([2, 5, 7], captured)
    Step(capturedMachine)
    Assert.Equal(2, Result(capturedMachine)!, "FLOW should consume explicit capture through ordinary fn type")

    let activationMachine = FilterWithActivationCapture([2, 5, 7], 5)
    Step(activationMachine)
    Assert.Equal(2, Result(activationMachine)!, "FLOW should construct an ordinary captured callable inside the activation")
}

template fn MapThroughTemplate<T, U>(values: T[], transform: fn(T) -> U) -> U[] {
    return Map<T, U>(values, transform)
}

fn StopAfterTrue(value: Int) -> Bool {
    if value == 1 {
        return true
    }
    var unreachable: Int[] = []
    return unreachable[0] == 0
}

fn StopAfterFalse(value: Int) -> Bool {
    if value == 1 {
        return false
    }
    var unreachable: Int[] = []
    return unreachable[0] == 0
}

[Fact]
fn MapCoversEmptySingletonCaptureAndEscapedCallable() -> Void {
    let offset = 4
    let addOffset = fn(value: Int) -> Int with {
        offset: offset
    } {
        return value + offset
    }
    let empty: Int[] = []
    Assert.Equal(0, Len(Map<Int, Int>(empty, addOffset)), "empty map stays empty")
    Assert.Equal(7, Map<Int, Int>([3], addOffset)[0], "singleton map invokes capture")

    let scaled = Map<Float, Float>([1.5, 2.0, 3.0], MakeScale(2.0))
    Assert.Equal(3.0, scaled[0], "escaped callable maps first value")
    Assert.Equal(6.0, scaled[2], "escaped callable maps last value")
}

[Fact]
fn MapIndexedAndTemplateCapturePreserveAscendingIndices() -> Void {
    let bias = 10
    let indexed = fn(index: Int, value: Int) -> Int with {
        bias: bias
    } {
        return bias + index * 100 + value
    }
    let result = MapIndexed<Int, Int>([5, 6, 7], indexed)
    Assert.Equal(15, result[0], "first index is zero")
    Assert.Equal(116, result[1], "second index is one")
    Assert.Equal(217, result[2], "third index is two")

    let factor = 3
    let scale = fn(value: Int) -> Int with {
        factor: factor
    } {
        return value * factor
    }
    let specialized = MapThroughTemplate<Int, Int>([2, 4], scale)
    Assert.Equal(6, specialized[0], "template passes captured callable")
    Assert.Equal(12, specialized[1], "specialized consumer keeps callable type")
}

[Fact]
fn FilterCoversNoneAllMixedCaptureAndSourceIsolation() -> Void {
    let threshold = 5
    let atLeast = fn(value: Int) -> Bool with {
        threshold: threshold
    } {
        return value >= threshold
    }
    Assert.Equal(0, Len(Filter<Int>([1, 2, 3], atLeast)), "none match")
    Assert.Equal(3, Len(Filter<Int>([5, 6, 7], atLeast)), "all match")

    var source = [2, 6, 4, 8]
    var selected = Filter<Int>(source, atLeast)
    Assert.Equal(2, Len(selected), "mixed filter count")
    selected[0] = 99
    Assert.Equal(6, source[1], "filtered result has independent storage")
}

[Fact]
fn AnyAndAllDefineEmptyCaptureAndShortCircuitSemantics() -> Void {
    let empty: Int[] = []
    let threshold = 3
    let above = fn(value: Int) -> Bool with {
        threshold: threshold
    } {
        return value > threshold
    }
    Assert.False(Any<Int>(empty, above), "Any empty is false")
    Assert.True(All<Int>(empty, above), "All empty is true")
    Assert.True(Any<Int>([1, 4], above), "Any uses captured predicate")
    Assert.False(All<Int>([4, 2], above), "All uses captured predicate")
    Assert.True(Any<Int>([1, 2], StopAfterTrue), "Any stops at first true")
    Assert.False(All<Int>([1, 2], StopAfterFalse), "All stops at first false")
}

[Fact]
fn FindIndexAndCountWhereUseCapturedPredicates() -> Void {
    let target = 8
    let equalsTarget = fn(value: Int) -> Bool with {
        target: target
    } {
        return value == target
    }
    Assert.Equal(0, FindIndex<Int>([8, 4, 8], equalsTarget), "finds first match")
    Assert.Equal(1, FindIndex<Int>([4, 8, 9], equalsTarget), "finds middle match")
    Assert.Equal(-1, FindIndex<Int>([1, 2], equalsTarget), "missing uses established -1 convention")
    Assert.Equal(2, CountWhere<Int>([8, 1, 8], equalsTarget), "count predicate carries target")
}

[Fact]
fn FoldIsLeftToRightAndSupportsCapturedReducer() -> Void {
    let radix = 10
    let appendDigit = fn(accumulator: Int, value: Int) -> Int with {
        radix: radix
    } {
        return accumulator * radix + value
    }
    let empty: Int[] = []
    Assert.Equal(42, Fold<Int, Int>(empty, 42, appendDigit), "empty fold returns initial")
    Assert.Equal(123, Fold<Int, Int>([1, 2, 3], 0, appendDigit), "fold order is left to right")
}

[Fact]
fn ScientificNormalizationUsesCapturedScale() -> Void {
    let samples = [3.0, 4.0]
    let norm = 5.0
    let normalize = fn(value: Float) -> Float with {
        norm: norm
    } {
        return value / norm
    }
    let normalized = Map<Float, Float>(samples, normalize)
    Assert.Near(0.6, normalized[0], 0.000001, "normalized first sample")
    Assert.Near(0.8, normalized[1], 0.000001, "normalized second sample")
    Assert.Near(1.0, normalized[0] * normalized[0] + normalized[1] * normalized[1], 0.000001, "normalized magnitude")
}

fn IsEven(value: Int) -> Bool {return value % 2 == 0}
fn IsLong(value: String) -> Bool {return Len(value) > 3}

[Fact]
fn FirstWhereSpecializesWithoutErasingPredicateType() -> Void {
    Assert.Equal(4, FirstWhere<Int>([1, 3, 4, 6], IsEven) !, "Int specialization")
    Assert.Equal("delta", FirstWhere<String>(["a", "delta"], IsLong) !, "String specialization")
    Assert.Error(FirstWhere<Int>([1, 3, 5], IsEven), "missing match remains fallible")
}

fn IsEvenValue(value: Int) -> Bool {
    return value % 2 == 0
}

fn InvalidRuntimeSieveLimit() -> Int {
    return 1
}

[Fact]
fn CountWhereSpecializesForExactPredicateType() -> Void {
    Assert.Equal(3, CountWhere<Int>([1, 2, 4, 7, 8], IsEvenValue), "three inputs should be even")
}

[Fact]
fn BinarySearchCoversBoundariesMissingAndEmpty() -> Void {
    let values = [-4, 0, 3, 9, 12]
    Assert.Equal(0, BinarySearch(values, -4), "first value should be found")
    Assert.Equal(4, BinarySearch(values, 12), "last value should be found")
    Assert.Equal(-1, BinarySearch(values, 8), "missing value should return -1")
    Assert.Equal(-1, BinarySearch([], 1), "empty input should return -1")
}

[Fact]
fn EuclidGcdAndLcmHandleSignsAndZeros() -> Void {
    Assert.Equal(6, GCD(54, 24), "Euclid's algorithm should find gcd")
    Assert.Equal(6, GCD(-54, 24), "gcd should be non-negative")
    Assert.Equal(0, GCD(0, 0), "gcd(0, 0) policy should be explicit")
    Assert.Equal(42, LCM(-21, 6), "lcm should be non-negative")
    Assert.Equal(0, LCM(0, 6), "lcm with zero should be zero")
}

[Fact]
fn PrimeAlgorithmsMatchSmallExactCases() -> Void {
    Assert.False(IsPrime(1), "one is not prime")
    Assert.True(IsPrime(2), "two is prime")
    Assert.False(IsPrime(49), "square composite should be rejected")
    Assert.True(IsPrime(97), "97 is prime")

    let primes = PrimesThrough(20)
    Assert.Equal(8, Len(primes), "there are eight primes through twenty")
    Assert.Equal(2, primes[0], "sieve should start at two")
    Assert.Equal(19, primes[7], "sieve should include upper-range prime")
    Assert.Error(SieveLimit(InvalidRuntimeSieveLimit()), "sieve requires a meaningful inclusive limit")
}
