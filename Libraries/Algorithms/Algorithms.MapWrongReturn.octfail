expect error: "argument 2 expects fn(Int) -> Int, got fn(Int) -> Bool"

package Algorithms

template fn Consume<T, U>(values: T[], transform: fn(T) -> U) -> U[] {
    var result: U[] = []
    return result
}

fn Wrong(value: Int) -> Bool { return value > 0 }

fn Invalid() -> Int[] {
    return Consume<Int, Int>([1, 2], Wrong)
}
