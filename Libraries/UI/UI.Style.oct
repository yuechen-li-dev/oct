package UI

record Color {
    R: Int
    G: Int
    B: Int
    A: Int
}

record Insets {
    Top: Int < px >
    Right: Int < px >
    Bottom: Int < px >
    Left: Int < px >
}

record TextStyle {
    Size: Int < px >
    Color: Color
    Weight: Int
}

record Style {
    Background: Color
    Foreground: Color
    BorderColor: Color
    BorderWidth: Int < px >
    Radius: Int < px >
    Padding: Insets
}

concept ColorChannel = Int {
    Require(Self >= 0, "a color channel must be at least 0")
    Require(Self <= 255, "a color channel must be at most 255")
}

concept NonNegativePx = Int < px > {
    Require(Self >= 0px, "a pixel inset must be non-negative")
}

fn Rgba(r: ColorChannel, g: ColorChannel, b: ColorChannel, a: ColorChannel) -> Color {
    return Color {R: r G: g B: b A: a}
}

fn Rgb(r: ColorChannel, g: ColorChannel, b: ColorChannel) -> Color {
    return Rgba(r, g, b, 255)
}

fn InsetsAll(value: NonNegativePx) -> Insets {
    return Insets {
        Top: value
        Right: value
        Bottom: value
        Left: value
    }
}

fn InsetsXY(x: NonNegativePx, y: NonNegativePx) -> Insets {
    return Insets {
        Top: y
        Right: x
        Bottom: y
        Left: x
    }
}

fn DefaultTextStyle() -> TextStyle {
    return TextStyle {
        Size: 14px
        Color: Rgb(0, 0, 0)
        Weight: 400
    }
}

fn DefaultStyle() -> Style {
    return Style {
        Background: Rgb(255, 255, 255)
        Foreground: Rgb(0, 0, 0)
        BorderColor: Rgb(210, 210, 210)
        BorderWidth: 1px
        Radius: 0px
        Padding: InsetsAll(0px)
    }
}
