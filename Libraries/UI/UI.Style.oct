package UI

record Color {
    R: Int
    G: Int
    B: Int
    A: Int
}

record Insets {
    Top: Int<px>
    Right: Int<px>
    Bottom: Int<px>
    Left: Int<px>
}

record TextStyle {
    Size: Int<px>
    Color: Color
    Weight: Int
}

record Style {
    Background: Color
    Foreground: Color
    BorderColor: Color
    BorderWidth: Int<px>
    Radius: Int<px>
}

concept ColorChannel = Int {
    Require(Self >= 0, "a color channel must be at least 0")
    Require(Self <= 255, "a color channel must be at most 255")
}

concept NonNegativePx = Int<px> {
    Require(Self >= 0px, "a pixel inset must be non-negative")
}

fn Rgba(r: ColorChannel, g: ColorChannel, b: ColorChannel, a: ColorChannel) -> Color {
    return Color { R: r G: g B: b A: a }
}

fn Rgb(r: ColorChannel, g: ColorChannel, b: ColorChannel) -> Color {
    return Rgba(r, g, b, 255)
}

fn InsetsAll(value: NonNegativePx) -> Insets {
    return Insets {
        Top: value
        Right: value
        Bottom: value
        Left: value
    }
}

fn InsetsXY(x: NonNegativePx, y: NonNegativePx) -> Insets {
    return Insets {
        Top: y
        Right: x
        Bottom: y
        Left: x
    }
}

fn DefaultTextStyle() -> TextStyle {
    return TextStyle {
        Size: 14px
        Color: Rgb(0, 0, 0)
        Weight: 400
    }
}

fn DefaultStyle() -> Style {
    return Style {
        Background: Rgb(255, 255, 255)
        Foreground: Rgb(0, 0, 0)
        BorderColor: Rgb(210, 210, 210)
        BorderWidth: 1px
        Radius: 0px
    }
}

// Styled paints a node with a Style: Background fills the node's rect,
// BorderColor and BorderWidth outline it, Radius rounds its corners, and
// Foreground colors the node's own text (a Text's content or a Button's
// label). A styled Button replaces the default button chrome. Inner space
// is layout, not paint: use a stack's Padding or UI.Inset.
fn Styled(style: Style, node: UI) -> UI {
    return UIStyleNode(node, [
        style.Background.R, style.Background.G, style.Background.B, style.Background.A,
        style.Foreground.R, style.Foreground.G, style.Foreground.B, style.Foreground.A,
        style.BorderColor.R, style.BorderColor.G, style.BorderColor.B, style.BorderColor.A
    ], style.BorderWidth, style.Radius)
}
