package UI

[Fact]
fn WidgetConstructorsReturnUI() -> Void {
    let text = Text("hello")
    let button = Button("ok", "app.ok")
    let column = Column([text, button])
    let row = Row([text, button])

    Assert.True(Len(Signature(text)) > 0, "Text must produce an opaque UI value")
    Assert.True(Len(Signature(button)) > 0, "Button must produce an opaque UI value")
    Assert.True(Len(Signature(column)) > 0, "Column must produce an opaque UI value")
    Assert.True(Len(Signature(row)) > 0, "Row must produce an opaque UI value")
}

[Fact]
fn CounterViewIsPureStateToUI() -> Void {
    let before = CounterView(CounterState { Count: 1 })
    let again = CounterView(CounterState { Count: 1 })
    let after = CounterView(CounterState { Count: 2 })

    Assert.Equal(Signature(before), Signature(again), "same state should render same UI signature")
    Assert.True(Signature(before) != Signature(after), "different state should render different UI signature")
}

[Fact]
fn MountPatchUnmountLifecycleWorks() -> Void {
    let mounted = MountUI(CounterView(CounterState { Count: 0 }))
    let patched = PatchUI(mounted, CounterView(CounterState { Count: 2 }))
    let unmounted = UnmountUI(mounted)

    Assert.Equal(0, patched, "patch should succeed")
    Assert.Equal(0, unmounted, "unmount should succeed")
}

[Fact]
fn ExplicitEventTokensDriveStateTransition() -> Void {
    let mounted = MountUI(CounterView(CounterState { Count: 0 }))
    let emitted = Emit(mounted, "counter.increment") !
    Assert.Equal(0, emitted, "event emission should succeed")

    let events = DrainEvents(mounted)
    Assert.Equal(1, Len(events), "exactly one event should be queued")
    Assert.Equal("counter.increment", events[0], "button event token should be preserved")

    let next = CounterUpdate(CounterState { Count: 0 }, events[0])
    Assert.Equal(1, next.Count, "application state must update explicitly from event token")

    let patch = PatchUI(mounted, CounterView(next))
    Assert.Equal(0, patch, "rerender after state transition should patch")

    let drainedAgain = DrainEvents(mounted)
    Assert.Equal(0, Len(drainedAgain), "drain should clear queued events")

    let unmounted = UnmountUI(mounted)
    Assert.Equal(0, unmounted, "cleanup should succeed")
}

[Fact]
fn UnknownEventTokenIsRejectedByRuntimeBridge() -> Void {
    let mounted = MountUI(CounterView(CounterState { Count: 0 }))
    match Emit(mounted, "counter.unknown") {
        ok(v) => {
            Assert.True(false, "runtime bridge must reject unknown event token")
        }
        err(e) => {}
    }
}
