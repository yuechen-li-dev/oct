package UI

[Fact]
fn M94UIEventCarriesTokenAndPayload() -> Void {
    let event = Event(Token("counter.increment"), "count=1")
    Assert.Equal("counter.increment", EventTokenValue(event.Token), "event token should be stored in UIEvent")
    Assert.Equal("count=1", event.Payload, "event payload should be stored in UIEvent")
}

[Fact]
fn M94EventTokenAccessorIsDeterministic() -> Void {
    let event = Event(Token("route.stats"), "")
    Assert.Equal("route.stats", EventTokenValue(EventTokenOf(event)), "token accessor should return original token")
    Assert.Equal("route.stats", EventTokenValue(EventTokenOf(event)), "token accessor should be deterministic")
}

[Fact]
fn M94EventPayloadAccessorIsDeterministic() -> Void {
    let event = Event(Token("evt.save"), "doc=alpha")
    Assert.Equal("doc=alpha", EventPayload(event), "payload accessor should return original payload")
    Assert.Equal("doc=alpha", EventPayload(event), "payload accessor should be deterministic")
}

[Fact]
fn M94EventSupportsEmptyPayload() -> Void {
    let event = Event(Token("nav.home"), "")
    Assert.Equal("", EventPayload(event), "empty payload should round-trip")
}
