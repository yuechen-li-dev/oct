package UI

fn M117PanelStyle() -> Style {
    return Style {
        Background: Rgb(32, 64, 128)
        Foreground: Rgb(255, 255, 255)
        BorderColor: Rgb(16, 32, 64)
        BorderWidth: 2px
        Radius: 6px
    }
}

[Fact]
fn M117StyledChangesTheNodeSignature() -> Void {
    let plain = Text("Setpoint")
    let styled = Styled(M117PanelStyle(), Text("Setpoint"))
    Assert.True(Signature(plain) != Signature(styled), "a style is part of the node's semantics")
}

[Fact]
fn M117StyledIsDeterministic() -> Void {
    let a = Styled(M117PanelStyle(), Button("Raise", Token("thermostat.raise"), true))
    let b = Styled(M117PanelStyle(), Button("Raise", Token("thermostat.raise"), true))
    Assert.Equal(Signature(a), Signature(b), "the same node and style give the same signature")
}

[Fact]
fn M117DifferentStylesDiffer() -> Void {
    let a = Styled(M117PanelStyle(), Text("x"))
    let b = Styled(M117PanelStyle() with { Radius: 0px }, Text("x"))
    Assert.True(Signature(a) != Signature(b), "radius is part of the style")
}

[Fact]
fn M117StylingAContainerKeepsItsChildren() -> Void {
    let plain = Column([Text("a"), Text("b")])
    let styled = Styled(DefaultStyle(), Column([Text("a"), Text("b")]))
    Assert.True(Len(Signature(styled)) > Len(Signature(plain)), "styling adds paint without dropping children")
}
