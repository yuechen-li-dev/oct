package UI

import String

// Colors, insets, styles and their refined channel types.

[Fact]
fn RgbSetsAlpha255() -> Void {
    let c = Rgb(1, 2, 3)
    Assert.Equal(1, c.R, "rgb should preserve red")
    Assert.Equal(2, c.G, "rgb should preserve green")
    Assert.Equal(3, c.B, "rgb should preserve blue")
    Assert.Equal(255, c.A, "rgb should set alpha to 255")
}

[Fact]
fn RgbaPreservesChannels() -> Void {
    let c = Rgba(1, 2, 3, 4)
    Assert.Equal(1, c.R, "rgba should preserve red")
    Assert.Equal(2, c.G, "rgba should preserve green")
    Assert.Equal(3, c.B, "rgba should preserve blue")
    Assert.Equal(4, c.A, "rgba should preserve alpha")
}

[Fact]
fn InsetsHelpers() -> Void {
    let all = InsetsAll(8px)
    Assert.Equal(8px, all.Top, "InsetsAll should set top")
    Assert.Equal(8px, all.Right, "InsetsAll should set right")
    Assert.Equal(8px, all.Bottom, "InsetsAll should set bottom")
    Assert.Equal(8px, all.Left, "InsetsAll should set left")

    let xy = InsetsXY(4px, 8px)
    Assert.Equal(8px, xy.Top, "InsetsXY should map y to top")
    Assert.Equal(4px, xy.Right, "InsetsXY should map x to right")
    Assert.Equal(8px, xy.Bottom, "InsetsXY should map y to bottom")
    Assert.Equal(4px, xy.Left, "InsetsXY should map x to left")
}

[Fact]
fn DefaultStyleDeterministicAndWithUpdate() -> Void {
    let base = DefaultStyle()
    let again = DefaultStyle()
    let next = base with { Radius: 8px }

    Assert.Equal(base.Radius, again.Radius, "default style should be deterministic")
    Assert.Equal(0px, base.Radius, "base radius should use default")
    Assert.Equal(8px, next.Radius, "with update should override radius")
    Assert.Equal(0px, base.Radius, "with update should not mutate base")
}

fn DemoPanelStyle() -> Style {
    return Style {
        Background: Rgb(32, 64, 128)
        Foreground: Rgb(255, 255, 255)
        BorderColor: Rgb(16, 32, 64)
        BorderWidth: 2px
        Radius: 6px
    }
}

[Fact]
fn StyledChangesTheNodeSignature() -> Void {
    let plain = Text("Setpoint")
    let styled = Styled(DemoPanelStyle(), Text("Setpoint"))
    Assert.True(Signature(plain) != Signature(styled), "a style is part of the node's semantics")
}

[Fact]
fn StyledIsDeterministic() -> Void {
    let a = Styled(DemoPanelStyle(), UIButtonMsg("Raise", DemoMsg.Save, true))
    let b = Styled(DemoPanelStyle(), UIButtonMsg("Raise", DemoMsg.Save, true))
    Assert.Equal(Signature(a), Signature(b), "the same node and style give the same signature")
}

[Fact]
fn DifferentStylesDiffer() -> Void {
    let a = Styled(DemoPanelStyle(), Text("x"))
    let b = Styled(DemoPanelStyle() with { Radius: 0px }, Text("x"))
    Assert.True(Signature(a) != Signature(b), "radius is part of the style")
}

[Fact]
fn StylingAContainerKeepsItsChildren() -> Void {
    let plain = Column([Text("a"), Text("b")])
    let styled = Styled(DefaultStyle(), Column([Text("a"), Text("b")]))
    Assert.True(Len(Signature(styled)) > Len(Signature(plain)), "styling adds paint without dropping children")
}

fn DemoInvalidChannel() -> Int {
    return 300
}

fn DemoInvalidPx() -> Int<px> {
    return -1px
}

[Fact]
fn RefinedColorChannelsPreserveAcceptedColorBehavior() -> Void {
    let color = Rgba(1, 2, 3, 4)
    Assert.Equal(1, color.R, "red remains unchanged")
    Assert.Equal(2, color.G, "green remains unchanged")
    Assert.Equal(3, color.B, "blue remains unchanged")
    Assert.Equal(4, color.A, "alpha remains unchanged")
}

[Fact]
fn RuntimeColorChannelConstructionChecksOnce() -> Void ! Error {
    let raw = 128
    let channel = ColorChannel(raw)?
    let color = Rgba(channel, channel, channel, 255)
    Assert.Equal(128, color.R, "admitted channel is reusable")
    Assert.Error(ColorChannel(DemoInvalidChannel()), "out-of-range runtime construction fails")
}

[Fact]
fn DimensionalPixelRefinementChecksRuntimeValues() -> Void ! Error {
    let raw = 4px
    let inset = NonNegativePx(raw)?
    let all = InsetsAll(inset)
    Assert.Equal(4px, all.Left, "admitted dimensional value is reusable")
    Assert.Error(NonNegativePx(DemoInvalidPx()), "negative runtime pixel construction fails")
}

[Fact]
fn StyledTakesTheStyleFirst() -> Void {
    let sig = Signature(Styled(DefaultStyle() with { Radius: 4px }, Text("x")))
    Assert.True(String.Contains(sig, "radius:4"), "Styled(style, node) paints the node")
}
