package Manifest

record PackageManifest {
    Name: String
    Version: String
    Description: String
    Authors: String[]
    Date: String
    Dependencies: Dependency[]
}

record Dependency {
    Name: String
    VersionRequirement: String
}

fn Manifest() -> PackageManifest {
    return PackageManifest {
        Name: "UI"
        Version: "0.2.0"
        Authors: ["Codex", "Claude"]
        Date: "2026-11-22"
        Description: "Machina UI authoring surface: typed views, layout tables, stacks and grids, text, styles and inputs"
        Dependencies: [Dependency { Name: "OctStd" VersionRequirement: "0.1.0" }]
    }
}
