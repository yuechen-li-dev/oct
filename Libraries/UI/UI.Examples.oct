package UI

record CounterState {
    Count: Int
    Voltage: Float
}

fn CounterInit() -> CounterState {
    return CounterState {
        Count: 0
        Voltage: 0.0
    }
}

fn CounterView(model: CounterState) -> UI {
    let status = Text("count=" + CounterCountText(model.Count))
    let voltage = Text("voltage=" + FormatFloat(model.Voltage, 2))
    let canDecrement = model.Count > 0
    return Column([
        status,
        voltage,
        Row([
            Button("increment", CounterIncrementEvent(), true),
            Button("decrement", CounterDecrementEvent(), canDecrement)
        ])
    ])
}

fn CounterUpdate(model: CounterState, event: String) -> CounterState {
    if event == CounterIncrementEvent() {
        return CounterState {
            Count: model.Count + 1
            Voltage: model.Voltage + 0.25
        }
    }

    if event == CounterDecrementEvent() {
        if model.Count > 0 {
            return CounterState {
                Count: model.Count - 1
                Voltage: model.Voltage - 0.25
            }
        }
        return model
    }

    return model
}

fn CounterIncrementEvent() -> String {
    return "counter.increment"
}

fn CounterDecrementEvent() -> String {
    return "counter.decrement"
}

fn CounterCountText(value: Int) -> String {
    if value == 0 {
        return "0"
    }
    if value == 1 {
        return "1"
    }
    if value == 2 {
        return "2"
    }
    if value == 3 {
        return "3"
    }
    if value == 4 {
        return "4"
    }
    if value == 5 {
        return "5"
    }
    if value == 6 {
        return "6"
    }
    if value == 7 {
        return "7"
    }
    if value == 8 {
        return "8"
    }
    if value == 9 {
        return "9"
    }
    if value < 0 {
        return "neg"
    }
    return "many"
}
