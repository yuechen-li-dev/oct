package UI

[Fact]
fn AbsoluteBoxPlacementProducesInspectableSignature() -> Void {
    let ui = Canvas([
        AbsoluteBox(10.0 px, 20.0 px, 100.0 px, 40.0 px, Text("absolute"))
    ])

    let mounted = MountUI(ui)
    let patched = PatchUI(mounted, ui)
    Assert.Equal(0, patched, "absolute placement should patch cleanly")
    Assert.Equal(0, UnmountUI(mounted), "cleanup should succeed")
}

[Fact]
fn AnchorBoxPlacementProducesInspectableSignature() -> Void {
    let ui = Canvas([
        AnchorBox(0.25 ui, 0.10 ui, 0.75 ui, 0.60 ui, Text("anchored"))
    ])

    let mounted = MountUI(ui)
    Assert.Equal(0, PatchUI(mounted, ui), "anchored placement should patch cleanly")
    Assert.Equal(0, UnmountUI(mounted), "cleanup should succeed")
}
