package UI

[Fact]
fn M95UIIRProjectionDeterministicForSameTree() -> Void {
    let snapshot = Column([
        Text("route=home"),
        Text("count=4"),
        Row([
            Button("Increment", Token("counter.increment"), true),
            Button("Decrement", Token("counter.decrement"), true)
        ])
    ])

    let left = Signature(snapshot)
    let right = Signature(snapshot)
    Assert.Equal(left, right, "same UI tree must project to identical UIIR signature")
}

[Fact]
fn M95UIIRProjectionChangesWhenTreeChanges() -> Void {
    let home = Signature(Column([
        Text("route=home"),
        Button("Stats", Token("route.stats"), true)
    ]))
    let stats = Signature(Column([
        Text("route=stats"),
        Button("Home", Token("route.home"), true)
    ]))

    Assert.True(home != stats, "different UI trees must alter projected UIIR shape")
}

[Fact]
fn M95UIIRStructuralNodeKindsAreExplicit() -> Void {
    let ui = Column([
        Text("title"),
        Button("Save", Token("evt.save"), true),
        Row([
            Spacer(),
            Grid([
                Text("cell.0"),
                Text("cell.1")
            ])
        ]),
        Canvas([
            AbsoluteBox(8.0 px, 12.0 px, 48.0 px, 20.0 px, Text("absolute")),
            AnchorBox(0.1 ui, 0.2 ui, 0.9 ui, 0.8 ui, Text("anchored"))
        ])
    ])

    let sig = Signature(ui)
    Assert.True(Contains(sig, "Text#"), "text must lower to Text UIIR node")
    Assert.True(Contains(sig, "Button#"), "button must lower to Button UIIR node")
    Assert.True(Contains(sig, "Row#"), "row must lower to Row UIIR node")
    Assert.True(Contains(sig, "Column#"), "column must lower to Column UIIR node")
    Assert.True(Contains(sig, "Grid#"), "grid must lower to Grid UIIR node")
    Assert.True(Contains(sig, "Spacer#"), "spacer must lower to Spacer UIIR node")
    Assert.True(Contains(sig, "AbsoluteBox#"), "absolute layout must remain explicit in UIIR")
    Assert.True(Contains(sig, "AnchorBox#"), "anchored layout must remain explicit in UIIR")
}

[Fact]
fn M95UIIRRowColumnOrderingIsStable() -> Void {
    let left = Signature(Column([
        Row([
            Text("first"),
            Text("second")
        ])
    ]))

    let right = Signature(Column([
        Row([
            Text("second"),
            Text("first")
        ])
    ]))

    Assert.True(left != right, "child order must be preserved in canonical UIIR")
}
