package UI

[Fact]
fn AbsoluteBoxAcceptsPixelConstants() -> Void {
    let cardX = 320.0 px
    let cardY = 158.0 px
    let cardW = 232.0 px
    let cardH = 120.0 px

    let ui = Canvas([
        Place(AbsoluteBox(cardX, cardY, cardW, cardH), Text("pixel-box"))
    ])

    let mounted = MountUI(ui)
    Assert.Equal(0, PatchUI(mounted, ui), "absolute typed placement should patch cleanly")
    Assert.Equal(0, UnmountUI(mounted), "cleanup should succeed")
}

[Fact]
fn AnchoredBoxAcceptsUIConstants() -> Void {
    let left = 0.01 ui
    let top = 0.08 ui
    let right = 0.90 ui
    let bottom = 0.95 ui

    let ui = Canvas([
        Place(AnchoredBox(left, top, right, bottom), Text("anchored-box"))
    ])

    let mounted = MountUI(ui)
    Assert.Equal(0, PatchUI(mounted, ui), "anchored typed placement should patch cleanly")
    Assert.Equal(0, UnmountUI(mounted), "cleanup should succeed")
}


[Fact]
fn BoxKindIsClosedEnumDomain() -> Void {
    let absolute = AbsoluteBox(1.0 px, 2.0 px, 3.0 px, 4.0 px)
    let anchored = AnchoredBox(0.1 ui, 0.2 ui, 0.3 ui, 0.4 ui)

    let absoluteKind = switch absolute.Kind {
        case BoxKind.Absolute => "abs"
        case BoxKind.Anchored => "anc"
    }
    let anchoredKind = switch anchored.Kind {
        case BoxKind.Absolute => "abs"
        case BoxKind.Anchored => "anc"
    }

    Assert.Equal("abs", absoluteKind, "absolute constructor should set absolute enum kind")
    Assert.Equal("anc", anchoredKind, "anchored constructor should set anchored enum kind")
}


[Fact]
fn AnchorAndAnchoredBoxCompatibilityAcceptUIConstants() -> Void {
    let canonical = Signature(Canvas([
        Place(Anchor(0.10 ui, 0.20 ui, 0.70 ui, 0.80 ui), Text("a"))
    ]))

    let compatibility = Signature(Canvas([
        Place(AnchoredBox(0.10 ui, 0.20 ui, 0.70 ui, 0.80 ui), Text("a"))
    ]))

    Assert.Equal(canonical, compatibility, "Anchor and AnchoredBox should match for ui constants")
}
