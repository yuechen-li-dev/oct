package UI

record EventToken {
    Value: String
}

record UIEvent {
    Token: EventToken
    Payload: String
}

fn Token(value: String) -> EventToken {
    return EventToken { Value: value }
}

fn EventTokenValue(token: EventToken) -> String {
    return token.Value
}

fn Event(token: EventToken, payload: String) -> UIEvent {
    return UIEvent {
        Token: token
        Payload: payload
    }
}

fn EventTokenOf(event: UIEvent) -> EventToken {
    return event.Token
}

fn EventPayload(event: UIEvent) -> String {
    return event.Payload
}
