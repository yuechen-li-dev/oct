package UI

record UIEvent {
    Token: String
    Payload: String
}

record AppState {
    Route: String
    Count: Int
}

record AppContract {
    Initial: AppState
}

fn DefineApp(
    initial: AppState,
    transition: fn(AppState, UIEvent) -> AppState ! Error,
    project: fn(AppState) -> UI
) -> AppContract ! Error {
    let _transitionBinding = transition
    let _projectBinding = project

    return AppContract {
        Initial: initial
    }
}

fn Event(token: String, payload: String) -> UIEvent {
    return UIEvent {
        Token: token
        Payload: payload
    }
}

fn EventToken(event: UIEvent) -> String {
    return event.Token
}

fn EventPayload(event: UIEvent) -> String {
    return event.Payload
}

fn CounterApp() -> AppContract ! Error {
    return DefineApp(CounterInitialState(), CounterTransition, CounterProject)?
}

fn CounterInitialState() -> AppState {
    return AppState {
        Route: CounterRouteHome()
        Count: 0
    }
}

fn CounterRouteHome() -> String {
    return "route.home"
}

fn CounterRouteStats() -> String {
    return "route.stats"
}

fn CounterIncrementToken() -> String {
    return "counter.increment"
}

fn CounterDecrementToken() -> String {
    return "counter.decrement"
}

fn CounterGoStatsToken() -> String {
    return "route.stats"
}

fn CounterGoHomeToken() -> String {
    return "route.home"
}

flow CounterControl(model: AppState, event: UIEvent) -> AppState {
    board {
        NextRoute: String
        NextCount: Int
    }

    state Dispatch {
        board.NextRoute = model.Route
        board.NextCount = model.Count

        when {
            case EventToken(event) == CounterIncrementToken() -> goto Increment
            case EventToken(event) == CounterDecrementToken() -> goto Decrement
            case EventToken(event) == CounterGoStatsToken() -> goto RouteStats
            case EventToken(event) == CounterGoHomeToken() -> goto RouteHome
            else -> return AppState {
                Route: board.NextRoute
                Count: board.NextCount
            }
        }
    }

    state Increment {
        board.NextRoute = model.Route
        board.NextCount = model.Count + 1
        return AppState {
            Route: board.NextRoute
            Count: board.NextCount
        }
    }

    state Decrement {
        if model.Count > 0 {
            board.NextRoute = model.Route
            board.NextCount = model.Count - 1
        }
        return AppState {
            Route: board.NextRoute
            Count: board.NextCount
        }
    }

    state RouteStats {
        board.NextRoute = CounterRouteStats()
        board.NextCount = model.Count
        return AppState {
            Route: board.NextRoute
            Count: board.NextCount
        }
    }

    state RouteHome {
        board.NextRoute = CounterRouteHome()
        board.NextCount = model.Count
        return AppState {
            Route: board.NextRoute
            Count: board.NextCount
        }
    }
}

fn CounterTransition(model: AppState, event: UIEvent) -> AppState ! Error {
    let machine = CounterControl(model, event)
    Step(machine)
    return Result(machine)?
}

fn CounterProject(model: AppState) -> UI {
    if model.Route == CounterRouteStats() {
        return Column([
            Text("route=stats"),
            Text("count=" + CounterCountText(model.Count)),
            Button("Home", CounterGoHomeToken(), true)
        ])
    }

    let canDecrement = model.Count > 0
    return Column([
        Text("route=home"),
        Text("count=" + CounterCountText(model.Count)),
        Row([
            Button("Increment", CounterIncrementToken(), true),
            Button("Decrement", CounterDecrementToken(), canDecrement),
            Button("Stats", CounterGoStatsToken(), true)
        ])
    ])
}
