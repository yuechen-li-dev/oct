package UI

record MountRef {
    Handle: Int
}

enum BoxKind {
    Absolute
    Anchored
}

record UIBox {
    Kind: BoxKind
    X: Float<px>
    Y: Float<px>
    Width: Float<px>
    Height: Float<px>
    Left: Float<ui>
    Top: Float<ui>
    Right: Float<ui>
    Bottom: Float<ui>
    Z: Int
}

fn Column(children: UI[]) -> UI {
    return UIColumn(children)
}

fn Row(children: UI[]) -> UI {
    return UIRow(children)
}

fn Canvas(children: UI[]) -> UI {
    return UICanvas(children)
}

fn Grid(children: UI[]) -> UI {
    return UIGrid(children)
}

fn Spacer() -> UI {
    return UISpacer()
}

fn Absolute(x: Float<px>, y: Float<px>, width: Float<px>, height: Float<px>) -> UIBox {
    return AbsoluteZ(x, y, width, height, 0)
}

fn AbsoluteZ(x: Float<px>, y: Float<px>, width: Float<px>, height: Float<px>, z: Int) -> UIBox {
    return UIBox {
        Kind: BoxKind.Absolute
        X: x
        Y: y
        Width: width
        Height: height
        Left: 0.0 ui
        Top: 0.0 ui
        Right: 0.0 ui
        Bottom: 0.0 ui
        Z: z
    }
}

fn Anchor(left: Float<ui>, top: Float<ui>, right: Float<ui>, bottom: Float<ui>) -> UIBox {
    return AnchorZ(left, top, right, bottom, 0)
}

fn AnchorZ(left: Float<ui>, top: Float<ui>, right: Float<ui>, bottom: Float<ui>, z: Int) -> UIBox {
    return UIBox {
        Kind: BoxKind.Anchored
        X: 0.0 px
        Y: 0.0 px
        Width: 0.0 px
        Height: 0.0 px
        Left: left
        Top: top
        Right: right
        Bottom: bottom
        Z: z
    }
}

fn AbsoluteBox(x: Float<px>, y: Float<px>, width: Float<px>, height: Float<px>) -> UIBox {
    return Absolute(x, y, width, height)
}

fn AbsoluteBoxZ(x: Float<px>, y: Float<px>, width: Float<px>, height: Float<px>, z: Int) -> UIBox {
    return AbsoluteZ(x, y, width, height, z)
}

fn AnchoredBox(left: Float<ui>, top: Float<ui>, right: Float<ui>, bottom: Float<ui>) -> UIBox {
    return Anchor(left, top, right, bottom)
}

fn AnchoredBoxZ(left: Float<ui>, top: Float<ui>, right: Float<ui>, bottom: Float<ui>, z: Int) -> UIBox {
    return AnchorZ(left, top, right, bottom, z)
}

fn Place(box: UIBox, child: UI) -> UI {
    return switch box.Kind {
        case BoxKind.Absolute => UIPlaceAbsolute(box.X, box.Y, box.Width, box.Height, child, box.Z)
        case BoxKind.Anchored => UIPlaceAnchored(box.Left, box.Top, box.Right, box.Bottom, child, box.Z)
    }
}

fn Mount(root: UI) -> MountRef {
    return MountRef { Handle: UIMount(root) }
}

fn Patch(mount: MountRef, next: UI) -> Int {
    return UIPatch(mount.Handle, next)
}

fn Unmount(mount: MountRef) -> Int {
    return UIUnmount(mount.Handle)
}

fn MountUI(root: UI) -> MountRef {
    return Mount(root)
}

fn PatchUI(mount: MountRef, next: UI) -> Int {
    return Patch(mount, next)
}

fn UnmountUI(mount: MountRef) -> Int {
    return Unmount(mount)
}

fn Emit(mount: MountRef, event: String) -> Int ! Error {
    return UIEmit(mount.Handle, event)?
}

fn DrainEvents(mount: MountRef) -> String[] {
    return UIDrainEvents(mount.Handle)
}

fn Signature(node: UI) -> String {
    return UISignature(node)
}
