package Json

// The contracts for the Json builtins are in Language/Builtins/Json. This
// file covers what the package is for: it gives the namespace a package, and
// inside it the builtins are the functions they are everywhere else.

record Reading {
    Name: String
    Levels: Float[]
}

[Fact]
fn AValueIsWrittenAndReadBack() -> Void ! Error {
    let text = Json.Text(Reading { Name: "north" Levels: [1.5, 2.0] })
    Assert.Equal("{\n  \"Name\": \"north\",\n  \"Levels\": [1.5, 2.0]\n}\n", text, "a record is an object with its fields as declared")
    let back = Json.Parse<Reading>(text)?
    Assert.Equal("north", back.Name, "the text reads back as the value")
    Assert.Equal(2.0, back.Levels[1], "with its array")
}

[Fact]
fn AFileThatDoesNotExistIsAnError() -> Void {
    Assert.Error(Json.Load<Reading>("Libraries/Json/no_such_file.json"), "the file does not exist")
}

[Fact]
fn NamespaceMarkerGivesThePackageADeclaration() -> Void {
    Assert.Equal(0, _JsonNamespaceMarker(), "import Json resolves to this package")
}
