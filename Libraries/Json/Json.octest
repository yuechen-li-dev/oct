package Json

[Fact]
fn JsonSaveLoadRoundTrip() -> Void {
    let path = "m11_json_roundtrip.json"
    let _saved = Save(path, "{ \"ok\": true, \"n\": 2 }")!
    let loaded = Load(path)!
    Assert.Equal("{\"ok\":true,\"n\":2}", loaded, "Json.Load should return compact JSON")
    Assert.Equal(loaded, Object(loaded), "Json.Object preserves raw string payloads")
    let _deleted = FileDelete(path)!
    return
}

[Fact]
fn JsonInvalidSaveFails() -> Void {
    var failed = false
    match Save("m11_json_invalid.json", "{") {
        ok(value) => { failed = value < 0 }
        err(reason) => { failed = true }
    }
    Assert.True(failed, "invalid JSON should fail before write")
    return
}
