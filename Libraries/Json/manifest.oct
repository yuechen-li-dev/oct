package Manifest

record PackageManifest {
    Name: String
    Version: String
    Description: String
    Authors: String[]
    Date: String
    Dependencies: Dependency[]
}

record Dependency {
    Name: String
    VersionRequirement: String
}

fn Manifest() -> PackageManifest {
    return PackageManifest {
        Name: "Json"
        Version: "0.1.0"
        Authors: ["Codex", "Claude"]
        Date: "2026-10-07"
        Description: "Reads JSON as a declared type and writes a typed value as JSON; the functions are compiler builtins"
        Dependencies: [Dependency { Name: "OctStd" VersionRequirement: "0.1.0" }]
    }
}
