package Manifest

record PackageManifest {
    Name: String
    Version: String
    Description: String
    Kind: String
    Dependencies: Dependency[]
    Wrappers: Wrapper[]
}

record Dependency {
    Name: String
    VersionRequirement: String
}

record Wrapper {
    Name: String
    Family: String
    Protocol: String
    SidecarCommand: String
    GoModuleDir: String
    Functions: WrapperFunction[]
}

record WrapperFunction {
    OctName: String
    WireName: String
    Args: String[]
    Return: String
    Fallible: Bool
}

fn Manifest() -> PackageManifest {
    return PackageManifest {
        Name: "Json"
        Version: "0.1.0"
        Description: "Thin JSON file wrappers with string payloads"
        Kind: "wrapper"
        Dependencies: [Dependency { Name: "OctStd" VersionRequirement: "0.1.0" }]
        Wrappers: [
            Wrapper {
                Name: "json"
                Family: "Json"
                Protocol: "octxiliary.v0"
                SidecarCommand: "octxiliary-json"
                GoModuleDir: "octxiliary"
                Functions: [
                    WrapperFunction { OctName: "Save" WireName: "JsonSave" Args: ["String", "String"] Return: "Int" Fallible: true },
                    WrapperFunction { OctName: "Load" WireName: "JsonLoad" Args: ["String"] Return: "String" Fallible: true }
                ]
            }
        ]
    }
}
