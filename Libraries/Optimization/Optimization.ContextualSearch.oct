package Optimization

// Optimization.ContextualSearch now uses explicit anonymous-function captures.
// The optimizer-facing objective keeps the ordinary fn(Float[]) -> Float type;
// external evidence is visibly snapshotted in the objective's `with` block.

/// Compatibility adapter for callers that previously threaded a packed context
/// argument through every Nelder-Mead objective call. New code should construct
/// a captured fn(Float[]) -> Float and call NelderMead directly.
fn NelderMeadWithContext(
    f:       fn(Float[], Float[]) -> Float,
    context: Float[],
    x0:      Float[],
    xTol:    Float,
    fTol:    Float,
    maxIter: Int
) -> OptimizationResultND ! Error {
    let objective = fn(x: Float[]) -> Float with {
        evaluate: f
        evidence: context
    } {
        return evaluate(x, evidence)
    }
    return NelderMead(objective, x0, xTol, fTol, maxIter)?
}

/// Single-coordinate perturbation search with a shrinking step size.
/// Only entries where active[i] is true are perturbed.
fn CoordinateDescent(
    f:           fn(Float[]) -> Float,
    x0:          Float[],
    active:      Bool[],
    initialStep: Float,
    outerRounds: Int
) -> OptimizationResultND ! Error {
    if Len(x0) == 0 {
        return error("CoordinateDescent: x0 must be non-empty")
    }
    if Len(active) != Len(x0) {
        return error("CoordinateDescent: active must be the same length as x0")
    }
    if initialStep <= 0.0 {
        return error("CoordinateDescent: initialStep must be > 0")
    }
    if outerRounds <= 0 {
        return error("CoordinateDescent: outerRounds must be > 0")
    }

    let n = Len(x0)
    var x = x0
    var bestLoss = f(x)
    var stepSize = initialStep
    var totalIter = 0

    for round in 0 .. outerRounds {
        var improved = true
        while improved {
            improved = false
            for j in 0 .. n {
                if active[j] {
                    let original = x[j]
                    x[j] = original + stepSize
                    let lossUp = f(x)
                    x[j] = original - stepSize
                    let lossDown = f(x)
                    x[j] = original

                    if lossUp < bestLoss and lossUp <= lossDown {
                        x[j] = original + stepSize
                        bestLoss = lossUp
                        improved = true
                    }
                    if lossDown < bestLoss and lossDown < lossUp {
                        x[j] = original - stepSize
                        bestLoss = lossDown
                        improved = true
                    }
                    totalIter = totalIter + 1
                }
            }
        }
        stepSize = stepSize * 0.5
    }

    return OptimizationResultND {
        Point:      x
        FMin:       bestLoss
        Iterations: totalIter
        Converged:  true
        GradNorm:   0.0
    }
}

/// Compatibility adapter for the former context-threading workaround.
fn CoordinateDescentWithContext(
    f:           fn(Float[], Float[]) -> Float,
    context:     Float[],
    x0:          Float[],
    active:      Bool[],
    initialStep: Float,
    outerRounds: Int
) -> OptimizationResultND ! Error {
    let objective = fn(x: Float[]) -> Float with {
        evaluate: f
        evidence: context
    } {
        return evaluate(x, evidence)
    }
    return CoordinateDescent(objective, x0, active, initialStep, outerRounds)?
}
