package Optimization

[Fact]
fn L2NormBasic() -> Void {
    let v = [3.0, 4.0]
    Assert.Near(5.0, L2Norm(v)!, 0.0001, "L2 norm of [3,4] = 5")
}

[Fact]
fn LInfNormBasic() -> Void {
    let v = [1.0, -5.0, 3.0]
    Assert.Near(5.0, LInfNorm(v)!, 0.0001, "L∞ norm of [1,-5,3] = 5")
}

[Fact]
fn DotProductBasic() -> Void {
    let a = [1.0, 2.0, 3.0]
    let b = [4.0, 5.0, 6.0]
    Assert.Near(32.0, Dot(a, b)!, 0.0001, "[1,2,3]·[4,5,6] = 32")
}

[Fact]
fn ScaleVector() -> Void {
    let v = [1.0, 2.0, 3.0]
    let s = Scale(v, 2.0)
    Assert.Near(2.0, s[0], 0.0001, "scale [1,2,3]*2 gives 2")
    Assert.Near(4.0, s[1], 0.0001, "scale [1,2,3]*2 gives 4")
    Assert.Near(6.0, s[2], 0.0001, "scale [1,2,3]*2 gives 6")
}

[Fact]
fn VecAddBasic() -> Void {
    let a = [1.0, 2.0]
    let b = [3.0, 4.0]
    let c = VecAdd(a, b)!
    Assert.Near(4.0, c[0], 0.0001, "vecadd [0]")
    Assert.Near(6.0, c[1], 0.0001, "vecadd [1]")
}

[Fact]
fn VecSubBasic() -> Void {
    let a = [5.0, 3.0]
    let b = [2.0, 1.0]
    let c = VecSub(a, b)!
    Assert.Near(3.0, c[0], 0.0001, "vecsub [0]")
    Assert.Near(2.0, c[1], 0.0001, "vecsub [1]")
}

[Fact]
fn RSSBasic() -> Void {
    let r = RSS([3.0, 4.0])
    Assert.Near(25.0, r, 0.0001, "RSS of [3,4] = 25")
}

[Fact]
fn LInfNormRejectsEmpty() -> Void {
    var empty: Float[] = []
    Assert.Error(LInfNorm(empty), "LInfNorm of empty should error")
}

[Fact]
fn L2NormRejectsEmpty() -> Void {
    var empty: Float[] = []
    Assert.Error(L2Norm(empty), "L2Norm of empty should error")
}

[Fact]
fn DotRejectsMismatch() -> Void {
    Assert.Error(Dot([1.0, 2.0], [1.0]), "Dot length mismatch should error")
}
