package Manifest

record PackageManifest {
    Name: String
    Version: String
    Description: String
    Authors: String[]
    Date: String
    Dependencies: Dependency[]
}

record Dependency {
    Name: String
    VersionRequirement: String
}

fn Manifest() -> PackageManifest {
    return PackageManifest {
        Name: "Optimization"
        Version: "0.2.0"
        Authors: ["Claude", "Codex"]
        Date: "2026-08-23"
        Description: "Mathematical optimization library. Multivariate gradient descent with Armijo backtracking, Nelder-Mead and coordinate-search objectives with explicit captures, nonlinear least-squares, and line search utilities."
        Dependencies: [Dependency { Name: "OctStd" VersionRequirement: "0.1.0" }]
    }
}
