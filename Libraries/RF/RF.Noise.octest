package RF

[Fact]
fn ThermalNoiseIncreasesWithBandwidthAndTemperature() -> Void {
    let narrow: Float<kg*m^2/s^3> = ThermalNoisePower(1000000Hz, 290.0K)
    let wide: Float<kg*m^2/s^3> = ThermalNoisePower(2000000Hz, 290.0K)
    Assert.True(wide > narrow, "noise power should increase with bandwidth")

    let cold = ThermalNoisePower(1000000Hz, 200.0K)
    let hot = ThermalNoisePower(1000000Hz, 400.0K)
    Assert.True(hot > cold, "noise power should increase with temperature")
}

[Fact]
fn ThermalNoiseSanityAndNoiseFigureComposition() -> Void {
    let baseNoise = ThermalNoisePower(1000000Hz, 290.0K)
    Assert.Near(0.00000000000000400388, baseNoise / (1kg*m^2/s^3), 0.000000000000000001, "kTB sanity for 1 MHz at 290 K")

    let nfNoise = ThermalNoisePowerWithNoiseFigure(1000000Hz, 290.0K, 2.0)
    Assert.Near(2.0, nfNoise / baseNoise, 0.000001, "noise figure should scale linear noise")
}

[Fact]
fn ThermalNoiseSeriesGeneralizesShapeAndElementwiseBehavior() -> Void {
    let single = ThermalNoisePowerSeries([1000000Hz], [290.0K])
    Assert.Equal(1, Len(single), "length-1 thermal noise shape")
    Assert.Near(ThermalNoisePower(1000000Hz, 290.0K) / (1kg*m^2/s^3), single[0] / (1kg*m^2/s^3), 0.000000000000000001, "length-1 equals scalar")

    var bandwidth: Float<Hz>[] = [1000000.0Hz]
    var temperature: Float<K>[] = [290.0K]
    var figure = [2.0]
    for _ in 1 .. 10 {
        bandwidth = Append(bandwidth, 1000000.0Hz)
        temperature = Append(temperature, 290.0K)
        figure = Append(figure, 2.0)
    }

    let series = ThermalNoisePowerWithNoiseFigureSeries(bandwidth, temperature, figure)
    Assert.Equal(Len(bandwidth), Len(series), "noise figure shape matches input")
    let seriesLast = Len(series) - 1
    Assert.Near(series[0] / (1kg*m^2/s^3), series[seriesLast] / (1kg*m^2/s^3), 0.000000000000000001, "constant inputs map elementwise")
}

[Fact]
fn InvalidNoiseInputsReturnZero() -> Void {
    Assert.Near(0.0, ThermalNoisePower(0Hz, 290.0K) / (1kg*m^2/s^3), 0.000001, "zero bandwidth invalid")
    Assert.Near(0.0, ThermalNoisePower(1000000Hz, 0.0K) / (1kg*m^2/s^3), 0.000001, "zero temperature invalid")
    Assert.Near(0.0, ThermalNoisePowerWithNoiseFigure(1000000Hz, 290.0K, 0.0) / (1kg*m^2/s^3), 0.000001, "zero noise figure invalid")
}
