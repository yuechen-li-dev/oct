package RF

[Fact]
fn NoisePowerForTargetSNRScalesAsExpected() -> Void {
    let noise = NoisePowerForTargetSNR(10.0kg*m^2/s^3, 5.0)
    Assert.Near(2.0, noise / (1.0kg*m^2/s^3), 0.000001, "noise power should be signal/snr")
}

[Fact]
fn AwgnHelpersPreserveShapeAndComposeAdditively() -> Void {
    let signal = [1.0kg*m^2/s^3, 2.0kg*m^2/s^3, 3.0kg*m^2/s^3, 4.0kg*m^2/s^3]
    let noise = [0.1kg*m^2/s^3, 0.0kg*m^2/s^3 - 0.2kg*m^2/s^3, 0.05kg*m^2/s^3, 0.0kg*m^2/s^3]

    let combined = ApplyAwgnSamples(signal, noise)
    Assert.Equal(Len(signal), Len(combined), "awgn helper should preserve sample shape")
    Assert.Near(1.1, combined[0] / (1.0kg*m^2/s^3), 0.000001, "first sample add")
    Assert.Near(1.8, combined[1] / (1.0kg*m^2/s^3), 0.000001, "second sample add")

    let scalar = ApplyAdditiveNoise(3.0kg*m^2/s^3, 0.0kg*m^2/s^3 - 0.5kg*m^2/s^3)
    Assert.Near(2.5, scalar / (1.0kg*m^2/s^3), 0.000001, "scalar additive noise")
}

[Fact]
fn AwgnHelpersGeneralizeAcrossSequenceLengths() -> Void {
    let len1 = ApplyAwgnSamples([2.0kg*m^2/s^3], [0.5kg*m^2/s^3])
    Assert.Equal(1, Len(len1), "length-1 awgn shape")
    Assert.Near(2.5, len1[0] / (1.0kg*m^2/s^3), 0.000001, "length-1 awgn value")

    var signal = [1.0kg*m^2/s^3]
    var noise = [0.01kg*m^2/s^3]
    for _ in 1 .. 100 {
        signal = Append(signal, 1.0kg*m^2/s^3)
        noise = Append(noise, 0.01kg*m^2/s^3)
    }

    let large = ApplyAwgnSamples(signal, noise)
    Assert.Equal(Len(signal), Len(large), "large awgn shape matches input")
    let largeLast = Len(large) - 1
    Assert.Near(1.01, large[0] / (1.0kg*m^2/s^3), 0.000001, "first large awgn sample")
    Assert.Near(1.01, large[largeLast] / (1.0kg*m^2/s^3), 0.000001, "last large awgn sample")
}

[Fact]
fn RayleighHelpersHaveExpectedAmplitudeAndGain() -> Void {
    let component = Sqrt(0.5)
    let gain = RayleighPowerGainFromComponents(component, component)
    Assert.Near(1.0, gain, 0.000001, "equal normalized components yield unit mean-power gain sample")

    let amplitude = RayleighAmplitudeFromComponents(0.6, 0.8)
    Assert.Near(1.0, amplitude, 0.000001, "amplitude should be sqrt(i^2 + q^2)")

    let faded = ApplyRayleighFading(2.0kg*m^2/s^3, 0.6, 0.8)
    Assert.Near(2.0, faded / (1.0kg*m^2/s^3), 0.000001, "faded power scales with gain")
}

[Fact]
fn RayleighSeriesAppliesElementwise() -> Void {
    let samples = [1.0kg*m^2/s^3, 2.0kg*m^2/s^3, 3.0kg*m^2/s^3, 4.0kg*m^2/s^3]
    let i = [1.0, 0.5, 0.0, 1.0]
    let q = [0.0, 0.5, 1.0, 1.0]

    let out = ApplyRayleighFadingSeries(samples, i, q)
    Assert.Equal(4, Len(out), "rayleigh series should preserve shape")
    Assert.Near(1.0, out[0] / (1.0kg*m^2/s^3), 0.000001, "gain 1")
    Assert.Near(1.0, out[1] / (1.0kg*m^2/s^3), 0.000001, "gain 0.5")
    Assert.Near(3.0, out[2] / (1.0kg*m^2/s^3), 0.000001, "gain 1")
    Assert.Near(8.0, out[3] / (1.0kg*m^2/s^3), 0.000001, "gain 2")
}

[Fact]
fn RayleighPowerGainAndSeriesGeneralizeAcrossLengths() -> Void {
    let scalar = ApplyPowerGain(2.0kg*m^2/s^3, 0.25)
    Assert.Near(0.5, scalar / (1.0kg*m^2/s^3), 0.000001, "scalar gain apply")

    let gain = RayleighPowerGainSeries([1.0], [1.0])
    Assert.Equal(1, Len(gain), "single-element gain length")
    Assert.Near(2.0, gain[0], 0.000001, "single-element gain value")

    var samples = [1.0kg*m^2/s^3]
    var i = [1.0]
    var q = [0.0]
    for _ in 1 .. 10 {
        samples = Append(samples, 1.0kg*m^2/s^3)
        i = Append(i, 0.6)
        q = Append(q, 0.8)
    }

    let out = ApplyRayleighFadingSeries(samples, i, q)
    Assert.Equal(Len(samples), Len(out), "rayleigh shape matches input")
    let outLast = Len(out) - 1
    Assert.Near(1.0, out[0] / (1.0kg*m^2/s^3), 0.000001, "first gain is one")
    Assert.Near(1.0, out[outLast] / (1.0kg*m^2/s^3), 0.000001, "last gain is one")
}

[Fact]
fn InvalidFadingInputsReturnSentinelShape() -> Void {
    let awgn = ApplyAwgnSamples([1.0kg*m^2/s^3, 2.0kg*m^2/s^3, 3.0kg*m^2/s^3, 4.0kg*m^2/s^3], [0.0kg*m^2/s^3])
    Assert.Equal(1, Len(awgn), "mismatched awgn arrays return sentinel shape")

    let rayleigh = ApplyRayleighFadingSeries([1.0kg*m^2/s^3, 2.0kg*m^2/s^3, 3.0kg*m^2/s^3, 4.0kg*m^2/s^3], [1.0], [1.0])
    Assert.Equal(1, Len(rayleigh), "mismatched rayleigh arrays return sentinel shape")
}

[Fact]
fn RicianHelpersCaptureLosVsRayleighLikeBehavior() -> Void {
    let rayleighLike = RicianPowerGainFromComponents(0.0, 1.0, 0.0)
    Assert.Near(1.0, rayleighLike, 0.000001, "k=0 should reduce to Rayleigh-style gain from scattered components")

    let losDominant = RicianPowerGainFromComponents(9.0, 0.0, 0.0)
    Assert.Near(0.9, losDominant, 0.000001, "pure LOS component should be k/(k+1)")

    let mixed = RicianPowerGainFromComponents(9.0, 1.0, 0.0)
    Assert.True(mixed > rayleighLike, "large K with aligned scatter should show LOS-dominant behavior")

    let amplitude = RicianAmplitudeFromComponents(3.0, 0.0, 0.0)
    Assert.Near(Sqrt(0.75), amplitude, 0.000001, "amplitude is sqrt(power gain)")
}

[Fact]
fn RicianSeriesHelpersComposeElementwise() -> Void {
    let samples = [1.0kg*m^2/s^3, 2.0kg*m^2/s^3, 3.0kg*m^2/s^3]
    let i = [0.0, 1.0, 0.0]
    let q = [0.0, 0.0, 1.0]

    let gain = RicianPowerGainSeries(1.0, i, q)
    Assert.Equal(3, Len(gain), "rician gain series shape")
    Assert.Near(0.5, gain[0], 0.000001, "los-only sample")

    let out = ApplyRicianFadingSeries(samples, 1.0, i, q)
    Assert.Equal(3, Len(out), "rician fade series shape")
    Assert.Near(0.5, out[0] / (1.0kg*m^2/s^3), 0.000001, "first sample scaled")

    let scalar = ApplyRicianFading(2.0kg*m^2/s^3, 1.0, 0.0, 0.0)
    Assert.Near(1.0, scalar / (1.0kg*m^2/s^3), 0.000001, "scalar rician fading")
}

[Fact]
fn InvalidRicianInputsReturnSentinelShape() -> Void {
    let mismatchedGain = RicianPowerGainSeries(1.0, [0.0, 1.0], [0.0])
    Assert.Equal(1, Len(mismatchedGain), "mismatched rician components return sentinel shape")

    let mismatchedFading = ApplyRicianFadingSeries([1.0kg*m^2/s^3, 2.0kg*m^2/s^3], 1.0, [0.0], [0.0])
    Assert.Equal(1, Len(mismatchedFading), "mismatched rician fading input returns sentinel shape")

    Assert.Near(0.0, RicianPowerGainFromComponents(0.0 - 1.0, 1.0, 0.0), 0.000001, "negative K-factor is invalid")
}
