package RF

/// Returns the Boltzmann constant used by thermal noise calculations.
/// Units: W/(Hz·K), represented in base SI units.
fn BoltzmannConstantWattsPerHzKelvin() -> Float<kg*m^2/s^2/K> {
    return 0.00000000000000000000001380649kg*m^2/s^2/K
}

/// Computes available thermal noise power using kTB.
/// Param bandwidthHz: Receiver noise-equivalent bandwidth.
/// Param temperatureKelvin: Physical noise temperature.
/// Units: Bandwidth in Hz, temperature in K, output in W.
/// Remarks: Returns zero when bandwidth or temperature is non-positive.
fn ThermalNoisePower(bandwidthHz: Float<Hz>, temperatureKelvin: Float<K>) -> Float<kg*m^2/s^3> {
    if bandwidthHz <= 0Hz {
        return 0kg*m^2/s^3
    }
    if temperatureKelvin <= 0K {
        return 0kg*m^2/s^3
    }

    return BoltzmannConstantWattsPerHzKelvin() * temperatureKelvin * bandwidthHz
}

/// Computes thermal noise power for paired bandwidth and temperature series.
/// Remarks: Returns [0 power] when lengths mismatch or input is empty.
fn ThermalNoisePowerSeries(bandwidthHz: Float<Hz>[], temperatureKelvin: Float<K>[]) -> Float<kg*m^2/s^3>[] {
    if Len(bandwidthHz) != Len(temperatureKelvin) {
        return [0kg*m^2/s^3]
    }
    if Len(bandwidthHz) == 0 {
        return [0kg*m^2/s^3]
    }

    var out = [ThermalNoisePower(bandwidthHz[0], temperatureKelvin[0])]
    for i in 1 .. Len(bandwidthHz) {
        out = Append(out, ThermalNoisePower(bandwidthHz[i], temperatureKelvin[i]))
    }
    return out
}

/// Applies receiver noise figure to ideal kTB noise power.
/// Param noiseFigureLinear: Dimensionless linear noise factor F.
/// Remarks: Returns zero when noise figure is non-positive.
fn ThermalNoisePowerWithNoiseFigure(bandwidthHz: Float<Hz>, temperatureKelvin: Float<K>, noiseFigureLinear: Float) -> Float<kg*m^2/s^3> {
    if noiseFigureLinear <= 0 {
        return 0kg*m^2/s^3
    }
    return ThermalNoisePower(bandwidthHz, temperatureKelvin) * noiseFigureLinear
}

/// Computes ThermalNoisePowerWithNoiseFigure for paired input series.
/// Remarks: Returns [0 power] when lengths mismatch or input is empty.
fn ThermalNoisePowerWithNoiseFigureSeries(bandwidthHz: Float<Hz>[], temperatureKelvin: Float<K>[], noiseFigureLinear: Float[]) -> Float<kg*m^2/s^3>[] {
    if Len(bandwidthHz) != Len(temperatureKelvin) {
        return [0kg*m^2/s^3]
    }
    if Len(bandwidthHz) != Len(noiseFigureLinear) {
        return [0kg*m^2/s^3]
    }
    if Len(bandwidthHz) == 0 {
        return [0kg*m^2/s^3]
    }

    var out = [ThermalNoisePowerWithNoiseFigure(bandwidthHz[0], temperatureKelvin[0], noiseFigureLinear[0])]
    for i in 1 .. Len(bandwidthHz) {
        out = Append(out, ThermalNoisePowerWithNoiseFigure(bandwidthHz[i], temperatureKelvin[i], noiseFigureLinear[i]))
    }
    return out
}
