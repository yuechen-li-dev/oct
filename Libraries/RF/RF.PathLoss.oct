package RF

import Physics

/// Compatibility RF name for the canonical Physics speed of light.
/// Units: m/s.
fn SpeedOfLightMetersPerSecond() -> Float<m/s> {
    return Physics.SpeedOfLight()
}

/// Computes free-space path loss factor from Friis geometry in linear scale.
/// Param distance: Line-of-sight propagation distance.
/// Param frequencyHz: Carrier frequency.
/// Returns: Dimensionless path-loss multiplier >= 0.
/// Units: Distance in m, frequency in Hz.
/// Remarks: Returns 0 when distance or frequency is non-positive.
fn FreeSpacePathLossLinear(distance: Float<m>, frequencyHz: Float<Hz>) -> Float {
    if distance <= 0m {
        return 0.0
    }
    if frequencyHz <= 0Hz {
        return 0.0
    }

    let wavelengthMeters = SpeedOfLightMetersPerSecond() / frequencyHz
    let geometricTerm = 4.0 * Pi() * (distance / 1m) / (wavelengthMeters / 1m)
    return geometricTerm * geometricTerm
}

/// Maps FreeSpacePathLossLinear across a distance series.
/// Param distance: Distance samples evaluated independently.
/// Param frequencyHz: Shared carrier frequency.
/// Remarks: Returns [0.0] for empty input.
fn FreeSpacePathLossLinearSeries(distance: Float<m>[], frequencyHz: Float<Hz>) -> Float[] {
    if Len(distance) == 0 {
        return [0.0]
    }

    var out = [FreeSpacePathLossLinear(distance[0], frequencyHz)]
    for i in 1 .. Len(distance) {
        out = Append(out, FreeSpacePathLossLinear(distance[i], frequencyHz))
    }
    return out
}

/// Computes log-distance path loss from a calibrated reference point.
/// Param distance: Evaluation distance.
/// Param referenceDistance: Calibration distance d0.
/// Param referencePathLossLinear: Path-loss factor at d0.
/// Param pathLossExponent: Environment exponent n.
/// Remarks: Returns 0 when any required positive input is invalid.
fn LogDistancePathLossLinear(distance: Float<m>, referenceDistance: Float<m>, referencePathLossLinear: Float, pathLossExponent: Float) -> Float {
    if distance <= 0m {
        return 0.0
    }
    if referenceDistance <= 0m {
        return 0.0
    }
    if referencePathLossLinear <= 0 {
        return 0.0
    }

    let distanceRatio = distance / referenceDistance
    return referencePathLossLinear * Pow(distanceRatio, pathLossExponent)
}

/// Maps LogDistancePathLossLinear across a distance series.
/// Param distance: Distance samples evaluated independently.
/// Remarks: Returns [0.0] for empty input.
fn LogDistancePathLossLinearSeries(distance: Float<m>[], referenceDistance: Float<m>, referencePathLossLinear: Float, pathLossExponent: Float) -> Float[] {
    if Len(distance) == 0 {
        return [0.0]
    }

    var out = [LogDistancePathLossLinear(distance[0], referenceDistance, referencePathLossLinear, pathLossExponent)]
    for i in 1 .. Len(distance) {
        out = Append(out, LogDistancePathLossLinear(distance[i], referenceDistance, referencePathLossLinear, pathLossExponent))
    }
    return out
}

/// Converts log-normal shadowing offset from dB to linear multiplier.
fn ShadowingLinearFromDb(shadowingDb: Float) -> Float {
    return DbToLinear(shadowingDb)
}

/// Maps ShadowingLinearFromDb across dB offsets.
/// Remarks: Returns [0.0] for empty input.
fn ShadowingLinearFromDbSeries(shadowingDb: Float[]) -> Float[] {
    if Len(shadowingDb) == 0 {
        return [0.0]
    }

    var out = [ShadowingLinearFromDb(shadowingDb[0])]
    for i in 1 .. Len(shadowingDb) {
        out = Append(out, ShadowingLinearFromDb(shadowingDb[i]))
    }
    return out
}

/// Applies a shadowing offset to path-loss factor in linear domain.
/// Param pathLossLinear: Baseline path-loss multiplier.
/// Param shadowingDb: Additional attenuation/amplification in dB.
/// Remarks: Returns 0 when baseline path loss is non-positive.
fn ApplyShadowingToPathLoss(pathLossLinear: Float, shadowingDb: Float) -> Float {
    if pathLossLinear <= 0 {
        return 0.0
    }
    return pathLossLinear * ShadowingLinearFromDb(shadowingDb)
}

/// Applies per-sample shadowing to per-sample path-loss factors.
/// Remarks: Returns [0.0] when lengths mismatch or input is empty.
fn ApplyShadowingToPathLossSeries(pathLossLinear: Float[], shadowingDb: Float[]) -> Float[] {
    if Len(pathLossLinear) != Len(shadowingDb) {
        return [0.0]
    }
    if Len(pathLossLinear) == 0 {
        return [0.0]
    }

    var out = [ApplyShadowingToPathLoss(pathLossLinear[0], shadowingDb[0])]
    for i in 1 .. Len(pathLossLinear) {
        out = Append(out, ApplyShadowingToPathLoss(pathLossLinear[i], shadowingDb[i]))
    }
    return out
}

/// Applies a shadowing loss factor to received power.
/// Param receivedPower: Baseline received power.
/// Param shadowingDb: Shadowing offset in dB, converted to linear before division.
/// Remarks: Returns zero power when converted shadowing factor is non-positive.
fn ApplyShadowingToReceivedPower(receivedPower: Float<kg*m^2/s^3>, shadowingDb: Float) -> Float<kg*m^2/s^3> {
    let shadowingLinear = ShadowingLinearFromDb(shadowingDb)
    if shadowingLinear <= 0 {
        return 0kg*m^2/s^3
    }
    return receivedPower / shadowingLinear
}

/// Applies ApplyShadowingToReceivedPower sample-by-sample.
/// Remarks: Returns [0 power] when lengths mismatch or input is empty.
fn ApplyShadowingToReceivedPowerSeries(receivedPower: Float<kg*m^2/s^3>[], shadowingDb: Float[]) -> Float<kg*m^2/s^3>[] {
    if Len(receivedPower) != Len(shadowingDb) {
        return [0kg*m^2/s^3]
    }
    if Len(receivedPower) == 0 {
        return [0kg*m^2/s^3]
    }

    var out = [ApplyShadowingToReceivedPower(receivedPower[0], shadowingDb[0])]
    for i in 1 .. Len(receivedPower) {
        out = Append(out, ApplyShadowingToReceivedPower(receivedPower[i], shadowingDb[i]))
    }
    return out
}
