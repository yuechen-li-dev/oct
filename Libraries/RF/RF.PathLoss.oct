package RF

fn SpeedOfLightMetersPerSecond() -> Float {
    return 299792458.0
}

fn FreeSpacePathLossLinear(distance: Float<m>, frequencyHz: Float) -> Float {
    if distance <= 0m {
        return 0.0
    }
    if frequencyHz <= 0 {
        return 0.0
    }

    let wavelengthMeters = SpeedOfLightMetersPerSecond() / frequencyHz
    let geometricTerm = 4.0 * Pi() * (distance / 1m) / wavelengthMeters
    return geometricTerm * geometricTerm
}

fn FreeSpacePathLossLinearSeries(distance: Float<m>[], frequencyHz: Float) -> Float[] {
    if Len(distance) == 0 {
        return [0.0]
    }

    var out = [FreeSpacePathLossLinear(distance[0], frequencyHz)]
    for i in 1 .. Len(distance) {
        out = Append(out, FreeSpacePathLossLinear(distance[i], frequencyHz))
    }
    return out
}

fn LogDistancePathLossLinear(distance: Float<m>, referenceDistance: Float<m>, referencePathLossLinear: Float, pathLossExponent: Float) -> Float {
    if distance <= 0m {
        return 0.0
    }
    if referenceDistance <= 0m {
        return 0.0
    }
    if referencePathLossLinear <= 0 {
        return 0.0
    }

    let distanceRatio = distance / referenceDistance
    return referencePathLossLinear * Exp(pathLossExponent * Ln(distanceRatio))
}

fn LogDistancePathLossLinearSeries(distance: Float<m>[], referenceDistance: Float<m>, referencePathLossLinear: Float, pathLossExponent: Float) -> Float[] {
    if Len(distance) == 0 {
        return [0.0]
    }

    var out = [LogDistancePathLossLinear(distance[0], referenceDistance, referencePathLossLinear, pathLossExponent)]
    for i in 1 .. Len(distance) {
        out = Append(out, LogDistancePathLossLinear(distance[i], referenceDistance, referencePathLossLinear, pathLossExponent))
    }
    return out
}
