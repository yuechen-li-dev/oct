package RF

fn SpeedOfLightMetersPerSecond() -> Float {
    return 299792458.0
}

fn FreeSpacePathLossLinear(distance: Float<m>, frequencyHz: Float) -> Float {
    if distance <= 0m {
        return 0.0
    }
    if frequencyHz <= 0 {
        return 0.0
    }

    let wavelengthMeters = SpeedOfLightMetersPerSecond() / frequencyHz
    let geometricTerm = 4.0 * Pi() * (distance / 1m) / wavelengthMeters
    return geometricTerm * geometricTerm
}

fn FreeSpacePathLossLinearSeries(distance: Float<m>[], frequencyHz: Float) -> Float[] {
    if Len(distance) == 0 {
        return [0.0]
    }

    var out = [FreeSpacePathLossLinear(distance[0], frequencyHz)]
    for i in 1 .. Len(distance) {
        out = Append(out, FreeSpacePathLossLinear(distance[i], frequencyHz))
    }
    return out
}

fn LogDistancePathLossLinear(distance: Float<m>, referenceDistance: Float<m>, referencePathLossLinear: Float, pathLossExponent: Float) -> Float {
    if distance <= 0m {
        return 0.0
    }
    if referenceDistance <= 0m {
        return 0.0
    }
    if referencePathLossLinear <= 0 {
        return 0.0
    }

    let distanceRatio = distance / referenceDistance
    return referencePathLossLinear * Exp(pathLossExponent * Ln(distanceRatio))
}

fn LogDistancePathLossLinearSeries(distance: Float<m>[], referenceDistance: Float<m>, referencePathLossLinear: Float, pathLossExponent: Float) -> Float[] {
    if Len(distance) == 0 {
        return [0.0]
    }

    var out = [LogDistancePathLossLinear(distance[0], referenceDistance, referencePathLossLinear, pathLossExponent)]
    for i in 1 .. Len(distance) {
        out = Append(out, LogDistancePathLossLinear(distance[i], referenceDistance, referencePathLossLinear, pathLossExponent))
    }
    return out
}


fn ShadowingLinearFromDb(shadowingDb: Float) -> Float {
    return DbToLinear(shadowingDb)
}

fn ShadowingLinearFromDbSeries(shadowingDb: Float[]) -> Float[] {
    if Len(shadowingDb) == 0 {
        return [0.0]
    }

    var out = [ShadowingLinearFromDb(shadowingDb[0])]
    for i in 1 .. Len(shadowingDb) {
        out = Append(out, ShadowingLinearFromDb(shadowingDb[i]))
    }
    return out
}

fn ApplyShadowingToPathLoss(pathLossLinear: Float, shadowingDb: Float) -> Float {
    if pathLossLinear <= 0 {
        return 0.0
    }
    return pathLossLinear * ShadowingLinearFromDb(shadowingDb)
}

fn ApplyShadowingToPathLossSeries(pathLossLinear: Float[], shadowingDb: Float[]) -> Float[] {
    if Len(pathLossLinear) != Len(shadowingDb) {
        return [0.0]
    }
    if Len(pathLossLinear) == 0 {
        return [0.0]
    }

    var out = [ApplyShadowingToPathLoss(pathLossLinear[0], shadowingDb[0])]
    for i in 1 .. Len(pathLossLinear) {
        out = Append(out, ApplyShadowingToPathLoss(pathLossLinear[i], shadowingDb[i]))
    }
    return out
}

fn ApplyShadowingToReceivedPower(receivedPower: Float<kg*m^2/s^3>, shadowingDb: Float) -> Float<kg*m^2/s^3> {
    let shadowingLinear = ShadowingLinearFromDb(shadowingDb)
    if shadowingLinear <= 0 {
        return 0kg*m^2/s^3
    }
    return receivedPower / shadowingLinear
}

fn ApplyShadowingToReceivedPowerSeries(receivedPower: Float<kg*m^2/s^3>[], shadowingDb: Float[]) -> Float<kg*m^2/s^3>[] {
    if Len(receivedPower) != Len(shadowingDb) {
        return [0kg*m^2/s^3]
    }
    if Len(receivedPower) == 0 {
        return [0kg*m^2/s^3]
    }

    var out = [ApplyShadowingToReceivedPower(receivedPower[0], shadowingDb[0])]
    for i in 1 .. Len(receivedPower) {
        out = Append(out, ApplyShadowingToReceivedPower(receivedPower[i], shadowingDb[i]))
    }
    return out
}
