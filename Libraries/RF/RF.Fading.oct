package RF

fn NoisePowerForTargetSNR(signalPower: Float<kg*m^2/s^3>, snrLinear: Float) -> Float<kg*m^2/s^3> {
    if snrLinear <= 0 {
        return 0.0kg*m^2/s^3
    }
    return signalPower / snrLinear
}

fn ApplyAdditiveNoise(signal: Float<kg*m^2/s^3>, noise: Float<kg*m^2/s^3>) -> Float<kg*m^2/s^3> {
    return signal + noise
}

fn ApplyPowerGain(sample: Float<kg*m^2/s^3>, gain: Float) -> Float<kg*m^2/s^3> {
    return sample * gain
}

fn ApplyAwgnSamples(signal: Float<kg*m^2/s^3>[], noise: Float<kg*m^2/s^3>[]) -> Float<kg*m^2/s^3>[] {
    if Len(signal) != Len(noise) {
        return [0.0kg*m^2/s^3]
    }
    if Len(signal) == 0 {
        return [0.0kg*m^2/s^3]
    }

    var out = [ApplyAdditiveNoise(signal[0], noise[0])]
    for i in 1 .. Len(signal) {
        out = Append(out, ApplyAdditiveNoise(signal[i], noise[i]))
    }

    return out
}

fn RayleighPowerGainFromComponents(inPhase: Float, quadrature: Float) -> Float {
    return inPhase * inPhase + quadrature * quadrature
}

fn RayleighAmplitudeFromComponents(inPhase: Float, quadrature: Float) -> Float {
    return Sqrt(RayleighPowerGainFromComponents(inPhase, quadrature))
}

fn ApplyRayleighFading(sample: Float<kg*m^2/s^3>, inPhase: Float, quadrature: Float) -> Float<kg*m^2/s^3> {
    return ApplyPowerGain(sample, RayleighPowerGainFromComponents(inPhase, quadrature))
}

fn RayleighPowerGainSeries(inPhase: Float[], quadrature: Float[]) -> Float[] {
    if Len(inPhase) != Len(quadrature) {
        return [0.0]
    }
    if Len(inPhase) == 0 {
        return [0.0]
    }

    var out = [RayleighPowerGainFromComponents(inPhase[0], quadrature[0])]
    for i in 1 .. Len(inPhase) {
        out = Append(out, RayleighPowerGainFromComponents(inPhase[i], quadrature[i]))
    }

    return out
}

fn ApplyPowerGainSeries(samples: Float<kg*m^2/s^3>[], gain: Float[]) -> Float<kg*m^2/s^3>[] {
    if Len(samples) != Len(gain) {
        return [0.0kg*m^2/s^3]
    }
    if Len(samples) == 0 {
        return [0.0kg*m^2/s^3]
    }

    var out = [ApplyPowerGain(samples[0], gain[0])]
    for i in 1 .. Len(samples) {
        out = Append(out, ApplyPowerGain(samples[i], gain[i]))
    }
    return out
}

fn ApplyRayleighFadingSeries(samples: Float<kg*m^2/s^3>[], inPhase: Float[], quadrature: Float[]) -> Float<kg*m^2/s^3>[] {
    let gain = RayleighPowerGainSeries(inPhase, quadrature)
    if Len(samples) != Len(gain) {
        return [0.0kg*m^2/s^3]
    }
    return ApplyPowerGainSeries(samples, gain)
}


fn RicianPowerGainFromComponents(kFactorLinear: Float, scatterInPhase: Float, scatterQuadrature: Float) -> Float {
    if kFactorLinear < 0 {
        return 0.0
    }

    let normalization = Sqrt(kFactorLinear + 1.0)
    let losInPhase = Sqrt(kFactorLinear) / normalization
    let scatterInPhaseNormalized = scatterInPhase / normalization
    let scatterQuadratureNormalized = scatterQuadrature / normalization

    let combinedInPhase = losInPhase + scatterInPhaseNormalized
    return RayleighPowerGainFromComponents(combinedInPhase, scatterQuadratureNormalized)
}

fn RicianAmplitudeFromComponents(kFactorLinear: Float, scatterInPhase: Float, scatterQuadrature: Float) -> Float {
    return Sqrt(RicianPowerGainFromComponents(kFactorLinear, scatterInPhase, scatterQuadrature))
}

fn ApplyRicianFading(sample: Float<kg*m^2/s^3>, kFactorLinear: Float, scatterInPhase: Float, scatterQuadrature: Float) -> Float<kg*m^2/s^3> {
    return ApplyPowerGain(sample, RicianPowerGainFromComponents(kFactorLinear, scatterInPhase, scatterQuadrature))
}

fn RicianPowerGainSeries(kFactorLinear: Float, scatterInPhase: Float[], scatterQuadrature: Float[]) -> Float[] {
    if Len(scatterInPhase) != Len(scatterQuadrature) {
        return [0.0]
    }
    if Len(scatterInPhase) == 0 {
        return [0.0]
    }

    var out = [RicianPowerGainFromComponents(kFactorLinear, scatterInPhase[0], scatterQuadrature[0])]
    for i in 1 .. Len(scatterInPhase) {
        out = Append(out, RicianPowerGainFromComponents(kFactorLinear, scatterInPhase[i], scatterQuadrature[i]))
    }

    return out
}

fn ApplyRicianFadingSeries(samples: Float<kg*m^2/s^3>[], kFactorLinear: Float, scatterInPhase: Float[], scatterQuadrature: Float[]) -> Float<kg*m^2/s^3>[] {
    let gain = RicianPowerGainSeries(kFactorLinear, scatterInPhase, scatterQuadrature)
    if Len(samples) != Len(gain) {
        return [0.0kg*m^2/s^3]
    }
    return ApplyPowerGainSeries(samples, gain)
}
