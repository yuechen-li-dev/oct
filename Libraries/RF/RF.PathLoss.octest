package RF

[Fact]
fn FreeSpacePathLossIncreasesWithDistanceAndFrequency() -> Void {
    let f = 2400000000

    let nearLoss = FreeSpacePathLossLinear(1m, f)
    let farLoss = FreeSpacePathLossLinear(10m, f)
    Assert.True(farLoss > nearLoss, "fspl should increase with distance")

    let lowFreqLoss = FreeSpacePathLossLinear(10m, 900000000)
    let highFreqLoss = FreeSpacePathLossLinear(10m, 2400000000)
    Assert.True(highFreqLoss > lowFreqLoss, "fspl should increase with frequency")
}

[Fact]
fn PathLossSeriesGeneralizesShapeAndElementwiseBehavior() -> Void {
    let distance = [1m]
    let fspl1 = FreeSpacePathLossLinearSeries(distance, 2400000000)
    Assert.Equal(1, Len(fspl1), "length-1 fspl shape")
    Assert.Near(FreeSpacePathLossLinear(1m, 2400000000), fspl1[0], 0.000001, "length-1 fspl equals scalar")

    var distances = [1m]
    for _ in 1 .. 100 {
        distances = Append(distances, 1m)
    }

    let fsplLarge = FreeSpacePathLossLinearSeries(distances, 2400000000)
    Assert.Equal(Len(distances), Len(fsplLarge), "large fspl shape matches input")
    let fsplLast = Len(fsplLarge) - 1
    Assert.Near(fsplLarge[0], fsplLarge[fsplLast], 0.000001, "constant distance maps elementwise")

    let logSeries = LogDistancePathLossLinearSeries([1m, 2m, 4m], 1m, 10.0, 2.0)
    Assert.Near(10.0, logSeries[0], 0.000001, "log-distance first element")
    Assert.Near(40.0, logSeries[1], 0.00001, "log-distance second element")
    Assert.Near(160.0, logSeries[2], 0.00001, "log-distance third element")
}

[Fact]
fn FreeSpacePathLossSanityAtOneMeterTwoPointFourGHz() -> Void {
    let fspl = FreeSpacePathLossLinear(1m, 2400000000)
    Assert.Near(10117.0, fspl, 50.0, "1 m, 2.4 GHz FSPL linear sanity")
}

[Fact]
fn LogDistancePathLossHasExpectedGrowthAndReference() -> Void {
    let reference = 100.0
    let sameDistance = LogDistancePathLossLinear(1m, 1m, reference, 2.0)
    Assert.Near(reference, sameDistance, 0.0001, "reference distance should preserve baseline")

    let n2 = LogDistancePathLossLinear(10m, 1m, reference, 2.0)
    let n3 = LogDistancePathLossLinear(10m, 1m, reference, 3.0)
    Assert.True(n2 > reference, "path loss should increase with distance")
    Assert.True(n3 > n2, "larger exponent should grow path loss faster")
}

[Fact]
fn InvalidPathLossInputsReturnZero() -> Void {
    Assert.Equal(0.0, FreeSpacePathLossLinear(0m, 1000000000), "zero distance is invalid")
    Assert.Equal(0.0, FreeSpacePathLossLinear(1m, 0), "zero frequency is invalid")
    Assert.Equal(0.0, LogDistancePathLossLinear(1m, 0m, 100.0, 2.0), "zero reference distance is invalid")
}

[Fact]
fn ShadowingComposesWithPathLossAndReceivedPower() -> Void {
    let baseLoss = 100.0
    let plusThreeDbLoss = ApplyShadowingToPathLoss(baseLoss, 3.0)
    Assert.True(plusThreeDbLoss > baseLoss, "+3 dB shadowing should increase path loss")

    let minusThreeDbLoss = ApplyShadowingToPathLoss(baseLoss, 0.0 - 3.0)
    Assert.True(minusThreeDbLoss < baseLoss, "-3 dB shadowing should decrease path loss")

    let rx = 1.0kg*m^2/s^3
    let rxPlusThreeDb = ApplyShadowingToReceivedPower(rx, 3.0)
    let rxMinusThreeDb = ApplyShadowingToReceivedPower(rx, 0.0 - 3.0)
    Assert.True(rxPlusThreeDb < rx, "+3 dB shadowing should reduce received power")
    Assert.True(rxMinusThreeDb > rx, "-3 dB shadowing should increase received power")
}

[Fact]
fn ShadowingSeriesHelpersPreserveShapeAndElementwiseBehavior() -> Void {
    let shadowingDb = [0.0, 3.0, 0.0 - 3.0]
    let linear = ShadowingLinearFromDbSeries(shadowingDb)
    Assert.Equal(3, Len(linear), "shadowing linear series shape")
    Assert.Near(1.0, linear[0], 0.000001, "0 dB is unity")

    let pathLossSeries = ApplyShadowingToPathLossSeries([100.0, 100.0, 100.0], shadowingDb)
    Assert.Equal(3, Len(pathLossSeries), "path loss shadowing shape")
    Assert.True(pathLossSeries[1] > pathLossSeries[0], "+3 dB path loss increases")
    Assert.True(pathLossSeries[2] < pathLossSeries[0], "-3 dB path loss decreases")

    let rxSeries = ApplyShadowingToReceivedPowerSeries([1.0kg*m^2/s^3, 1.0kg*m^2/s^3, 1.0kg*m^2/s^3], shadowingDb)
    Assert.Equal(3, Len(rxSeries), "rx shadowing shape")
    Assert.True(rxSeries[1] < rxSeries[0], "+3 dB reduces rx")
    Assert.True(rxSeries[2] > rxSeries[0], "-3 dB raises rx")
}

[Fact]
fn InvalidShadowingSeriesInputsReturnSentinelShape() -> Void {
    let pathLoss = ApplyShadowingToPathLossSeries([100.0, 200.0], [3.0])
    Assert.Equal(1, Len(pathLoss), "mismatched shadowing/path-loss arrays return sentinel")

    let rx = ApplyShadowingToReceivedPowerSeries([1.0kg*m^2/s^3, 2.0kg*m^2/s^3], [3.0])
    Assert.Equal(1, Len(rx), "mismatched shadowing/rx arrays return sentinel")
}


test "LogDistancePathLossLinear uses power-law scaling" {
    let d0 = 1m
    let d = 10m
    let pl0 = 2.0
    let n = 3.0
    let expected = pl0 * Pow(d / d0, n)
    Assert.Near(expected, LogDistancePathLossLinear(d, d0, pl0, n), 0.000001, "log-distance model matches power-law form")
}
