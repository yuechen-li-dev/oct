package Manifest

record PackageManifest {
    Name: String
    Version: String
    Description: String
    Authors: String[]
    Date: String
    Dependencies: Dependency[]
}

record Dependency {
    Name: String
    VersionRequirement: String
}

fn Manifest() -> PackageManifest {
    return PackageManifest {
        Name: "LinearAlgebra"
        Version: "0.1.0"
        Authors: ["Codex", "Claude"]
        Date: "2026-06-15"
        Description: "Minimal deterministic vector and matrix operations"
        Dependencies:[Dependency {Name: "OctStd" VersionRequirement: "0.1.0"}]
    }
}
