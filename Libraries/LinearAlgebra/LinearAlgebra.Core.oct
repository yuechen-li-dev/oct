package LinearAlgebra

fn Dot(a: Float[], b: Float[]) -> Float ! Error {
    let vok = ValidateVector(a)?
    let wok = ValidateVector(b)?

    if Len(a) != Len(b) {
        return error("dot requires vectors with same length")
    }

    var sum = 0.0
    for i in 0 .. Len(a) {
        sum = sum + a[i] * b[i]
    }
    return sum
}

fn Norm(a: Float[]) -> Float ! Error {
    let vok = ValidateVector(a)?

    var sumSquares = 0.0
    for i in 0 .. Len(a) {
        sumSquares = sumSquares + a[i] * a[i]
    }

    return Sqrt(sumSquares)
}

fn MatMul(A: Float[], aRows: Int, aCols: Int, B: Float[], bRows: Int, bCols: Int) -> Float[] ! Error {
    let aok = ValidateMatrixData(A, aRows, aCols)?
    let bok = ValidateMatrixData(B, bRows, bCols)?

    if aCols != bRows {
        return error("matmul requires A columns to equal B rows")
    }

    var out = [0.0]
    var i = 1
    while i < aRows * bCols {
        out = Append(out, 0.0)
        i = i + 1
    }

    var r = 0
    while r < aRows {
        var c = 0
        while c < bCols {
            var sum = 0.0
            var k = 0
            while k < aCols {
                sum = sum + A[FlatIndex(r, k, aCols)] * B[FlatIndex(k, c, bCols)]
                k = k + 1
            }
            out[FlatIndex(r, c, bCols)] = sum
            c = c + 1
        }
        r = r + 1
    }

    return out
}

fn MatVecMul(A: Float[], rows: Int, cols: Int, x: Float[]) -> Float[] ! Error {
    let mok = ValidateMatrixData(A, rows, cols)?
    let vok = ValidateVector(x)?

    if Len(x) != cols {
        return error("matvecmul requires vector length to equal matrix columns")
    }

    var out = [0.0]
    var oi = 1
    while oi < rows {
        out = Append(out, 0.0)
        oi = oi + 1
    }

    var r = 0
    while r < rows {
        var sum = 0.0
        var c = 0
        while c < cols {
            sum = sum + A[FlatIndex(r, c, cols)] * x[c]
            c = c + 1
        }
        out[r] = sum
        r = r + 1
    }

    return out
}

fn VecMatMul(x: Float[], A: Float[], rows: Int, cols: Int) -> Float[] ! Error {
    let vok = ValidateVector(x)?
    let mok = ValidateMatrixData(A, rows, cols)?

    if Len(x) != rows {
        return error("vecmatmul requires vector length to equal matrix rows")
    }

    var out = [0.0]
    var oi = 1
    while oi < cols {
        out = Append(out, 0.0)
        oi = oi + 1
    }

    var c = 0
    while c < cols {
        var sum = 0.0
        var r = 0
        while r < rows {
            sum = sum + x[r] * A[FlatIndex(r, c, cols)]
            r = r + 1
        }
        out[c] = sum
        c = c + 1
    }

    return out
}

fn Transpose(A: Float[], rows: Int, cols: Int) -> Float[] ! Error {
    let mok = ValidateMatrixData(A, rows, cols)?

    var out = [0.0]
    var i = 1
    while i < rows * cols {
        out = Append(out, 0.0)
        i = i + 1
    }

    var r = 0
    while r < rows {
        var c = 0
        while c < cols {
            out[FlatIndex(c, r, rows)] = A[FlatIndex(r, c, cols)]
            c = c + 1
        }
        r = r + 1
    }

    return out
}

fn Trace(A: Float[], rows: Int, cols: Int) -> Float ! Error {
    let mok = ValidateMatrixData(A, rows, cols)?

    if rows != cols {
        return error("trace requires a square matrix")
    }

    var sum = 0.0
    var i = 0
    while i < rows {
        sum = sum + A[FlatIndex(i, i, cols)]
        i = i + 1
    }

    return sum
}

fn Diagonal(A: Float[], rows: Int, cols: Int) -> Float[] ! Error {
    let mok = ValidateMatrixData(A, rows, cols)?

    var n = rows
    if cols < n {
        n = cols
    }

    var out = [A[0]]
    var i = 1
    while i < n {
        out = Append(out, A[FlatIndex(i, i, cols)])
        i = i + 1
    }

    out[0] = A[FlatIndex(0, 0, cols)]
    return out
}

fn Identity(n: Int) -> Float[] ! Error {
    if n <= 0 {
        return error("identity requires n > 0")
    }

    var out = Zeros(n, n)?

    var i = 0
    while i < n {
        out[FlatIndex(i, i, n)] = 1.0
        i = i + 1
    }

    return out
}

fn Zeros(m: Int, n: Int) -> Float[] ! Error {
    if m <= 0 or n <= 0 {
        return error("matrix dimensions must be > 0")
    }

    var out = [0.0]
    var i = 1
    while i < m * n {
        out = Append(out, 0.0)
        i = i + 1
    }

    return out
}

fn Ones(m: Int, n: Int) -> Float[] ! Error {
    if m <= 0 or n <= 0 {
        return error("matrix dimensions must be > 0")
    }

    var out = [1.0]
    var i = 1
    while i < m * n {
        out = Append(out, 1.0)
        i = i + 1
    }

    return out
}

fn Add(A: Float[], B: Float[], rows: Int, cols: Int) -> Float[] ! Error {
    let mok = ValidateMatrixData(A, rows, cols)?
    let nok = ValidateMatrixData(B, rows, cols)?

    var out = [A[0] + B[0]]
    var i = 1
    while i < Len(A) {
        out = Append(out, A[i] + B[i])
        i = i + 1
    }

    return out
}

fn Sub(A: Float[], B: Float[], rows: Int, cols: Int) -> Float[] ! Error {
    let mok = ValidateMatrixData(A, rows, cols)?
    let nok = ValidateMatrixData(B, rows, cols)?

    var out = [A[0] - B[0]]
    var i = 1
    while i < Len(A) {
        out = Append(out, A[i] - B[i])
        i = i + 1
    }

    return out
}

fn Scale(A: Float[], rows: Int, cols: Int, k: Float) -> Float[] ! Error {
    return MatScalarMul(A, rows, cols, k)?
}

fn MatScalarMul(A: Float[], rows: Int, cols: Int, s: Float) -> Float[] ! Error {
    let mok = ValidateMatrixData(A, rows, cols)?

    var out = [A[0] * s]
    var i = 1
    while i < Len(A) {
        out = Append(out, A[i] * s)
        i = i + 1
    }

    return out
}

fn Determinant(a: Float[], rows: Int, cols: Int) -> Float ! Error {
    let mok = ValidateSquareMatrixData(a, rows, cols)?
    let epsilon = 0.000000000001

    var work = [a[0]]
    var wi = 1
    while wi < Len(a) {
        work = Append(work, a[wi])
        wi = wi + 1
    }

    var sign = 1.0
    var col = 0
    while col < cols {
        var pivotRow = col
        var maxAbs = Abs(work[FlatIndex(col, col, cols)])

        var r = col + 1
        while r < rows {
            let candidate = Abs(work[FlatIndex(r, col, cols)])
            if candidate > maxAbs {
                maxAbs = candidate
                pivotRow = r
            }
            r = r + 1
        }

        if maxAbs <= epsilon {
            return 0.0
        }

        if pivotRow != col {
            work = SwapRows(work, cols, col, pivotRow)
            sign = 0.0 - sign
        }

        let pivot = work[FlatIndex(col, col, cols)]
        var rr = col + 1
        while rr < rows {
            let factor = work[FlatIndex(rr, col, cols)] / pivot
            work[FlatIndex(rr, col, cols)] = 0.0

            var cc = col + 1
            while cc < cols {
                work[FlatIndex(rr, cc, cols)] = work[FlatIndex(rr, cc, cols)] - factor * work[FlatIndex(col, cc, cols)]
                cc = cc + 1
            }
            rr = rr + 1
        }

        col = col + 1
    }

    var det = sign
    var i = 0
    while i < rows {
        det = det * work[FlatIndex(i, i, cols)]
        i = i + 1
    }
    return det
}

fn SolveLinearSystem(a: Float[], rows: Int, cols: Int, b: Float[]) -> Float[] ! Error {
    let mok = ValidateSquareMatrixData(a, rows, cols)?
    let vok = ValidateVector(b)?
    let epsilon = 0.000000000001

    if Len(b) != rows {
        return error("solve requires RHS length to equal matrix rows")
    }

    var work = [a[0]]
    var wi = 1
    while wi < Len(a) {
        work = Append(work, a[wi])
        wi = wi + 1
    }

    var rhs = [b[0]]
    var bi = 1
    while bi < Len(b) {
        rhs = Append(rhs, b[bi])
        bi = bi + 1
    }

    var col = 0
    while col < cols {
        var pivotRow = col
        var maxAbs = Abs(work[FlatIndex(col, col, cols)])

        var r = col + 1
        while r < rows {
            let candidate = Abs(work[FlatIndex(r, col, cols)])
            if candidate > maxAbs {
                maxAbs = candidate
                pivotRow = r
            }
            r = r + 1
        }

        if maxAbs <= epsilon {
            return error("solve requires a non-singular matrix")
        }

        if pivotRow != col {
            work = SwapRows(work, cols, col, pivotRow)
            let t = rhs[col]
            rhs[col] = rhs[pivotRow]
            rhs[pivotRow] = t
        }

        let pivot = work[FlatIndex(col, col, cols)]
        var rr = col + 1
        while rr < rows {
            let factor = work[FlatIndex(rr, col, cols)] / pivot
            work[FlatIndex(rr, col, cols)] = 0.0

            var cc = col + 1
            while cc < cols {
                work[FlatIndex(rr, cc, cols)] = work[FlatIndex(rr, cc, cols)] - factor * work[FlatIndex(col, cc, cols)]
                cc = cc + 1
            }
            rhs[rr] = rhs[rr] - factor * rhs[col]
            rr = rr + 1
        }

        col = col + 1
    }

    var x = [0.0]
    var xi = 1
    while xi < rows {
        x = Append(x, 0.0)
        xi = xi + 1
    }

    var i = rows - 1
    while i >= 0 {
        var sum = rhs[i]
        var j = i + 1
        while j < cols {
            sum = sum - work[FlatIndex(i, j, cols)] * x[j]
            j = j + 1
        }

        let pivot = work[FlatIndex(i, i, cols)]
        if Abs(pivot) <= epsilon {
            return error("solve requires a non-singular matrix")
        }

        x[i] = sum / pivot
        i = i - 1
    }

    return x
}

fn Inverse(a: Float[], rows: Int, cols: Int) -> Float[] ! Error {
    let mok = ValidateSquareMatrixData(a, rows, cols)?

    var inv = Zeros(rows, cols)?

    var c = 0
    while c < cols {
        var e = [0.0]
        var i = 1
        while i < rows {
            e = Append(e, 0.0)
            i = i + 1
        }
        e[c] = 1.0

        let column = SolveLinearSystem(a, rows, cols, e)?
        var r = 0
        while r < rows {
            inv[FlatIndex(r, c, cols)] = column[r]
            r = r + 1
        }
        c = c + 1
    }

    return inv
}

fn SwapRows(a: Float[], cols: Int, rowA: Int, rowB: Int) -> Float[] {
    var out = [a[0]]
    var i = 1
    while i < Len(a) {
        out = Append(out, a[i])
        i = i + 1
    }

    var c = 0
    while c < cols {
        let ia = FlatIndex(rowA, c, cols)
        let ib = FlatIndex(rowB, c, cols)
        let t = out[ia]
        out[ia] = out[ib]
        out[ib] = t
        c = c + 1
    }
    return out
}

fn ValidateSquareMatrixData(a: Float[], rows: Int, cols: Int) -> Bool ! Error {
    let ok = ValidateMatrixData(a, rows, cols)?
    if rows != cols {
        return error("operation requires a square matrix")
    }
    return true
}

fn FlatIndex(row: Int, col: Int, cols: Int) -> Int {
    return row * cols + col
}

fn ValidateVector(a: Float[]) -> Bool ! Error {
    if Len(a) == 0 {
        return error("vector must be non-empty")
    }
    return true
}


fn ValidateMatrixData(A: Float[], rows: Int, cols: Int) -> Bool ! Error {
    if rows <= 0 or cols <= 0 {
        return error("matrix dimensions must be > 0")
    }
    if Len(A) == 0 {
        return error("matrix data must be non-empty")
    }
    if Len(A) != rows * cols {
        return error("matrix data length must equal rows * cols")
    }
    return true
}
