package LinearAlgebra

record LUFactorization {
    L: Float[]
    U: Float[]
    Permutation: Int[]
    SwapCount: Int
    Rows: Int
    Cols: Int
}

fn Dot(a: Float[], b: Float[]) -> Float ! Error {
    let vok = ValidateVector(a)?
    let wok = ValidateVector(b)?

    if Len(a) != Len(b) {
        return error("dot requires vectors with same length")
    }

    var sum = 0.0
    for i in 0 .. Len(a) {
        sum = sum + a[i] * b[i]
    }
    return sum
}

fn Norm(a: Float[]) -> Float ! Error {
    let vok = ValidateVector(a)?

    var sumSquares = 0.0
    for i in 0 .. Len(a) {
        sumSquares = sumSquares + a[i] * a[i]
    }

    return Sqrt(sumSquares)
}

fn MatMul(A: Float[], aRows: Int, aCols: Int, B: Float[], bRows: Int, bCols: Int) -> Float[] ! Error {
    let aok = ValidateMatrixData(A, aRows, aCols)?
    let bok = ValidateMatrixData(B, bRows, bCols)?

    if aCols != bRows {
        return error("matmul requires A columns to equal B rows")
    }

    var out = [0.0]
    for i in 1 .. aRows * bCols {
        out = Append(out, 0.0)
    }

    for r in 0 .. aRows {
        for c in 0 .. bCols {
            var sum = 0.0
            for k in 0 .. aCols {
                sum = sum + A[FlatIndex(r, k, aCols)] * B[FlatIndex(k, c, bCols)]
            }
            out[FlatIndex(r, c, bCols)] = sum
        }
    }

    return out
}

fn MatVecMul(A: Float[], rows: Int, cols: Int, x: Float[]) -> Float[] ! Error {
    let mok = ValidateMatrixData(A, rows, cols)?
    let vok = ValidateVector(x)?

    if Len(x) != cols {
        return error("matvecmul requires vector length to equal matrix columns")
    }

    var out = [0.0]
    for oi in 1 .. rows {
        out = Append(out, 0.0)
    }

    for r in 0 .. rows {
        var sum = 0.0
        for c in 0 .. cols {
            sum = sum + A[FlatIndex(r, c, cols)] * x[c]
        }
        out[r] = sum
    }

    return out
}

fn VecMatMul(x: Float[], A: Float[], rows: Int, cols: Int) -> Float[] ! Error {
    let vok = ValidateVector(x)?
    let mok = ValidateMatrixData(A, rows, cols)?

    if Len(x) != rows {
        return error("vecmatmul requires vector length to equal matrix rows")
    }

    var out = [0.0]
    for oi in 1 .. cols {
        out = Append(out, 0.0)
    }

    for c in 0 .. cols {
        var sum = 0.0
        for r in 0 .. rows {
            sum = sum + x[r] * A[FlatIndex(r, c, cols)]
        }
        out[c] = sum
    }

    return out
}

fn Transpose(A: Float[], rows: Int, cols: Int) -> Float[] ! Error {
    let mok = ValidateMatrixData(A, rows, cols)?

    var out = [0.0]
    var i = 1
    while i < rows * cols {
        out = Append(out, 0.0)
        i = i + 1
    }

    var r = 0
    while r < rows {
        var c = 0
        while c < cols {
            out[FlatIndex(c, r, rows)] = A[FlatIndex(r, c, cols)]
            c = c + 1
        }
        r = r + 1
    }

    return out
}

fn MatrixTrace(A: Float[], rows: Int, cols: Int) -> Float ! Error {
    let mok = ValidateMatrixData(A, rows, cols)?

    if rows != cols {
        return error("trace requires a square matrix")
    }

    var sum = 0.0
    var i = 0
    while i < rows {
        sum = sum + A[FlatIndex(i, i, cols)]
        i = i + 1
    }

    return sum
}

fn Diagonal(A: Float[], rows: Int, cols: Int) -> Float[] ! Error {
    let mok = ValidateMatrixData(A, rows, cols)?

    var n = rows
    if cols < n {
        n = cols
    }

    var out = [A[0]]
    var i = 1
    while i < n {
        out = Append(out, A[FlatIndex(i, i, cols)])
        i = i + 1
    }

    out[0] = A[FlatIndex(0, 0, cols)]
    return out
}

fn Identity(n: Int) -> Float[] ! Error {
    if n <= 0 {
        return error("identity requires n > 0")
    }

    var out = Zeros(n, n)?

    var i = 0
    while i < n {
        out[FlatIndex(i, i, n)] = 1.0
        i = i + 1
    }

    return out
}

fn Zeros(m: Int, n: Int) -> Float[] ! Error {
    if m <= 0 or n <= 0 {
        return error("matrix dimensions must be > 0")
    }

    var out = [0.0]
    var i = 1
    while i < m * n {
        out = Append(out, 0.0)
        i = i + 1
    }

    return out
}

fn Ones(m: Int, n: Int) -> Float[] ! Error {
    if m <= 0 or n <= 0 {
        return error("matrix dimensions must be > 0")
    }

    var out = [1.0]
    var i = 1
    while i < m * n {
        out = Append(out, 1.0)
        i = i + 1
    }

    return out
}

fn Add(A: Float[], B: Float[], rows: Int, cols: Int) -> Float[] ! Error {
    let mok = ValidateMatrixData(A, rows, cols)?
    let nok = ValidateMatrixData(B, rows, cols)?

    var out = [A[0] + B[0]]
    var i = 1
    while i < Len(A) {
        out = Append(out, A[i] + B[i])
        i = i + 1
    }

    return out
}

fn Sub(A: Float[], B: Float[], rows: Int, cols: Int) -> Float[] ! Error {
    let mok = ValidateMatrixData(A, rows, cols)?
    let nok = ValidateMatrixData(B, rows, cols)?

    var out = [A[0] - B[0]]
    var i = 1
    while i < Len(A) {
        out = Append(out, A[i] - B[i])
        i = i + 1
    }

    return out
}

fn Scale(A: Float[], rows: Int, cols: Int, k: Float) -> Float[] ! Error {
    return MatScalarMul(A, rows, cols, k)?
}

fn MatScalarMul(A: Float[], rows: Int, cols: Int, s: Float) -> Float[] ! Error {
    let mok = ValidateMatrixData(A, rows, cols)?

    var out = [A[0] * s]
    var i = 1
    while i < Len(A) {
        out = Append(out, A[i] * s)
        i = i + 1
    }

    return out
}

fn Determinant(a: Float[], rows: Int, cols: Int) -> Float ! Error {
    let mok = ValidateSquareMatrixData(a, rows, cols)?

    match LUDecompose(a, rows, cols) {
        ok(factorization) => {
            return LUDeterminant(factorization)?
        }
        err(e) => {
            return 0.0
        }
    }
}

fn SolveLinearSystem(a: Float[], rows: Int, cols: Int, b: Float[]) -> Float[] ! Error {
    let factorization = LUDecompose(a, rows, cols)?
    return LUSolve(factorization, b)?
}

fn Inverse(a: Float[], rows: Int, cols: Int) -> Float[] ! Error {
    let factorization = LUDecompose(a, rows, cols)?
    return LUInverse(factorization)?
}

fn LUDecompose(a: Float[], rows: Int, cols: Int) -> LUFactorization ! Error {
    let mok = ValidateSquareMatrixData(a, rows, cols)?
    let epsilon = PivotEpsilon()

    var work = CopyFloatArray(a)

    var permutation = [0]
    var pi = 1
    while pi < rows {
        permutation = Append(permutation, pi)
        pi = pi + 1
    }

    var swapCount = 0
    var col = 0
    while col < cols {
        var pivotRow = col
        var maxAbs = Abs(work[FlatIndex(col, col, cols)])

        var r = col + 1
        while r < rows {
            let candidate = Abs(work[FlatIndex(r, col, cols)])
            if candidate > maxAbs {
                maxAbs = candidate
                pivotRow = r
            }
            r = r + 1
        }

        if maxAbs <= epsilon {
            return error("lu decomposition requires a non-singular matrix")
        }

        if pivotRow != col {
            work = SwapRows(work, cols, col, pivotRow)
            permutation = SwapIntEntries(permutation, col, pivotRow)
            swapCount = swapCount + 1
        }

        let pivot = work[FlatIndex(col, col, cols)]
        var rr = col + 1
        while rr < rows {
            let factor = work[FlatIndex(rr, col, cols)] / pivot
            work[FlatIndex(rr, col, cols)] = factor

            var cc = col + 1
            while cc < cols {
                work[FlatIndex(rr, cc, cols)] = work[FlatIndex(rr, cc, cols)] - factor * work[FlatIndex(col, cc, cols)]
                cc = cc + 1
            }
            rr = rr + 1
        }

        col = col + 1
    }

    var l = Zeros(rows, cols)?
    var u = Zeros(rows, cols)?

    var row = 0
    while row < rows {
        var c = 0
        while c < cols {
            let idx = FlatIndex(row, c, cols)
            l[idx] = 0.0
            u[idx] = work[idx]

            if c < row {
                l[idx] = work[idx]
                u[idx] = 0.0
            }

            if c == row {
                l[idx] = 1.0
                u[idx] = work[idx]
            }

            c = c + 1
        }
        row = row + 1
    }

    return LUFactorization {
        L: l
        U: u
        Permutation: permutation
        SwapCount: swapCount
        Rows: rows
        Cols: cols
    }
}

fn LUSolve(factorization: LUFactorization, b: Float[]) -> Float[] ! Error {
    let n = ValidateLUFactorization(factorization)?
    let vok = ValidateVector(b)?

    if Len(b) != n {
        return error("lu solve requires RHS length to equal factorization rows")
    }

    var rhs = [b[factorization.Permutation[0]]]
    var i = 1
    while i < n {
        rhs = Append(rhs, b[factorization.Permutation[i]])
        i = i + 1
    }

    var y = [0.0]
    var yi = 1
    while yi < n {
        y = Append(y, 0.0)
        yi = yi + 1
    }

    var r = 0
    while r < n {
        var sum = rhs[r]
        var c = 0
        while c < r {
            sum = sum - factorization.L[FlatIndex(r, c, n)] * y[c]
            c = c + 1
        }
        y[r] = sum
        r = r + 1
    }

    let epsilon = PivotEpsilon()
    var x = [0.0]
    var xi = 1
    while xi < n {
        x = Append(x, 0.0)
        xi = xi + 1
    }

    var row = n - 1
    while row >= 0 {
        var sum = y[row]
        var col = row + 1
        while col < n {
            sum = sum - factorization.U[FlatIndex(row, col, n)] * x[col]
            col = col + 1
        }

        let pivot = factorization.U[FlatIndex(row, row, n)]
        if Abs(pivot) <= epsilon {
            return error("lu solve requires a non-singular factorization")
        }

        x[row] = sum / pivot
        row = row - 1
    }

    return x
}

fn LUDeterminant(factorization: LUFactorization) -> Float ! Error {
    let n = ValidateLUFactorization(factorization)?

    var sign = 1.0
    var swap = 0
    while swap < factorization.SwapCount {
        sign = 0.0 - sign
        swap = swap + 1
    }

    var det = sign
    var i = 0
    while i < n {
        det = det * factorization.U[FlatIndex(i, i, n)]
        i = i + 1
    }

    return det
}

fn LUInverse(factorization: LUFactorization) -> Float[] ! Error {
    let n = ValidateLUFactorization(factorization)?

    var inv = Zeros(n, n)?

    var c = 0
    while c < n {
        var e = [0.0]
        var ei = 1
        while ei < n {
            e = Append(e, 0.0)
            ei = ei + 1
        }
        e[c] = 1.0

        let column = LUSolve(factorization, e)?
        var r = 0
        while r < n {
            inv[FlatIndex(r, c, n)] = column[r]
            r = r + 1
        }

        c = c + 1
    }

    return inv
}

fn CopyFloatArray(a: Float[]) -> Float[] {
    var out = [a[0]]
    var i = 1
    while i < Len(a) {
        out = Append(out, a[i])
        i = i + 1
    }
    return out
}

fn SwapIntEntries(values: Int[], i: Int, j: Int) -> Int[] {
    var out = [values[0]]
    var k = 1
    while k < Len(values) {
        out = Append(out, values[k])
        k = k + 1
    }

    let t = out[i]
    out[i] = out[j]
    out[j] = t

    return out
}

fn PivotEpsilon() -> Float {
    return 0.000000000001
}

fn ValidateLUFactorization(factorization: LUFactorization) -> Int ! Error {
    if factorization.Rows <= 0 or factorization.Cols <= 0 {
        return error("lu factorization requires positive dimensions")
    }

    if factorization.Rows != factorization.Cols {
        return error("lu factorization requires square dimensions")
    }

    let n = factorization.Rows
    if Len(factorization.L) != n * n {
        return error("lu factorization L length must equal rows * cols")
    }

    if Len(factorization.U) != n * n {
        return error("lu factorization U length must equal rows * cols")
    }

    if Len(factorization.Permutation) != n {
        return error("lu factorization permutation length must equal rows")
    }

    if factorization.SwapCount < 0 {
        return error("lu factorization swap count must be >= 0")
    }

    var seen = [0]
    var si = 1
    while si < n {
        seen = Append(seen, 0)
        si = si + 1
    }

    var i = 0
    while i < n {
        let p = factorization.Permutation[i]
        if p < 0 or p >= n {
            return error("lu factorization permutation indices must be in range")
        }

        if seen[p] != 0 {
            return error("lu factorization permutation must not repeat indices")
        }

        seen[p] = 1
        i = i + 1
    }

    return n
}

fn SwapRows(a: Float[], cols: Int, rowA: Int, rowB: Int) -> Float[] {
    var out = [a[0]]
    var i = 1
    while i < Len(a) {
        out = Append(out, a[i])
        i = i + 1
    }

    var c = 0
    while c < cols {
        let ia = FlatIndex(rowA, c, cols)
        let ib = FlatIndex(rowB, c, cols)
        let t = out[ia]
        out[ia] = out[ib]
        out[ib] = t
        c = c + 1
    }
    return out
}

fn ValidateSquareMatrixData(a: Float[], rows: Int, cols: Int) -> Bool ! Error {
    let ok = ValidateMatrixData(a, rows, cols)?
    if rows != cols {
        return error("operation requires a square matrix")
    }
    return true
}

fn FlatIndex(row: Int, col: Int, cols: Int) -> Int {
    return row * cols + col
}

fn ValidateVector(a: Float[]) -> Bool ! Error {
    if Len(a) == 0 {
        return error("vector must be non-empty")
    }
    return true
}


fn ValidateMatrixData(A: Float[], rows: Int, cols: Int) -> Bool ! Error {
    if rows <= 0 or cols <= 0 {
        return error("matrix dimensions must be > 0")
    }
    if Len(A) == 0 {
        return error("matrix data must be non-empty")
    }
    if Len(A) != rows * cols {
        return error("matrix data length must equal rows * cols")
    }
    return true
}
