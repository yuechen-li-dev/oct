package Electromagnetism

[Fact]
fn OhmLawRoundTripsVoltageAndCurrent() -> Void {
    let resistance = 10.0kg*m^2/s^3/A^2
    let voltage = OhmVoltage(2.0A, resistance)
    let current = OhmCurrent(voltage, resistance)!
    Assert.Near(20.0, voltage / (1.0kg*m^2/s^3/A), 0.000000001, "two amperes through ten ohms")
    Assert.Near(2.0, current / 1.0A, 0.000000001, "Ohm law inverse")
}

[Fact]
fn ElectricalPowerCarriesWatts() -> Void {
    let power = ElectricalPower(12.0kg*m^2/s^3/A, 2.0A)
    Assert.Near(24.0, power / (1.0kg*m^2/s^3), 0.000000001, "twelve volts times two amperes")
}

[Fact]
fn SeriesAndParallelResistanceTeachNetworkRules() -> Void {
    let r1 = 10.0kg*m^2/s^3/A^2
    let r2 = 20.0kg*m^2/s^3/A^2
    let series = SeriesResistance([r1, r2])!
    let parallel = ParallelResistance2(r1, r2)!
    Assert.Near(30.0, series / (1.0kg*m^2/s^3/A^2), 0.000000001, "series sum")
    Assert.Near(6.6666666667, parallel / (1.0kg*m^2/s^3/A^2), 0.000000001, "two-resistor parallel")
}

[Fact]
fn RCDischargeFallsToOneOverEAtOneTau() -> Void {
    let tau = RCTimeConstant(1000.0kg*m^2/s^3/A^2, 0.000001A^2*s^4/kg/m^2)!
    let voltage = RCDischargeVoltage(5.0kg*m^2/s^3/A, tau, tau)!
    Assert.Near(0.001, tau / 1.0s, 0.000000001, "one-kilohm one-microfarad time constant")
    Assert.Near(5.0 / E(), voltage / (1.0kg*m^2/s^3/A), 0.000000001, "one tau discharge")
}

[Fact]
fn CircuitRelationsRejectSingularResistance() -> Void {
    Assert.Error(OhmCurrent(1.0kg*m^2/s^3/A, 0.0kg*m^2/s^3/A^2), "zero resistance inversion")
    Assert.Error(ParallelResistance2(1.0kg*m^2/s^3/A^2, 0.0kg*m^2/s^3/A^2), "zero parallel branch policy")
    Assert.Error(SeriesResistance([]), "empty network")
}
