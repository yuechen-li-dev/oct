package Manifest

record PackageManifest {
    Name: String
    Version: String
    Description: String
    Authors: String[]
    Date: String
    Dependencies: Dependency[]
}

record Dependency {
    Name: String
    VersionRequirement: String
}

fn Manifest() -> PackageManifest {
    return PackageManifest {
        Name: "DatabaseTemplates"
        Version: "0.1.0"
        Description: "Typed semantic specialization templates for bounded read-oriented database workloads"
        Authors:["Codex"]
        Date: "2026-08-23"
        Dependencies:[Dependency {Name: "OctStd" VersionRequirement: "0.1.0"}]
    }
}
