expect error: "missing field 'Access'"

package DatabaseTemplates

record MissingPublicationJob {Ready: Bool}
fn MissingPublicationReady(job: MissingPublicationJob) -> Bool {return job.Ready}

template record ReadMostlyDataset<Record> {ExpectedReadsPerPublish: Int}

template record MaterializedFilter<Record> {
    Access: ReadMostlyDataset<Record>
    Predicate: fn(Record) -> Bool
    Limit: Int
}

fn Main() -> Void {
    let invalid = MaterializedFilter<MissingPublicationJob> {Predicate: MissingPublicationReady Limit: 10}
}
