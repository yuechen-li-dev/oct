package Manifest

record PackageManifest {
    Name: String
    Version: String
    Description: String
    Authors: String[]
    Date: String
    Dependencies: Dependency[]
}

record Dependency {
    Name: String
    VersionRequirement: String
}

fn Manifest() -> PackageManifest {
    return PackageManifest {
        Name: "Csv"
        Version: "0.1.0"
        Authors: ["Codex"]
        Date: "2026-06-15"
        Description: "Thin CSV wrappers for raw row-major string tables"
        Dependencies: [Dependency { Name: "OctStd" VersionRequirement: "0.1.0" }, Dependency { Name: "IO" VersionRequirement: "0.1.0" }]
    }
}
