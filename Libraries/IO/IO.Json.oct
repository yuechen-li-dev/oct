package IO

record JsonRawGraphNode {
    Id:          Int
    ParentId:    Int
    Key:         String
    Kind:        String
    NumberValue: Float
    StringValue: String
    BoolValue:   Bool
    IsNull:      Bool
}

record JsonRawGraph {
    Nodes: JsonRawGraphNode[]
}

record JsonRecovered {
    Kind:      String
    Canonical: String
    Raw:       String
}

record JsonNodeLookup {
    Found: Bool
    Node:  JsonRawGraphNode
}

fn NormalizeJson(text: String) -> String ! Error {
    return JsonNormalize(text)?
}

fn Parse(text: String) -> String ! Error {
    return JsonParse(text)?
}

fn Stringify(value: String) -> String ! Error {
    return JsonStringify(value)?
}

fn Load(path: String) -> String ! Error {
    return JsonLoad(path)?
}

fn Save(path: String, value: String) -> Int ! Error {
    return JsonSave(path, value)?
}

fn ImportRawJson(path: String) -> String ! Error {
    return Load(path)?
}

fn ImportRawJsonGraph(path: String) -> JsonRawGraph ! Error {
    return JsonLoadStructured<JsonRawGraph>(path)?
}

fn LowerJsonToRawGraph(text: String) -> JsonRawGraph ! Error {
    return JsonLower<JsonRawGraph>(text)?
}

fn ImportJson(path: String) -> JsonRecovered ! Error {
    let rawText = ImportRawJson(path)?
    let rawGraph = ImportRawJsonGraph(path)?
    return RecoverJsonIntent(rawText, rawGraph)
}

fn RecoverJsonIntent(rawText: String, rawGraph: JsonRawGraph) -> JsonRecovered {
    let tagged = LooksLikeTaggedArrayGraph(rawGraph)
    let table = LooksLikeHomogeneousObjectArrayGraph(rawGraph)
    let mapping = LooksLikeMappingObjectGraph(rawGraph)
    let grid = LooksLikeRectangularNumericGridGraph(rawGraph)
    let config = LooksLikeConfigObjectGraph(rawGraph)
    let ambiguous = IsAmbiguousRecovery(tagged, table, mapping, grid, config)
    let recoveredKind = when utility {
        case "tagged.decomposed" when tagged and not ambiguous score 100
        case "table.columnar" when table and not ambiguous score 95
        case "mapping.table" when mapping and not ambiguous score 90
        case "grid.nested_array" when grid and not ambiguous score 85
        case "config.nested_record" when config and not ambiguous score 80
        case "record.raw.ambiguous" when ambiguous score 70
        else "record.raw"
    }

    let canonical = switch recoveredKind {
        case "table.columnar" => CanonicalColumnarTable(rawGraph)
        case "mapping.table" => CanonicalMappingTable(rawGraph)
        case "grid.nested_array" => CanonicalNumericGrid(rawGraph)
        case "tagged.decomposed" => CanonicalTaggedSplit(rawGraph)
        case "config.nested_record" => CanonicalConfigRecord(rawGraph)
        case "record.raw.ambiguous" => CanonicalAmbiguousRecord(rawGraph)
        else => CanonicalRawRecord(rawGraph)
    }

    return JsonRecovered {
        Kind:      recoveredKind
        Canonical: canonical
        Raw:       rawText
    }
}

fn RootNode(graph: JsonRawGraph) -> JsonRawGraphNode {
    return graph.Nodes[0]
}

fn IsNodeKind(node: JsonRawGraphNode, kind: String) -> Bool {
    return node.Kind == kind
}

fn IsNullNode(node: JsonRawGraphNode) -> Bool {
    return node.Kind == "null" and node.IsNull
}

fn ChildByKey(graph: JsonRawGraph, parentId: Int, key: String) -> JsonNodeLookup {
    for i in 0 .. Len(graph.Nodes) {
        let node = graph.Nodes[i]
        if node.ParentId == parentId and node.Key == key {
            return JsonNodeLookup {Found: true Node: node}
        }
    }
    return JsonNodeLookup {Found: false Node: graph.Nodes[0]}
}

fn ChildCount(graph: JsonRawGraph, parentId: Int) -> Int {
    var count = 0
    for i in 0 .. Len(graph.Nodes) {
        if graph.Nodes[i].ParentId == parentId {
            count = count + 1
        }
    }
    return count
}

fn IsScalarNode(node: JsonRawGraphNode) -> Bool {
    return node.Kind == "string" or node.Kind == "number" or node.Kind == "bool"
}

fn IsSimpleValueNode(node: JsonRawGraphNode) -> Bool {
    return IsScalarNode(node) or IsNullNode(node)
}

fn FirstChild(graph: JsonRawGraph, parentId: Int) -> JsonNodeLookup {
    for i in 0 .. Len(graph.Nodes) {
        let node = graph.Nodes[i]
        if node.ParentId == parentId {
            return JsonNodeLookup {Found: true Node: node}
        }
    }
    return JsonNodeLookup {Found: false Node: graph.Nodes[0]}
}

fn IsArrayOfObjects(graph: JsonRawGraph, arrayNode: JsonRawGraphNode) -> Bool {
    if not IsNodeKind(arrayNode, "array") {
        return false
    }
    let childCount = ChildCount(graph, arrayNode.Id)
    if childCount == 0 {
        return false
    }
    for i in 0 .. Len(graph.Nodes) {
        let node = graph.Nodes[i]
        if node.ParentId == arrayNode.Id and not IsNodeKind(node, "object") {
            return false
        }
    }
    return true
}

fn HasArrayOfObjectsChild(graph: JsonRawGraph, parentId: Int) -> Bool {
    for i in 0 .. Len(graph.Nodes) {
        let node = graph.Nodes[i]
        if node.ParentId == parentId and IsArrayOfObjects(graph, node) {
            return true
        }
    }
    return false
}

fn HasStableTagKey(graph: JsonRawGraph, arrayNode: JsonRawGraphNode) -> Bool {
    if not IsArrayOfObjects(graph, arrayNode) {
        return false
    }
    var seenTaggedRows = 0
    for i in 0 .. Len(graph.Nodes) {
        let row = graph.Nodes[i]
        if row.ParentId == arrayNode.Id {
            let tag = ChildByKey(graph, row.Id, "type")
            if not tag.Found {
                return false
            }
            let tagNode = tag.Node
            if not IsNodeKind(tagNode, "string") {
                return false
            }
            seenTaggedRows = seenTaggedRows + 1
        }
    }
    return seenTaggedRows > 0
}

fn IsRectangularNumericArrayNode(graph: JsonRawGraph, arrayNode: JsonRawGraphNode) -> Bool {
    if not IsNodeKind(arrayNode, "array") {
        return false
    }
    let rowCount = ChildCount(graph, arrayNode.Id)
    if rowCount == 0 {
        return false
    }
    var expectedCols = -1
    var checkedRows = 0
    for i in 0 .. Len(graph.Nodes) {
        let row = graph.Nodes[i]
        if row.ParentId == arrayNode.Id {
            if not IsNodeKind(row, "array") {
                return false
            }
            let cols = ChildCount(graph, row.Id)
            if cols == 0 {
                return false
            }
            let colsAligned = switch {
                case expectedCols < 0 => true
                else => cols == expectedCols
            }
            if not colsAligned {
                return false
            }
            if expectedCols < 0 {
                expectedCols = cols
            }
            for j in 0 .. Len(graph.Nodes) {
                let cell = graph.Nodes[j]
                if cell.ParentId == row.Id and not IsNodeKind(cell, "number") {
                    return false
                }
            }
            checkedRows = checkedRows + 1
        }
    }
    return checkedRows == rowCount and expectedCols > 0
}

fn FirstArrayOfObjects(graph: JsonRawGraph, parentId: Int) -> JsonNodeLookup {
    for i in 0 .. Len(graph.Nodes) {
        let node = graph.Nodes[i]
        if node.ParentId == parentId and IsArrayOfObjects(graph, node) {
            return JsonNodeLookup {Found: true Node: node}
        }
    }
    return JsonNodeLookup {Found: false Node: graph.Nodes[0]}
}

fn LooksLikeHomogeneousObjectArrayGraph(raw: JsonRawGraph) -> Bool {
    let root = RootNode(raw)
    if not IsNodeKind(root, "object") {
        return false
    }
    for i in 0 .. Len(raw.Nodes) {
        let node = raw.Nodes[i]
        if node.ParentId == root.Id and IsArrayOfObjects(raw, node) and not HasStableTagKey(raw, node) {
            return true
        }
    }
    return false
}

fn LooksLikeMappingObjectGraph(raw: JsonRawGraph) -> Bool {
    let root = RootNode(raw)
    if not IsNodeKind(root, "object") {
        return false
    }
    if HasArrayOfObjectsChild(raw, root.Id) {
        return false
    }
    var valueCount = 0
    for i in 0 .. Len(raw.Nodes) {
        let child = raw.Nodes[i]
        if child.ParentId == root.Id {
            valueCount = valueCount + 1
            if not IsSimpleValueNode(child) {
                return false
            }
        }
    }
    return valueCount > 0
}

fn LooksLikeRectangularNumericGridGraph(raw: JsonRawGraph) -> Bool {
    let root = RootNode(raw)
    if IsRectangularNumericArrayNode(raw, root) {
        return true
    }
    for i in 0 .. Len(raw.Nodes) {
        let child = raw.Nodes[i]
        if child.Id != root.Id and IsRectangularNumericArrayNode(raw, child) {
            return true
        }
    }
    return false
}

fn LooksLikeConfigObjectGraph(raw: JsonRawGraph) -> Bool {
    let root = RootNode(raw)
    if not IsNodeKind(root, "object") {
        return false
    }
    if LooksLikeMappingObjectGraph(raw) {
        return false
    }
    if LooksLikeHomogeneousObjectArrayGraph(raw) {
        return false
    }
    if LooksLikeRectangularNumericGridGraph(raw) {
        return false
    }
    for i in 0 .. Len(raw.Nodes) {
        let child = raw.Nodes[i]
        if child.ParentId == root.Id {
            if IsNodeKind(child, "object") {
                return true
            }
            if IsNodeKind(child, "array") and not IsRectangularNumericArrayNode(raw, child) and not HasStableTagKey(raw, child) and ChildCount(raw, child.Id) > 0 {
                return true
            }
        }
    }
    return false
}

fn LooksLikeTaggedArrayGraph(raw: JsonRawGraph) -> Bool {
    let root = RootNode(raw)
    if IsNodeKind(root, "array") {
        return HasStableTagKey(raw, root)
    }
    for i in 0 .. Len(raw.Nodes) {
        let child = raw.Nodes[i]
        if child.ParentId == root.Id and IsNodeKind(child, "array") {
            if HasStableTagKey(raw, child) {
                return true
            }
        }
    }
    return false
}

fn CanonicalColumnarTable(raw: JsonRawGraph) -> String {
    let root = RootNode(raw)
    let candidate = FirstArrayOfObjects(raw, root.Id)
    if candidate.Found {
        return "table.columnar: {columns: inferred, sparse_optional: deterministic}"
    }
    return "table.columnar: {columns: inferred}"
}

fn CanonicalMappingTable(raw: JsonRawGraph) -> String {
    let root = RootNode(raw)
    if IsNodeKind(root, "object") {
        return "mapping.table: {key: [...], value: [...]}"
    }
    return "mapping.table"
}

fn CanonicalNumericGrid(raw: JsonRawGraph) -> String {
    let root = RootNode(raw)
    if IsRectangularNumericArrayNode(raw, root) {
        return "grid.nested_array: [[Float]]"
    }
    for i in 0 .. Len(raw.Nodes) {
        let child = raw.Nodes[i]
        if child.Id != root.Id and IsRectangularNumericArrayNode(raw, child) {
            return "grid.nested_array: [[Float]]"
        }
    }
    return "grid.nested_array"
}

fn CanonicalTaggedSplit(raw: JsonRawGraph) -> String {
    return "tagged.decomposed: {by_type: deterministic}"
}

fn CanonicalConfigRecord(raw: JsonRawGraph) -> String {
    return "config.nested_record: {shape: nested composition}"
}

fn CanonicalAmbiguousRecord(raw: JsonRawGraph) -> String {
    return "raw_json: ambiguous_intent_recovery_use_ImportRawJson_or_ImportRawJsonGraph"
}

fn CanonicalRawRecord(raw: JsonRawGraph) -> String {
    return "raw_json"
}

fn IsAmbiguousRecovery(tagged: Bool, table: Bool, mapping: Bool, grid: Bool, config: Bool) -> Bool {
    var matches = 0
    if tagged {
        matches = matches + 1
    }
    if table {
        matches = matches + 1
    }
    if mapping {
        matches = matches + 1
    }
    if grid {
        matches = matches + 1
    }
    if config {
        matches = matches + 1
    }
    return matches > 1
}
