package IO

[Fact]
fn FileReadWriteTextAndDeleteRoundTrip() -> Void {
    let path = "io_mx103b_text.txt"
    let _w = WriteText(path, "hello wrappers") !
    Assert.True(Exists(path), "written file should exist")
    let text = ReadText(path)!
    Assert.Equal("hello wrappers", text, "text roundtrip should preserve payload")
    let _d = Delete(path)!
    Assert.False(Exists(path), "deleted file should not exist")
}

[Fact]
fn FileReadWriteBytesRoundTrip() -> Void {
    let srcPath = "io_mx103b_bytes_src.bin"
    let dstPath = "io_mx103b_bytes_dst.bin"
    let _seed = WriteText(srcPath, "OCT") !
    let data = ReadBytes(srcPath)!
    Assert.Equal(3, Len(data), "byte payload should preserve length")
    Assert.Equal(79, data[0], "first byte should roundtrip")
    let _w = WriteBytes(dstPath, data) !
    let copied = ReadBytes(dstPath)!
    Assert.Equal(84, copied[2], "copied payload should preserve final byte")
    let _d1 = Delete(srcPath)!
    let _d2 = Delete(dstPath)!
}

[Fact]
fn FileReadMissingFails() -> Void {
    Assert.Error(ReadText("io_mx103b_missing.txt"), "reading a missing file should fail")
}

[Fact]
fn PathWrappersCoverJoinAndSegments() -> Void {
    let joined = JoinPath(["a", "b", "c.txt"])
    Assert.Equal(Clean("a/b/c.txt"), Clean(joined), "join should compose with clean")
    Assert.Equal("c.txt", BaseName("a/b/c.txt"), "basename should return tail")
    Assert.Equal(".txt", Extension("a/b/c.txt"), "extension should include dot")
    Assert.Equal("c", Stem("a/b/c.txt"), "stem should omit extension")
    Assert.Equal(Clean("a/b"), Clean(Parent("a/b/c.txt")), "parent should remove last segment")
}

[Fact]
fn DirectoryMakeListAndRemoveAllRoundTrip() -> Void {
    let root = "io_mx103b_dir"
    let nested = JoinPath([root, "nested"])
    let filePath = JoinPath([root, "nested", "entry.txt"])
    let _m = MakeAll(nested)!
    let _w = WriteText(filePath, "x")!
    let entries = List(root)!
    Assert.Equal(1, Len(entries), "root should contain one nested folder")
    Assert.Equal("nested", entries[0], "list should include nested folder")
    let _rm = RemoveAll(root)!
    Assert.False(Exists(root), "remove all should remove directory tree")
}

[Fact]
fn DirectoryListMissingFails() -> Void {
    Assert.Error(List("io_mx103b_missing_dir"), "listing a missing directory should fail")
}

[Fact]
fn JsonParseStringifyAndSaveLoadRoundTrip() -> Void {
    let parsed = Parse("[3, 2, 1]")!
    let stringified = Stringify(parsed)!
    Assert.Equal("[3,2,1]", stringified, "json wrappers should produce compact output")

    let path = "io_mx103b_data.json"
    let _save = Save(path, "[1,2,3]")!
    let loaded = Load(path)!
    Assert.Equal("[1,2,3]", loaded, "json load should return compact valid json")
    let _delete = Delete(path)!
}

[Fact]
fn JsonParseRejectsInvalidDocument() -> Void {
    Assert.Error(Parse("{"), "invalid json should fail")
}

[Fact]
fn CsvReadWriteRoundTrip() -> Void {
    let path = "io_mx103b_table.csv"
    let rows = [["name", "score"], ["ada", "42"], ["lin", "7"]]
    let _w = Write(path, rows)!
    let readBack = Read(path)!
    Assert.Equal(3, Len(readBack), "csv should preserve row count")
    Assert.Equal("name", readBack[0][0], "header should roundtrip")
    Assert.Equal("7", readBack[2][1], "cell should roundtrip")
    let _d = Delete(path)!
}

[Fact]
fn CsvReadRejectsInvalidCsv() -> Void {
    let path = "io_mx103b_invalid.csv"
    let _w = Write(path, [["a", "b"], ["c"]])!
    Assert.Error(Read(path), "invalid csv should fail")
    let _d = Delete(path)!
}

[Fact]
fn CsvReadRowsRoundTripQuotedCommaQuoteAndEmpty() -> Void {
    let root = "out/test-artifacts/io_csv_shapes/rows"
    let path = JoinPath([root, "rows.csv"])
    let rows = [["a,b", "say \"hi\"", ""], ["x", "y", "z"]]
    let _w = Write(path, rows)!
    let readBack = CsvReadRows(path)!
    Assert.Equal(2, Len(readBack), "ReadRows should preserve row count")
    Assert.Equal("a,b", readBack[0][0], "ReadRows should preserve commas")
    Assert.Equal("say \"hi\"", readBack[0][1], "ReadRows should preserve quotes")
    Assert.Equal("", readBack[0][2], "ReadRows should preserve empty fields")
    let _rm = RemoveAll("out/test-artifacts/io_csv_shapes")!
}

[Fact]
fn CsvReadTableImportsHeaderIntoColumnarRecord() -> Void {
    let root = "out/test-artifacts/io_csv_shapes/table"
    let path = JoinPath([root, "metrics.csv"])
    let _w = Write(path, [["name", "score"], ["ada", "42"], ["lin", "7"]])!
    let _table = CsvReadTable(path)!
    Assert.True(true, "ReadTable should parse header csv without errors")
    let _rm = RemoveAll("out/test-artifacts/io_csv_shapes")!
}

[Fact]
fn CsvReadTableRejectsDuplicateHeadersAndRaggedRows() -> Void {
    let root = "out/test-artifacts/io_csv_shapes/table_invalid"
    let duplicate = JoinPath([root, "duplicate.csv"])
    let ragged = JoinPath([root, "ragged.csv"])
    let _w1 = Write(duplicate, [["name", "name"], ["ada", "42"]])!
    let _w2 = Write(ragged, [["name", "score"], ["ada"]])!
    Assert.Error(CsvReadTable(duplicate), "ReadTable should reject duplicate headers")
    Assert.Error(CsvReadTable(ragged), "ReadTable should reject ragged rows")
    let _rm = RemoveAll("out/test-artifacts/io_csv_shapes")!
}

[Fact]
fn CsvReadMatrixImportsNumericGridAndRejectsNonNumeric() -> Void {
    let root = "out/test-artifacts/io_csv_shapes/matrix"
    let numeric = JoinPath([root, "numeric.csv"])
    let invalid = JoinPath([root, "invalid.csv"])
    let _w1 = Write(numeric, [["1.5", "2"], ["3", "-4.25"]])!
    let _w2 = Write(invalid, [["x", "2"], ["3", "4"]])!
    let grid = CsvReadMatrix(numeric)!
    let firstRow = grid[0]
    let secondRow = grid[1]
    Assert.Equal(2, Len(grid), "ReadMatrix should import row-major numeric grid")
    Assert.Equal(2.0, firstRow[1], "ReadMatrix should parse numeric cells as Float")
    Assert.Equal(-4.25, secondRow[1], "ReadMatrix should preserve decimal floats")
    Assert.Error(CsvReadMatrix(invalid), "ReadMatrix should reject non-numeric cells and does not infer headers")
    let _rm = RemoveAll("out/test-artifacts/io_csv_shapes")!
}

[Fact]
fn FileWriteTextReadTextRoundTripAndOverwrite() -> Void {
    let dir = "out/test-artifacts/io_mx106/text"
    let path = JoinPath([dir, "roundtrip.txt"])
    let _w1 = WriteText(path, "alpha\nbeta")!
    let first = ReadText(path)!
    Assert.Equal("alpha\nbeta", first, "write then read should preserve exact newlines")
    let _w2 = WriteText(path, "replacement")!
    let second = ReadText(path)!
    Assert.Equal("replacement", second, "write should overwrite existing text file")
    let _rm = RemoveAll("out/test-artifacts/io_mx106")!
}

[Fact]
fn FileReadMissingReportsError() -> Void {
    Assert.Error(ReadText("out/test-artifacts/io_mx106/missing.txt"), "missing file should report failure")
}

[Fact]
fn FileWriteLinesReadLinesPreservesEmptyLines() -> Void {
    let root = "out/test-artifacts/io_mx106/lines"
    let path = JoinPath([root, "lines.txt"])
    let lines = ["first", "", "third", ""]
    let _w = WriteLines(path, lines)!
    let readBack = ReadLines(path)!
    Assert.Equal(4, Len(readBack), "ReadLines should preserve empty lines")
    Assert.Equal("", readBack[1], "ReadLines should preserve middle empty line")
    Assert.Equal("", readBack[3], "ReadLines should preserve trailing empty line")

    let parsed = ReadLines(path)!
    Assert.Equal(4, Len(parsed), "ReadLines on WriteLines output should preserve deterministic line count")
    Assert.Equal("", parsed[1], "ReadLines should preserve empty lines")
    let _rm = RemoveAll("out/test-artifacts/io_mx106")!
}

[Fact]
fn CsvWriteEscapesAndArtifactRoundTrip() -> Void {
    let root = "out/test-artifacts/io_mx106/csv"
    let path = JoinPath([root, "metrics.csv"])
    let rows = [
        ["name", "value", "note", "empty"],
        ["a,b", "quote here", "line1", ""]
    ]
    let _w = Write(path, rows)!
    let csvText = ReadText(path)!
    Assert.True(Contains(csvText, "name,value,note,empty"), "artifact csv should contain deterministic header row")
    let readBack = Read(path)!
    Assert.Equal(2, Len(readBack), "csv read should preserve row count")
    Assert.Equal("a,b", readBack[1][0], "csv read should roundtrip comma field")
    Assert.Equal("quote here", readBack[1][1], "csv read should roundtrip plain field")
    Assert.Equal("line1", readBack[1][2], "csv read should roundtrip plain field")
    Assert.Equal("", readBack[1][3], "csv read should roundtrip empty field")

    let escapePath = JoinPath([root, "escaping.csv"])
    let escapeRows = [["a,b", "", "x,y"]]
    let _we = Write(escapePath, escapeRows)!
    let _rm = RemoveAll("out/test-artifacts/io_mx106")!
}
