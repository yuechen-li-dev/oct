package Manifest

record PackageManifest {
    Name: String
    Version: String
    Description: String
    Authors: String[]
    Date: String
    Dependencies: Dependency[]
}

record Dependency {
    Name: String
    VersionRequirement: String
}

fn Manifest() -> PackageManifest {
    return PackageManifest {
        Name: "Cooking"
        Version: "0.1.0"
        Authors: ["Claude", "Codex"]
        Date: "2026-08-23"
        Description: "Typed practical cooking units, recipe scaling, baker's math, yield, brine, density, and cooling models"
        Dependencies: [
            Dependency { Name: "OctStd" VersionRequirement: "0.1.0" },
            Dependency { Name: "Units" VersionRequirement: "0.1.0" },
            Dependency { Name: "Thermofluids" VersionRequirement: "0.1.0" }
        ]
    }
}
