package Numerics

// ============================================================
// Numerics.Integration
//
// Numerical quadrature: approximate ∫_a^b f(x) dx.
//
// Methods in order of increasing accuracy and cost:
//   Trapezoid     — O(h²), simple, general purpose
//   Simpson       — O(h⁴), same cost as trapezoid for n panels
//   GaussLegendre — O(h^{2n}), spectral accuracy for smooth f
//   AdaptiveSimpson — automatically refines until tolerance met
//
// All methods take fn(Float) -> Float and return Float ! Error.
// ============================================================

record IntegrationResult {
    Value:      Float
    Iterations: Int   // number of function evaluations
    Converged:  Bool  // only meaningful for adaptive methods
}

record AdaptivePanelResult {
    Value: Float
    Evaluations: Int
    Converged: Bool
}

// ============================================================
// Trapezoidal rule
//
// Approximates ∫_a^b f(x) dx using n equal-width trapezoids.
// Error ∝ h² where h = (b-a)/n.
// Good for: discontinuous or non-smooth integrands.
// ============================================================

/// Trapezoidal rule with n equal panels.
///
/// n must be ≥ 1. Total function evaluations: n+1.
fn Trapezoid(f: fn(Float) -> Float, a: Float, b: Float, n: Int) -> Float ! Error {
    if n <= 0 {
        return error("Trapezoid: n must be >= 1")
    }
    if a >= b {
        return error("Trapezoid: a must be < b")
    }

    let h = (b - a) / Float(n)
    var sum = f(a) / 2.0 + f(b) / 2.0

    for i in 1 .. n {
        sum = sum + f(a + Float(i) * h)
    }

    return sum * h
}

// ============================================================
// Simpson's rule
//
// Approximates ∫_a^b f(x) dx using composite Simpson's 1/3 rule.
// Error ∝ h⁴ — one order better than trapezoidal for same n.
// Requires n to be even.
// ============================================================

/// Composite Simpson's 1/3 rule with n equal panels (n must be even).
///
/// n must be ≥ 2 and even. Total function evaluations: n+1.
/// For the same number of evaluations, Simpson's is much more
/// accurate than Trapezoid for smooth integrands.
fn Simpson(f: fn(Float) -> Float, a: Float, b: Float, n: Int) -> Float ! Error {
    if n < 2 {
        return error("Simpson: n must be >= 2")
    }
    if n % 2 != 0 {
        return error("Simpson: n must be even")
    }
    if a >= b {
        return error("Simpson: a must be < b")
    }

    let h = (b - a) / Float(n)
    var sum = f(a) + f(b)
    var i = 1

    while i < n {
        let x = a + Float(i) * h
        if i % 2 == 0 {
            sum = sum + 2.0 * f(x)
        } else {
            sum = sum + 4.0 * f(x)
        }
        i = i + 1
    }

    return sum * h / 3.0
}

// ============================================================
// 5-point Gauss-Legendre quadrature
//
// Integrates exactly polynomials up to degree 9.
// For smooth analytic integrands, dramatically more accurate
// than trapezoid or Simpson with the same number of evaluations.
//
// Nodes and weights for [-1, 1] from Abramowitz & Stegun §25.4.
// Transformed to [a, b] via linear change of variables.
// ============================================================

/// 5-point Gauss-Legendre quadrature over [a, b].
///
/// Exactly integrates polynomials of degree ≤ 9.
/// Total function evaluations: 5.
/// Best for: smooth, well-behaved integrands.
fn GaussLegendre5(f: fn(Float) -> Float, a: Float, b: Float) -> Float ! Error {
    if a >= b {
        return error("GaussLegendre5: a must be < b")
    }

    // Nodes on [-1, 1]
    let n0 =  0.0
    let n1 =  0.538469310105683
    let n2 = -0.538469310105683
    let n3 =  0.906179845938664
    let n4 = -0.906179845938664

    // Weights
    let w0 = 0.568888888888889
    let w1 = 0.478628670499366
    let w2 = 0.478628670499366
    let w3 = 0.236926885056189
    let w4 = 0.236926885056189

    // Transform: x = (b-a)/2 * t + (b+a)/2
    let mid   = (b + a) / 2.0
    let half  = (b - a) / 2.0

    let sum = w0 * f(mid + half * n0)
            + w1 * f(mid + half * n1)
            + w2 * f(mid + half * n2)
            + w3 * f(mid + half * n3)
            + w4 * f(mid + half * n4)

    return half * sum
}

// ============================================================
// Adaptive Simpson's method
//
// Recursively subdivides the interval [a, b] until the
// Simpson's estimate on each subinterval is within tolerance.
// Efficient for integrands that are smooth in some regions
// and rough in others.
//
// Algorithm: compare Simpson's on [a, b] with Simpson's on
// [a, mid] + [mid, b]. If difference < 15*tolerance, accept.
// (The factor 15 comes from the error estimate for Simpson's.)
// ============================================================

/// Adaptive Simpson's integration with error tolerance.
///
/// Automatically refines the interval partition until the
/// estimated error is within tolerance. Returns the integral
/// value and the number of function evaluations used.
///
/// tolerance should be the absolute error target.
/// maxDepth limits recursion (default: use 50).
fn AdaptiveSimpson(
    f: fn(Float) -> Float,
    a: Float,
    b: Float,
    tolerance: Float,
    maxDepth: Int
) -> IntegrationResult ! Error {
    if a >= b {
        return error("AdaptiveSimpson: a must be < b")
    }
    if tolerance <= 0.0 {
        return error("AdaptiveSimpson: tolerance must be > 0")
    }
    if maxDepth <= 0 {
        return error("AdaptiveSimpson: maxDepth must be > 0")
    }

    let mid  = (a + b) / 2.0
    let fa   = f(a)
    let fm   = f(mid)
    let fb   = f(b)

    let whole = (b - a) / 6.0 * (fa + 4.0 * fm + fb)

    let result = adaptiveSimpsonHelper(f, a, b, fa, fm, fb, whole, tolerance, maxDepth)
    return IntegrationResult {
        Value: result.Value
        Iterations: 3 + result.Evaluations
        Converged: result.Converged
    }
}

fn adaptiveSimpsonHelper(
    f: fn(Float) -> Float,
    a: Float,
    b: Float,
    fa: Float,
    fm: Float,
    fb: Float,
    whole: Float,
    tolerance: Float,
    depth: Int
) -> AdaptivePanelResult {
    let mid  = (a + b) / 2.0
    let lmid = (a + mid) / 2.0
    let rmid = (mid + b) / 2.0

    let flm = f(lmid)
    let frm = f(rmid)

    let left  = (mid - a) / 6.0 * (fa  + 4.0 * flm + fm)
    let right = (b - mid) / 6.0 * (fm  + 4.0 * frm + fb)
    let delta = left + right - whole

    let corrected = left + right + delta / 15.0
    if Abs(delta) <= tolerance * 15.0 {
        return AdaptivePanelResult {
            Value: corrected
            Evaluations: 2
            Converged: true
        }
    }
    if depth <= 0 {
        return AdaptivePanelResult {
            Value: corrected
            Evaluations: 2
            Converged: false
        }
    }

    let leftResult = adaptiveSimpsonHelper(f, a, mid, fa, flm, fm, left, tolerance / 2.0, depth - 1)
    let rightResult = adaptiveSimpsonHelper(f, mid, b, fm, frm, fb, right, tolerance / 2.0, depth - 1)
    return AdaptivePanelResult {
        Value: leftResult.Value + rightResult.Value
        Evaluations: 2 + leftResult.Evaluations + rightResult.Evaluations
        Converged: leftResult.Converged and rightResult.Converged
    }
}
