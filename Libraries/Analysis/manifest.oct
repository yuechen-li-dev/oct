package Manifest

record PackageManifest {
    Name: String
    Version: String
    Description: String
    Authors: String[]
    Date: String
    Dependencies: Dependency[]
}

record Dependency {
    Name: String
    VersionRequirement: String
}

fn Manifest() -> PackageManifest {
    return PackageManifest {
        Name: "Analysis"
        Version: "0.1.0"
        Authors: ["Claude", "Codex"]
        Date: "2026-08-23"
        Description: "Finite differences, accumulation, and shape analysis for sampled data series"
        Dependencies: [Dependency { Name: "OctStd" VersionRequirement: "0.1.0" }]
    }
}
