package Octomata

/// Discrete-time state-space system update.
///
/// System form:
///   x[k+1] = A * x[k] + B * u[k]   (state update)
///   y[k]   = C * x[k] + D * u[k]   (output equation)
///
/// A: n×n state transition matrix (flat, row-major), length n*n
/// B: n×m input matrix, length n*m
/// C: p×n output matrix, length p*n
/// D: p×m feedthrough matrix, length p*m
/// x: state vector, length n
/// u: input vector, length m
///
/// Returns updated state x[k+1] and output y[k].
/// All values are dimensionless Float in M0.
record StateSpaceResult {
    State:  Float[]
    Output: Float[]
}

fn StateSpaceUpdate(
    A: Float[],
    B: Float[],
    C: Float[],
    D: Float[],
    x: Float[],
    u: Float[],
    n: Int,
    m: Int,
    p: Int
) -> StateSpaceResult ! Error {
    if n <= 0 or m <= 0 or p <= 0 {
        return error("state-space update requires n, m, p > 0")
    }
    if Len(A) != n * n {
        return error("state-space update requires A length == n*n")
    }
    if Len(B) != n * m {
        return error("state-space update requires B length == n*m")
    }
    if Len(C) != p * n {
        return error("state-space update requires C length == p*n")
    }
    if Len(D) != p * m {
        return error("state-space update requires D length == p*m")
    }
    if Len(x) != n {
        return error("state-space update requires x length == n")
    }
    if Len(u) != m {
        return error("state-space update requires u length == m")
    }

    /// x_next = A*x + B*u
    let Ax = MatVecMulFlat(A, n, n, x)?
    let Bu = MatVecMulFlat(B, n, m, u)?
    let xNext = VecAdd(Ax, Bu)?

    /// y = C*x + D*u
    let Cx = MatVecMulFlat(C, p, n, x)?
    let Du = MatVecMulFlat(D, p, m, u)?
    let y = VecAdd(Cx, Du)?

    return StateSpaceResult {
        State:  xNext
        Output: y
    }
}

/// Flat row-major matrix-vector multiply: y = A * x
/// A is rows×cols, x is cols-length, y is rows-length.
fn MatVecMulFlat(A: Float[], rows: Int, cols: Int, x: Float[]) -> Float[] ! Error {
    if Len(A) != rows * cols {
        return error("matvecmul requires A length == rows*cols")
    }
    if Len(x) != cols {
        return error("matvecmul requires x length == cols")
    }

    var out = [0.0]
    var i = 1
    while i < rows {
        out = Append(out, 0.0)
        i = i + 1
    }

    var r = 0
    while r < rows {
        var sum = 0.0
        var c = 0
        while c < cols {
            sum = sum + A[r * cols + c] * x[c]
            c = c + 1
        }
        out[r] = sum
        r = r + 1
    }

    return out
}

/// Element-wise vector addition. Requires equal length.
fn VecAdd(a: Float[], b: Float[]) -> Float[] ! Error {
    if Len(a) != Len(b) {
        return error("vec add requires equal length vectors")
    }

    var out = [a[0] + b[0]]
    var i = 1
    while i < Len(a) {
        out = Append(out, a[i] + b[i])
        i = i + 1
    }

    return out
}

/// Element-wise vector subtraction. Requires equal length.
fn VecSub(a: Float[], b: Float[]) -> Float[] ! Error {
    if Len(a) != Len(b) {
        return error("vec sub requires equal length vectors")
    }

    var out = [a[0] - b[0]]
    var i = 1
    while i < Len(a) {
        out = Append(out, a[i] - b[i])
        i = i + 1
    }

    return out
}

/// Scalar-vector multiply.
fn VecScale(a: Float[], s: Float) -> Float[] {
    var out = [a[0] * s]
    var i = 1
    while i < Len(a) {
        out = Append(out, a[i] * s)
        i = i + 1
    }
    return out
}
