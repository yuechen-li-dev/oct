package Octomata

/// --- StateSpaceUpdate ---

[Fact]
fn StateSpaceIdentitySystemPreservesState() -> Void {
    /// A = I, B = 0, C = I, D = 0 -> x_next = x, y = x
    let A = [1.0, 0.0, 0.0, 1.0]
    let B = [0.0, 0.0]
    let C = [1.0, 0.0, 0.0, 1.0]
    let D = [0.0, 0.0]
    let x = [3.0, 7.0]
    let u = [0.0]

    let result = StateSpaceUpdate(A, B, C, D, x, u, 2, 1, 2)!

    Assert.Near(3.0, result.State[0], 0.000001, "state[0] preserved")
    Assert.Near(7.0, result.State[1], 0.000001, "state[1] preserved")
    Assert.Near(3.0, result.Output[0], 0.000001, "output[0] = state[0]")
    Assert.Near(7.0, result.Output[1], 0.000001, "output[1] = state[1]")
}

[Fact]
fn StateSpaceIntegratorAccumulates() -> Void {
    /// Scalar integrator: A=1, B=1, C=1, D=0
    /// x[k+1] = x[k] + u[k]
    let A = [1.0]
    let B = [1.0]
    let C = [1.0]
    let D = [0.0]
    let u = [2.0]

    let r1 = StateSpaceUpdate(A, B, C, D, [0.0], u, 1, 1, 1)!
    let r2 = StateSpaceUpdate(A, B, C, D, r1.State, u, 1, 1, 1)!
    let r3 = StateSpaceUpdate(A, B, C, D, r2.State, u, 1, 1, 1)!

    Assert.Near(2.0, r1.State[0], 0.000001, "after tick 1: x = 2")
    Assert.Near(4.0, r2.State[0], 0.000001, "after tick 2: x = 4")
    Assert.Near(6.0, r3.State[0], 0.000001, "after tick 3: x = 6")
}

[Fact]
fn StateSpaceDoubleIntegratorModelsPosition() -> Void {
    /// Double integrator in discrete time with dt=0.1:
    /// state = [position, velocity]
    /// A = [[1, dt][0, 1]], B = [[0.5*dt^2][dt]], C = [[1, 0]], D = [0]
    /// Input u = acceleration
    let dt = 0.1
    let A = [1.0, dt, 0.0, 1.0]
    let B = [0.5*dt*dt, dt]
    let C = [1.0, 0.0]
    let D = [0.0]

    /// Apply constant acceleration of 10 m/s^2 for 10 ticks
    let u = [10.0]
    var x = [0.0, 0.0]
    var i = 0
    while i < 10 {
        let r = StateSpaceUpdate(A, B, C, D, x, u, 2, 1, 1)!
        x = r.State
        i = i + 1
    }

    /// After 1 second at 10 m/s^2: v = 10, x ≈ 5 (kinematics)
    Assert.Near(10.0, x[1], 0.001, "velocity after 1s at 10 m/s^2")
    Assert.Near(5.0, x[0], 0.01, "position after 1s at 10 m/s^2")
}

[Fact]
fn StateSpaceRejectsInvalidDimensions() -> Void {
    let A = [1.0, 0.0, 0.0, 1.0]
    let B = [1.0]
    let C = [1.0, 0.0]
    let D = [0.0]

    /// Wrong B length — should be n*m = 2*1 = 2
    match StateSpaceUpdate(A, B, C, D, [0.0, 0.0], [0.0], 2, 1, 1) {
        ok(r) => { Assert.True(false, "should reject wrong B length") }
        err(e) => { }
    }
}

[Fact]
fn MatVecMulFlatComputesCorrectly() -> Void {
    /// [[1,2][3,4]] * [1, 2] = [5, 11]
    let A = [1.0, 2.0, 3.0, 4.0]
    let x = [1.0, 2.0]
    let result = MatVecMulFlat(A, 2, 2, x)!

    Assert.Near(5.0, result[0], 0.000001, "row 0 dot product")
    Assert.Near(11.0, result[1], 0.000001, "row 1 dot product")
}

[Fact]
fn VecAddAndSubAreInverse() -> Void {
    let a = [1.0, 2.0, 3.0]
    let b = [4.0, 5.0, 6.0]
    let sum = VecAdd(a, b)!
    let diff = VecSub(sum, b)!

    Assert.Near(a[0], diff[0], 0.000001, "add then sub recovers original [0]")
    Assert.Near(a[1], diff[1], 0.000001, "add then sub recovers original [1]")
    Assert.Near(a[2], diff[2], 0.000001, "add then sub recovers original [2]")
}
