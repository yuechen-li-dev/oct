package Manifest

record PackageManifest {
    Name: String
    Version: String
    Description: String
    Dependencies: Dependency[]
}

record Dependency {
    Name: String
    VersionRequirement: String
}

fn Manifest() -> PackageManifest {
    return PackageManifest {
        Name: "ChemistryNmr"
        Version: "0.1.0"
        Description: "NMR spectroscopy library for Oct. Provides gyromagnetic ratios, Larmor frequency computation, chemical shift arithmetic (ppm/Hz), coupling constants, and 1D spectrum peak/spectrum records with window queries. Dimensional types enforce Hz vs dimensionless separation at compile time."
        Dependencies: [Dependency { Name: "OctStd" VersionRequirement: "0.1.0" }]
    }
}
