package Manifest

record PackageManifest {
    Name: String
    Version: String
    Description: String
    Authors: String[]
    Date: String
    Dependencies: Dependency[]
}

record Dependency {
    Name: String
    VersionRequirement: String
}

fn Manifest() -> PackageManifest {
    return PackageManifest {
        Name: "Signal"
        Version: "0.1.0"
        Authors: ["Codex"]
        Date: "2026-08-23"
        Description: "Deterministic finite-sequence convolution, correlation, and moving-average helpers"
        Dependencies: [Dependency { Name: "OctStd" VersionRequirement: "0.1.0" }]
    }
}
