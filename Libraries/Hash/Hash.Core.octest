package Hash

[Fact]
fn Sha256TextKnownValueChecks() -> Void ! Error {
    Assert.Equal("2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824", Sha256Text("hello")?, "sha256 text should match known vector")
}

[Fact]
fn Sha256BytesKnownValueChecks() -> Void ! Error {
    let path = "mx103c_hash_hello_bytes.txt"
    let _w = FileWriteText(path, "hello")?
    let bytes = FileReadBytes(path)?
    Assert.Equal("2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824", Sha256Bytes(bytes)?, "sha256 bytes should match known vector")
    let _d = FileDelete(path)?
}

[Fact]
fn Sha256FileKnownValueChecks() -> Void ! Error {
    let path = "mx103c_hash_hello_file.txt"
    let _w = FileWriteText(path, "hello")?
    Assert.Equal("2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824", Sha256File(path)?, "sha256 file should match known vector")
    let _d = FileDelete(path)?
}

[Fact]
fn Sha256FileMissingFails() -> Void ! Error {
    match Sha256File("mx103c_missing_hash.txt") {
        ok(value) => {
            Assert.True(false, value)
        }
        err(e) => {
            Assert.True(true, "sha256 file should fail for missing path")
        }
    }
}
