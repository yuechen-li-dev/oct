package Distributions

fn NormalPdf(x: Float, mean: Float, sigma: Float) -> Float ! Error {
    if sigma <= 0.0 {
        return error("normal pdf requires sigma > 0")
    }

    let z = (x - mean) / sigma
    let norm = sigma * Sqrt(2.0 * Pi())
    return Exp((0.0 - 0.5) * z * z) / norm
}

fn NormalCdf(x: Float, mean: Float, sigma: Float) -> Float ! Error {
    if sigma <= 0.0 {
        return error("normal cdf requires sigma > 0")
    }

    let z = (x - mean) / sigma
    let scaled = z / Sqrt(2.0)
    return 0.5 * (1.0 + ErfApprox(scaled))
}

fn UniformPdf(x: Float, a: Float, b: Float) -> Float ! Error {
    if a >= b {
        return error("uniform pdf requires a < b")
    }

    if x < a or x > b {
        return 0.0
    }

    return 1.0 / (b - a)
}

fn UniformCdf(x: Float, a: Float, b: Float) -> Float ! Error {
    if a >= b {
        return error("uniform cdf requires a < b")
    }

    if x < a {
        return 0.0
    }

    if x > b {
        return 1.0
    }

    return (x - a) / (b - a)
}

fn ExponentialPdf(x: Float, lambda: Float) -> Float ! Error {
    if lambda <= 0.0 {
        return error("exponential pdf requires lambda > 0")
    }

    if x < 0.0 {
        return 0.0
    }

    return lambda * Exp(0.0 - lambda * x)
}

fn ExponentialCdf(x: Float, lambda: Float) -> Float ! Error {
    if lambda <= 0.0 {
        return error("exponential cdf requires lambda > 0")
    }

    if x < 0.0 {
        return 0.0
    }

    return 1.0 - Exp(0.0 - lambda * x)
}

fn ErfApprox(value: Float) -> Float {
    // Abramowitz and Stegun 7.1.26 (deterministic approximation).
    let p = 0.3275911
    let a1 = 0.254829592
    let a2 = 0.0 - 0.284496736
    let a3 = 1.421413741
    let a4 = 0.0 - 1.453152027
    let a5 = 1.061405429

    let sign = SignFloat(value)
    let x = Abs(value)
    let t = 1.0 / (1.0 + p * x)
    let poly = (((((a5 * t + a4) * t + a3) * t + a2) * t + a1) * t)
    let y = 1.0 - poly * Exp(0.0 - x * x)

    return sign * y
}

fn SignFloat(value: Float) -> Float {
    if value > 0.0 {
        return 1.0
    }

    if value < 0.0 {
        return 0.0 - 1.0
    }

    return 0.0
}
