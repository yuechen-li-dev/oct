package Distributions

concept Probability = Float {
    Require(Self >= 0.0, "probability must be at least 0")
    Require(Self <= 1.0, "probability must be at most 1")
}

concept PositiveDistributionScale = Float {
    Require(Self > 0.0, "distribution scale must be positive")
}

concept NonNegativeCount = Int {
    Require(Self >= 0, "count must be non-negative")
}

fn NormalPdf(x: Float, mean: Float, sigma: PositiveDistributionScale) -> Float {

    let z = (x - mean) / sigma
    let norm = sigma * Sqrt(2.0 * Pi())
    return Exp((0.0 - 0.5) * z * z) / norm
}

fn NormalCdf(x: Float, mean: Float, sigma: PositiveDistributionScale) -> Float {

    let z = (x - mean) / sigma
    let scaled = z / Sqrt(2.0)
    return 0.5 * (1.0 + ErfApprox(scaled))
}

fn UniformPdf(x: Float, a: Float, b: Float) -> Float ! Error {
    if a >= b {
        return error("uniform pdf requires a < b")
    }

    if x < a or x > b {
        return 0.0
    }

    return 1.0 / (b - a)
}

fn UniformCdf(x: Float, a: Float, b: Float) -> Float ! Error {
    if a >= b {
        return error("uniform cdf requires a < b")
    }

    if x < a {
        return 0.0
    }

    if x > b {
        return 1.0
    }

    return (x - a) / (b - a)
}

fn ExponentialPdf(x: Float, lambda: PositiveDistributionScale) -> Float {
    if x < 0.0 {
        return 0.0
    }

    return lambda * Exp(0.0 - lambda * x)
}

fn ExponentialCdf(x: Float, lambda: PositiveDistributionScale) -> Float {
    if x < 0.0 {
        return 0.0
    }

    return 1.0 - Exp(0.0 - lambda * x)
}

/// Bernoulli probability mass function for k in {0, 1}.
fn BernoulliPmf(k: Int, probability: Probability) -> Float {
    if k == 0 {
        return 1.0 - probability
    }
    if k == 1 {
        return probability
    }
    return 0.0
}

/// Binomial probability mass for k successes in n independent trials.
/// The multiplicative coefficient avoids constructing factorials explicitly.
/// Suitable for moderate n; extreme-tail work should use a log-domain implementation.
fn BinomialPmf(k: Int, n: NonNegativeCount, probability: Probability) -> Float {
    let p = probability + 0.0
    let trials = n + 0
    if k < 0 or k > trials {
        return 0.0
    }
    if p == 0.0 {
        return if k == 0 { 1.0 } else { 0.0 }
    }
    if p == 1.0 {
        return if k == trials { 1.0 } else { 0.0 }
    }

    let symmetricK = if k < trials - k { k } else { trials - k }
    var coefficient = 1.0
    for i in 1 .. symmetricK + 1 {
        coefficient = coefficient * Float(trials - symmetricK + i) / Float(i)
    }
    return coefficient * Pow(p, Float(k)) * Pow(1.0 - p, Float(trials - k))
}

/// Poisson probability mass for k events at positive expected count lambda.
/// The recurrence exp(-lambda) * product(lambda/i) avoids factorial overflow.
fn PoissonPmf(k: Int, lambda: PositiveDistributionScale) -> Float {
    if k < 0 {
        return 0.0
    }

    var probability = Exp(0.0 - lambda)
    for i in 1 .. k + 1 {
        probability = probability * lambda / Float(i)
    }
    return probability
}

/// log(n!) computed as a sum of logarithms, avoiding factorial overflow.
fn LogFactorial(n: NonNegativeCount) -> Float {
    var result = 0.0
    for i in 2 .. n + 1 {
        result = result + Ln(Float(i))
    }
    return result
}

fn ErfApprox(value: Float) -> Float {
    // Abramowitz and Stegun 7.1.26 (deterministic approximation).
    let p = 0.3275911
    let a1 = 0.254829592
    let a2 = 0.0 - 0.284496736
    let a3 = 1.421413741
    let a4 = 0.0 - 1.453152027
    let a5 = 1.061405429

    let sign = SignFloat(value)
    let x = Abs(value)
    let t = 1.0 / (1.0 + p * x)
    let poly = (((((a5 * t + a4) * t + a3) * t + a2) * t + a1) * t)
    let y = 1.0 - poly * Exp(0.0 - x * x)

    return sign * y
}

fn SignFloat(value: Float) -> Float {
    if value > 0.0 {
        return 1.0
    }

    if value < 0.0 {
        return 0.0 - 1.0
    }

    return 0.0
}
