package Manifest

record PackageManifest {
    Name: String
    Version: String
    Description: String
    Authors: String[]
    Date: String
    Dependencies: Dependency[]
}

record Dependency {
    Name: String
    VersionRequirement: String
}

fn Manifest() -> PackageManifest {
    return PackageManifest {
        Name: "Atlas"
        Version: "0.1.0"
        Description: "Domain-neutral semantic provenance and traceability authoring records"
        Authors:["Codex"]
        Date: "2026-08-30"
        Dependencies:[Dependency {Name: "OctStd" VersionRequirement: "0.1.0"}]
    }
}
