package Random

/// Rolls one die with the given number of sides at index i. Faces are 1..sides.
fn RollDie(s: Stream, i: Int, sides: Int) -> Int {
    Assert.True(sides >= 2, "RollDie requires sides >= 2")
    return IntBetween(s, i, 1, sides)
}

/// Rolls count dice at index i. Die k is RollDie(Child(s, i), k, sides), so
/// the dice at one index do not overlap the draws at any other index.
fn RollDice(s: Stream, i: Int, count: Int, sides: Int) -> Int[] {
    Assert.True(count >= 0, "RollDice requires count >= 0")
    Assert.True(sides >= 2, "RollDice requires sides >= 2")
    let step = Child(s, i)
    var rolls: Int[] = []
    for k in 0..count {
        rolls = Append(rolls, RollDie(step, k, sides))
    }
    return rolls
}

/// Rolls two dice at index i and keeps the higher.
fn RollWithAdvantage(s: Stream, i: Int, sides: Int) -> Int {
    let rolls = RollDice(s, i, 2, sides)
    return if rolls[0] >= rolls[1] { rolls[0] } else { rolls[1] }
}

/// Rolls the same two dice as RollWithAdvantage at index i and keeps the lower.
fn RollWithDisadvantage(s: Stream, i: Int, sides: Int) -> Int {
    let rolls = RollDice(s, i, 2, sides)
    return if rolls[0] <= rolls[1] { rolls[0] } else { rolls[1] }
}

// Entropy-backed dice (Random v1). These move to the Entropy package in
// ladder milestone M5.

fn CryptoRollDie(sides: Int) -> Int ! Error {
    if sides < 2 {
        return error("CryptoRollDie requires sides >= 2")
    }
    return CryptoRandInt(1, sides)!
}

fn CryptoRollD20() -> Int ! Error {
    return CryptoRollDie(20)!
}

fn CryptoRollDice(count: Int, sides: Int) -> Int[] ! Error {
    if count < 0 {
        return error("CryptoRollDice requires count >= 0")
    }
    if sides < 2 {
        return error("CryptoRollDice requires sides >= 2")
    }

    let values: Int[] = []
    return CryptoRollDiceInto(values, count, sides)!
}

fn CryptoRollDiceInto(values: Int[], remaining: Int, sides: Int) -> Int[] ! Error {
    if remaining == 0 {
        return values
    }
    let next = Append(values, CryptoRollDie(sides)!)
    return CryptoRollDiceInto(next, remaining - 1, sides)!
}
