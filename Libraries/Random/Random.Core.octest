package Random

[Fact]
fn RandomRandomCoreFacts() -> Void {
    let rng0 = RngSeed(42)
    let a1 = RandInt(rng0, 1, 10)
    let a2 = RandInt(a1.Next, 1, 10)
    let rng1 = RngSeed(42)
    let b1 = RandInt(rng1, 1, 10)
    let b2 = RandInt(b1.Next, 1, 10)
    Assert.Equal(a1.Value, b1.Value, "deterministic first draw")
    Assert.Equal(a2.Value, b2.Value, "deterministic second draw")
    Assert.Equal(a1.Value, RandInt(rng0, 1, 10).Value, "state threading explicit")
    let rf = RandFloat01(a2.Next)
    Assert.True(rf.Value >= 0.0 and rf.Value < 1.0, "float01 range")
    Assert.Equal(false, RandBernoulli(rf.Next, 0.0).Value, "bernoulli zero")
    let b1 = RandBernoulli(rf.Next, 1.0).Value
    Assert.True(b1 == true or b1 == false, "bernoulli one domain")
    Assert.Equal(3.5, RandNormal(rf.Next, 3.5, 0.0).Value, "normal zero stddev")
    let rr = RandFloatRange(rf.Next, 2.0, 2.0)
    Assert.Equal(2.0, rr.Value, "float range equal bounds")
    let bytes = CryptoRandBytes(16)!
    Assert.True(Len(bytes) >= 0, "crypto bytes length non-negative")
}
