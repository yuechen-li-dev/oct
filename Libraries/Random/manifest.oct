package Manifest

record PackageManifest {
    Name: String
    Version: String
    Description: String
    Authors: String[]
    Date: String
    Dependencies: Dependency[]
}

record Dependency {
    Name: String
    VersionRequirement: String
}

fn Manifest() -> PackageManifest {
    return PackageManifest {
        Name: "Random"
        Version: "0.1.0"
        Authors: ["Codex"]
        Date: "2026-08-23"
        Description: "Seeded pseudorandom generation plus bounded distribution, coin, and dice sampling helpers"
        Dependencies:[Dependency {Name: "OctStd" VersionRequirement: "0.1.0"}]
    }
}
