package Manifest

record PackageManifest {
    Name: String
    Version: String
    Description: String
    Authors: String[]
    Date: String
    Dependencies: Dependency[]
}

record Dependency {
    Name: String
    VersionRequirement: String
}

fn Manifest() -> PackageManifest {
    return PackageManifest {
        Name: "Random"
        Version: "0.2.0"
        Authors: ["Codex", "Claude"]
        Date: "2026-10-03"
        Description: "Reproducible counter-based random streams, with sampling, coin and dice helpers"
        Dependencies: [Dependency { Name: "OctStd" VersionRequirement: "0.1.0" }]
    }
}
