package Random

[Fact]
fn RandomRandomCoinTossFacts() -> Void {
    let a0 = RngSeed(42)
    let aMany = FlipCoins(a0, 10)

    let b0 = RngSeed(42)
    let bMany = FlipCoins(b0, 10)

    Assert.Equal(10, Len(aMany.Flips), "flip count")
    Assert.Equal(10, Len(bMany.Flips), "flip count reproducible")

    for i in 0..Len(aMany.Flips) {
        Assert.Equal(aMany.Flips[i], bMany.Flips[i], "same seed same side sequence")
    }

    let different = FlipCoins(RngSeed(99), 10)
    Assert.Equal(10, Len(different.Flips), "different seed count")

    let always = FlipBiasedCoin(a0, 1.0).Side
    Assert.True(always == CoinSide.Heads or always == CoinSide.Tails, "biased coin domain")
    Assert.Equal(CoinSide.Tails, FlipBiasedCoin(a0, 0.0).Side, "pHeads=0 always tails")

    let known = [CoinSide.Heads, CoinSide.Tails, CoinSide.Heads]
    Assert.Equal(2, CountHeads(known), "count heads")
    Assert.Equal(1, CountTails(known), "count tails")

    Assert.Equal("Heads", CoinSideToString(CoinSide.Heads), "text heads")
    Assert.Equal("Tails", CoinSideToString(CoinSide.Tails), "text tails")

    let firstFlip = FlipCoin(RngSeed(123))
    let secondFromThreaded = FlipCoin(firstFlip.Next)
    let replay = FlipCoins(RngSeed(123), 2)
    Assert.Equal(replay.Flips[1], secondFromThreaded.Side, "threaded state matches replay")

    let cryptoSide = CryptoFlipCoin()!
    Assert.True(cryptoSide == CoinSide.Heads or cryptoSide == CoinSide.Tails, "crypto side domain")
    Assert.Equal(CoinSide.Heads, CryptoFlipBiasedCoin(1.0)!, "crypto pHeads=1")
    Assert.Equal(CoinSide.Tails, CryptoFlipBiasedCoin(0.0)!, "crypto pHeads=0")
    Assert.Equal(4, Len(CryptoFlipCoins(4)!), "crypto count")

}
