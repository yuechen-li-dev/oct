package Main

import Random

[Fact]
fn RandomTupleThreadingRequiresMutableRng() -> Void {
    var rng = Random.RngSeed(42)
    rng, x = Random.RandInt(rng, 1, 6)
    rng, y = Random.RandInt(rng, 1, 6)
    Assert.True(x >= 1 && x <= 6, "first draw in range")
    Assert.True(y >= 1 && y <= 6, "second draw in range")
}
