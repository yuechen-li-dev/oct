package Random

[Fact]
fn UniformRangeAndDegenerateCase() -> Void {
    let sample = Uniform(RngSeed(7), -2.0, 3.0)
    Assert.True(sample.Value >= -2.0, "uniform lower bound inclusive")
    Assert.True(sample.Value < 3.0, "uniform upper bound exclusive")

    let same = Uniform(RngSeed(7), 1.25, 1.25)
    Assert.Equal(1.25, same.Value, "uniform min==max returns min")
}

[Fact]
fn JitterSpikeAndDriftAreNonDegenerate() -> Void {
    var jitterRng = RngSeed(20)
    var jitterNonZero = false
    for _i in 0..100 {
        let sample = Jitter(jitterRng, 0.05)
        jitterRng = sample.Next
        if sample.Value != 0.0 {
            jitterNonZero = true
        }
    }
    Assert.True(jitterNonZero, "jitter eventually non-zero")

    var spikeRng = RngSeed(21)
    var sawSpike = false
    for _j in 0..200 {
        let sample = Spike(spikeRng, 0.1, 4.0)
        spikeRng = sample.Next
        if sample.Value != 0.0 {
            sawSpike = true
        }
    }
    Assert.True(sawSpike, "spike eventually emits spike")

    var driftRng = RngSeed(22)
    var current = 0.0
    var changed = false
    for _k in 0..50 {
        let draw = DriftStep(driftRng, current, 0.25)
        driftRng = draw.Next
        if draw.Value != current {
            changed = true
        }
        current = draw.Value
    }
    Assert.True(changed, "drift step changes over time")
}

[Fact]
fn GaussianAndExponentialDeterministicProperties() -> Void {
    let sample = Gaussian(RngSeed(3), 12.5, 0.0)
    Assert.Equal(12.5, sample.Value, "gaussian stddev=0 returns mean")

    let a = Exponential(RngSeed(99), 2.0)
    let b = Exponential(RngSeed(99), 2.0)
    Assert.True(a.Value >= 0.0, "exponential non-negative")
    Assert.Equal(a.Value, b.Value, "exponential reproducible for same seed")
}
