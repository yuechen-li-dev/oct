package Random

[Fact]
fn UniformRangeAndDegenerateCase() -> Void {
    let sample = Uniform(RngSeed(7), -2.0, 3.0)
    Assert.True(sample.Value >= -2.0, "uniform lower bound inclusive")
    Assert.True(sample.Value < 3.0, "uniform upper bound exclusive")

    let same = Uniform(RngSeed(7), 1.25, 1.25)
    Assert.Equal(1.25, same.Value, "uniform min==max returns min")
}

[Fact]
fn GaussianZeroStddevReturnsMean() -> Void {
    let sample = Gaussian(RngSeed(3), 12.5, 0.0)
    Assert.Equal(12.5, sample.Value, "gaussian stddev=0 returns mean")
}

[Fact]
fn ExponentialIsNonNegativeAndReproducible() -> Void {
    let a = Exponential(RngSeed(99), 2.0)
    let b = Exponential(RngSeed(99), 2.0)
    Assert.True(a.Value >= 0.0, "exponential non-negative")
    Assert.Equal(a.Value, b.Value, "exponential reproducible for same seed")
}

[Fact]
fn JitterRangeAndZeroAmplitude() -> Void {
    let sample = Jitter(RngSeed(2), 0.75)
    Assert.True(sample.Value >= -0.75, "jitter lower bound inclusive")
    Assert.True(sample.Value < 0.75, "jitter upper bound exclusive")

    let zero = Jitter(RngSeed(2), 0.0)
    Assert.Equal(0.0, zero.Value, "jitter amplitude=0 returns zero")
}

[Fact]
fn SpikeExtremesAndReproducibility() -> Void {
    let never = Spike(RngSeed(4), 0.0, 10.0)
    Assert.Equal(0.0, never.Value, "spike p=0 returns zero")

    let alwaysA = Spike(RngSeed(8), 1.0, 10.0)
    let alwaysB = Spike(RngSeed(8), 1.0, 10.0)
    let isPositive = alwaysA.Value == 10.0
    let isNegative = alwaysA.Value == -10.0
    let validSign = if isPositive { true } else { isNegative }
    Assert.True(validSign, "spike p=1 returns +/- amplitude")
    Assert.Equal(alwaysA.Value, alwaysB.Value, "spike reproducible for same seed")
}

[Fact]
fn DriftStepZeroStddevReturnsCurrent() -> Void {
    let sample = DriftStep(RngSeed(12), 123.5, 0.0)
    Assert.Equal(123.5, sample.Value, "drift step stddev=0 returns current")
}

[Fact]
fn StateThreadingIsExplicitAndDeterministic() -> Void {
    let r0 = RngSeed(13)

    let a1 = Jitter(r0, 0.2)
    let a2 = Gaussian(a1.Next, 0.0, 1.0)

    let b1 = Jitter(RngSeed(13), 0.2)
    let b2 = Gaussian(b1.Next, 0.0, 1.0)

    Assert.Equal(a1.Value, b1.Value, "first sample deterministic")
    Assert.Equal(a2.Value, b2.Value, "threaded second sample deterministic")
}
