package Random

enum CoinSide {
    Heads
    Tails
}

record CoinFlipResult {
    Next: Rng
    Side: CoinSide
}

record CoinFlipManyResult {
    Next: Rng
    Flips: CoinSide[]
}

fn FlipCoin(rng: Rng) -> CoinFlipResult {
    return FlipBiasedCoin(rng, 0.5)
}

fn FlipBiasedCoin(rng: Rng, pHeads: Float) -> CoinFlipResult {
    let draw = RandBernoulli(rng, pHeads)
    let side = switch draw.Value {
        case true => CoinSide.Heads
        case false => CoinSide.Tails
        else => CoinSide.Tails
    }
    return CoinFlipResult {
        Next: draw.Next
        Side: side
    }
}

fn FlipCoins(rng: Rng, count: Int) -> CoinFlipManyResult {
    Assert.True(count >= 0, "FlipCoins requires count >= 0")

    var next = rng
    var flips: CoinSide[] = []
    for _i in 0..count {
        let flipResult = FlipCoin(next)
        next = flipResult.Next
        flips = Append(flips, flipResult.Side)
    }

    return CoinFlipManyResult {
        Next: next
        Flips: flips
    }
}

fn CountHeads(flips: CoinSide[]) -> Int {
    var count = 0
    for i in 0..Len(flips) {
        if flips[i] == CoinSide.Heads {
            count = count + 1
        }
    }
    return count
}

fn CountTails(flips: CoinSide[]) -> Int {
    var count = 0
    for i in 0..Len(flips) {
        if flips[i] == CoinSide.Tails {
            count = count + 1
        }
    }
    return count
}

fn CoinSideToString(side: CoinSide) -> String {
    return switch side {
        case CoinSide.Heads => "Heads"
        case CoinSide.Tails => "Tails"
        else => "Tails"
    }
}

fn CryptoFlipCoin() -> CoinSide ! Error {
    return CryptoFlipBiasedCoin(0.5)!
}

fn CryptoFlipBiasedCoin(pHeads: Float) -> CoinSide ! Error {
    let draw = CryptoRandFloat01()!
    if draw < pHeads {
        return CoinSide.Heads
    }
    return CoinSide.Tails
}

fn CryptoFlipCoins(count: Int) -> CoinSide[] ! Error {
    let flips: CoinSide[] = []
    return CryptoFlipCoinsInto(flips, count)!
}

fn CryptoFlipCoinsInto(flips: CoinSide[], remaining: Int) -> CoinSide[] ! Error {
    if remaining < 0 {
        return error("CryptoFlipCoins requires count >= 0")
    }
    if remaining == 0 {
        return flips
    }
    let next = Append(flips, CryptoFlipCoin()!)
    return CryptoFlipCoinsInto(next, remaining - 1)!
}
