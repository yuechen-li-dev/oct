package Random

enum CoinSide {
    Heads
    Tails
}

/// Flips a fair coin at index i.
fn FlipCoin(s: Stream, i: Int) -> CoinSide {
    if Chance(s, i, 0.5) {
        return CoinSide.Heads
    }
    return CoinSide.Tails
}

/// Flips count fair coins at index i. Flip k is FlipCoin(Child(s, i), k), so
/// the flips at one index do not overlap the draws at any other index.
fn FlipCoins(s: Stream, i: Int, count: Int) -> CoinSide[] {
    Assert.True(count >= 0, "FlipCoins requires count >= 0")
    let step = Child(s, i)
    var flips: CoinSide[] = []
    for k in 0..count {
        flips = Append(flips, FlipCoin(step, k))
    }
    return flips
}

fn CountHeads(flips: CoinSide[]) -> Int {
    var count = 0
    for i in 0..Len(flips) {
        if flips[i] == CoinSide.Heads {
            count = count + 1
        }
    }
    return count
}

fn CountTails(flips: CoinSide[]) -> Int {
    var count = 0
    for i in 0..Len(flips) {
        if flips[i] == CoinSide.Tails {
            count = count + 1
        }
    }
    return count
}

fn CoinSideToString(side: CoinSide) -> String {
    return switch side {
        case CoinSide.Heads => "Heads"
        case CoinSide.Tails => "Tails"
        else => "Tails"
    }
}

// Entropy-backed coins (Random v1). These move to the Entropy package in
// ladder milestone M5.

fn CryptoFlipCoin() -> CoinSide ! Error {
    return CryptoFlipBiasedCoin(0.5)!
}

fn CryptoFlipBiasedCoin(pHeads: Float) -> CoinSide ! Error {
    let draw = CryptoRandFloat01()!
    if draw < pHeads {
        return CoinSide.Heads
    }
    return CoinSide.Tails
}

fn CryptoFlipCoins(count: Int) -> CoinSide[] ! Error {
    let flips: CoinSide[] = []
    return CryptoFlipCoinsInto(flips, count)!
}

fn CryptoFlipCoinsInto(flips: CoinSide[], remaining: Int) -> CoinSide[] ! Error {
    if remaining < 0 {
        return error("CryptoFlipCoins requires count >= 0")
    }
    if remaining == 0 {
        return flips
    }
    let next = Append(flips, CryptoFlipCoin()!)
    return CryptoFlipCoinsInto(next, remaining - 1)!
}
