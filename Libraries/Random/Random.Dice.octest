package Random

fn Sum(values: Int[]) -> Int {
    var total = 0
    for i in 0..Len(values) {
        total = total + values[i]
    }
    return total
}

fn AssertInRange(value: Int, low: Int, high: Int, message: String) -> Void {
    Assert.True(value >= low, message)
    Assert.True(value <= high, message)
}

[Fact]
fn RandomRandomDiceFacts() -> Void {
    let a0 = RngSeed(42)
    let aMany = RollDice(a0, 10, 6)

    let b0 = RngSeed(42)
    let bMany = RollDice(b0, 10, 6)

    Assert.Equal(10, Len(aMany.Values), "same seed roll count")
    Assert.Equal(10, Len(bMany.Values), "same seed roll count reproducible")
    Assert.Equal(aMany.Total, bMany.Total, "same seed total")
    for i in 0..Len(aMany.Values) {
        Assert.Equal(aMany.Values[i], bMany.Values[i], "same seed sequence")
    }

    let different = RollDice(RngSeed(99), 10, 6)
    Assert.Equal(10, Len(different.Values), "different seed roll count")

    AssertInRange(RollD4(a0).Value, 1, 4, "d4 range")
    AssertInRange(RollD6(a0).Value, 1, 6, "d6 range")
    AssertInRange(RollD8(a0).Value, 1, 8, "d8 range")
    AssertInRange(RollD10(a0).Value, 1, 10, "d10 range")
    AssertInRange(RollD12(a0).Value, 1, 12, "d12 range")
    AssertInRange(RollD20(a0).Value, 1, 20, "d20 range")
    AssertInRange(RollD100(a0).Value, 1, 100, "d100 range")

    let pool = RollDice(a0, 5, 6)
    Assert.Equal(5, Len(pool.Values), "pool length")
    Assert.Equal(Sum(pool.Values), pool.Total, "pool total equals value sum")
    for i in 0..Len(pool.Values) {
        AssertInRange(pool.Values[i], 1, 6, "pool value range")
    }

    let zero = RollDice(a0, 0, 6)
    Assert.Equal(0, Len(zero.Values), "zero-count values empty")
    Assert.Equal(0, zero.Total, "zero-count total is zero")

    let sumOnly = RollDiceSum(a0, 4, 8)
    AssertInRange(sumOnly.Value, 4, 32, "sum helper range")

    let adv = RollD20Advantage(a0)
    Assert.Equal(2, Len(adv.Values), "advantage has two values")
    let maxValue = if adv.Values[0] >= adv.Values[1] { adv.Values[0] } else { adv.Values[1] }
    Assert.Equal(maxValue, adv.Total, "advantage picks max")

    let dis = RollD20Disadvantage(a0)
    Assert.Equal(2, Len(dis.Values), "disadvantage has two values")
    let minValue = if dis.Values[0] <= dis.Values[1] { dis.Values[0] } else { dis.Values[1] }
    Assert.Equal(minValue, dis.Total, "disadvantage picks min")

    let cryptoD6 = CryptoRollDie(6)!
    Assert.True(cryptoD6 >= 0, "crypto d6 non-negative smoke")
    let cryptoD20 = CryptoRollD20()!
    Assert.True(cryptoD20 >= 0, "crypto d20 non-negative smoke")
    let cryptoMany = CryptoRollDice(3, 6)!
    Assert.Equal(3, Len(cryptoMany), "crypto count")
    for i in 0..Len(cryptoMany) {
        Assert.True(cryptoMany[i] >= 0, "crypto many non-negative smoke")
    }

}
