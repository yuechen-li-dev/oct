package Mechanics

[Fact]
fn DisplacementStrainToStressPathwayIsRepresentational() -> Void {
    let u = vector[0.1, -0.05]
    let eps = SymGrad(u)
    let twoMuI = matrix[[160.0, 0.0] [0.0, 160.0]]
    let sigma = twoMuI * eps

    let _ = sigma[0, 1]
}

[Fact]
fn LinearIsotropicStress2DStillAppliesOnMaterializedStrain() -> Void {
    let sampledGradU = matrix[[0.02, 0.03] [0.01, -0.01]]
    let eps = SmallStrain2D(sampledGradU)
    let sigma = LinearIsotropicStress2D(eps, 120.0, 80.0)

    let _ = Div(sigma)
}

[Fact]
fn StrongFormResidualShapeIsRepresentational() -> Void {
    let u = vector[0.02, -0.01]
    let eps = SymGrad(u)
    let _ = eps

    let b = vector[0.0, -9.81]
    let r = Div(SymGrad(u)) + b
    let _ = r
}
