package Mechanics

/// Minimal continuum-kinematics helper: right Cauchy-Green tensor C = F^T F.
fn RightCauchyGreen2D(F: Matrix<Float>) -> Matrix<Float> {
    let i = Idx("i")
    let j = Idx("j")
    let k = Idx("k")

    return F[k, i] * F[k, j]
}

/// Minimal small-strain kinematics helper: eps = 0.5 * (gradU + gradU^T).
fn SmallStrain2D(gradU: Matrix<Float>) -> Matrix<Float> {
    return matrix[[
        gradU[0, 0],
        0.5 * (gradU[0, 1] + gradU[1, 0])
    ] [
        0.5 * (gradU[1, 0] + gradU[0, 1]),
        gradU[1, 1]
    ]]
}

/// First invariant I1 for a second-order tensor via explicit trace.
fn FirstInvariantI1(tensor: Matrix<Float>) -> Float {
    return Trace(tensor)
}

/// Isotropic small-strain shear modulus from engineering parameters.
/// mu = E / (2 * (1 + nu)).
fn MuFromYoungPoisson(E: Float, nu: Float) -> Float {
    return E / (2.0 * (1.0 + nu))
}

/// Isotropic 3D Lamé lambda from engineering parameters.
/// lambda = E * nu / ((1 + nu) * (1 - 2 * nu)).
fn LameLambdaFromYoungPoisson(E: Float, nu: Float) -> Float {
    return (E * nu) / ((1.0 + nu) * (1.0 - (2.0 * nu)))
}

/// Small-strain isotropic linear-elastic skeleton:
/// sigma = lambda * tr(eps) * I + 2 * mu * eps.
/// In 2D continuum usage this corresponds to a plane-strain constitutive slice.
fn LinearIsotropicStress2D(strain: Matrix<Float>, lambda: Float, mu: Float) -> Matrix<Float> {
    let identity = matrix[[1.0, 0.0] [0.0, 1.0]]
    let volumetric = FirstInvariantI1(strain)

    return (lambda * volumetric) * identity + (2.0 * mu) * strain
}

/// Effective in-plane Lamé coefficient for isotropic plane stress,
/// derived from 3D Lamé parameters by eliminating sigma_zz = 0.
fn PlaneStressLambda2D(lambda: Float, mu: Float) -> Float {
    return (2.0 * mu * lambda) / (lambda + (2.0 * mu))
}

/// Isotropic small-strain in-plane stress under plane strain assumption.
fn LinearIsotropicStressPlaneStrain2D(strain: Matrix<Float>, lambda: Float, mu: Float) -> Matrix<Float> {
    return LinearIsotropicStress2D(strain, lambda, mu)
}

/// Isotropic small-strain in-plane stress under plane stress assumption.
fn LinearIsotropicStressPlaneStress2D(strain: Matrix<Float>, lambda: Float, mu: Float) -> Matrix<Float> {
    return LinearIsotropicStress2D(strain, PlaneStressLambda2D(lambda, mu), mu)
}

/// Isotropic small-strain in-plane stress under plane strain assumption,
/// using explicit engineering parameters (E, nu).
fn LinearIsotropicStressPlaneStrain2DFromYoungPoisson(strain: Matrix<Float>, E: Float, nu: Float) -> Matrix<Float> {
    let lambda = LameLambdaFromYoungPoisson(E, nu)
    let mu = MuFromYoungPoisson(E, nu)

    return LinearIsotropicStressPlaneStrain2D(strain, lambda, mu)
}

/// Isotropic small-strain in-plane stress under plane stress assumption,
/// using explicit engineering parameters (E, nu).
fn LinearIsotropicStressPlaneStress2DFromYoungPoisson(strain: Matrix<Float>, E: Float, nu: Float) -> Matrix<Float> {
    let lambda = LameLambdaFromYoungPoisson(E, nu)
    let mu = MuFromYoungPoisson(E, nu)

    return LinearIsotropicStressPlaneStress2D(strain, lambda, mu)
}
