package Mechanics

[Fact]
fn VonMisesPlaneStressMatchesUniaxialAndCombinedCases() -> Void {
    let uniaxial = VonMisesPlaneStress(200000000.0kg/m/s^2, 0.0kg/m/s^2, 0.0kg/m/s^2)
    Assert.Near(200000000.0, uniaxial / 1kg/m/s^2, 0.01, "uniaxial von Mises should match axial stress")

    let pureShear = VonMisesPlaneStress(0.0kg/m/s^2, 0.0kg/m/s^2, 50000000.0kg/m/s^2)
    Assert.Near(86602540.378, pureShear / 1kg/m/s^2, 0.1, "pure shear von Mises should be sqrt(3)*tau")

    let combined = VonMisesPlaneStress(100000000.0kg/m/s^2, 40000000.0kg/m/s^2, 30000000.0kg/m/s^2)
    Assert.Near(101488915.65, combined / 1kg/m/s^2, 0.1, "combined plane-stress von Mises hand-check")
}

[Fact]
fn VonMisesFromPrincipalMatchesKnownCase() -> Void {
    let equivalent = VonMisesFromPrincipal(120000000.0kg/m/s^2, 60000000.0kg/m/s^2, 0.0kg/m/s^2)
    Assert.Near(103923048.45, equivalent / 1kg/m/s^2, 0.1, "principal-stress von Mises hand-check")
}

[Fact]
fn PrincipalStressesAndTrescaMatchPlanarCase() -> Void {
    let sigmaX = 100000000.0kg/m/s^2
    let sigmaY = 40000000.0kg/m/s^2
    let tau = 30000000.0kg/m/s^2

    let sigma1 = PrincipalStressMaxPlane(sigmaX, sigmaY, tau)
    let sigma2 = PrincipalStressMinPlane(sigmaX, sigmaY, tau)

    Assert.Near(112426406.87, sigma1 / 1kg/m/s^2, 0.1, "sigma1 hand-check")
    Assert.Near(27573593.13, sigma2 / 1kg/m/s^2, 0.1, "sigma2 hand-check")

    let tresca = MaximumShearStressTresca(sigma1, sigma2, 0.0kg/m/s^2)
    Assert.Near(56213203.44, tresca / 1kg/m/s^2, 0.1, "tresca max shear hand-check")
}

[Fact]
fn FactorOfSafetyHelpersComputeSimpleRatios() -> Void {
    let fos = FactorOfSafety(250000000.0kg/m/s^2, 125000000.0kg/m/s^2)
    Assert.Near(2.0, fos, 0.000001, "factor of safety ratio")

    let yieldFos = YieldFactorOfSafety(300000000.0kg/m/s^2, 150000000.0kg/m/s^2)
    Assert.Near(2.0, yieldFos, 0.000001, "yield factor of safety ratio")
}

[Fact]
fn InvalidActualStressReturnsZeroFactorOfSafety() -> Void {
    let fosZero = FactorOfSafety(250000000.0kg/m/s^2, 0.0kg/m/s^2)
    Assert.Near(0.0, fosZero, 0.000001, "zero actual stress guard")
}
