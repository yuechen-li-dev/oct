package Manifest

record PackageManifest {
    Name: String
    Version: String
    Description: String
    Dependencies: Dependency[]
}

record Dependency {
    Name: String
    VersionRequirement: String
}

fn Manifest() -> PackageManifest {
    return PackageManifest {
        Name: "Mechanics"
        Version: "0.5.0"
        Description: "Mechanics stress, failure, fatigue relations, endurance-limit modifiers, and notch fatigue concentration core"
        Dependencies: [Dependency { Name: "OctStd" VersionRequirement: "0.1.0" }]
    }
}
