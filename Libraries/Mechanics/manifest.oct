package Manifest

record PackageManifest {
    Name: String
    Version: String
    Description: String
    Authors: String[]
    Date: String
    Dependencies: Dependency[]
}

record Dependency {
    Name: String
    VersionRequirement: String
}

fn Manifest() -> PackageManifest {
    return PackageManifest {
        Name: "Mechanics"
        Version: "0.6.0"
        Authors: ["Codex", "Claude"]
        Date: "2026-08-23"
        Description: "Engineering mechanics: stress, failure, fatigue, shafts, continuum, beams, buckling, torsion, and thin-wall vessels"
        Dependencies: [Dependency { Name: "OctStd" VersionRequirement: "0.1.0" }, Dependency { Name: "Tensor2D" VersionRequirement: "0.1.0" }]
    }
}
