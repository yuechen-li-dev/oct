package Mechanics

/// Computes mean stress for a stress cycle.
fn MeanStress(maxStress: Float<kg/m/s^2>, minStress: Float<kg/m/s^2>) -> Float<kg/m/s^2> {
    return 0.5 * (maxStress + minStress)
}

/// Computes alternating stress amplitude for a stress cycle.
fn AlternatingStress(maxStress: Float<kg/m/s^2>, minStress: Float<kg/m/s^2>) -> Float<kg/m/s^2> {
    return 0.5 * Abs(maxStress - minStress)
}

/// Computes Goodman utilization for combined mean and alternating stress.
/// Remarks: Linear interaction model between endurance and ultimate strengths.
fn GoodmanUtilization(alternatingStress: Float<kg/m/s^2>, meanStress: Float<kg/m/s^2>, enduranceLimit: Float<kg/m/s^2>, ultimateStrength: Float<kg/m/s^2>) -> Float {
    Assert.True(enduranceLimit > 0kg/m/s^2, "GoodmanUtilization requires enduranceLimit > 0")
    Assert.True(ultimateStrength > 0kg/m/s^2, "GoodmanUtilization requires ultimateStrength > 0")
    return alternatingStress / enduranceLimit + meanStress / ultimateStrength
}

/// Returns fatigue factor of safety from Goodman utilization.
fn GoodmanFactorOfSafety(alternatingStress: Float<kg/m/s^2>, meanStress: Float<kg/m/s^2>, enduranceLimit: Float<kg/m/s^2>, ultimateStrength: Float<kg/m/s^2>) -> Float {
    let utilization = GoodmanUtilization(alternatingStress, meanStress, enduranceLimit, ultimateStrength)
    Assert.True(utilization > 0, "GoodmanFactorOfSafety requires utilization > 0")
    return 1.0 / utilization
}

/// Computes Gerber utilization with parabolic mean-stress correction.
/// Remarks: Typically less conservative than Goodman near high mean stress.
fn GerberUtilization(alternatingStress: Float<kg/m/s^2>, meanStress: Float<kg/m/s^2>, enduranceLimit: Float<kg/m/s^2>, ultimateStrength: Float<kg/m/s^2>) -> Float {
    Assert.True(enduranceLimit > 0kg/m/s^2, "GerberUtilization requires enduranceLimit > 0")
    Assert.True(ultimateStrength > 0kg/m/s^2, "GerberUtilization requires ultimateStrength > 0")
    let meanRatio = meanStress / ultimateStrength
    return alternatingStress / enduranceLimit + meanRatio * meanRatio
}

/// Returns fatigue factor of safety from Gerber utilization.
fn GerberFactorOfSafety(alternatingStress: Float<kg/m/s^2>, meanStress: Float<kg/m/s^2>, enduranceLimit: Float<kg/m/s^2>, ultimateStrength: Float<kg/m/s^2>) -> Float {
    let utilization = GerberUtilization(alternatingStress, meanStress, enduranceLimit, ultimateStrength)
    Assert.True(utilization > 0, "GerberFactorOfSafety requires utilization > 0")
    return 1.0 / utilization
}

/// Computes Soderberg utilization using yield-strength mean-stress limit.
/// Remarks: More conservative than Goodman and Gerber for ductile materials.
fn SoderbergUtilization(alternatingStress: Float<kg/m/s^2>, meanStress: Float<kg/m/s^2>, enduranceLimit: Float<kg/m/s^2>, yieldStrength: Float<kg/m/s^2>) -> Float {
    Assert.True(enduranceLimit > 0kg/m/s^2, "SoderbergUtilization requires enduranceLimit > 0")
    Assert.True(yieldStrength > 0kg/m/s^2, "SoderbergUtilization requires yieldStrength > 0")
    return alternatingStress / enduranceLimit + meanStress / yieldStrength
}

/// Returns fatigue factor of safety from Soderberg utilization.
fn SoderbergFactorOfSafety(alternatingStress: Float<kg/m/s^2>, meanStress: Float<kg/m/s^2>, enduranceLimit: Float<kg/m/s^2>, yieldStrength: Float<kg/m/s^2>) -> Float {
    let utilization = SoderbergUtilization(alternatingStress, meanStress, enduranceLimit, yieldStrength)
    Assert.True(utilization > 0, "SoderbergFactorOfSafety requires utilization > 0")
    return 1.0 / utilization
}
