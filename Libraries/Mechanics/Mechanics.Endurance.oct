package Mechanics

/// Multiplies Marin-style endurance modifiers into one combined factor.
/// Precondition: all modifier inputs must be positive.
fn EnduranceModifierProduct(surfaceFactor: Float, sizeFactor: Float, loadFactor: Float, temperatureFactor: Float, reliabilityFactor: Float) -> Float {
    Require(surfaceFactor > 0, "EnduranceModifierProduct requires surfaceFactor > 0")
    Require(sizeFactor > 0, "EnduranceModifierProduct requires sizeFactor > 0")
    Require(loadFactor > 0, "EnduranceModifierProduct requires loadFactor > 0")
    Require(temperatureFactor > 0, "EnduranceModifierProduct requires temperatureFactor > 0")
    Require(reliabilityFactor > 0, "EnduranceModifierProduct requires reliabilityFactor > 0")
    return surfaceFactor * sizeFactor * loadFactor * temperatureFactor * reliabilityFactor
}

/// Applies endurance modifiers to unmodified endurance limit.
fn DesignEnduranceLimit(unmodifiedEnduranceLimit: Float<kg/m/s^2>, surfaceFactor: Float, sizeFactor: Float, loadFactor: Float, temperatureFactor: Float, reliabilityFactor: Float) -> Float<kg/m/s^2> {
    Require(unmodifiedEnduranceLimit > 0kg/m/s^2, "DesignEnduranceLimit requires unmodifiedEnduranceLimit > 0")

    let modifier = EnduranceModifierProduct(surfaceFactor, sizeFactor, loadFactor, temperatureFactor, reliabilityFactor)
    return unmodifiedEnduranceLimit * modifier
}

/// Computes surface finish factor from ultimate strength via power-law fit.
/// Param a: Fit coefficient for finish/process.
/// Param b: Fit exponent for finish/process.
/// Remarks: Uses MPa-normalized ultimate strength in the correlation.
fn SurfaceFactorFromUltimateStrength(ultimateStrength: Float<kg/m/s^2>, a: Float, b: Float) -> Float {
    Require(ultimateStrength > 0kg/m/s^2, "SurfaceFactorFromUltimateStrength requires ultimateStrength > 0")
    Require(a > 0, "SurfaceFactorFromUltimateStrength requires a > 0")

    let sutMpa = ultimateStrength / 1000000kg/m/s^2
    return a * Pow(sutMpa, b)
}

/// Computes size factor from diameter ratio using a power-law model.
fn SizeFactorFromDiameter(diameter: Float<m>, referenceDiameter: Float<m>, exponent: Float) -> Float {
    Require(diameter > 0m, "SizeFactorFromDiameter requires diameter > 0")
    Require(referenceDiameter > 0m, "SizeFactorFromDiameter requires referenceDiameter > 0")

    let ratio = diameter / referenceDiameter
    return Pow(ratio, exponent)
}

/// Pass-through load factor with positivity guard.
fn LoadFactorDirect(loadFactor: Float) -> Float {
    Require(loadFactor > 0, "EnduranceModifierProduct requires loadFactor > 0")
    return loadFactor
}

/// Returns nominal Marin load factor for bending-dominated loading.
fn LoadFactorBending() -> Float {
    return 1.0
}

/// Returns nominal Marin load factor for axial loading.
fn LoadFactorAxial() -> Float {
    return 0.85
}

/// Returns nominal Marin load factor for torsional loading.
fn LoadFactorTorsion() -> Float {
    return 0.59
}

/// Pass-through temperature factor with positivity guard.
fn TemperatureFactorDirect(temperatureFactor: Float) -> Float {
    Require(temperatureFactor > 0, "EnduranceModifierProduct requires temperatureFactor > 0")
    return temperatureFactor
}

/// Approximates reliability factor from standard normal score.
/// Remarks: Linearized relation used as a simplified engineering fit.
fn ReliabilityFactorFromStandardScore(standardScore: Float) -> Float {
    let factor = 1.0 - 0.08 * standardScore
    Require(factor > 0, "ReliabilityFactorFromStandardScore requires resulting factor > 0")
    return factor
}

/// Returns tabulated reliability factor from target reliability percent.
/// Remarks: Piecewise constants follow common machine-design handbook values.
fn ReliabilityFactorFromPercent(reliabilityPercent: Float) -> Float {
    if reliabilityPercent < 0 {
        return 0
    }

    if reliabilityPercent <= 50.0 {
        return 1.0
    }
    if reliabilityPercent <= 90.0 {
        return 0.897
    }
    if reliabilityPercent <= 95.0 {
        return 0.868
    }
    if reliabilityPercent <= 99.0 {
        return 0.814
    }
    if reliabilityPercent <= 99.9 {
        return 0.753
    }
    if reliabilityPercent <= 99.99 {
        return 0.702
    }
    if reliabilityPercent <= 99.999 {
        return 0.659
    }
    if reliabilityPercent <= 99.9999 {
        return 0.620
    }

    return 0.0
}
