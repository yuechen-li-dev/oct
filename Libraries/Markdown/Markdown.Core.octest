package Markdown

import Artifact

record MetricsTable { Mode: String[] Method: String[] OutputSNRDb: String[] }
record ZeroTable { Metric: String[] Value: String[] }
record SmokeTable { Name: String[] Value: String[] }

[Fact]
fn MarkdownBlocksM0() -> Void {
    Assert.Equal("# Title", MarkdownH1("Title")[0], "h1")
    Assert.Equal("## Title", MarkdownH2("Title")[0], "h2")
    Assert.Equal("### Title", MarkdownH3("Title")[0], "h3")
    Assert.Equal("a b", MarkdownParagraph("a\nb")[0], "paragraph")
    Assert.Equal("", MarkdownBlank()[0], "blank")
    Assert.Equal("---", MarkdownHorizontalRule()[0], "hr")
    Assert.Equal("- a", MarkdownBullets(["a", "b"])[0], "bullets")
    Assert.Equal("2. b", MarkdownNumbered(["a", "b"])[1], "numbered")
    Assert.Equal("```oct", MarkdownCodeBlock("oct", ["let x = 1"])[0], "code open")
    Assert.Equal("a\\|b", MarkdownEscapeTableCell("a|b"), "escape cell")
}

[Fact]
fn MarkdownReportAndTablesM0() -> Void {
    let report = MarkdownReport([MarkdownH1("Title"), MarkdownParagraph("Intro"), MarkdownBullets(["a", "b"])])
    Assert.Equal(6, Len(report), "report length")
    Assert.Equal("", report[1], "report separator")

    let table = MetricsTable { Mode: ["Direct", "Direct", "PhaseFM"] Method: ["NoFilter", "Adaptive", "Adaptive"] OutputSNRDb: ["-1.59", "-1.67", "-2.85"] }
    let tableLines = MarkdownTable(table)
    Assert.Equal("| Mode | Method | OutputSNRDb |", tableLines[0], "table header")
    Assert.Equal("| Direct | NoFilter | -1.59 |", tableLines[2], "table row")

    let ordered = MarkdownTableWithColumns(table, ["OutputSNRDb", "Mode"])
    Assert.Equal("| OutputSNRDb | Mode |", ordered[0], "explicit order")

    let zero = ZeroTable { Metric: [] Value: [] }
    let zeroLines = MarkdownTable(zero)
    Assert.Equal(2, Len(zeroLines), "zero rows")
}

[Artifact]
fn MarkdownReportSmoke() -> Void {
    let table = SmokeTable { Name: ["alpha", "beta"] Value: ["1", "2"] }
    let report = MarkdownReport([MarkdownH1("Markdown Smoke"), MarkdownParagraph("Generated by Markdown M0."), MarkdownH2("Table"), MarkdownTable(table), MarkdownH2("Notes"), MarkdownBullets(["first", "second"])])
    Artifact.WriteMarkdown("markdown_smoke.md", report)
}
