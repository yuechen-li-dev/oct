package AuditStageOctGen

enum Shape {
    Vector
    Model
    Hidden
    Qkv
    Adaln
}

record StageSpec {
    Name: String
    Policy: String
    Source: String
    BaseShape: Shape
    BaseMultiplier: Int
    CountShape: Shape
    Layout: String
    Capture: String
    Lifetime: String
    ExtraKeys: Int[]
}

record AuditStage {
    ID: Int
    Name: String
    Policy: String
    Source: String
    Base: Int
    Count: Int
    Layout: String
    Capture: String
    Lifetime: String
    Keys: Int[]
}

record GeneratedAuditStages {
    Package: String
    Noise: AuditStage[]
    Context: AuditStage[]
}

fn CountOf(shape: Shape, vector: Int, model: Int, hidden: Int, adaln: Int) -> Int {
    return switch shape {
        case Shape.Vector => vector
        case Shape.Model => model
        case Shape.Hidden => hidden
        case Shape.Qkv => model * 3
        case Shape.Adaln => adaln
    }
}

fn HasKey(keys: Int[], candidate: Int) -> Bool {
    for i in 0..Len(keys) {
        if keys[i] == candidate {
            return true
        }
    }
    return false
}

fn AddKey(keys: Int[], count: Int, candidate: Int) -> Int[] {
    if candidate < 0 {
        return keys
    }
    if candidate >= count {
        return keys
    }
    if Len(keys) >= 15 {
        return keys
    }
    if HasKey(keys, candidate) {
        return keys
    }
    return Append(keys, candidate)
}

fn KeysFor(count: Int, extra: Int[]) -> Int[] {
    var keys = [0]
    keys = AddKey(keys, count, count - 1)
    keys = AddKey(keys, count, count / 2)
    for i in 0..Len(extra) {
        keys = AddKey(keys, count, extra[i])
    }
    return keys
}

fn BuildStage(spec: StageSpec, id: Int, vector: Int, model: Int, hidden: Int, adaln: Int) -> AuditStage {
    let count = CountOf(spec.CountShape, vector, model, hidden, adaln)
    let base = CountOf(spec.BaseShape, vector, model, hidden, adaln) * spec.BaseMultiplier
    return AuditStage {
        ID: id
        Name: spec.Name
        Policy: spec.Policy
        Source: spec.Source
        Base: base
        Count: count
        Layout: spec.Layout
        Capture: spec.Capture
        Lifetime: spec.Lifetime
        Keys: KeysFor(count, spec.ExtraKeys)
    }
}

fn BuildStages(specs: StageSpec[], vector: Int, model: Int, hidden: Int, adaln: Int) -> AuditStage[] {
    var stages = [BuildStage(specs[0], 1, vector, model, hidden, adaln)]
    for i in 1..Len(specs) {
        stages = Append(stages, BuildStage(specs[i], i + 1, vector, model, hidden, adaln))
    }
    return stages
}

fn Generate() -> GeneratedAuditStages {
    let noise = [
        StageSpec { Name: "timestep_linear" Policy: "Full" Source: "AdalnProjection" BaseShape: Shape.Vector BaseMultiplier: 0 CountShape: Shape.Adaln Layout: "Vector" Capture: "after_adaln" Lifetime: "before_attention_norm" ExtraKeys: [3839, 7680, 11519] },
        StageSpec { Name: "attention_scale_raw" Policy: "Full" Source: "AdalnProjection" BaseShape: Shape.Vector BaseMultiplier: 0 CountShape: Shape.Vector Layout: "Vector" Capture: "after_adaln" Lifetime: "before_attention_norm" ExtraKeys: [] },
        StageSpec { Name: "attention_scale_adjusted" Policy: "Full" Source: "AttentionScale" BaseShape: Shape.Vector BaseMultiplier: 0 CountShape: Shape.Vector Layout: "Vector" Capture: "after_adaln" Lifetime: "before_attention_norm" ExtraKeys: [] },
        StageSpec { Name: "attention_gate_raw" Policy: "Full" Source: "AdalnProjection" BaseShape: Shape.Vector BaseMultiplier: 1 CountShape: Shape.Vector Layout: "Vector" Capture: "after_adaln" Lifetime: "before_attention_residual" ExtraKeys: [] },
        StageSpec { Name: "attention_gate_tanh" Policy: "Full" Source: "AttentionGate" BaseShape: Shape.Vector BaseMultiplier: 0 CountShape: Shape.Vector Layout: "Vector" Capture: "after_adaln" Lifetime: "before_attention_residual" ExtraKeys: [] },
