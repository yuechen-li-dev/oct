        StageSpec { Name: "mlp_gate_raw" Policy: "Full" Source: "AdalnProjection" BaseShape: Shape.Vector BaseMultiplier: 3 CountShape: Shape.Vector Layout: "Vector" Capture: "after_adaln" Lifetime: "before_final_residual" ExtraKeys: [] },
        StageSpec { Name: "mlp_gate_tanh" Policy: "Full" Source: "MlpGate" BaseShape: Shape.Vector BaseMultiplier: 0 CountShape: Shape.Vector Layout: "Vector" Capture: "after_adaln" Lifetime: "before_final_residual" ExtraKeys: [] },
        StageSpec { Name: "attention_norm" Policy: "ProjectionAndSummary" Source: "NormAudit" BaseShape: Shape.Vector BaseMultiplier: 0 CountShape: Shape.Model Layout: "TokenChannel" Capture: "after_attention_norm" Lifetime: "before_qkv" ExtraKeys: [3839, 3928320] },
        StageSpec { Name: "attention_modulated" Policy: "ProjectionAndSummary" Source: "Modulated" BaseShape: Shape.Vector BaseMultiplier: 0 CountShape: Shape.Model Layout: "TokenChannel" Capture: "after_attention_norm" Lifetime: "before_qkv" ExtraKeys: [3839, 3928320] },
