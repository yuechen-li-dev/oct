        StageSpec { Name: "q_rope" Policy: "ProjectionAndSummary" Source: "Qkv" BaseShape: Shape.Vector BaseMultiplier: 0 CountShape: Shape.Model Layout: "TokenHeadChannel" Capture: "after_q_rope" Lifetime: "before_attention" ExtraKeys: [63, 64, 127, 128, 3928320] },
