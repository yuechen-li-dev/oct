profile Verilog

package Main

flow Counter(limit: Int) accepts enable: Bool yields Int -> Int {
    board {
        Count: Int
        Armed: Bool
    }

    state Count {
        board.Armed = enable
        if board.Armed {
            board.Count = board.Count + 1
        }
        when {
            case board.Count >= limit -> return board.Count
            else -> goto Emit
        }
    }

    state Emit {
        yield board.Count
        goto Count
    }
}

flow WaitOnce() -> Int {
    state Wait {
        suspend
        return 9
    }
}

flow SumFour() -> Int {
    board { Total: Int }
    state Run {
        for i in 0..4 {
            board.Total = board.Total + i
        }
        return board.Total
    }
}
