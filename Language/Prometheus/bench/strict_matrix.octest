package Main

[Benchmark]
fn MatrixMulCPUReferenceM0() -> Void {
    let a = Matrix.fill(2, 2, 3.0)
    let b = Matrix.fill(2, 2, 5.0)
    let c = a @ b
    Print(c)
}

[Benchmark]
fn MatrixMulPrometheusM0() -> Void {
    let a = Matrix.fill(2, 2, 3.0)
    let b = Matrix.fill(2, 2, 5.0)
    PROMETHEUS {
        let c = a @ b
        Print(c)
    }
}
