expect error: "function 'StaticAssert.Near' argument 2: fallible expression must be handled explicitly"

package Main

// An assertion on a value takes the value, not a fallible result. Assert.Equal,
// Assert.Near and Assert.False are test-file forms, so this contract is written
// with StaticAssert.Near, which is legal in ordinary source and shares their operand rule.
fn Reading() -> Float ! Error {
    return 7.0
}

fn Main() -> Void {
    StaticAssert.Near(7.0, Reading(), 0.1, "an assertion compares values, not results")
}
