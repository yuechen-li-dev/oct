[Fact]
fn ScalarAssertions() -> void {
    Assert.True(true, "ScalarAssertions must preserve its declared invariant");
    Assert.False(false, "ScalarAssertions must preserve its declared invariant");
    Assert.Equal(true, true, "ScalarAssertions must preserve its declared invariant");
    Assert.Equal(7, 7, "ScalarAssertions must preserve its declared invariant");
    Assert.Equal(7u, 7u, "ScalarAssertions must preserve its declared invariant");
    Assert.Equal(1.0, 1.0, "ScalarAssertions must preserve its declared invariant");
    Assert.NotEqual(7u, 8u, "ScalarAssertions must preserve its declared invariant");
    Assert.Near(1.0, 1.0001, 0.01, "ScalarAssertions must preserve its declared invariant");
}

[Theory]
[InlineData(1u, 2u)]
[InlineData(4u, 5u)]
fn TheoryArithmetic(value: u32, expected: u32) -> void {
    let result: u32 = value + 1u;
    Assert.Equal(expected, result, "TheoryArithmetic must preserve its declared invariant");
}
