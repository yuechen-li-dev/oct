type ModelEmbedding = float4 @space(zimage.noise_refiner.embedding);
type QueryHead = float4 @space(zimage.attention.query_head);
type KeyHead = float4 @space(zimage.attention.key_head);
type ValueHead = float4 @space(zimage.attention.value_head);
type PositionedQueryHead = float4 @space(zimage.attention.positioned_query_head);
type PositionedKeyHead = float4 @space(zimage.attention.positioned_key_head);
type AttentionScore = float4 @space(zimage.attention.score_value);
type AttentionProbability = float4 @space(zimage.attention.probability);

fn ProjectQuery(value: ModelEmbedding) -> QueryHead { return float4(value.x, value.y, value.z, value.w); }
fn ProjectKey(value: ModelEmbedding) -> KeyHead { return float4(value.x, value.y, value.z, value.w); }
fn ProjectValue(value: ModelEmbedding) -> ValueHead { return float4(value.x, value.y, value.z, value.w); }
fn ApplyQueryRoPE(value: QueryHead) -> PositionedQueryHead { return float4(value.x, value.y, value.z, value.w); }
fn ApplyKeyRoPE(value: KeyHead) -> PositionedKeyHead { return float4(value.x, value.y, value.z, value.w); }

fn Score(query: PositionedQueryHead, key: PositionedKeyHead) -> AttentionScore {
    return float4(query.x * key.x, query.y * key.y, query.z * key.z, query.w * key.w);
}

fn NormalizeScores(value: AttentionScore) -> AttentionProbability {
    let denominator: f32 = value.x + value.y + value.z + value.w;
    return float4(value.x / denominator, value.y / denominator, value.z / denominator, value.w / denominator);
}

fn AggregateValues(probability: AttentionProbability, value: ValueHead) -> ModelEmbedding {
    return float4(
        probability.x * value.x,
        probability.y * value.y,
        probability.z * value.z,
        probability.w * value.w
    );
}

fn AddResidual(left: ModelEmbedding, right: ModelEmbedding) -> ModelEmbedding {
    return float4(left.x + right.x, left.y + right.y, left.z + right.z, left.w + right.w);
}

[WorkgroupSize(1, 1, 1)]
[DispatchGroups(1, 1, 1)]
[Fact]
fn SemanticAttentionFlowExecutesAsOrdinaryArithmetic() -> void {
    let embedding: ModelEmbedding = float4(1.0, 2.0, 3.0, 4.0);
    let query: QueryHead = ProjectQuery(embedding);
    let key: KeyHead = ProjectKey(embedding);
    let value: ValueHead = ProjectValue(embedding);
    let attentionScore: AttentionScore = Score(ApplyQueryRoPE(query), ApplyKeyRoPE(key));
    let probability: AttentionProbability = NormalizeScores(attentionScore);
    let aggregated: ModelEmbedding = AggregateValues(probability, value);
    let output: ModelEmbedding = AddResidual(embedding, aggregated);
    Assert.Near(1.0333333, output.x, 0.00001, "semantic attention spaces must erase to ordinary arithmetic");
    Assert.Near(2.2666667, output.y, 0.00001, "semantic attention spaces must preserve the value aggregation result");
    Assert.Near(3.9, output.z, 0.00001, "semantic attention spaces must preserve the value aggregation result");
    Assert.Near(6.1333333, output.w, 0.00001, "semantic attention spaces must preserve the residual result");
}
