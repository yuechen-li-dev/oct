namespace Examples.SDSLV.M13;

shader M13IfDemo {
    stage compute [numthreads(1, 1, 1)] fn CS() -> void {
        comptime let UseFastPath: bool = true;

        comptime if UseFastPath {
            static assert UseFastPath == true;
            let scale: f32 = 1.0;
        } else {
            static assert false;
            let scale: f32 = 0.5;
        }
        return;
    }
}
