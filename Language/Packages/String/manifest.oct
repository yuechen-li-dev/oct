package Manifest

record PackageManifest {
    Name: String
    Version: String
    Description: String
    Authors: String[]
    Date: String
    Dependencies: Dependency[]
}

record Dependency {
    Name: String
    VersionRequirement: String
}

fn Manifest() -> PackageManifest {
    return PackageManifest {
        Name: "String"
        Version: "0.1.0"
        Description: "Marker package so that Language fixtures can import String; the functions are compiler-owned builtins"
        Authors: ["Claude"]
        Date: "2026-10-03"
        Dependencies: []
    }
}
