package MainValid

[Fact]
fn TraceReturnsScalarForSquareMatrix() -> Void {
    let a = matrix[[3, 2, 1] [4, 5, 6] [7, 8, 9]]
    let t = Trace(a)

    Assert.Equal(17, t, "trace-int")
}

[Fact]
fn TraceSupportsFloatMatrices() -> Void {
    let sigma = matrix[[2.0, 0.0] [1.0, 4.0]]
    let tr = Trace(sigma)

    Assert.Equal(6.0, tr, "trace-float")
}
