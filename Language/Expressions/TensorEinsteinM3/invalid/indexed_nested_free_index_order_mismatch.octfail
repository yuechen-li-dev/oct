expect error: "EinAdd requires matching free-index order on both terms (left=[i,j], right=[j,i])"

package Main

fn Main() -> Void {
    let i = Idx("i")
    let j = Idx("j")
    let k = Idx("k")

    let a = matrix[[1, 2] [3, 4]]
    let b = matrix[[5, 6] [7, 8]]

    let partial = a[i, k] * b[k, j]
    let _ = partial[i, j] + a[j, i]
}
