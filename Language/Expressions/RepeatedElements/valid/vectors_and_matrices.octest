package RepeatedElements

// `value ... count` is an element of a vector literal and of a matrix row,
// and `[row] ... count` repeats a row of a matrix literal.

fn Unit(n: Int) -> Vector<Float> {
    return vector[1.0 ... n]
}

fn Grid(rows: Int, cols: Int) -> Matrix<Float> {
    return matrix[[0.0 ... cols] ... rows]
}

[Fact]
fn VectorElements() -> Void {
    let v = vector[0.5 ... 3]
    Assert.Near(0.5, v[2], 0.001, "a counted element")
    let mixed = vector[1.0, 0.0 ... 2, 4.0]
    Assert.Near(0.0, mixed[2], 0.001, "a segment")
    Assert.Near(4.0, mixed[3], 0.001, "an element after it")
    Assert.Near(1.0, Unit(4)[3], 0.001, "a count known only when the program runs")
}

[Fact]
fn MatrixRowElements() -> Void {
    let m = matrix[[1.0 ... 3] [2.0, 3.0 ... 2]]
    Assert.Near(1.0, m[0, 2], 0.001, "a row of one value")
    Assert.Near(3.0, m[1, 2], 0.001, "a segment in a row")
}

[Fact]
fn RepeatedRows() -> Void {
    let m = matrix[[1.0, 2.0] ... 3]
    Assert.Near(2.0, m[2, 1], 0.001, "a row written once, three times")
    let zeros = Grid(2, 3)
    Assert.Near(0.0, zeros[1, 2], 0.001, "rows and columns counted when the program runs")
    var written = Grid(2, 2)
    written[0, 0] = 5.0
    Assert.Near(0.0, written[1, 0], 0.001, "each row is its own")
}

[Fact]
fn RowAfterARepeatedRow() -> Void {
    // The rows of a matrix literal follow one another with nothing between
    // them, so the `[` after a count starts the next row.
    let n = 2
    let m = matrix[[1.0, 0.0] [0.0 ... 2] ... n [5.0, 6.0]]
    Assert.Near(1.0, m[0, 0], 0.001, "the first row")
    Assert.Near(0.0, m[2, 1], 0.001, "the repeated row")
    Assert.Near(6.0, m[3, 1], 0.001, "the row after the count")
    let lines = matrix[
        [1.0 ... 2] ... n
        [5.0, 6.0]
    ]
    Assert.Near(5.0, lines[2, 0], 0.001, "the same on separate lines")
}

[Fact]
fn RowCountThatIndexesIsParenthesized() -> Void {
    let counts = [2, 1]
    let m = matrix[[1.0, 0.0] ... (counts[0]) [5.0, 6.0] ... (counts[1])]
    Assert.Near(0.0, m[1, 1], 0.001, "the first count")
    Assert.Near(5.0, m[2, 0], 0.001, "the second count")
}

fn VectorTotal(v: Vector<Float>) -> Float {
    var total = 0.0
    for i in 0..Len(v) {
        total = total + v[i]
    }
    return total
}

[Fact]
fn ZeroCountGivesAnEmptyVectorOrMatrix() -> Void {
    // The element still names the type, as it does for an array.
    let none = vector[0.5 ... 0]
    Assert.Equal(0, Len(none), "a constant zero")
    let unit = Unit(0)
    Assert.Equal(0, Len(unit), "a zero count when the program runs")
    Assert.Near(0.0, VectorTotal(unit), 0.001, "it is a Vector<Float>")
    let tail = vector[1.0 ... 0, 4.0]
    Assert.Equal(1, Len(tail), "a zero-count segment adds nothing")
    let noRows = Grid(0, 3)
    let noColumns = Grid(2, 0)
    Assert.True(true, "a matrix may have no rows, or rows with no elements")
}
