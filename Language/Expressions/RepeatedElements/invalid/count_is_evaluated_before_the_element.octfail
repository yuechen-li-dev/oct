expect runtime error: "runtime error: repeat count must not be negative, got -1"

package Main

// The count comes first, so its error is the one reported.
fn Unreachable() -> Int ! Error {
    return error("the element was evaluated")
}

fn Count(n: Int) -> Int {
    return n
}

fn Main() -> Int {
    let values = [Unreachable()! ... Count(-1)]
    return 0
}
