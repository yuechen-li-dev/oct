expect runtime error: "runtime error: array literal has 3 elements before `...` and its length is fixed at 2"

package Main

record table Marks {
    Value: Float
    Valid: Bool
}

fn Count(n: Int) -> Int {
    return n
}

fn Main() -> Int {
    let values = [1.0 ... Count(2)]
    let marks = Marks {
        Value: values
        Valid: [true, false, true, false ...]
    }
    return 0
}
