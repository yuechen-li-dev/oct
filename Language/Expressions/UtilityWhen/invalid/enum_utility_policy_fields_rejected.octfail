expect error: "`when utility` keeps no commitment between evaluations, so it takes no policy fields"

package Main

enum Mode {
    Idle
    Run
}

// The enum-targeted form is a one-shot choice too, and takes no policy block.
fn Main() -> Int {
    let mode = when utility Mode {
        hysteresis: 7
        min_commit: 3
    } {
        case Mode.Run when true score 10
        else Mode.Idle
    }
    return 0
}
