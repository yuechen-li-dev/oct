package MainValid

[Fact]
fn IndexedEinsteinSubtractsMatchingFreeIndexTerms() -> Void {
    let i = Idx("i")
    let j = Idx("j")

    let a = matrix[[10, 20] [30, 40]]
    let b = matrix[[1, 2] [3, 4]]

    let c = a[i, j] - b[i, j]

    Assert.Equal(9, c[0, 0], "c00")
    Assert.Equal(18, c[0, 1], "c01")
    Assert.Equal(27, c[1, 0], "c10")
    Assert.Equal(36, c[1, 1], "c11")
}

[Fact]
fn IndexedEinsteinSubtractionComposesWithMultiplication() -> Void {
    let i = Idx("i")
    let j = Idx("j")
    let k = Idx("k")

    let a = matrix[[1, 2] [3, 4]]
    let b = matrix[[5, 6] [7, 8]]
    let correction = matrix[[1, 2] [3, 4]]

    let c = (a[i, k] * b[k, j]) - correction[i, j]

    Assert.Equal(18, c[0, 0], "c00")
    Assert.Equal(20, c[0, 1], "c01")
    Assert.Equal(40, c[1, 0], "c10")
    Assert.Equal(46, c[1, 1], "c11")
}

[Fact]
fn IndexedEinsteinSubtractionComposesWithAddition() -> Void {
    let i = Idx("i")
    let j = Idx("j")

    let a = matrix[[10, 20] [30, 40]]
    let b = matrix[[1, 2] [3, 4]]
    let d = matrix[[2, 4] [6, 8]]

    let c = a[i, j] + b[i, j] - d[i, j]

    Assert.Equal(9, c[0, 0], "c00")
    Assert.Equal(18, c[0, 1], "c01")
    Assert.Equal(27, c[1, 0], "c10")
    Assert.Equal(36, c[1, 1], "c11")
}

[Fact]
fn IndexedEinsteinSubtractionSupportsReindexedIntermediate() -> Void {
    let i = Idx("i")
    let j = Idx("j")

    let a = matrix[[10, 20] [30, 40]]
    let b = matrix[[1, 2] [3, 4]]

    let partial = a[i, j] - b[i, j]
    let again = partial[i, j] + b[i, j]

    Assert.Equal(10, again[0, 0], "again00")
    Assert.Equal(20, again[0, 1], "again01")
    Assert.Equal(30, again[1, 0], "again10")
    Assert.Equal(40, again[1, 1], "again11")
}
