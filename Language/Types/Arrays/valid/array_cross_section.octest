package MainValid

record Sample {
    Value: Float
}

enum Mode {
    Slow
    Fast
}

[Fact]
fn ArrayCrossSectionForms() -> Void {
    let samples = [10, 20, 30, 40, 50]

    let copy = Array.CrossSection(samples, ..)
    Assert.Equal(5, Len(copy), "cross section copy-all length")
    Assert.Equal(10, copy[0], "cross section copy-all first")
    Assert.Equal(50, copy[4], "cross section copy-all last")

    let prefix = Array.CrossSection(samples, ..3)
    Assert.Equal(3, Len(prefix), "cross section prefix length")
    Assert.Equal(10, prefix[0], "cross section prefix first")
    Assert.Equal(30, prefix[2], "cross section prefix last")

    let suffix = Array.CrossSection(samples, 2..)
    Assert.Equal(3, Len(suffix), "cross section suffix length")
    Assert.Equal(30, suffix[0], "cross section suffix first")
    Assert.Equal(50, suffix[2], "cross section suffix last")

    let middle = Array.CrossSection(samples, 1..4)
    Assert.Equal(3, Len(middle), "cross section middle length")
    Assert.Equal(20, middle[0], "cross section middle first")
    Assert.Equal(40, middle[2], "cross section middle last")

    let decimated = Array.CrossSection(samples, 0..5 step 2)
    Assert.Equal(3, Len(decimated), "cross section step length")
    Assert.Equal(10, decimated[0], "cross section step first")
    Assert.Equal(30, decimated[1], "cross section step middle")
    Assert.Equal(50, decimated[2], "cross section step last")
}

[Fact]
fn ArrayCrossSectionCopySemantics() -> Void {
    var source = [1, 2, 3, 4]
    var part = Array.CrossSection(source, 1..3)
    part[0] = 99
    Assert.Equal(2, source[1], "cross section result mutation does not mutate source")
    Assert.Equal(99, part[0], "cross section result mutation applies to result")

    source[1] = 77
    Assert.Equal(99, part[0], "cross section source mutation after copy does not mutate result")
    Assert.Equal(77, source[1], "cross section source mutation applies to source")
}

[Fact]
fn ArrayCrossSectionPreservesExactElementTypes() -> Void {
    let temps: Float<K>[] = [290.0K, 291.0K, 292.0K]
    let tempWindow = Array.CrossSection(temps, 1..)
    Assert.Equal(2, Len(tempWindow), "cross section unit length")
    Assert.Equal(291.0K, tempWindow[0], "cross section unit first")

    let samples = [Sample { Value: 1.0 }, Sample { Value: 2.0 }]
    let sampleWindow = Array.CrossSection(samples, 1..)
    Assert.Equal(2.0, sampleWindow[0].Value, "cross section record field")

    let modes = [Mode.Slow, Mode.Fast, Mode.Slow]
    let modeWindow = Array.CrossSection(modes, ..2)
    Assert.True(modeWindow[1] == Mode.Fast, "cross section enum element")
}
