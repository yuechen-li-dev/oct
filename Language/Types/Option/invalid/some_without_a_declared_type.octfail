expect error: "`Option.Some(...)` does not say which Option it is, and nothing here declares it; declare the type where the value goes (`let x: Option<T> = Option.Some(...)`), or write `Option<T>.Some(...)`"

package Main

fn Main() -> Float {
    let level = Option.Some(1.5)
    return match level {
        case Option.Some(v) => v
        case Option.None => 0.0
    }
}
