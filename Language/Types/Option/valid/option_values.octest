package OptionTypes

record Reading {
    Station: String
    Level: Option<Float>
}

enum Shape {
    Dot
    Circle(Float)
}

fn Half(value: Int) -> Option<Int> {
    if value % 2 == 0 {
        return Option.Some(value / 2)
    }
    return Option.None
}

fn OrZero(value: Option<Int>) -> Int {
    return match value {
        case Option.Some(v) => v
        case Option.None => 0
    }
}

fn Describe(value: Option<String>) -> String {
    return match value {
        case Option.None => "nothing"
        case Option.Some(text) => text
    }
}

fn IsNone(value: Option<Int>) -> Bool {
    return switch value {
        case Option.None => true
        else => false
    }
}

[Fact]
fn ATypedBindingDecidesWhichOptionItIs() -> Void {
    let some: Option<Int> = Option.Some(42)
    let none: Option<Int> = Option.None
    Assert.Equal(42, OrZero(some), "Some carries its payload")
    Assert.Equal(0, OrZero(none), "None carries nothing")
}

[Fact]
fn TheTypeArgumentCanBeWritten() -> Void {
    let some = Option<Int>.Some(7)
    let none = Option<Int>.None
    Assert.Equal(7, OrZero(some), "Option<Int>.Some(7) is an Option<Int>")
    Assert.Equal(0, OrZero(none), "Option<Int>.None is an Option<Int>")
}

[Fact]
fn AParameterDecidesWhichOptionItIs() -> Void {
    Assert.Equal(5, OrZero(Option.Some(5)), "the parameter type decides")
    Assert.Equal(0, OrZero(Option.None), "the parameter type decides for None")
    Assert.Equal("text", Describe(Option.Some("text")), "a String payload")
    Assert.Equal("nothing", Describe(Option.None), "a String option that is None")
}

[Fact]
fn AResultTypeDecidesWhichOptionItIs() -> Void {
    Assert.Equal(4, OrZero(Half(8)), "Half(8) is Some(4)")
    Assert.Equal(0, OrZero(Half(7)), "Half(7) is None")
}

[Fact]
fn OptionsCompareWithEquality() -> Void {
    let some: Option<Int> = Option.Some(3)
    let none: Option<Int> = Option.None
    Assert.True(some == Option.Some(3), "equal payloads are equal")
    Assert.True(some != Option.Some(4), "different payloads are unequal")
    Assert.True(some != Option.None, "Some is not None")
    Assert.True(none == Option.None, "None is None")
    Assert.True(Option.None == none, "the typed side may be on the right")
    Assert.True(Half(6) == some, "two typed options compare")
    Assert.False(none == some, "None is not Some")
}

[Fact]
fn ASwitchOverAnOptionSelectsOnNone() -> Void {
    Assert.True(IsNone(Option.None), "None is selected by its label")
    Assert.False(IsNone(Option.Some(1)), "Some falls to else")
}

[Fact]
fn ARecordFieldDecidesWhichOptionItIs() -> Void {
    let wet = Reading { Station: "A" Level: Option.Some(1.5) }
    let dry = Reading { Station: "B" Level: Option.None }
    let wetLevel = match wet.Level {
        case Option.Some(level) => level
        case Option.None => -1.0
    }
    let dryLevel = match dry.Level {
        case Option.Some(level) => level
        case Option.None => -1.0
    }
    Assert.Equal(1.5, wetLevel, "the field holds Some(1.5)")
    Assert.Equal(-1.0, dryLevel, "the field holds None")
    let refilled = dry with { Level: Option.Some(2.5) }
    Assert.True(refilled.Level == Option.Some(2.5), "`with` replaces an option field")
    Assert.True(dry.Level == Option.None, "the original record is unchanged")
}

[Fact]
fn AnArrayElementTypeDecidesWhichOptionItIs() -> Void {
    var values: Option<Int>[] = [Option.Some(1), Option.None, Option.Some(3)]
    var total = 0
    for i in 0..Len(values) {
        total = total + OrZero(values[i])
    }
    Assert.Equal(4, total, "1 + 0 + 3")
    values[1] = Option.Some(10)
    Assert.Equal(10, OrZero(values[1]), "an element assignment takes the element type")
    values = Append(values, Option<Int>.None)
    Assert.Equal(4, Len(values), "a written type argument works where no type is declared")
}

[Fact]
fn AnAssignmentTakesTheTypeOfItsVariable() -> Void {
    var current: Option<Int> = Option.None
    Assert.Equal(0, OrZero(current), "starts as None")
    current = Option.Some(9)
    Assert.Equal(9, OrZero(current), "assigned Some(9)")
    current = Option.None
    Assert.Equal(0, OrZero(current), "assigned None")
    var inferred = Half(8)
    Assert.Equal(4, OrZero(inferred), "a variable whose type was inferred from a call")
    inferred = Option.None
    Assert.Equal(0, OrZero(inferred), "an assignment takes that inferred type")
    inferred = Option.Some(6)
    Assert.Equal(6, OrZero(inferred), "for Some as for None")
}

[Fact]
fn BranchesPassTheDeclaredTypeAlong() -> Void {
    let flag = true
    let chosen: Option<Int> = if flag { Option.Some(1) } else { Option.None }
    Assert.Equal(1, OrZero(chosen), "the if expression yields Some(1)")
    let mapped: Option<Int> = match chosen {
        case Option.Some(v) => Option.Some(v + 1)
        case Option.None => Option.None
    }
    Assert.Equal(2, OrZero(mapped), "the match arms take the declared type")
    let grouped: Option<Int> = (Option.Some(5))
    Assert.Equal(5, OrZero(grouped), "parentheses pass the type along")
}

[Fact]
fn APayloadCanBeARecordAnEnumOrAnArray() -> Void {
    let reading: Option<Reading> = Option.Some(Reading { Station: "C" Level: Option.None })
    let station = match reading {
        case Option.Some(r) => r.Station
        case Option.None => ""
    }
    Assert.Equal("C", station, "a record payload")

    let shape: Option<Shape> = Option.Some(Shape.Circle(2.0))
    let radius = match shape {
        case Option.Some(s) => match s {
            case Shape.Circle(r) => r
            case Shape.Dot => 0.0
        }
        case Option.None => -1.0
    }
    Assert.Equal(2.0, radius, "an enum payload")

    let list: Option<Int[]> = Option.Some([1, 2, 3])
    let count = match list {
        case Option.Some(items) => Len(items)
        case Option.None => 0
    }
    Assert.Equal(3, count, "an array payload")
}

[Fact]
fn AnOptionOfAnOptionNests() -> Void {
    let inner: Option<Option<Int>> = Option.Some(Option.Some(4))
    let hollow: Option<Option<Int>> = Option.Some(Option.None)
    let nothing: Option<Option<Int>> = Option.None
    Assert.True(inner != hollow, "Some(Some(4)) is not Some(None)")
    Assert.True(hollow != nothing, "Some(None) is not None")
    let value = match inner {
        case Option.Some(o) => OrZero(o)
        case Option.None => -1
    }
    Assert.Equal(4, value, "the nested payload is reached by two matches")
}

[Fact]
fn ADeclaredFloatPayloadIsAFloat() -> Void {
    let level: Option<Float> = Option.Some(1)
    let halved = match level {
        case Option.Some(v) => v / 2
        case Option.None => 0.0
    }
    Assert.Equal(0.5, halved, "Some(1) in an Option<Float> holds 1.0")
}

[Fact]
fn AnEnumPayloadCanBeAnOption() -> Void {
    let level: Option<Float<m>> = Option.Some(2.0m)
    let doubled = match level {
        case Option.Some(v) => v * 2.0
        case Option.None => 0.0m
    }
    Assert.Equal(4.0m, doubled, "a dimensioned payload keeps its dimension")
}

fn Double(value: Int) -> Int {
    return value * 2
}

fn HalfOfSecond(direction: Option<Vector<Float>>) -> Float {
    return match direction {
        case Option.Some(v) => v[1] / 2
        case Option.None => 0.0
    }
}

fn HalfOfCorner(grid: Option<Matrix<Float>>) -> Float {
    return match grid {
        case Option.Some(m) => m[1, 0] / 2
        case Option.None => 0.0
    }
}

fn ApplyOr(step: Option<fn(Int) -> Int>, value: Int) -> Int {
    return match step {
        case Option.Some(apply) => apply(value)
        case Option.None => value
    }
}

[Fact]
fn APayloadCanBeAVectorAMatrixOrAFunction() -> Void {
    let direction: Option<Vector<Float>> = Option.Some(vector[1, 3])
    let second = match direction {
        case Option.Some(v) => v[1] / 2
        case Option.None => 0.0
    }
    Assert.Equal(1.5, second, "a vector payload, which is a Vector<Float>")
    Assert.Equal(2.5, HalfOfSecond(Option.Some(vector[1, 5])), "the same as an argument")

    let grid: Option<Matrix<Float>> = Option.Some(matrix[[1, 2] [3, 4]])
    let corner = match grid {
        case Option.Some(m) => m[1, 0] / 2
        case Option.None => 0.0
    }
    Assert.Equal(1.5, corner, "a matrix payload, which is a Matrix<Float>")
    Assert.Equal(3.5, HalfOfCorner(Option.Some(matrix[[1, 2] [7, 4]])), "the same as an argument")

    let step: Option<fn(Int) -> Int> = Option.Some(Double)
    let stepped = match step {
        case Option.Some(apply) => apply(4)
        case Option.None => 0
    }
    Assert.Equal(8, stepped, "a function payload")
    Assert.Equal(10, ApplyOr(Option.Some(Double), 5), "the same as an argument")
    Assert.Equal(5, ApplyOr(Option.None, 5), "and None of that option")
}

[Fact]
fn OptionsWithArrayPayloadsCompareByValue() -> Void {
    let pair: Option<Int[]> = Option.Some([1, 2])
    Assert.True(pair == Option.Some([1, 2]), "equal arrays make equal options")
    Assert.True(pair != Option.Some([1, 3]), "a different element makes them unequal")
    Assert.True(pair != Option.Some([1, 2, 3]), "a different length makes them unequal")
    Assert.True(pair != Option.None, "Some of an array is not None")
    let nested: Option<Option<Int[]>> = Option.Some(pair)
    Assert.True(nested == Option.Some(Option.Some([1, 2])), "equality reaches through a nested option")
    let rows: Option<Int[][]> = Option.Some([[1], [2, 3]])
    Assert.True(rows == Option.Some([[1], [2, 3]]), "and through nested arrays")
    Assert.True(rows != Option.Some([[1], [2, 4]]), "to the last element")
    let empty: Option<Int[]> = Option.Some([])
    Assert.True(empty == Option.Some([]), "an empty array payload takes its element type from the option")
    Assert.True(empty != Option.None, "Some of an empty array is not None")
    let names: Option<String[]> = Option.Some([])
    let grown = match names {
        case Option.Some(values) => Append(values, "first")
        case Option.None => ["none"]
    }
    Assert.Equal(1, Len(grown), "an empty payload of an Option<String[]> is a String[]")
    Assert.Equal("first", grown[0], "and holds what is appended to it")
}

[Fact]
fn OptionsOfEachScalarCompareByValue() -> Void {
    let level: Option<Float> = Option.Some(1.5)
    Assert.True(level == Option.Some(1.5), "equal Floats")
    Assert.True(level != Option.Some(2.5), "different Floats")
    let flag: Option<Bool> = Option.Some(true)
    Assert.True(flag == Option.Some(true), "equal Bools")
    Assert.True(flag != Option.Some(false), "different Bools")
    let name: Option<String> = Option.Some("a")
    Assert.True(name == Option.Some("a"), "equal Strings")
    Assert.True(name != Option.Some("b"), "different Strings")
    let phase: Option<Complex> = Option.Some(Complex(1.5, 0.5))
    Assert.True(phase == Option.Some(Complex(1.5, 0.5)), "equal Complex values")
    Assert.True(phase != Option.Some(Complex(1.5, 2.5)), "different Complex values")
    let whole: Option<Complex> = Option.Some(2)
    Assert.True(whole == Option.Some(Complex(2.0, 0.0)), "Some(2) in an Option<Complex> holds a Complex")
}

record Choice {
    Label: String
    Weight: Int
}

fn LabelOf(Option: Choice) -> String {
    return Option.Label
}

// `Option` is not a reserved word. Where a parameter or a local has the
// name, `Option.Label` reads a field of it; the type `Option<T>` is the
// builtin everywhere, and so is `Option.None` once the value is out of scope.
[Fact]
fn AValueNamedOptionIsThatValue() -> Void {
    Assert.Equal("a", LabelOf(Choice { Label: "a" Weight: 2 }), "a parameter named Option is read as a value")
    if true {
        let Option = Choice { Label: "b" Weight: 3 }
        Assert.Equal(3, Option.Weight, "and so is a local")
        let held: Option<Int> = Half(8)
        Assert.Equal(4, OrZero(held), "the type Option<Int> is the builtin while a value has the name")
        let none = switch held {
            case Option.None => true
            else => false
        }
        Assert.False(none, "a case label names the variant, never the value")
    }
    let after: Option<Int> = Option.None
    Assert.True(after == Option.None, "after the block the name is the builtin again")
}
