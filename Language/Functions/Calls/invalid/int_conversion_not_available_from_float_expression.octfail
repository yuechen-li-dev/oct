expect error: "Int(...) is not a conversion in Oct because float-to-int conversion must choose a rounding policy explicitly. Use FloorToInt(x), CeilToInt(x), or RoundToInt(x). For sample counts, FloorToInt(sampleRate * duration) is usually intended."

package Main

fn Main() -> Int {
    let sampleRate = 44100.0
    let duration = 0.5
    return Int(sampleRate * duration)
}
