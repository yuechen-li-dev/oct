package Main

fn Main() -> Void {
    Require(true, "should pass")

    Assert.Error(RequireFail(), "Require(false, ...) should raise runtime error")
    Assert.Error(RollDieGuard(1), "require message should surface")
}

fn RequireFail() -> Int ! Error {
    Require(false, "expected failure")
    return 0
}

fn RollDieGuard(sides: Int) -> Int ! Error {
    Require(sides >= 2, "RollDie requires sides >= 2")
    return sides
}
