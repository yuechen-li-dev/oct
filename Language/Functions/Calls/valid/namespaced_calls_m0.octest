package MainValid

import String

// The String namespace and the global spelling name the same builtin.
// Namespaced IO, Csv and Json calls run wrapper sidecars and write files, so
// they are covered under Libraries/IO and Libraries/ArtifactUsage.
[Fact]
fn StringJoinNamespaced() -> Void {
    Assert.Equal("a,b", String.Join(["a", "b"], ","), "String.Join should resolve via namespace alias")
    Assert.Equal("a,b", Join(["a", "b"], ","), "global Join should remain available")
}
