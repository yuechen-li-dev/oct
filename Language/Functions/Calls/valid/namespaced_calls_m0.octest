package MainValid

import String

// The String namespace and the global spelling name the same builtin.
// Namespaced IO, Csv, Json and Markdown calls are library contracts: they
// need an import that a Language fixture cannot resolve, and they are covered
// under Libraries/IO, Libraries/ArtifactUsage and Libraries/Markdown.
[Fact]
fn StringJoinNamespaced() -> Void {
    Assert.Equal("a,b", String.Join(["a", "b"], ","), "String.Join should resolve via namespace alias")
    Assert.Equal("a,b", Join(["a", "b"], ","), "global Join should remain available")
}
