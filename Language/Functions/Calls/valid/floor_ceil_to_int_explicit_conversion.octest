package MainValid

[Fact]
fn FloorCeilToIntExplicitConversion() -> Void {
    Assert.Equal(2, FloorToInt(2.9), "FloorToInt rounds a positive value down")
    Assert.Equal(2, FloorToInt(2.0), "FloorToInt keeps a whole value")
    Assert.Equal(0 - 3, FloorToInt(0.0 - 2.1), "FloorToInt rounds a negative value toward negative infinity")

    Assert.Equal(3, CeilToInt(2.1), "CeilToInt rounds a positive value up")
    Assert.Equal(2, CeilToInt(2.0), "CeilToInt keeps a whole value")
    Assert.Equal(0 - 2, CeilToInt(0.0 - 2.9), "CeilToInt rounds a negative value toward zero")
}
