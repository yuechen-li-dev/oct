package Main

import String

[Fact]
fn StringConcatAndFromM0() -> Void {
    Assert.Equal("abc", String.Concat(["a", "b", "c"]), "concat in order")
    var emptyParts: String[] = []
    Assert.Equal("", String.Concat(emptyParts), "concat empty")
    Assert.Equal("0", String.From<Int>(0), "from zero int")
    Assert.Equal("-42", String.From<Int>(-42), "from negative int")
    Assert.Equal("3.5", String.From<Float>(3.5), "from simple float")
    Assert.Equal("0", String.From<Float>(0.0), "from zero float")
    Assert.Equal("true", String.From<Bool>(true), "from bool true")
    Assert.Equal("false", String.From<Bool>(false), "from bool false")
    Assert.Equal("abc", String.From<String>("abc"), "from string identity")
    return
}
