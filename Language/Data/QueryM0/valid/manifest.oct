package Manifest

record PackageManifest {
    Name: String
    Version: String
    Description: String
    Authors: String[]
    Date: String
    Dependencies: Dependency[]
}

record Dependency {
    Name: String
    VersionRequirement: String
}

fn Manifest() -> PackageManifest {
    return PackageManifest {
        Name: "QueryM0Valid"
        Version: "0.1.0"
        Description: "FLOW-backed bounded read-only query algebra contracts"
        Authors: ["Codex"]
        Date: "2026-08-22"
        Dependencies: [Dependency { Name: "OctStd" VersionRequirement: "0.1.0" }]
    }
}
