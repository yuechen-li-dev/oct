package Manifest

record PackageManifest {
    Name: String
    Version: String
    Description: String
    Dependencies: Dependency[]
}

record Dependency {
    Name: String
    VersionRequirement: String
}

fn Manifest() -> PackageManifest {
    return PackageManifest {
        Name: "OctagonEmissionValid"
        Version: "0.1.0"
        Description: "Valid contracts for WriteOctagon artifact emission"
        Dependencies: [Dependency {
            Name: "OctStd"
            VersionRequirement: "0.1.0"
        }]
    }
}
