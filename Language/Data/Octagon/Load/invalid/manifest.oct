package Manifest

record PackageManifest {
    Name: String
    Version: String
    Description: String
    Dependencies: Dependency[]
}

record Dependency {
    Name: String
    VersionRequirement: String
}

fn Manifest() -> PackageManifest {
    return PackageManifest {
        Name: "OctagonLoadInvalid"
        Version: "0.1.0"
        Description: "Invalid contracts for LoadOctagon typed runtime load"
        Dependencies: [Dependency {
            Name: "OctStd"
            VersionRequirement: "0.1.0"
        }]
    }
}
