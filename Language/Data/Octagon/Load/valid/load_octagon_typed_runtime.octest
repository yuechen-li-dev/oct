package OctagonLoadValid

record SimulationConfig {
    Name: String
    Dt: Float<s>
    Steps: Int
}

record SamplesConfig {
    Name: String
    Samples: Float<m>[]
}

record SignedSamplesConfig {
    Offset: Float
    Samples: Float[]
}

enum SolverMode {
    Explicit
    Implicit
}

[Fact]
fn LoadScalar() -> Void ! Error {
    let value = LoadOctagon<Int>("Language/Data/Octagon/valid/scalar_literal.octagon")?
    Assert.Equal(42, value, "scalar load")
}

[Fact]
fn LoadDimensionedScalar() -> Void ! Error {
    let value = LoadOctagon<Float<m/s^2>>("Language/Data/Octagon/valid/dimensioned_scalar_literal.octagon")?
    Assert.Equal(9.81m/s^2, value, "dimensioned scalar load")
}

[Fact]
fn LoadArray() -> Void ! Error {
    let value = LoadOctagon<Int[]>("Language/Data/Octagon/valid/array_of_scalars.octagon")?
    Assert.Equal(3, Len(value), "array length")
    Assert.Equal(2, value[1], "array element")
}

[Fact]
fn LoadRecord() -> Void ! Error {
    let value = LoadOctagon<SimulationConfig>("Language/Data/Octagon/valid/record_literal.octagon")?
    Assert.Equal("Cantilever", value.Name, "record field")
    Assert.Equal(1000, value.Steps, "record int field")
}

[Fact]
fn LoadEnum() -> Void ! Error {
    let value = LoadOctagon<SolverMode>("Language/Data/Octagon/valid/enum_value.octagon")?
    Assert.Equal(SolverMode.Explicit, value, "enum load")
}

[Fact]
fn LoadNestedRecordArrayEnum() -> Void ! Error {
    let samples = LoadOctagon<SamplesConfig>("Language/Data/Octagon/Load/valid/samples_config.octagon")?
    let mode = LoadOctagon<SolverMode>("Language/Data/Octagon/valid/enum_value.octagon")?
    Assert.Equal(SolverMode.Explicit, mode, "nested enum load")
    Assert.Equal(3, Len(samples.Samples), "nested array field")
}

enum PublicationStatus {
    Draft
    Published
}

concept PositivePrice = Float {
    Require(Self > 0.0, "price must be positive")
}

record table PublicationCatalog {
    ID: Int
    Status: PublicationStatus
    Price: PositivePrice
    Name: String
}

[Fact]
fn LoadSignedNumericData() -> Void ! Error {
    let values = LoadOctagon<SignedSamplesConfig>("Language/Data/Octagon/Load/valid/signed_samples_config.octagon")?
    Assert.Near(-0.5, values.Offset, 0.0000001, "signed scalar field")
    Assert.Near(-1.25, values.Samples[0], 0.0000001, "signed array float")
    Assert.Near(2.0, values.Samples[1], 0.0000001, "positive array float")
}

[Fact]
fn LoadNominalRecordTableWithEnumAndRefinementCells() -> Void ! Error {
    let catalog = LoadOctagon<PublicationCatalog>("Language/Data/Octagon/Load/valid/publication_catalog.octagon")?
    Assert.Equal(3, Len(catalog), "nominal table materializes column storage")
    Assert.Equal(PublicationStatus.Published, catalog[1].Status, "enum cells retain nominal identity")
    Assert.True(catalog[2].Price == 2.5, "refined cells are admitted by their Concept")
    Assert.Equal("Alpha", catalog[0].Name, "ordinary cells share the same materialization path")
}
