package MainValid

[Fact]
fn ContinuumM0KinematicsAndInvariantSurface() -> Void {
    let i = Idx("i")
    let j = Idx("j")
    let k = Idx("k")

    let F = matrix[[1.1, 0.2] [0.0, 0.95]]
    let C = F[k, i] * F[k, j]
    let I1 = Trace(C)

    Assert.Near(1.21, C[0, 0], 0.000001, "C00")
    Assert.Near(0.9425, C[1, 1], 0.000001, "C11")
    Assert.Near(2.1525, I1, 0.000001, "I1")
}
