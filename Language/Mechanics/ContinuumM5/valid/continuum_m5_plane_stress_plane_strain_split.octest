package MainValid

fn PlaneStressLambda2D(lambda: Float, mu: Float) -> Float {
    return (2.0 * mu * lambda) / (lambda + (2.0 * mu))
}

fn LinearIsotropicStress2D(strain: Matrix<Float>, lambda: Float, mu: Float) -> Matrix<Float> {
    let identity = Matrix.identity[Float](2)
    let volumetric = Trace(strain)

    return (lambda * volumetric) * identity + (2.0 * mu) * strain
}

fn PlaneStrainStress2D(strain: Matrix<Float>, lambda: Float, mu: Float) -> Matrix<Float> {
    return LinearIsotropicStress2D(strain, lambda, mu)
}

fn PlaneStressStress2D(strain: Matrix<Float>, lambda: Float, mu: Float) -> Matrix<Float> {
    return LinearIsotropicStress2D(strain, PlaneStressLambda2D(lambda, mu), mu)
}

[Fact]
fn ContinuumM5PlaneStressAndPlaneStrainConstitutiveSplitIsExpressible() -> Void {
    let u = vector[0.12, -0.03]
    let eps = SymGrad(u)

    let lambda = 120.0
    let mu = 80.0

    let sigmaPlaneStrain = PlaneStrainStress2D(eps, lambda, mu)
    let sigmaPlaneStress = PlaneStressStress2D(eps, lambda, mu)

    let _ = sigmaPlaneStrain
    let _ = sigmaPlaneStress
}

[Fact]
fn ContinuumM5PlaneStressStrongFormSliceRemainsDirect() -> Void {
    let u = vector[0.11, -0.04]
    let lambda = 120.0
    let mu = 80.0
    let b = vector[0.0, -9.81]

    let r = Div(PlaneStressStress2D(SymGrad(u), lambda, mu)) + b
    let _ = r
}
