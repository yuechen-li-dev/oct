package MainValid

record Body2D {
    Width: Float
    Height: Float
}

record MaterialModel {
    E: Float
    Nu: Float
    Assumption: String
}

record Load2D {
    Kind: String
    Fx: Float
    Fy: Float
}

record Constraint2D {
    Kind: String
    Edge: String
    Ux: Float
    Uy: Float
}

record ContinuumProblem2D {
    BodyWidth: Float
    BodyHeight: Float
    Assumption: String
    E: Float
    Nu: Float
    UnknownFieldName: String
    UnknownFieldKind: String
    LoadKind: String
    BodyForceFx: Float
    BodyForceFy: Float
    ConstraintKind: String
    FixedEdge: String
    FixedUx: Float
    FixedUy: Float
    GoverningRelation: String
    Query: String
}

record BoundaryProbeResult {
    Category: String
    Missing: String
    Why: String
}

fn MuFromYoungPoisson(E: Float, nu: Float) -> Float {
    return E / (2.0 * (1.0 + nu))
}

fn LameLambdaFromYoungPoisson(E: Float, nu: Float) -> Float {
    return (E * nu) / ((1.0 + nu) * (1.0 - (2.0 * nu)))
}

fn PlaneStressLambda2D(lambda: Float, mu: Float) -> Float {
    return (2.0 * mu * lambda) / (lambda + (2.0 * mu))
}

fn LinearIsotropicStress2D(strain: Matrix<Float>, lambda: Float, mu: Float) -> Matrix<Float> {
    let identity = matrix[[1.0, 0.0] [0.0, 1.0]]
    return ((lambda * Trace(strain)) * identity) + ((2.0 * mu) * strain)
}

fn StressFromMaterial(strain: Matrix<Float>, material: MaterialModel) -> Matrix<Float> {
    let lambda = LameLambdaFromYoungPoisson(material.E, material.Nu)
    let mu = MuFromYoungPoisson(material.E, material.Nu)

    if material.Assumption == "PlaneStress" {
        return LinearIsotropicStress2D(strain, PlaneStressLambda2D(lambda, mu), mu)
    }

    return LinearIsotropicStress2D(strain, lambda, mu)
}

fn ProbeComputability(problem: ContinuumProblem2D) -> BoundaryProbeResult {
    if problem.Query == "SolveForField" {
        return BoundaryProbeResult {
            Category: "Computational"
            Missing: "MissingFiniteLowering"
            Why: "Problem is representable and specified, but solving for u over the body requires finite computational lowering."
        }
    }

    return BoundaryProbeResult {
        Category: "None"
        Missing: "None"
        Why: "Residual can be formed for a concrete candidate field using existing continuum operators."
    }
}

fn TinyCantileverProblem(query: String) -> ContinuumProblem2D {
    return ContinuumProblem2D {
        BodyWidth: 2.0
        BodyHeight: 1.0
        Assumption: "PlaneStress"
        E: 210000000000.0
        Nu: 0.30
        UnknownFieldName: "u"
        UnknownFieldKind: "Displacement"
        LoadKind: "BodyForce"
        BodyForceFx: 0.0
        BodyForceFy: -1000.0
        ConstraintKind: "DisplacementFixed"
        FixedEdge: "Left"
        FixedUx: 0.0
        FixedUy: 0.0
        GoverningRelation: "LinearMomentumBalance"
        Query: query
    }
}

[Fact]
fn ContinuumBoundaryM0RepresentationAndProblemSpecificationAreExpressible() -> Void {
    let problem = TinyCantileverProblem("SolveForField")

    Assert.Equal(2.0, problem.BodyWidth, "body width")
    Assert.Equal(1.0, problem.BodyHeight, "body height")
    Assert.Equal("Displacement", problem.UnknownFieldKind, "unknown kind")
    Assert.Equal("BodyForce", problem.LoadKind, "load kind")
    Assert.Equal("DisplacementFixed", problem.ConstraintKind, "constraint kind")
    Assert.Equal("Left", problem.FixedEdge, "left edge fixed")
    Assert.Equal("SolveForField", problem.Query, "query intent")
}

[Fact]
fn ContinuumBoundaryM0ResidualFormExistsForCandidateField() -> Void {
    let problem = TinyCantileverProblem("ResidualAtCandidateField")
    let material = MaterialModel { E: problem.E Nu: problem.Nu Assumption: problem.Assumption }
    let load = Load2D { Kind: problem.LoadKind Fx: problem.BodyForceFx Fy: problem.BodyForceFy }
    let _ = Constraint2D { Kind: problem.ConstraintKind Edge: problem.FixedEdge Ux: problem.FixedUx Uy: problem.FixedUy }
    let _ = Body2D { Width: problem.BodyWidth Height: problem.BodyHeight }

    let uCandidate = vector[0.001, -0.0004]
    let residual = Div(StressFromMaterial(SymGrad(uCandidate), material)) + vector[load.Fx, load.Fy]
    let _ = residual

    let boundary = ProbeComputability(problem)
    Assert.Equal("None", boundary.Category, "residual query does not require finite lowering")
    Assert.Equal("None", boundary.Missing, "no missing capability for residual formation")
}

[Fact]
fn ContinuumBoundaryM0SolveQueryHitsComputabilityBoundary() -> Void {
    let problem = TinyCantileverProblem("SolveForField")

    let boundary = ProbeComputability(problem)
    Assert.Equal("Computational", boundary.Category, "boundary category")
    Assert.Equal("MissingFiniteLowering", boundary.Missing, "first missing capability")
}
