package Main

[Fact]
fn GenericWrapperM6ScalarListBytesAndVoid() -> Void ! Error {
    Assert.Equal("hello", EchoString("hello")?, "String wrapper should echo")
    Assert.Equal("a,b", JoinStrings(["a", "b"])?, "String[] wrapper should join")
    let bytes = Random.CryptoRandBytes(4)?
    Assert.Equal(4, BytesLen(bytes)?, "Bytes wrapper should return length")
    Assert.Equal(5, AddInt(2, 3)?, "Int wrapper should add")
    Assert.Near(4.0, Half(8.0)?, 0.000001, "Float wrapper should halve")
    Assert.Near(4.5, SumFloats([1.0, 2.5, 1.0])?, 0.000001, "Float[] wrapper should sum")
    Assert.Equal("demo:7", DescribeOptions(TestOptions { Count: 7 Name: "demo" })?, "record argument wrapper should preserve fields")
    let returnedOptions = ReturnOptions()?
    Assert.Equal(11, returnedOptions.Count, "record return wrapper should preserve Int fields")
    Assert.Equal("returned", returnedOptions.Name, "record return wrapper should preserve String fields")
    Assert.False(Not(true)?, "Bool wrapper should invert")
    let rows = EchoStringRows([["a", "b"], ["c"]])?
    Assert.Equal(2, Len(rows), "String[][] wrapper should preserve outer row count")
    Assert.Equal("b", rows[0][1], "String[][] wrapper should preserve cells")
    Assert.Equal(1, Len(rows[1]), "String[][] wrapper should preserve ragged rows")
    let emptyRows: String[][] = []
    Assert.Equal(0, RowCount(emptyRows)?, "String[][] wrapper should preserve empty outer arrays")
    match Touch() {
        ok(value) => {
            Assert.True(true, "Void wrapper should succeed")
        }
        err(e) => {
            Assert.True(false, "Void wrapper should succeed")
        }
    }
    TouchDirect()
    Assert.True(true, "non-fallible Void wrapper should continue execution")
    let handle = CreateHandle()
    Assert.True(handle.Handle > 0, "handle return should reconstruct public record")
    Assert.Equal(handle.Handle, UseHandle(handle)?, "handle arg should pass typed handle to sidecar")
}

[Fact]
fn GenericWrapperM6SidecarErrorPropagates() -> Void ! Error {
    match AlwaysFails() {
        ok(value) => {
            Assert.True(false, value)
        }
        err(e) => {
            Assert.True(true, "sidecar error should propagate through fallible result")
        }
    }
}
