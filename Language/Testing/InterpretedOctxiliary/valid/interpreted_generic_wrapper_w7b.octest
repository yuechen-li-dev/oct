package Main

[Fact]
fn InterpretedGenericWrapperW7bSuccess() -> Void ! Error {
    Assert.Equal("hello", EchoString("hello")?, "String raw wrapper should echo through public function")
    let bytes = Entropy.Bytes(5)?
    Assert.Equal(5, ByteLength(bytes)?, "Bytes raw wrapper should return length")
    Assert.False(BoolNot(true)?, "Bool raw wrapper should invert")
}

[Fact]
fn InterpretedGenericWrapperW7bSidecarError() -> Void ! Error {
    match NotOk() {
        ok(value) => {
            Assert.True(false, value)
        }
        err(e) => {
            Assert.True(true, "sidecar error should propagate as Error")
        }
    }
}

[Fact]
[Interpreted("the interpreted lane runs the source body of a function the manifest also names; the compiled lane lowers that name to the sidecar call")]
fn InterpretedGenericWrapperW7bSourcePrecedence() -> Void ! Error {
    Assert.Equal("source:value", ShadowRaw("value")?, "source function should take precedence over manifest raw metadata")
}
