expect artifact error: "not statically discoverable: provider attempted effectful operation Json.Save"

package Main

concept NativeComputeRequest { Package: String Wrapper: String Operation: String }
concept ArtifactCapabilityRequest { Native: NativeComputeRequest[] }

// Capability discovery must be static. A provider that writes a file is
// rejected before the write happens. `Json.Text` writes no file and is not
// rejected.
fn Capabilities() -> ArtifactCapabilityRequest {
    let text = Json.Text([1, 2, 3])
    Json.Save("wrappers.json", [text])!
    return ArtifactCapabilityRequest { Native: [] }
}

[Artifact(Capabilities)]
fn Emit() -> Void { return }
