package Main

concept NativeComputeRequest {Package: String Wrapper: String Operation: String}
concept ArtifactCapabilityRequest {Native: NativeComputeRequest[]}

// Capability discovery must be static. A provider that reads the operating
// system's random source is rejected before the read happens.
fn Capabilities() -> ArtifactCapabilityRequest {
    let seed = Entropy.Seed() !
    return ArtifactCapabilityRequest {Native:[]}
}

[Artifact(Capabilities)]
fn Emit() -> Void {return}
