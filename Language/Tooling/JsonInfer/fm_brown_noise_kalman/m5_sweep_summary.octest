package JsonInferFmBrownNoiseKalman

// What `oct json infer Experiments/FmBrownNoiseKalman/M5/sweep_summary.json` --name M5SweepSummary
// prints, pasted as it is, and the document loaded with it. The tests of
// internal/jsoninfer hold the command to the lines between here and the fact.

concept M5SweepSummary {
    TotalCases: Int
    ScalarAdaptiveWin: Int
    WindowedAdaptiveWin: Int
    WindowedBetterRecovery: Int
    WindowedBetterWhiteness: Int
}

// Json.Load<M5SweepSummary>("Experiments/FmBrownNoiseKalman/M5/sweep_summary.json")?

[Fact]
fn M5SweepSummaryLoads() -> Void ! Error {
    let loaded = Json.Load<M5SweepSummary>("Experiments/FmBrownNoiseKalman/M5/sweep_summary.json")?
    Assert.Equal(27, loaded.TotalCases, "the case count")
    Assert.Equal(11, loaded.ScalarAdaptiveWin, "a count")
}
