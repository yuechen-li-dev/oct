package Manifest

record PackageManifest {
    Name: String
    Version: String
    Description: String
    Authors: String[]
    Date: String
    Dependencies: Dependency[]
}

record Dependency {
    Name: String
    VersionRequirement: String
}

fn Manifest() -> PackageManifest {
    return PackageManifest {
        Name: "AsyncM0Invalid"
        Version: "0.1.0"
        Description: "diagnostic contracts for bounded ASYNC-M0"
        Authors: ["Codex"]
        Date: "2026-09-14"
        Dependencies: []
    }
}
