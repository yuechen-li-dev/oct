package Manifest

record PackageManifest {
    Name: String
    Version: String
    Description: String
    Authors: String[]
    Date: String
    Dependencies: Dependency[]
}

record Dependency {
    Name: String
    VersionRequirement: String
}

fn Manifest() -> PackageManifest {
    return PackageManifest {
        Name: "AsyncM0Valid"
        Version: "0.1.0"
        Description: "async fn and await lowering to ordinary Octomata FLOW"
        Authors: ["Codex"]
        Date: "2026-09-14"
        Dependencies: [Dependency { Name: "OctStd" VersionRequirement: "0.1.0" }]
    }
}
