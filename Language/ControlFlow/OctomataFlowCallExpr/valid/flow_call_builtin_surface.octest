package Main

flow CallBuiltinFlow() -> Float {
    board {
        X: Float
        I: Int
    }
    state Start {
        board.X = Abs(0.0 - 2.5)
        board.I = FloorToInt(3.9)
        board.X = Sqrt(4.0) + 1.0
        return board.X
    }
}

flow LenFlow(xs: Float[]) -> Int {
    board {
        Count: Int
    }
    state Start {
        board.Count = Len(xs)
        return board.Count
    }
}

flow LenStringFlow() -> Int {
    board {
        Count: Int
    }
    state Start {
        board.Count = Len("abc")
        return board.Count
    }
}

flow FloatBuiltinFlow(count: Int, total: Int) -> Float {
    board {
        Count: Int
        Total: Int
        Ratio: Float
        Score: Float
    }
    state Start {
        let base = Float(count)
        board.Count = count
        board.Total = total
        board.Ratio = Float(board.Count) / Float(board.Total)
        board.Score = Clamp01(Float(board.Count) / 10.0)
        return base + board.Ratio + board.Score
    }
}

[Fact]
fn FlowBuiltinCallExprCompiled() -> Void {
    let machine = CallBuiltinFlow()
    Step(machine)
    let out = Assert.LGTM(Result(machine), "result should be available after step")
    Assert.Equal(3.0, out, "flow builtin call expression should evaluate")
}

[Fact]
fn FlowLenCallExprCompiled() -> Void {
    let machine = LenFlow([1.0, 2.0, 3.0])
    Step(machine)
    let out = Assert.LGTM(Result(machine), "result should be available after len step")
    Assert.Equal(3, out, "flow len call expression should evaluate for arrays")
}

[Fact]
fn FlowLenStringCallExprCompiled() -> Void {
    let machine = LenStringFlow()
    Step(machine)
    let out = Assert.LGTM(Result(machine), "result should be available after string len step")
    Assert.Equal(3, out, "flow len call expression should evaluate for strings")
}

[Fact]
fn FlowFloatBuiltinCallExprCompiled() -> Void {
    let machine = FloatBuiltinFlow(4, 5)
    Step(machine)
    let out = Assert.LGTM(Result(machine), "result should be available after float conversion step")
    Assert.Near(5.2, out, 0.000001, "flow Float(Int) conversion should evaluate in let, assignment, return, and nested expressions")
}
