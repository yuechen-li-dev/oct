package MainValid

flow BoardDeclLoop(tempHigh: Bool) -> String {
    board {
        FaultLatched: Bool
        CooldownTicks: Int
        LastTemp: Float
        Label: String
    }

    state Tick {
        if tempHigh {
            board.FaultLatched = true
            board.CooldownTicks = 2
            board.LastTemp = 99.5
            board.Label = "fault"
            goto Fault
        }

        if board.CooldownTicks > 0 {
            board.CooldownTicks = board.CooldownTicks - 1
            return "cooldown"
        }

        return board.Label
    }

    state Fault {
        return board.Label
    }
}

[Fact]
fn DeclaredBoardDefaultsAndMutationsWork() -> Void {
    let nominal = BoardDeclLoop(false)
    Step(nominal)
    let nominalResult = Assert.LGTM(Result(nominal), "nominal run should return")
    Assert.Equal("", nominalResult, "String board fields should default to empty")

    let fault = BoardDeclLoop(true)
    Step(fault)
    let faultResult = Assert.LGTM(Result(fault), "fault run should return")
    Assert.Equal("fault", faultResult, "mutated board fields should persist across goto")
}
