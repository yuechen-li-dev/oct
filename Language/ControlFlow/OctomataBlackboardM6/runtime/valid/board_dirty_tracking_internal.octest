package MainValid

record Board {
    DisplayMode: String
    AlertStatus: String
}

flow TouchBoard(board: Board) -> Board {
    state Start {
        board.DisplayMode = "Fault"
        board.AlertStatus = "Fault"
        return board
    }
}

[Fact]
fn BoardFlowReturnsMutatedBoardFields() -> Void {
    let f = TouchBoard(Board { DisplayMode: "Trend" AlertStatus: "Normal" })
    Step(f)

    let value = Assert.LGTM(Result(f), "TouchBoard should complete successfully")
    Assert.Equal("Fault", value.DisplayMode, "board display should be mutable only in flow")
    Assert.Equal("Fault", value.AlertStatus, "board alert should be mutable only in flow")
}
