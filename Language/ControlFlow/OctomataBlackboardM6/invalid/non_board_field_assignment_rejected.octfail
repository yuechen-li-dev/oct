expect error: "function Sample: inside flow state bodies, field assignment is only supported on `board`, e.g. `board.Count = board.Count + 1`; ordinary records are immutable and must use `with`"

package MainInvalid

record Board {
    FaultLatched: Bool
}

flow Sample(board: Board) -> Int {
    state Start {
        let snapshot = board
        snapshot.FaultLatched = true
        return 1
    }
}
