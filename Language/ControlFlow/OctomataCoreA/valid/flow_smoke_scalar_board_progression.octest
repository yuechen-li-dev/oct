package MainValid

flow FlowSmokeScalarBoard() -> Int {
    board {
        Counter: Int
        Done: Bool
    }

    state Start {
        board.Counter = 1
        goto Finish
    }

    state Finish {
        board.Done = true
        return board.Counter
    }
}

[Fact]
fn FlowSmokeScalarBoardProgression() -> Void {
    let run = FlowSmokeScalarBoard()
    Step(run)
    Assert.True(Complete(run), "flow smoke should complete")
    Assert.Equal(1, Result(run)!, "flow smoke result should be deterministic")
    Assert.True(Len(StateHistory(run)) >= 1, "state history should be available for smoke debugging")
}
