package MainValid

flow DoneFlow() -> Int {
    state Start {
        return 7
    }
}

[Fact]
fn ResultUnwrapAfterGuaranteedCompletion() -> Void {
    let machine = DoneFlow()
    Step(machine)
    let result = Result(machine)!
    Assert.Equal(7, result, "Result(machine)! after guaranteed completion")
}
