package MainValid

flow OneSuspend() -> Int {
    state Start {
        suspend
        return 7
    }
}

[Fact]
fn ResultBeforeCompletionIsErrorAndStepCompletedIsNoop() -> Void {
    let f = OneSuspend()
    var sawPreCompletionError = false

    Assert.Error(Result(f), "Result should fail before completion")
    sawPreCompletionError = true
    Assert.True(sawPreCompletionError, "Result returns error before completion")

    Step(f)
    Assert.Equal("Start", Active(f), "flow suspended in Start")

    Step(f)
    Assert.Equal("", Active(f), "flow completed after second step")

    Step(f)
    Assert.Equal("", Active(f), "stepping completed flow is a no-op")

    let value = Assert.LGTM(Result(f), "Result should remain available")
    Assert.Equal(7, value, "completed flow keeps result")
}
