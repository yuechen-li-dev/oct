package MainValid

flow PatrolLoop(limit: Int) -> Int {
    state Search {
        goto Track
    }

    state Track {
        suspend
        return limit
    }
}

[Fact]
fn PatrolRuntimeProgression() -> Void {
    let f = PatrolLoop(2)

    Step(f)
    Assert.Equal("Track", Active(f), "first step transitions into Track and suspends")

    Step(f)
    Assert.Equal("", Active(f), "second step resumes Track and returns")

    let value = Assert.LGTM(Result(f), "Result should succeed once completed")
    Assert.Equal(2, value, "result captured after multi-state progression")
}
