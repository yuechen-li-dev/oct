package MainValid

flow PatrolGoto(input: Int) -> Int {
    state Search {
        if input > 0 {
            goto Track
        }
        suspend
    }

    state Track {
        suspend
        return input
    }
}

[Fact]
fn GotoTransitionsWithinSingleStep() -> Void {
    let f = PatrolGoto(3)

    Step(f)
    Assert.Equal("Track", Active(f), "goto transitions to Track during same step")

    Step(f)
    Assert.Equal("", Active(f), "second step completes flow")

    let value = Assert.LGTM(Result(f), "Result should be available after completion")
    Assert.Equal(3, value, "flow returns value from Track state")
}
