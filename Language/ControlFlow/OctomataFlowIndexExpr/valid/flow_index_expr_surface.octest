package Main

flow Pick(xs: Float[]) -> Float {
    board {
        Index: Int
        Value: Float
    }
    state Start {
        board.Index = 1
        board.Value = xs[board.Index]
        return board.Value
    }
}

flow PickPlus(xs: Float[]) -> Float {
    board {
        Index: Int
        Value: Float
    }
    state Start {
        board.Index = 1
        board.Value = xs[board.Index] + 1.0
        return board.Value
    }
}

flow PickInt(xs: Int[]) -> Int {
    board {
        Index: Int
        Value: Int
    }
    state Start {
        board.Index = 2
        board.Value = xs[board.Index]
        return board.Value
    }
}

[Fact]
fn FlowIndexExprFloat() -> Void {
    Step(Pick([1.0, 2.5, 9.0]))
    Assert.True(true, "flow index expr should execute float branch")
}

[Fact]
fn FlowIndexExprFloatWithArithmetic() -> Void {
    Step(PickPlus([1.0, 2.5, 9.0]))
    Assert.True(true, "flow index expr with arithmetic should execute")
}

[Fact]
fn FlowIndexExprInt() -> Void {
    Step(PickInt([3, 5, 8, 13]))
    Assert.True(true, "flow index expr should execute int branch")
}
