package MainValid

flow Ordered(input: Int) -> Int {
    state Start {
        when {
            case input > 10 -> return 10
            case input > 0 -> return 1
            else -> return 0
        }
    }
}

[Fact]
fn MultipleCasesCompiles() -> Void {
    Assert.Equal(1, 1, "ordered when cases are accepted")
}
