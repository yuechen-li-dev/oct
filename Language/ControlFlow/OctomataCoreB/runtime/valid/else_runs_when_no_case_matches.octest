package MainValid

flow ElseFallback(input: Int) -> Int {
    state Start {
        when {
            case input > 0 -> return 1
            case input < 0 -> return 0 - 1
            else -> return 7
        }
    }
}

[Fact]
fn ElseRunsWhenNoCaseMatches() -> Void {
    let f = ElseFallback(0)
    Step(f)
    let value = Assert.LGTM(Result(f), "result should be available")
    Assert.Equal(7, value, "else should execute when no case matches")
}
