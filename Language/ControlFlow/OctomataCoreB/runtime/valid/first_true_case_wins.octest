package MainValid

flow Prioritized() -> Int {
    state Start {
        when {
            case true -> return 1
            case true -> return 2
            else -> return 3
        }
    }
}

[Fact]
fn FirstTrueCaseWins() -> Void {
    let f = Prioritized()
    Step(f)
    let value = Assert.LGTM(Result(f), "result should be available")
    Assert.Equal(1, value, "first true case should win")
}
