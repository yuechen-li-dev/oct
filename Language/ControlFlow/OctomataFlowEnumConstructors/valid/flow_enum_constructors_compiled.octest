package Main

enum ShadowOutcome {
    Match
    Late(Float)
}

flow FlowFromTagOnly() -> Float {
    board {
        Value: Float
    }

    state Start {
        let fromTag = ShadowOutcome.Match
        let resolved = match fromTag {
            case ShadowOutcome.Match => 1.0
            case ShadowOutcome.Late(ticks) => ticks
        }
        board.Value = resolved
        return board.Value
    }
}

flow FlowFromPayloadLet() -> Float {
    board {
        Value: Float
    }

    state Start {
        let outcome = ShadowOutcome.Late(5.0)
        let resolved = match outcome {
            case ShadowOutcome.Late(ticks) => ticks
            case ShadowOutcome.Match => 0.0
        }
        board.Value = resolved
        return board.Value
    }
}

flow FlowFromPayloadDirectSubject() -> Float {
    board {
        Value: Float
    }

    state Start {
        let resolved = match ShadowOutcome.Late(3.0) {
            case ShadowOutcome.Late(ticks) => ticks
            case ShadowOutcome.Match => 0.0
        }
        board.Value = resolved
        return board.Value
    }
}

flow FlowAssignmentAndBoardFieldAccess() -> Float {
    board {
        Value: Float
    }

    state Start {
        let outcome = ShadowOutcome.Late(4.0)
        board.Value = match outcome {
            case ShadowOutcome.Late(ticks) => ticks + 1.0
            case ShadowOutcome.Match => 0.0
        }
        return board.Value
    }
}

[Fact]
fn FlowEnumConstructorTagOnlyInFlowExpr() -> Void {
    let machine = FlowFromTagOnly()
    Step(machine)
    let out = Result(machine)!
    Assert.True(out == 1.0, "tag-only variant should resolve")
}

[Fact]
fn FlowEnumConstructorPayloadInLet() -> Void {
    let machine = FlowFromPayloadLet()
    Step(machine)
    let out = Result(machine)!
    Assert.True(out == 5.0, "payload let should preserve payload")
}

[Fact]
fn FlowEnumConstructorPayloadAsMatchSubject() -> Void {
    let machine = FlowFromPayloadDirectSubject()
    Step(machine)
    let out = Result(machine)!
    Assert.True(out == 3.0, "direct constructor match should preserve payload")
}

[Fact]
fn FlowEnumConstructorAssignmentAndBoardFieldAccess() -> Void {
    let machine = FlowAssignmentAndBoardFieldAccess()
    Step(machine)
    let out = Result(machine)!
    Assert.True(out == 5.0, "board field access should remain distinct from enum constructor access")
}
