package MainValid

flow MinCommitExpires() -> Int {
    state Decide {
        var t = 0
        var last = 0
        while true {
            last = when policy {
                hysteresis: 0
                min_commit: 3
            } {
                case 1 when true score 60
                case 2 when t > 0 score 90
                else 0
            }
            if t == 3 {
                return last
            }
            t = t + 1
        }
    }
}

[Fact]
fn MinCommitExpiryAllowsLaterSwitch() -> Void {
    let f = MinCommitExpires()
    Step(f)
    match Result(f) {
        ok(value) => { Assert.Equal(2, value, "choice may switch after min_commit horizon") }
        err(e) => { Assert.True(false, "result should be available") }
    }
}
