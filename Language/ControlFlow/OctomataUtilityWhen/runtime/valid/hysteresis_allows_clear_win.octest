package MainValid

flow HysteresisSwitch() -> Int {
    state Decide {
        var t = 0
        var last = 0
        while true {
            last = when policy {
                hysteresis: 8
                min_commit: 1
            } {
                case 1 when true score 60
                case 2 when t > 0 score 71
                else 0
            }
            if t == 1 {
                return last
            }
            t = t + 1
        }
    }
}

[Fact]
fn HysteresisAllowsSwitchWhenMarginExceeded() -> Void {
    let f = HysteresisSwitch()
    Step(f)
    let value = Assert.LGTM(Result(f), "result should be available")
    Assert.Equal(2, value, "challenger above hysteresis margin should replace current")
}
