package MainValid

// `hysteresis` is the lead a rival needs over the committed arm's recorded
// score. A lead equal to `hysteresis` does not end the commitment; a lead of
// one more does. `min_commit` is 1 in both flows, so it holds nothing at the
// second evaluation.

flow LeadEqualToHysteresis() -> Int {
    state Decide {
        var t = 0
        var last = 0
        while true {
            last = when policy {
                hysteresis: 5
                min_commit: 1
            } {
                case 1 when true score 10
                case 2 when t > 0 score 15
                else 0
            }
            if t == 1 {
                return last
            }
            t = t + 1
        }
    }
}

flow LeadOneAboveHysteresis() -> Int {
    state Decide {
        var t = 0
        var last = 0
        while true {
            last = when policy {
                hysteresis: 5
                min_commit: 1
            } {
                case 1 when true score 10
                case 2 when t > 0 score 16
                else 0
            }
            if t == 1 {
                return last
            }
            t = t + 1
        }
    }
}

// A case whose condition holds is a candidate at any score, so `else` is not
// selected here even though both scores are below zero.
flow ScoresBelowZeroStillBeatElse(first: Int, second: Int) -> Int {
    state Decide {
        return when policy {
            hysteresis: 0
            min_commit: 1
        } {
            case 1 when true score first
            case 2 when true score second
            else 0
        }
    }
}

[Fact]
fn ALeadEqualToHysteresisDoesNotEndTheCommitment() -> Void {
    let held = LeadEqualToHysteresis()
    Step(held)
    Assert.Equal(1, Assert.LGTM(Result(held), "result"), "15 does not beat 10 by more than 5")

    let replaced = LeadOneAboveHysteresis()
    Step(replaced)
    Assert.Equal(2, Assert.LGTM(Result(replaced), "result"), "16 beats 10 by more than 5")
}

[Fact]
fn APolicyCaseWhoseConditionHoldsBeatsElseAtAnyScore() -> Void {
    let f = ScoresBelowZeroStillBeatElse(-5, -2)
    Step(f)
    Assert.Equal(2, Assert.LGTM(Result(f), "result"), "the greater of two negative scores")
}
