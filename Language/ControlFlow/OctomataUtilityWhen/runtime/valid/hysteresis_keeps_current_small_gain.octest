package MainValid

flow HysteresisKeep() -> Int {
    state Decide {
        var t = 0
        var last = 0
        while true {
            last = when policy {
                hysteresis: 8
                min_commit: 1
            } {
                case 1 when true score 60
                case 2 when t > 0 score 65
                else 0
            }
            if t == 1 {
                return last
            }
            t = t + 1
        }
    }
}

[Fact]
fn HysteresisKeepsCurrentForSmallGain() -> Void {
    let f = HysteresisKeep()
    Step(f)
    let value = Assert.LGTM(Result(f), "result should be available")
    Assert.Equal(1, value, "challenger within hysteresis should not replace current")
}
