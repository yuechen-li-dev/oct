package MainValid

flow InvalidCurrentDropped() -> Int {
    state Decide {
        var t = 0
        var last = 0
        while true {
            last = when policy {
                hysteresis: 10
                min_commit: 5
            } {
                case 1 when t == 0 score 100
                case 2 when true score 10
                else 0
            }
            if t == 1 {
                return last
            }
            t = t + 1
        }
    }
}

[Fact]
fn InvalidRememberedChoiceIsDiscarded() -> Void {
    let f = InvalidCurrentDropped()
    Step(f)
    let value = Assert.LGTM(Result(f), "result should be available")
    Assert.Equal(2, value, "invalid current choice should not be preserved")
}
