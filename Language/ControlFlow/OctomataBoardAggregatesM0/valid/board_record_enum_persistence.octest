package Main

record ControllerMemory {
    Count: Int
    Score: Float
}

enum Mode {
    Search
    Track
    Recover
}

record NestedMemory {
    Current: ControllerMemory
    LastMode: Mode
}

enum Status {
    Idle
    Reading(ControllerMemory)
}

fn StatusCount(status: Status) -> Int {
    return match status {
        case Status.Idle => 0
        case Status.Reading(memory) => memory.Count
    }
}

flow Controller() -> Int {
    board {
        Memory: ControllerMemory
        Mode: Mode
        Direction: Vector<Float>
        Transform: Matrix<Float>
        Nested: NestedMemory
        Status: Status
        Values: Int[]
    }

    state Run {
        board.Memory = ControllerMemory {
            Count: 1
            Score: 2.5
        }
        board.Mode = Mode.Track
        board.Direction = vector[1.0, 2.0]
        board.Transform = matrix[[1.0, 2.0] [3.0, 4.0]]
        board.Nested = NestedMemory {
            Current: board.Memory
            LastMode: board.Mode
        }
        board.Status = Status.Reading(board.Memory)
        board.Values = [1, 2, 3]
        suspend
        board.Memory = board.Memory with {
            Count: board.Memory.Count + 1
        }
        board.Direction = vector[5.0, 6.0]
        board.Transform = matrix[[7.0, 8.0] [9.0, 10.0]]
        board.Values[0] = 99
        return board.Memory.Count
    }
}

[Fact]
fn RecordAndEnumBoardValuesPersistWithoutSnapshotAliasing() -> Void {
    let machine = Controller()
    Step(machine)
    let before = BoardSnapshot(machine)!
    Assert.Equal(1, before.Memory.Count, "record board field should be visible after suspend")
    Assert.True(before.Mode == Mode.Track, "enum board field should persist directly")
    Assert.Equal(2.0, before.Direction[1], "vector board field should retain ordinary indexing")
    Assert.Equal(3.0, before.Transform[1, 0], "matrix board field should retain ordinary indexing")
    Assert.Equal(1, before.Nested.Current.Count, "nested persistent record should preserve fields")
    Assert.Equal(1, StatusCount(before.Status), "payload enum should preserve its record payload")
    Assert.Equal(1, before.Values[0], "compiled snapshot should detach slice-backed board values")
    Step(machine)
    let after = BoardSnapshot(machine)!
    Assert.Equal(2, after.Memory.Count, "record with update should persist on board")
    Assert.Equal(1, before.Memory.Count, "earlier board snapshot must not alias later mutation")
    Assert.Equal(2.0, before.Direction[1], "replaced vector must not change earlier snapshot")
    Assert.Equal(3.0, before.Transform[1, 0], "replaced matrix must not change earlier snapshot")
    Assert.Equal(1, before.Values[0], "indexed board mutation must not alias an earlier snapshot")
    Assert.Equal(2, Result(machine)!, "flow should complete with updated record field")
    Assert.Equal("Run", StateHistory(machine)[0], "history remains coherent with aggregate board values")
}
