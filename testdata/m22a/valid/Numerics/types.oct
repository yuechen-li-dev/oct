package Numerics

enum RootReason {
    Converged
    MaxIterationsReached
    InvalidBracket
    ZeroDerivative
}

record SolveOptions {
    MaxIterations: Int
    Tolerance: Float
}

record RootResult {
    Converged: Bool
    Iterations: Int
    Value: Float
    Residual: Float
    ReasonCode: Int
}

fn ReasonConverged() -> Int { return 0 }
fn ReasonMaxIterationsReached() -> Int { return 1 }
fn ReasonInvalidBracket() -> Int { return 2 }
fn ReasonZeroDerivative() -> Int { return 3 }

fn ProblemSqrt2() -> Int { return 1 }
fn ProblemCubic() -> Int { return 2 }
