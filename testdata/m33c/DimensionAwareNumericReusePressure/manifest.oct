package Manifest

record PackageManifest {
    Name: String
    Version: String
    Description: String
    Dependencies: Dependency[]
}

record Dependency {
    Name: String
    VersionRequirement: String
}

fn Manifest() -> PackageManifest {
    return PackageManifest {
        Name: "DimensionAwareNumericReusePressure"
        Version: "0.1.0"
        Description: "m33c dimension-aware numeric reuse pressure probes"
        Dependencies: [Dependency { Name: "OctStd" VersionRequirement: "0.1.0" }]
    }
}
