package Main
import Mechanics

fn Main() -> Int {
    let applied = Mechanics.Vec2Force {
        X: 10kg*m/s^2
        Y: 0kg*m/s^2 - 4kg*m/s^2
    }
    let reaction = Mechanics.Vec2Force {
        X: 0kg*m/s^2 - 9.9kg*m/s^2
        Y: 3.9kg*m/s^2
    }

    let report = Mechanics.ResultantReport(applied, reaction, 0.05kg^2*m^2/s^4)
    Print(report)

    let stiffness = Mechanics.Stiffness2 {
        K: matrix[[120kg/s^2, 0kg/s^2] [0kg/s^2, 80kg/s^2]]
    }
    let displacement = Mechanics.Displacement2 {
        X: 0.02m
        Y: 0m - 0.05m
    }

    let internal = Mechanics.InternalForce(stiffness, displacement)
    Print(internal)
    Print(Mechanics.DominantAxis(internal))

    if report.Balanced == false { return 1 }
    if Abs(internal.X - 2.4kg*m/s^2) > 0.0001kg*m/s^2 { return 2 }
    if Abs(internal.Y + 4.0kg*m/s^2) > 0.0001kg*m/s^2 { return 3 }

    return 0
}
