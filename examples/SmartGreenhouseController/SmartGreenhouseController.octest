package SmartGreenhouseController

[Fact]
fn ComfortBandSwitchWorks() -> Void {
    Assert.Equal(ComfortClass.Cold, ComfortBand(289.15K), "cold bucket")
    Assert.Equal(ComfortClass.Comfort, ComfortBand(295.15K), "comfort bucket")
    Assert.Equal(ComfortClass.Hot, ComfortBand(300.15K), "hot bucket")
}

[Fact]
fn WithUpdateIsImmutable() -> Void {
    let start = GreenhouseState {AirTemp: 293.15K SoilMoisture: 0.50 LightLevel: 0.75 BatteryCharge: 0.90}
    let warmed = WarmByOneStep(start, 2.0s)
    Assert.Equal(293.15K, start.AirTemp, "source record unchanged")
    Assert.True(warmed.AirTemp > start.AirTemp, "updated record warmed")
}

[Fact]
fn EnumPayloadMatchWorks() -> Void {
    Assert.Equal(294.15K, NormalizeTemperature(SensorReading.Valid(294.15K), 290.15K), "valid payload pass-through")
    Assert.Equal(290.15K, NormalizeTemperature(SensorReading.Missing("dropout"), 290.15K), "missing payload fallback")
}

[Fact]
fn MatrixVectorDistinctFromArray() -> Void {
    let arr =[1.0, 2.0]
    let next = PredictDeviation(vector[arr[0], arr[1]])
    Assert.Near(1.06, next[0], 0.0001, "predicted temp deviation")
    Assert.Near(1.81, next[1], 0.0001, "predicted moisture deviation")
}

[Fact]
fn BatchScoresAllCandidates() -> Void {
    let s = GreenhouseState {AirTemp: 289.15K SoilMoisture: 0.40 LightLevel: 0.60 BatteryCharge: 0.95}
    let scores = BatchModeScores(s)
    Assert.Equal(4, Len(scores), "batch output count")
    Assert.True(scores[0] > scores[3], "heat preferred in cold state")
}

[Fact]
fn FlowCompletesAndHistoryPresent() -> Void {
    let init = GreenhouseState {AirTemp: 289.15K SoilMoisture: 0.35 LightLevel: 0.55 BatteryCharge: 1.0}
    let machine = RunController(init, 4)
    while Complete(machine) == false {
        Step(machine)
    }

    let endState = Result(machine) !
    let history = StateHistory(machine)
    let snap = BoardSnapshot(machine) !

    Assert.True(endState.BatteryCharge < init.BatteryCharge, "battery consumed")
    Assert.True(Len(history) >= 4, "visited multiple states")
    Assert.Equal(4, snap.StepIndex, "board tracked step count")
}

[Fact]
fn UnitTypedCalculationCompilesAndRuns() -> Void {
    let period: Float < s > = 2.0s
    let distance = 3.0m
    let velocity: Float < m * s ^ - 1 > = distance / period
    Assert.Near(1.5, velocity /(1.0m * s ^ - 1), 0.000001, "dimensioned velocity")
}
