package SignalBatchAnalysis

[Fact]
fn BatchAnalysisShapeAndExpectedValues() -> Void {
    let sampleMeans = [1.0, 3.0, 5.0]
    let metrics = AnalyzeMeasurements(sampleMeans, 1.0)

    Assert.Equal(3, Len(metrics), "one metric per input sample")
    Assert.Near(0.1, metrics[0], 0.0001, "first metric value")
    Assert.Near(1.3, metrics[1], 0.0001, "second metric value")
    Assert.Near(4.5, metrics[2], 0.0001, "third metric value")
}

[Fact]
fn BatchAnalysisPreservesOrderedOutput() -> Void {
    let sampleMeans = [10.0, 2.0, 6.0]
    let metrics = AnalyzeMeasurements(sampleMeans, 1.0)

    Assert.Near(21.25, metrics[0], 0.0001, "first output tracks first input")
    Assert.Near(0.45, metrics[1], 0.0001, "second output tracks second input")
    Assert.Near(6.85, metrics[2], 0.0001, "third output tracks third input")
}

[Fact]
fn BatchAnalysisIsDeterministicAcrossRuns() -> Void {
    let sampleMeans = [2.0, 4.0, 8.0]

    let first = AnalyzeMeasurements(sampleMeans, 0.5)
    let second = AnalyzeMeasurements(sampleMeans, 0.5)

    Assert.Equal(Len(first), Len(second), "same input should produce same result count")
    Assert.Near(first[0], second[0], 0.0001, "first metric deterministic")
    Assert.Near(first[1], second[1], 0.0001, "second metric deterministic")
    Assert.Near(first[2], second[2], 0.0001, "third metric deterministic")
}
